// Recommended rank 2 of 7.
// Syntax Family B: Categorized design blocks.
//
// The design file keeps primitive categories explicit, then exposes mixed
// semantic collections through the same [] modifier surface app code uses.

use Badge, Box, Button, Checkbox, Col, Divider, IconButton, Row, Screen, Text, TextInput from @tao/ui

app TodoApp {
   design TodoDesign
   view MainScreen
}

design TodoDesign {
   space {
      xs 4px
      sm 8px
      md 12px
      lg 20px
      xl 28px
      screen 24px
   }

   color {
      brand #3b82f6
      brandHover #2563eb
      danger #dc2626
      ink #0f172a
      muted #64748b
      canvas #f8fafc
      surface white
      border #e2e8f0
      focus #93c5fd
      warningBg #fef3c7
      warningFg #92400e
      homeBg #dbeafe
      homeFg #1d4ed8
      workBg #ede9fe
      workFg #6d28d9
   }

   radius {
      sm 6px
      md 12px
      lg 18px
      pill 999px
   }

   font {
      sans Inter
      mono JetBrainsMono
      display Fraunces
   }

   typography {
      display [font display, size 32, weight bold, text ink, line 38]
      title [font sans, size 22, weight semibold, text ink, line 28]
      body [font sans, size 16, text ink, line 22]
      label [font sans, size 15, weight semibold, text ink, line 20]
      caption [font sans, size 13, text muted, line 18]
   }

   border {
      subtle [color border, width 1]
      focus [color focus, width 2]
      danger [color danger, width 1]
   }

   shadow {
      sm [y 1, blur 3, color #00000022]
      md [y 4, blur 12, color #00000024]
   }

   layout {
      screenFrame [fill]
      pageStack [fill, pad screen, gap lg]
      cardStack [stack, gap md]
      taskRow [row, gap md, content center stretch]
      actionRow [row, gap sm]
   }

   look {
      appSurface [bg canvas, text ink]
      cardChrome [bg surface, border subtle, radius lg, pad lg]
      taskChrome [bg surface, border subtle, radius lg, pad md]
      completedTaskChrome [taskChrome, text muted, opacity 60%]
      primaryButtonChrome [bg brand, text white, radius md, pad md, minTap 44]
      secondaryButtonChrome [bg surface, text ink, border subtle, radius md, pad md, minTap 44]
      destructiveButtonChrome [bg danger, text white, radius md, pad md, minTap 44]
      inputChrome [bg surface, text ink, border subtle, radius md, pad md, minTap 44]
      warningChrome [bg warningBg, text warningFg, border subtle, radius md, pad md]
      homeBadgeChrome [bg homeBg, text homeFg, radius pill, pad sm]
      workBadgeChrome [bg workBg, text workFg, radius pill, pad sm]
   }

   collection {
      screen [screenFrame, appSurface]
      page [pageStack]
      card [cardStack, cardChrome]
      task [taskRow, taskChrome]
      completedTask [taskRow, completedTaskChrome]
      primaryButton [actionRow, primaryButtonChrome]
      secondaryButton [actionRow, secondaryButtonChrome]
      destructiveButton [actionRow, destructiveButtonChrome]
      input [inputChrome]
      warning [row, gap sm, content center stretch, warningChrome]
      homeBadge [homeBadgeChrome]
      workBadge [workBadgeChrome]
   }
}

variant DisplayTitle = Text [typography display]
variant Title = Text [typography title]
variant Body = Text [typography body]
variant Caption = Text [typography caption]
variant Card = Col [collection card]
variant PrimaryButton = Button [collection primaryButton]
variant SecondaryButton = Button [collection secondaryButton]
variant DestructiveButton = Button [collection destructiveButton]

view MainScreen {
   state DraftTitle = ""
   state SyncState = "paused"

   render Screen [collection screen] {
      Col [collection page] {
         Row [content spaceBetween center] {
            Col [gap xs] {
               DisplayTitle "Today's Tasks"
               Caption "Three open tasks"
            }
            IconButton "settings" [collection secondaryButton]
         }

         Card {
            Title "Quick add"
            Row [layout actionRow] {
               TextInput DraftTitle [collection input, width fill]
               PrimaryButton "Add", action saveDraft
            }
            Text "Press enter or tap Add to save." [typography caption]
         }

         Box [collection warning] when SyncState == "paused" {
            Body "Offline changes will sync later."
         }

         Row [layout actionRow] {
            Button "All" [collection secondaryButton]
            Button "Open" [collection primaryButton]
            Button "Completed" [collection secondaryButton]
         }

         TaskRow "Buy oat milk" "Barista blend if available" "home" false
         TaskRow "Send design notes" "Send the shortlist" "work" false

         Divider [border subtle]
         Text "Compact density keeps the list scannable." [typography caption]
      }
   }
}

view TaskRow TitleText is text, Notes is text, Priority is text, Done is boolean {
   render Row [Done ? collection completedTask : collection task] {
      Checkbox Done
      Col [width fill, gap xs] {
         Body TitleText
         Caption Notes
         Badge [Priority == "work" ? collection workBadge : collection homeBadge] {
            Text Priority [typography label]
         }
      }
      DestructiveButton "Delete"
   }
}
