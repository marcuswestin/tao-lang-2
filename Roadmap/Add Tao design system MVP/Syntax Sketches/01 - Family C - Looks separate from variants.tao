// Recommended rank 1 of 7.
// Syntax Family C: Looks separate from variants.
//
// A lowercase look is presentation-only. It may combine layout and style, but
// it cannot add behavior. A capitalized variant or view is the behavior
// boundary.

use Badge, Box, Button, Checkbox, Col, IconButton, Link, Row, Screen, Text, TextInput from @tao/ui

app TodoApp {
   design TodoDesign
   view MainScreen
}

type TodoItem is {
   Title is text
   Notes is text
   Due is text
   Priority is text
   Done is boolean
}

alias FirstTodo = TodoItem {
   Title "Buy oat milk"
   Notes "Barista blend if available"
   Due "Today"
   Priority "home"
   Done false
}

alias SecondTodo = TodoItem {
   Title "Send design notes"
   Notes "Send the shortlist"
   Due "Tomorrow"
   Priority "work"
   Done false
}

design TodoDesign {
   primary #3b82f6
   primaryPress #2563eb
   danger #dc2626
   ink #0f172a
   muted #64748b
   canvas #f8fafc
   surface white
   border #e2e8f0
   focus #93c5fd

   xs 4px
   sm 8px
   md 12px
   lg 20px
   xl 28px
   pill 999px

   type display [size 32, weight bold, text ink, line 38]
   type title [size 22, weight semibold, text ink, line 28]
   type body [size 16, text ink, line 22]
   type label [size 15, weight semibold, text ink, line 20]
   type caption [size 13, text muted, line 18]

   look screen [fill, bg canvas, text ink]
   look page [fill, pad xl, gap lg]
   look card [stack, bg surface, border border, radius lg, pad lg]
   look task [row, bg surface, border border, radius lg, pad md]
   look completedTask [task, text muted, opacity 60%]
   look priorityHome [bg #dbeafe, text #1d4ed8, radius pill, pad sm]
   look priorityWork [bg #ede9fe, text #6d28d9, radius pill, pad sm]
   look primaryAction [rowCenter, bg primary, text white, radius md, pad md, minTap 44]
   look primaryActionPressed [primaryAction, bg primaryPress]
   look secondaryAction [rowCenter, bg surface, text ink, border border, radius md, pad md, minTap 44]
   look dangerAction [rowCenter, bg danger, text white, radius md, pad md, minTap 44]
   look linkAction [text primary, underline true]
   look input [bg surface, text ink, border border, radius md, pad md, minTap 44]
   look inputFocused [input, border primary, ring focus]
   look warning [row, bg #fef3c7, text #92400e, border #f59e0b, radius md, pad md]
}

variant DisplayTitle = Text [display]
variant Title = Text [title]
variant Body = Text [body]
variant Caption = Text [caption]
variant Card = Col [card]
variant Warning = Box [warning]
variant PrimaryButton = Button [primaryAction]
variant SecondaryButton = Button [secondaryAction]
variant DestructiveButton = Button [dangerAction]
variant PrimaryLink = Link [linkAction]
variant SearchInput = TextInput [input]
variant ButtonLikeLabel = Text [primaryAction]

view MainScreen {
   state DraftTitle = ""
   state ShowCompleted = true
   state IsSyncPaused = true

   render Screen [screen] {
      Col [page] {
         Row [content spaceBetween center] {
            Col [gap xs] {
               DisplayTitle "Today's Tasks"
               Caption "Three open tasks"
            }
            IconButton "settings" [secondaryAction]
         }

         Card [gap md] {
            Title "Quick add"
            Row [gap sm] {
               SearchInput DraftTitle [width fill]
               PrimaryButton "Add", action {
                  set DraftTitle = ""
               }
            }
            Caption "Press enter or tap Add to save."
         }

         Warning when IsSyncPaused {
            Body "Offline changes will sync later."
            PrimaryLink "Retry now", action retrySync
         }

         Row [gap sm] {
            SecondaryButton "All"
            SecondaryButton "Open"
            SecondaryButton "Completed" when ShowCompleted
         }

         TaskRow FirstTodo
         TaskRow SecondTodo

         ButtonLikeLabel "Not pressable"
      }
   }
}

view TaskRow Todo is TodoItem {
   render Row [Todo.Done ? completedTask : task, gap md, content center stretch] {
      Checkbox Todo.Done
      Col [width fill, gap xs] {
         Body Todo.Title
         Caption Todo.Notes
         Row [gap sm] {
            Caption Todo.Due
            PriorityBadge Todo.Priority
         }
      }
      DestructiveButton "Delete", action delete Todo
   }
}

view PriorityBadge Priority is text {
   render Badge [Priority == "work" ? priorityWork : priorityHome] {
      Text Priority [label]
   }
}

view EmptyState {
   render Card [gap md, content center] {
      Title "Nothing left"
      Body "Add a task to build today's list."
      PrimaryButton "Add a task"
   }
}
