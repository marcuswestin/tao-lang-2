// Recommended rank 4 of 7.
// Syntax Family A: Flat lowercase design objects.
//
// This is the most compact shape. Lowercase names can be tokens, typography,
// layout, style, or mixed presentation collections. The validator has to keep
// those categories typed even though authors see one flat design vocabulary.

use Badge, Box, Button, Checkbox, Col, IconButton, Link, Row, Screen, Text, TextInput from @tao/ui

app TodoApp {
   design TodoDesign
   view MainScreen
}

design TodoDesign {
   xs 4px
   sm 8px
   md 12px
   lg 20px
   xl 28px
   pill 999px

   primary #3b82f6
   primaryPress #2563eb
   danger #dc2626
   ink #0f172a
   muted #64748b
   canvas #f8fafc
   surface white
   subtle #e2e8f0
   focus #93c5fd
   homeBg #dbeafe
   homeFg #1d4ed8
   workBg #ede9fe
   workFg #6d28d9

   display [size 32, weight bold, text ink, line 38]
   title [size 22, weight semibold, text ink, line 28]
   body [size 16, text ink, line 22]
   label [size 15, weight semibold, text ink, line 20]
   caption [size 13, text muted, line 18]

   screen [fill, bg canvas, text ink]
   page [fill, pad xl, gap lg]
   card [stack, gap md, bg surface, border subtle, radius lg, pad lg]
   task [row, bg surface, border subtle, radius lg, pad md]
   completedTask [task, text muted, opacity 60%]
   primaryButton [rowCenter, bg primary, text white, radius md, pad md, minTap 44]
   primaryButtonPressed [primaryButton, bg primaryPress]
   secondaryButton [rowCenter, bg surface, text ink, border subtle, radius md, pad md, minTap 44]
   destructiveButton [rowCenter, bg danger, text white, radius md, pad md, minTap 44]
   input [bg surface, text ink, border subtle, radius md, pad md, minTap 44]
   focusedInput [input, border primary, ring focus]
   warning [row, bg #fef3c7, text #92400e, border #f59e0b, radius md, pad md]
   homeBadge [bg homeBg, text homeFg, radius pill, pad sm]
   workBadge [bg workBg, text workFg, radius pill, pad sm]
   linkAction [text primary, underline true]
}

variant DisplayTitle = Text [display]
variant Title = Text [title]
variant Body = Text [body]
variant Caption = Text [caption]
variant Card = Col [card]
variant PrimaryButton = Button [primaryButton]
variant SecondaryButton = Button [secondaryButton]
variant DestructiveButton = Button [destructiveButton]
variant PrimaryLink = Link [linkAction]
variant ButtonLikeLabel = Text [primaryButton]

view MainScreen {
   state DraftTitle = ""
   state SyncPaused = true

   render Screen [screen] {
      Col [page] {
         Row [content spaceBetween center] {
            Col [gap xs] {
               DisplayTitle "Today's Tasks"
               Caption "Three open tasks"
            }
            IconButton "settings" [secondaryButton]
         }

         Card {
            Title "Quick add"
            Row [gap sm] {
               TextInput DraftTitle [input, width fill]
               PrimaryButton "Add", action saveDraft
            }
            Caption "Press enter or tap Add to save."
         }

         Box [warning] when SyncPaused {
            Body "Offline changes will sync later."
         }

         Row [gap sm] {
            Button "All" [secondaryButton]
            Button "Open" [primaryButton]
            Button "Completed" [secondaryButton]
         }

         TaskRow "Buy oat milk" "Barista blend if available" "home" false
         TaskRow "Send design notes" "Send the shortlist" "work" false

         ButtonLikeLabel "Not pressable"
      }
   }
}

view TaskRow TitleText is text, Notes is text, Priority is text, Done is boolean {
   render Row [Done ? completedTask : task, gap md, content center stretch] {
      Checkbox Done
      Col [width fill, gap xs] {
         Body TitleText
         Caption Notes
         Row [gap sm] {
            Caption "Due today"
            Badge Priority [Priority == "work" ? workBadge : homeBadge]
         }
      }
      DestructiveButton "Delete"
   }
}
