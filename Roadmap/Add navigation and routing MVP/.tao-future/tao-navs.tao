// Proposed @tao/nav contract. This file is future syntax and is not executable yet.
// Native injections reconcile descriptors produced by Tao's one semantic navigation reducer.
// Every `inject` also receives compiler-supplied Provider.Descriptor, Provider.Snapshot,
// Provider.Revision, Provider.OperationId, Provider.DispatchNativeIntent,
// Provider.AcknowledgeOperation, and Provider.RejectOperation. These are injection capabilities,
// not public nav properties, and they expose no ambient Tao scope.

public type Presentable is ui | nav

public enum SelectionDisplay {
   "automatic"
   "tabs"
   "sidebar"
   "rail"
   "drawer"
}

public enum SplitAxis {
   "automatic"
   "horizontal"
   "vertical"
}

public enum OverlayLayout {
   "automatic"
   "sheet"
   "popover"
   "full-screen"
   "palette"
   "inspector"
   "floating"
}

// SlotNav owns one replaceable content occurrence.
// present/replace set Content; dismiss restores/clears changed content and delegates at initial/empty state.
public nav SlotNav {
   optional Initial Presentable
   inject Initial ...
}

// StackNav always starts with Initial.
// present pushes, replace replaces the top, and dismiss pops or delegates at the root.
public nav StackNav {
   Initial Presentable
   inject Initial ...
}

// A generic keyed occurrence wrapper distinguishes equal semantic content in Dynamic SelectionNav only.
public nav Occurrence {
   Content Presentable
   Key text
   inject Content, Key ...
}

// SelectionItem is keyed-entry data, not a callable nav.
// The compiler lowers every stable @key to an internal targetable wrapper that activates and forwards.
public type SelectionItem is {
   Label text
   optional Icon
   optional Badge text
   Content Presentable
}

public nav SelectionNav {
   // Literal @keys may be supplied directly; explicit Items remains valid for empty or computed collections.
   Items { @ SelectionItem }
   optional Initial key of Items
   Display SelectionDisplay default "automatic"
   Dynamic boolean default false
   inject Items, Initial, Display, Dynamic ...
}

// Static SelectionNav requires at least one item and a valid Initial key.
// Dynamic SelectionNav may begin empty. It focuses semantic identity unless Occurrence supplies a Key.
// UI item content normalizes to SlotNav { Initial Content }; nav item content mounts directly.

// SplitPane is keyed-entry data, not a callable nav.
// The compiler lowers every stable @key to an internal targetable wrapper that reveals and forwards.
public type SplitPane is {
   Content nav
   optional Title text
   optional IdealSize number
   optional Grow number
   optional CollapsePriority number
   Collapsible boolean default true
}

public nav SplitNav {
   // Literal @keys may be supplied directly; explicit Panes remains valid for empty or computed collections.
   Panes { @ SplitPane }
   Axis SplitAxis default "automatic"
   inject Panes, Axis ...
}

// OverlayNav stacks non-blocking UI above current content.
// Overlays are dismissible by default; disabling dismissal must be explicit.
public nav OverlayNav {
   optional Initial Presentable
   Layout OverlayLayout default "automatic"
   Dismissible boolean default true
   inject Initial, Layout, Dismissible ...
}

// ToastHost accepts transient Toast descriptors or UI shorthand with default metadata. It owns no initial content.
public nav ToastHost {
   inject ...
}

public nav Toast {
   Content ui
   optional Key text
   Duration duration default 4.seconds
   inject Content, Key, Duration ...
}

// WindowHost owns top-level native windows. Ordinary configured UI or nav content is shorthand for an unkeyed Window.
public nav WindowHost {
   inject ...
}

public nav Window {
   Content Presentable
   optional Key text
   optional Title text
   inject Content, Key, Title ...
}

// Occurrence, Toast, and Window are policy wrappers: only a compatible receiving nav may mount them.
// Their Key distinguishes occurrences; labels, layout, sizing, and titles are non-identity metadata.
