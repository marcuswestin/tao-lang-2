use @tao/nav as Nav
use Button, Col, List, Row, Spinner, Text from @tao/ui

// Authoritative intended navigation sketch for the navigation roadmap.
// This app is planning input until the corresponding language/runtime slices are implemented.

data WriterData {
   Workspaces/Workspace {
      Name text
      Documents
   }

   Documents/Document {
      Title text
      Workspace
      Paragraphs
   }

   Paragraphs/Paragraph {
      Document
      Text text
   }
}

enum ConfirmResult {
   "confirmed"
}

// A configured nav binding is an immutable descriptor, not a mounted instance or exposed state.
workspace let HomeStack = Nav.StackNav { Initial HomeUi }
workspace let SettingsStack = Nav.StackNav { Initial SettingsUi }
workspace let WorkspaceNav = Nav.SlotNav { Initial WorkspaceChooserUi }

workspace let WriterNavigator = Nav.SelectionNav {
   Initial @home
   Display "automatic"

   // Direct keys bind to Items and share this configured nav's target-key namespace.
   @home {
      Label "Home"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Content SettingsStack
   }
}

workspace let WriterOverlays = Nav.OverlayNav { Layout "automatic" }
workspace let WriterToasts = Nav.ToastHost {}
workspace let DocumentWindows = Nav.WindowHost {}

app Writer {
   Name "Writer"
   Navigator WriterNavigator

   // Declaring a nav does not mount it. App-owned direct keys mount these auxiliary hosts.
   // Direct keys bind to Auxiliaries. The property name is not part of Writer@overlays and similar paths.
   @overlays WriterOverlays
   @toasts WriterToasts
   @windows DocumentWindows
}

// `with` copies public properties. WriterNavigator and Writer remain unchanged.
let WriterDrawer = Writer with {
   Name "Writer - Drawer Preview"
   Navigator WriterNavigator with { Display "drawer" }
}

let SignedOutNav = Nav.StackNav { Initial SignedOutUi }

ui HomeUi {
   query WriterData.Workspaces { Name }

   render Col {
      Text "Writer"
      Button "Activate workspace", on press -> { present Writer@workspace }

      List Workspaces {
         Text Workspace.Name

         on select -> Workspace {
            // Omitted target delegates to HomeStack, so each call pushes a new occurrence.
            present WorkspaceDetailsUi Workspace
         }
      }
   }
}

ui WorkspaceDetailsUi {
   Workspace WriterData.Workspace

   query WriterData.Documents { Title, where Workspace = Workspace }

   render Col {
      Text Workspace.Name
      Button "Open workspace", on press -> {
         // A configured nav value locates its one equal active mount. The next statement sees the update synchronously.
         present WorkspaceSplit Workspace in WorkspaceNav
         present Writer@workspace
      }
      Button "Push this workspace twice", on press -> {
         present WorkspaceDetailsUi Workspace
         present WorkspaceDetailsUi Workspace
      }

      List Documents {
         Text Document.Title
         on select -> Document {
            present WorkspaceSplit Workspace in Writer@workspace
            present DocumentEditorUi Document in Writer@workspace@documents
         }
      }
   }
}

ui WorkspaceChooserUi {
   query WriterData.Workspaces { Name }

   render Col {
      Text "Choose a workspace"
      List Workspaces {
         Button Workspace.Name, on press -> {
            present WorkspaceSplit Workspace in Writer@workspace
         }
      }
   }
}

// A nav definition declares public properties and produces one root nav descriptor.
nav WorkspaceSplit {
   Workspace WriterData.Workspace

   render Nav.SplitNav {
      Axis "horizontal"

      // Direct keys bind to Panes. The nested SelectionNav starts its own key namespace.
      @files {
         Content Nav.SlotNav { Initial FileTreeUi Workspace }
         Title "Files"
         IdealSize 280
         CollapsePriority 2
      }
      @documents {
         Content Nav.SelectionNav {
            Items {}
            Display "tabs"
            Dynamic true
         }
         Title "Documents"
         Grow 1
         CollapsePriority 3
      }
      @inspector {
         Content Nav.SlotNav {}
         Title "Inspector"
         IdealSize 340
         CollapsePriority 1
      }
   }
}

ui FileTreeUi {
   Workspace WriterData.Workspace

   query WriterData.Documents { Title, where Workspace = Workspace }

   render Col {
      Text Workspace.Name

      List Documents {
         Row {
            Button Document.Title, on press -> {
               // Relative @documents resolves to the nearest unique pane and reveals it.
               present DocumentEditorUi Document in @documents
            }
            Button "Rooted", on press -> {
               present DocumentEditorUi Document in Writer@workspace@documents
            }
            Button "Via mounted binding", on press -> {
               // WorkspaceNav is mounted once; resolution follows its active WorkspaceSplit content.
               present DocumentEditorUi Document in WorkspaceNav@documents
            }
            Button "Comparison tab", on press -> {
               // Dynamic selection normally focuses semantic identity; a key makes another occurrence.
               present Nav.Occurrence {
                  Content DocumentEditorUi Document
                  Key "comparison"
               } in @documents
            }
         }
      }
   }
}

ui DocumentEditorUi {
   Document WriterData.Document
   let Title = Document.Title

   guard Document when
      Loading -> render Spinner
      Available -> render DocumentEditor Document
      Missing -> render MissingDocumentUi Document.Id
      Unauthorized -> render Text "You no longer have access to this document."
      Failed -> render Text "The document could not be loaded."
}

view DocumentEditor {
   Document WriterData.Document

   query WriterData.Paragraphs { Text, where Document = Document }

   render Col {
      Text "Document: {Document.Title}"
      List Paragraphs {
         Text Paragraph.Text
         on select -> Paragraph {
            present ParagraphInspectorUi Paragraph in @inspector
         }
      }

      Row {
         Button "Document info", on press -> {
            present DocumentInfoUi Document in Writer@overlays
         }
         Button "Save", on press -> {
            present Nav.Toast {
               Content SavedToastUi
               Key "document-saved"
               Duration 3.seconds
            } in Writer@toasts
         }
         Button "Comparison window", on press -> {
            present Nav.Window {
               Content DocumentEditorUi Document
               Key "comparison-left"
               Title Document.Title
            } in Writer@windows
         }
         Button "Snapshot", on press -> {
            let Snapshot = snapshot Document
            present DocumentSnapshotUi Snapshot in Writer@overlays
         }
         Button "Close document", on press -> {
            let Result = ask ConfirmCloseDialogue Document
            when Result is
               ConfirmResult."confirmed" -> dismiss
               none -> log "close cancelled"
         }
      }
   }
}

ui ParagraphInspectorUi {
   Paragraph WriterData.Paragraph
   render Text "{Paragraph.Document.Title} - {Paragraph.Text}"
}

ui DocumentInfoUi {
   Document WriterData.Document

   render Col {
      Text Document.Title
      Text "{Document.Paragraphs.Count} paragraphs"
      Button "Dismiss", on press -> { dismiss }
   }
}

ui DocumentSnapshotUi {
   Snapshot WriterData.Document.Snapshot

   render Col {
      Text "Captured version"
      Text Snapshot.Title
      Button "Dismiss", on press -> { dismiss }
   }
}

ui MissingDocumentUi {
   DocumentId WriterData.Document.Id
   render Text "Document {DocumentId} no longer exists."
}

ui SavedToastUi {
   render Text "Saved"
}

dialogue ConfirmCloseDialogue responds ConfirmResult {
   Document WriterData.Document

   render Col {
      Text "Close {Document.Title}?"
      Button "Close", on press -> { respond "confirmed" }
      Button "Cancel", on press -> { respond }
   }
}

ui SettingsUi {
   render Col {
      Text "Settings"
      Button "Reset to signed out", on press -> { replace SignedOutNav in Writer }
   }
}

ui SignedOutUi {
   render Text "Signed out"
}

// Deterministic foundation harness: only the first-slice app root, SlotNav, and StackNav.
workspace let FoundationStack = Nav.StackNav { Initial FoundationHomeUi }
workspace let FoundationNavigator = Nav.SlotNav { Initial FoundationStack }

app WriterFoundationTest {
   Name "Writer Navigation Foundation Test"
   Navigator FoundationNavigator
}

ui FoundationHomeUi {
   render Col {
      Text "Foundation home marker"
      Button "Open deterministic detail", on press -> { present FoundationDetailUi }
      Button "Open deterministic slot", on press -> {
         present FoundationSlotUi in FoundationNavigator
      }
   }
}

ui FoundationDetailUi {
   render Col {
      Text "Foundation detail marker"
      Button "Reset foundation app", on press -> {
         replace FoundationNavigator in WriterFoundationTest
      }
   }
}

ui FoundationSlotUi {
   render Col {
      Text "Foundation slot marker"
      Button "Restore initial stack", on press -> { dismiss }
   }
}

// coverage: DEC-NAV-003 rejects an ambiguous bare block when two same-source slots are not named.
// coverage: DEC-NAV-006 rejects rendering any Nav.* value inside a view or ui.
// coverage: DEC-NAV-008 rejects missing or ambiguous explicit paths without fallback.
// coverage: DEC-NAV-009 requires a rooted path if WorkspaceNav is ever mounted more than once.
// coverage: DEC-NAV-015 rejects a UI property whose value is a function, closure, native handle, or component instance.
// coverage: DEC-NAV-017 exposes validation and runtime failures as structured diagnostics.
// deferred: DEF-NAV-001 owns route declaration syntax for reconstructing Writer@workspace@documents.
// deferred: DEF-NAV-002 owns custom migration syntax for renamed keys or declarations.
// deferred: DEF-NAV-003 owns multiple scenes, spatial presentation, widgets, and complications.
// deferred: DEF-NAV-005 keeps suspended dialogue continuations process-local.
// deferred: DEF-NAV-009 owns entity validity rules after an action resumes from ask.

test "Writer semantic navigation" {
   check "native back uses the semantic reducer" {
      run WriterFoundationTest
      expect text "Foundation home marker"
      expect missing text "Foundation detail marker"
      press text "Open deterministic detail"
      expect text "Foundation detail marker"
      back
      expect text "Foundation home marker"
      expect missing text "Foundation detail marker"
   }

   check "slot dismissal restores its initial stack" {
      run WriterFoundationTest
      press text "Open deterministic slot"
      expect text "Foundation slot marker"
      press text "Restore initial stack"
      expect text "Foundation home marker"
      expect missing text "Foundation slot marker"
   }

   check "drawer is a selection display" {
      run WriterDrawer
      press text "Workspace"
      expect text "Choose a workspace"
   }
}
