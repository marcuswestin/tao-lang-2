{
  // Dprint formatting
  "editor.defaultFormatter": "dprint.dprint",
  "editor.formatOnSave": true,
  "dprint.path": ".devenv/profile/bin/dprint",
  //
  // File and search exclusions
  "files.exclude": {
    ".devenv": true,
    ".direnv": true,
    "**/node_modules": true,
    "**/tsconfig.tsbuildinfo": true,
    "local.properties": true,
    "skills-lock.json": true,
    ".android": true,
    ".codex": true
  },
  "search.exclude": {
    "**/bun.lock": true
  }
}
