{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install-ide-extension",
      "type": "shell",
      "command": "just install-ide-extension",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "zsh",
          "args": [
            "-c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "type": "vscode-just",
      "task": "just test",
      "problemMatcher": [],
      "label": "vscode-just: Run default recipe",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
