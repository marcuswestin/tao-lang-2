#!/bin/sh

if [ -z "${ZSH_VERSION:-}" ]; then
  SCRIPT_PATH=$0
  while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_LINK=$(readlink "$SCRIPT_PATH") || exit 1
    case "$SCRIPT_LINK" in
      /*) SCRIPT_PATH=$SCRIPT_LINK ;;
      *) SCRIPT_PATH=${SCRIPT_PATH%/*}/$SCRIPT_LINK ;;
    esac
  done
  SCRIPT_DIR=$(CDPATH= cd -- "${SCRIPT_PATH%/*}" && pwd -P) || exit 1
  . "$SCRIPT_DIR/packages/cli/dev-cli/dev-cli-src/environment/repo-shell.sh"
  tao_exec_repo_zsh "$SCRIPT_DIR" "$0" "$@"
fi

set -e

# Resolve the wrapper location so ./tao works from any invocation directory.
SCRIPT_DIR="${0:A:h}"
DEVENV_PROFILE="$SCRIPT_DIR/.devenv/profile"

source "$SCRIPT_DIR/packages/cli/dev-cli/dev-cli-src/cli/agent-worktree-profile.zsh"
if ! tao_activate_devenv_profile "$SCRIPT_DIR" "$DEVENV_PROFILE"; then
  echo "Tao's pinned devenv profile is unavailable." >&2
  echo "On macOS run ./enter-tao-dev-env; on Linux run ./bootstrap-tao-dev-env --install-nix." >&2
  exit 1
fi

exec bun "$SCRIPT_DIR/packages/cli/tao-cli/cli-src/tao-cli.ts" "$@"
