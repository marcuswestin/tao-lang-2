{
  "extends": "../tsconfig.base.json",
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "**/node_modules/**/*"
  ],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "incremental": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "bun",
      "node"
    ]
  }
}
