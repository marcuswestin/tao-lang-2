{
  "extends": "../tsconfig.base.json",
  "include": [
    "dev-src/**/*",
    "dev-tests/**/*",
    "performance-checks/**/*",
    "host-testing/**/*",
    "studio-smoke/**/*"
  ],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "incremental": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "bun",
      "node"
    ]
  }
}
