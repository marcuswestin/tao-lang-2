{
  "extends": "../tsconfig.base.json",
  "include": [
    "ide-extension-src/**/*",
    "ide-extension-tests/**/*",
    "esbuild.config.ts"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "declaration": false,
    "incremental": false,
    "noEmit": true,
    "types": [
      "bun",
      "node"
    ]
  }
}
