+#if TARGET_OS_MACCATALYST
+// Trial compatibility: UIKit owns a tiled tab pane's bounds, while Fabric initially
+// sizes the tab's nested stack against the complete tabs host. Native screens already
+// publish their corrected bounds back to Fabric through RNSScreen.updateBounds.
+- (void)catalystSyncDirectTabParentBounds
+{
+  UIView *parent = self.superview;
+  BOOL isDirectTabChild = [parent isKindOfClass:RNSTabsScreenComponentView.class];
+  if (!isDirectTabChild) {
+    if (_catalystTabParentSizing) {
+      self.autoresizingMask = _catalystPreviousAutoresizingMask;
+      _catalystTabParentSizing = NO;
+    }
+    return;
+  }
+  if (!_catalystTabParentSizing) {
+    _catalystPreviousAutoresizingMask = self.autoresizingMask;
+    _catalystTabParentSizing = YES;
+    self.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+  }
+  if (!CGRectEqualToRect(self.frame, parent.bounds)) {
+    self.frame = parent.bounds;
+    [self setNeedsLayout];
+  }
+}
+
+- (void)didMoveToSuperview
+{
+  [super didMoveToSuperview];
+  [self catalystSyncDirectTabParentBounds];
+}
+
+- (void)updateLayoutMetrics:(const react::LayoutMetrics &)layoutMetrics
+           oldLayoutMetrics:(const react::LayoutMetrics &)oldLayoutMetrics
+{
+  [super updateLayoutMetrics:layoutMetrics oldLayoutMetrics:oldLayoutMetrics];
+  [self catalystSyncDirectTabParentBounds];
+}
+#endif
