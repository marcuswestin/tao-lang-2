+#if TARGET_OS_MACCATALYST
+- (CGFloat)catalystNativeContentOriginDeltaX
+{
+  RNSTabsHostComponentView *host = self.reactSuperview;
+  if (self.window == nil || host == nil || host.window != self.window) {
+    return 0;
+  }
+  // UIKit reparents the pane inside its own containers. Convert to the original
+  // React parent rather than assuming the immediate native parent's coordinates.
+  CGPoint nativeOrigin = [self convertPoint:CGPointZero toView:host];
+  return nativeOrigin.x - _layoutMetrics.frame.origin.x;
+}
+#endif
