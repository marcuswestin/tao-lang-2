{
  "extends": "../tsconfig.base.json",
  "include": [
    "code-editor-src/**/*",
    "code-editor-tests/**/*"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "declaration": false,
    "incremental": false,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "types": [
      "bun",
      "node"
    ]
  }
}
