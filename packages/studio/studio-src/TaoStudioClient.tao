// Tao Studio client strangler contract. Its mounted slice is a native Tao recursive Files panel over
// the live StudioServer datasource. The compiled root owns the Files and editor workbench slots;
// the host publishes versioned browser-local selection state into the external editor boundary.
use SlotNav from @tao/nav
use Checkbox, Col, Text, TextInput from @tao/ui

// File contents remain editor buffers and never appear in Files or any related entity.
app TaoStudioFiles {
   Name "Tao Studio Files"
   state CollapsedFolders is list of text = [] (persist)
   action ToggleFolder(FolderPath text) {
      set CollapsedFolders = StudioToggleFolder(CollapsedFolders, FolderPath)
   }
   Design StudioDesign
   Navigator SlotNav {
      Initial StudioRoot(CollapsedFolders: CollapsedFolders, ToggleFolder: ToggleFolder)
   }
   Datasource StudioServer { }
}

design StudioDesign {
   panel #090909
   ink #f4f4f4
   line #363636
   Text [ink ink]
   TextInput [background panel, border line, ink ink]
}

type StudioServer is datasource with {
   ServerOrigin text is ""

   provider StudioServerProvider from ./StudioServerDataProvider.ts
}

workspace
data Files / File {
   StableId text (unique)
   Path text
   Name text
   ParentPath text
   Version text
   Dirty boolean
   Folder boolean
   DiagnosticCount number
   Diagnostics (owned)

   order by Path
}

workspace
data Diagnostics / Diagnostic {
   Message text
   Source text
   File
}

workspace
data Screens / Screen {
   StableId text (unique)
   Name text
   SourcePath text
}

workspace
data Views / View {
   StableId text (unique)
   Name text
   SourcePath text
}

workspace
data Scenarios / Scenario {
   StableId text (unique)
   Group text
   Name text
   SourcePath text
   SubjectId text
}

workspace
data Checkpoints / Checkpoint {
   StableId text (unique)
   Path text
   BeforeVersion text
   AfterVersion text
   Status text
}

workspace
data DesignTokens / DesignToken {
   StableId text (unique)
   DesignName text
   Kind text
   Name text
   SourcePath text
   SourceVersion text
   Start number
   End number
   Value text

   order by SourcePath
}

type StudioActionFailure is one of Conflict

action SyncDraft(Path text, SourceVersion text, Content text) runs latest from ./TaoStudioServerActions.ts

action ApplySourceAction(Envelope text) fails Conflict "This file changed under this edit." from ./TaoStudioServerActions.ts

action UndoSourceAction(Envelope text) fails Conflict "This file changed under this edit." from ./TaoStudioServerActions.ts

action CreateFile(Path text) fails Conflict "This file changed under this edit." from ./TaoStudioProductHost.tsx

action RenameFile(Path text, SourceVersion text, TargetPath text) fails Conflict "This file changed under this edit." from ./TaoStudioProductHost.tsx

action MoveGeneratedSource(Path text, SourceVersion text, TargetPackage text) fails Conflict "This file changed under this edit." from ./TaoStudioProductHost.tsx

action DeleteFile(Path text, SourceVersion text) fails Conflict "This file changed under this edit." from ./TaoStudioProductHost.tsx

action OpenFile(Path text) from ./TaoStudioProductHost.tsx

action OpenSource(Path text, SourceVersion text, Start number) from ./TaoStudioProductHost.tsx

action InsertComponent(Name text) from ./TaoStudioProductHost.tsx

action InsertProjectView(Name text) from ./TaoStudioProductHost.tsx

