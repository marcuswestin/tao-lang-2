// Tao Studio client strangler contract. Its mounted slice is a native Tao recursive Files panel over
// the live StudioServer datasource. The compiled root owns the Files and editor workbench slots;
// the host publishes versioned browser-local selection state into the external editor boundary.
use SlotNav from @tao/nav
use Col, Text from @tao/ui

// File contents remain editor buffers and never appear in Files or any related entity.
app TaoStudioFiles {
   Name "Tao Studio Files"
   Design StudioDesign
   Navigator SlotNav {
      Initial StudioRoot
   }
   Datasource StudioServer { }
}

design StudioDesign { }

type StudioServer is datasource with {
   ServerOrigin text is ""

   provider StudioServerProvider from ./StudioServerDataProvider.ts
}

workspace
data Files / File {
   StableId text (unique)
   Path text
   Name text
   ParentPath text
   Version text
   Dirty boolean
   Folder boolean
   DiagnosticCount number
   Diagnostics (owned)

   order by Path
}

workspace
data Diagnostics / Diagnostic {
   Message text
   Source text
   File
}

workspace
data Screens / Screen {
   StableId text (unique)
   Name text
   SourcePath text
}

workspace
data Views / View {
   StableId text (unique)
   Name text
   SourcePath text
}

workspace
data Scenarios / Scenario {
   StableId text (unique)
   Group text
   Name text
   SourcePath text
   SubjectId text
}

workspace
data Checkpoints / Checkpoint {
   StableId text (unique)
   Path text
   BeforeVersion text
   AfterVersion text
   Status text
}

type StudioActionFailure is one of Conflict

action SyncDraft(Path text, SourceVersion text, Content text) runs latest from ./TaoStudioServerActions.ts

action ApplySourceAction(Envelope text) fails Conflict "This file changed under this edit." from ./TaoStudioServerActions.ts

action UndoSourceAction(Envelope text) from ./TaoStudioServerActions.ts

action CreateFile(Path text) fails Conflict "This file changed under this edit." from ./TaoStudioProductHost.tsx

action RenameFile(Path text, SourceVersion text, TargetPath text) fails Conflict "This file changed under this edit." from ./TaoStudioProductHost.tsx

action DeleteFile(Path text, SourceVersion text) fails Conflict "This file changed under this edit." from ./TaoStudioProductHost.tsx

action OpenFile(Path text) from ./TaoStudioProductHost.tsx

action ApplyActiveCellEnvironment(Preset text, Width number, Height number, Network text, Latency number, ErrorMessage text, ErrorStatus number) fails Conflict "This preview changed while its environment was being edited." from ./TaoStudioProductHost.tsx

view FilesPanel() {
   state NewPath = ""
   action Create() {
      do CreateFile(NewPath)
      set NewPath = ""
   }
   action ChangeNewPath(Value text) {
      set NewPath = Value
   }
   render FilesPanelSurface() {
      FileCreateBar(NewPath, ChangeNewPath, Create)
      FileTree("")
}  }

view FilesPanelSurface() accepts content from ./TaoStudioProductHost.tsx

view FileCreateBar(Path text, Change action(text), Create action()) from ./TaoStudioProductHost.tsx

// Disclosure stays Studio-local: Tao has no generic tree construct. Its expansion is view-local
// because persisted view-instance keying is deliberately deferred by the current language.
view Disclosure(Label text) {
   state Expanded = true
   action Toggle() {
      toggle Expanded
   }
   render TreeFolder(Label, Expanded, Toggle) {
      when Expanded {
         true -> { @@content }
         otherwise -> { }
}  }  }

view TreeFolder(Label text, Expanded boolean, Toggle action()) accepts content from ./TaoStudioProductHost.tsx

view FileTree(FolderPath text) {
   query Files as Children {
      where ParentPath == FolderPath
   }
   render Col() {
      guard Children {
         loading -> { Text("Loading Studio files…") }
         error -> Message { Text(Message) }
      }
      loop Children / File {
         when File.Folder {
            true -> { Disclosure(File.Name) {
               FileTree(File.Path)
            } }
            otherwise -> { FileRow(File) }
}  }  }  }

view FileRow(File) {
   state RenamePath = File.Path
   state Renaming = false
   state ConfirmDelete = false
   action Open() {
      do OpenFile(File.Path)
   }
   action ChangeRenamePath(Value text) {
      set RenamePath = Value
   }
   action BeginRename() {
      set ConfirmDelete = false
      set Renaming = true
   }
   action CancelRename() {
      set RenamePath = File.Path
      set Renaming = false
   }
   action Rename() {
      do RenameFile(Path: File.Path, SourceVersion: File.Version, TargetPath: RenamePath)
      set Renaming = false
   }
   action BeginDelete() {
      set Renaming = false
      set ConfirmDelete = true
   }
   action CancelDelete() {
      set ConfirmDelete = false
   }
   action Delete() {
      do DeleteFile(Path: File.Path, SourceVersion: File.Version)
   }
   render TreeFileRow(Name: File.Name, Path: File.Path, Dirty: File.Dirty, DiagnosticCount: File.DiagnosticCount, RenamePath: RenamePath, Renaming: Renaming, ConfirmDelete: ConfirmDelete, Open: Open, ChangeRenamePath: ChangeRenamePath, BeginRename: BeginRename, CancelRename: CancelRename, Rename: Rename, BeginDelete: BeginDelete, CancelDelete: CancelDelete, Delete: Delete)
}

view TreeFileRow(Name text, Path text, Dirty boolean, DiagnosticCount number, RenamePath text, Renaming boolean, ConfirmDelete boolean, Open action(), ChangeRenamePath action(text), BeginRename action(), CancelRename action(), Rename action(), BeginDelete action(), CancelDelete action(), Delete action()) from ./TaoStudioProductHost.tsx

view StudioEditorSurface() from ./TaoStudioProductHost.tsx

view StudioContextPanel(Revision number, ProjectRoot text, ActiveFilePath text, ActiveFileContent text, ActiveFileVersion text, SelectionAnchor number, SelectionHead number, SelectedRenderId text, SelectedRenderPath text, SelectedRenderVersion text, ActiveCellId text, CellRevision number, ActiveScenarioId text, ViewportPresetId text, ViewportWidth number, ViewportHeight number, NetworkOutcome text, NetworkLatencyMs number, NetworkErrorMessage text, NetworkErrorStatus number, SchemeRequested text, SchemeStatus text) {
   state Preset = ViewportPresetId
   state Width = ViewportWidth
   state Height = ViewportHeight
   state Network = NetworkOutcome
   state Latency = NetworkLatencyMs
   state ErrorMessage = NetworkErrorMessage
   state ErrorStatus = NetworkErrorStatus
   action ChangePreset(Value text) {
      set Preset = Value
   }
   action ChangeWidth(Value number) {
      set Preset = "custom"
      set Width = Value
   }
   action ChangeHeight(Value number) {
      set Preset = "custom"
      set Height = Value
   }
   action ChangeNetwork(Value text) {
      set Network = Value
   }
   action ChangeLatency(Value number) {
      set Latency = Value
   }
   action ChangeErrorMessage(Value text) {
      set ErrorMessage = Value
   }
   action ChangeErrorStatus(Value number) {
      set ErrorStatus = Value
   }
   action ApplyEnvironment() {
      do ApplyActiveCellEnvironment(Preset: Preset, Width: Width, Height: Height, Network: Network, Latency: Latency, ErrorMessage: ErrorMessage, ErrorStatus: ErrorStatus)
   }
   render StudioContextPanelSurface() {
      StudioContextSummary(FilePath: ActiveFilePath, ScenarioId: ActiveScenarioId, CellId: ActiveCellId, RenderId: SelectedRenderId, ViewportWidth: ViewportWidth, ViewportHeight: ViewportHeight)
      when ActiveCellId {
         empty -> { }
         otherwise -> { StudioScenarioEnvironmentControls(Preset: Preset, Width: Width, Height: Height, Network: Network, Latency: Latency, ErrorMessage: ErrorMessage, ErrorStatus: ErrorStatus, SchemeRequested: SchemeRequested, SchemeStatus: SchemeStatus, ChangePreset: ChangePreset, ChangeWidth: ChangeWidth, ChangeHeight: ChangeHeight, ChangeNetwork: ChangeNetwork, ChangeLatency: ChangeLatency, ChangeErrorMessage: ChangeErrorMessage, ChangeErrorStatus: ChangeErrorStatus, Apply: ApplyEnvironment) }
}  }  }

view StudioContextPanelSurface() accepts content from ./TaoStudioProductHost.tsx

view StudioContextSummary(FilePath text, ScenarioId text, CellId text, RenderId text, ViewportWidth number, ViewportHeight number) from ./TaoStudioProductHost.tsx

view StudioScenarioEnvironmentControls(Preset text, Width number, Height number, Network text, Latency number, ErrorMessage text, ErrorStatus number, SchemeRequested text, SchemeStatus text, ChangePreset action(text), ChangeWidth action(number), ChangeHeight action(number), ChangeNetwork action(text), ChangeLatency action(number), ChangeErrorMessage action(text), ChangeErrorStatus action(number), Apply action()) from ./TaoStudioProductHost.tsx

view StudioRoot() {
   render ProductHostBoundary() {
      @files FilesPanel()
      @editor StudioEditorSurface()
      @inspector StudioContextPanel(Revision: 0, ProjectRoot: "", ActiveFilePath: "", ActiveFileContent: "", ActiveFileVersion: "", SelectionAnchor: 0, SelectionHead: 0, SelectedRenderId: "", SelectedRenderPath: "", SelectedRenderVersion: "", ActiveCellId: "", CellRevision: 0, ActiveScenarioId: "", ViewportPresetId: "custom", ViewportWidth: 0, ViewportHeight: 0, NetworkOutcome: "normal", NetworkLatencyMs: 0, NetworkErrorMessage: "Injected Studio network failure", NetworkErrorStatus: 503, SchemeRequested: "light", SchemeStatus: "inert")
}  }

view ProductHostBoundary() accepts content slots @files, @editor, @inspector from ./TaoStudioProductHost.tsx
