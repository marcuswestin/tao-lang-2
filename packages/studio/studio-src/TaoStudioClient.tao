type StudioPanelAction is {
   Name text,
   Payload text,
}

type StudioProblemPanelRow is {
   Action StudioPanelAction,
   Actionable boolean,
   Column number,
   Detail text,
   HasPosition boolean,
   Label text,
   Line number,
   Path text,
   SourceVersion text,
}

type StudioCompilePanel is {
   AppliedRevision number,
   CompileRevision number,
   DiagnosticCount number,
   Diagnostics list of StudioProblemPanelRow,
   Message text,
   Status text,
}

type StudioProblemsPanel is {
   Rows list of StudioProblemPanelRow,
}

type StudioDataPanelTable is {
   Datasource text,
   Entity text,
   RetainedRowCount number,
   Rows list of text,
   TotalRowCount number,
}

type StudioDataPanel is {
   CaptureAction StudioPanelAction,
   Error text,
   Loading boolean,
   RefreshAction StudioPanelAction,
   Source text,
   Tables list of StudioDataPanelTable,
}

type StudioTestFailure is {
   Action StudioPanelAction,
   Column number,
   Detail text,
   HasPosition boolean,
   Label text,
   Line number,
   Path text,
}

type StudioTestsPanel is {
   Available boolean,
   Error text,
   Failures list of StudioTestFailure,
   Output text,
   Reason text,
   RunAction StudioPanelAction,
   Running boolean,
   Summary text,
   Watch boolean,
   WatchAction StudioPanelAction,
}

type StudioLogPanelRow is {
   Level text,
   Message text,
   Timestamp number,
}

type StudioLogsPanel is {
   ClearAction StudioPanelAction,
   RetainedCount number,
   Rows list of StudioLogPanelRow,
   Source text,
   TotalCount number,
}

type StudioDebugJournalRow is {
   Action text,
   Detail text,
   Outcome text,
}

type StudioDebugBinding is {
   Name text,
   Value text,
}

type StudioDebugPendingWrite is {
   Committed text,
   Kind text,
   Pending text,
   Target text,
}

type StudioDebugPanel is {
   BreakAction StudioPanelAction,
   ClearAction StudioPanelAction,
   ContinueAction StudioPanelAction,
   Frames list of text,
   Journal list of StudioDebugJournalRow,
   Paused boolean,
   PausedAt text,
   PendingWrites list of StudioDebugPendingWrite,
   Scope list of StudioDebugBinding,
   Source text,
   StepIntoAction StudioPanelAction,
   StepOutAction StudioPanelAction,
   StepOverAction StudioPanelAction,
}

type StudioSearchPanelRow is {
   Action StudioPanelAction,
   Column number,
   Detail text,
   End number,
   Kind text,
   Label text,
   Line number,
   Path text,
   SourceVersion text,
   Start number,
}

