function StudioNetworkShowsError(Network text) returns boolean {
   return StudioNetworkShowsError(Network) from ./TaoStudioProductHost.tsx
}

view StudioScenarioEnvironment(Preset text, Width number, Height number, Network text, Latency number, ErrorMessage text, ErrorStatus number, WidthValid boolean, HeightValid boolean, LatencyValid boolean, ErrorStatusValid boolean, SchemeRequested text, SchemeResolved text, SchemeSource text, SchemeCapability text, ChangePreset action(text), ChangeWidth action(number), ChangeHeight action(number), ChangeNetwork action(text), ChangeLatency action(number), ChangeErrorMessage action(text), ChangeErrorStatus action(number), ChangeWidthValid action(boolean), ChangeHeightValid action(boolean), ChangeLatencyValid action(boolean), ChangeErrorStatusValid action(boolean), Apply action()) {
   action SubmitErrorMessage() { }
   render StudioScenarioControlGroup("Environment") {
      StudioInspectorField("Device") {
         StudioSegmented(Value: Preset, Change: ChangePreset, Options: ["phone", "tablet", "laptop", "custom"], Label: "Device")
      }
      StudioInspectorRow("Size") {
         StudioNumericInput(Label: "Width", Value: Width, Minimum: 1, Maximum: 0, Integer: false, Change: ChangeWidth, ChangeValid: ChangeWidthValid)
         StudioNumericInput(Label: "Height", Value: Height, Minimum: 1, Maximum: 0, Integer: false, Change: ChangeHeight, ChangeValid: ChangeHeightValid)
      }
      StudioInspectorField("Network") {
         StudioSegmented(Value: Network, Change: ChangeNetwork, Options: ["normal", "offline", "error"], Label: "Network")
      }
      StudioNumericInput(Label: "Latency ms", Value: Latency, Minimum: 0, Maximum: 0, Integer: false, Change: ChangeLatency, ChangeValid: ChangeLatencyValid)
      when StudioNetworkShowsError(Network) {
         true -> {
            StudioInspectorField("Error") {
               TextInput(Value: ErrorMessage, Change: ChangeErrorMessage, Submit: SubmitErrorMessage, Label: "Error")
            }
            StudioNumericInput(Label: "Status", Value: ErrorStatus, Minimum: 100, Maximum: 599, Integer: true, Change: ChangeErrorStatus, ChangeValid: ChangeErrorStatusValid)
         }
         otherwise -> { }
      }
      StudioSchemeNote(Requested: SchemeRequested, Resolved: SchemeResolved, Source: SchemeSource, Capability: SchemeCapability)
      StudioActions() {
         StudioButton(Label: "Apply & remount", Press: Apply, Disabled: not StudioEnvironmentValid(WidthValid: WidthValid, HeightValid: HeightValid, LatencyValid: LatencyValid, ErrorStatusValid: ErrorStatusValid, Network: Network, ErrorMessage: ErrorMessage), Variant: "primary")
}  }  }

