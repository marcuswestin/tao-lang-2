function StudioFolderIsExpanded(CollapsedFolders list of text, FolderPath text) returns boolean {
   return StudioFolderIsExpanded(CollapsedFolders, FolderPath) from ./StudioFolderExpansion.ts
}

function StudioToggleFolder(CollapsedFolders list of text, FolderPath text) returns list of text {
