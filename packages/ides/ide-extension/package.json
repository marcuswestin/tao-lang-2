{
  "name": "tao-ide-extension",
  "displayName": "Tao Lang",
  "version": "0.0.1",
  "private": true,
  "description": "Tao Lang VS Code extension",
  "publisher": "tao",
  "categories": [
    "Programming Languages"
  ],
  "type": "module",
  "main": "_gen_ide-extension/extension/main.cjs",
  "files": [
    "_gen_ide-extension/",
    "ide-extension-syntaxes/_gen_syntaxes/tao-lang.tmLanguage.json",
    "language-configuration.json",
    "package.json"
  ],
  "contributes": {
    "configurationDefaults": {
      "[tao]": {
        "editor.tabSize": 3,
        "editor.insertSpaces": true
      }
    },
    "grammars": [
      {
        "language": "tao",
        "scopeName": "source.tao-lang",
        "path": "./ide-extension-syntaxes/_gen_syntaxes/tao-lang.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.ts.tao-lang": "typescriptreact"
        }
      }
    ],
    "languages": [
      {
        "id": "tao",
        "aliases": [
          "Tao",
          "Tao Lang",
          "tao"
        ],
        "extensions": [
          ".tao"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "tao.fixSource",
        "title": "Tao: Fix Source"
      },
      {
        "command": "tao.organizeSource",
        "title": "Tao: Organize Source"
      },
      {
        "command": "tao.removeUnusedImports",
        "title": "Tao: Remove Unused Imports"
      },
      {
        "command": "tao.moveRendersLast",
        "title": "Tao: Move Renders Last"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tao.fixSource",
          "when": "editorLangId == tao"
        },
        {
          "command": "tao.organizeSource",
          "when": "editorLangId == tao"
        },
        {
          "command": "tao.removeUnusedImports",
          "when": "editorLangId == tao"
        },
        {
          "command": "tao.moveRendersLast",
          "when": "editorLangId == tao"
        }
      ]
    }
  },
  "dependencies": {
    "tao-formatter": "workspace:*",
    "tao-parser": "workspace:*",
    "tao-shared": "workspace:*",
    "tao-compiler": "workspace:*",
    "tao-source-actions": "workspace:*",
    "vscode-languageclient": "~10.1.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "~0.28.2"
  },
  "engines": {
    "vscode": "^1.104.0"
  }
}
