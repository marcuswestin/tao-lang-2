{
  "name": "tao",
  "displayName": "Tao Lang",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Tao language support: syntax highlighting, diagnostics, formatting, and source actions",
  "publisher": "devtao",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcuswestin/tao-lang-2.git",
    "directory": "packages/ides/ide-extension"
  },
  "categories": [
    "Programming Languages"
  ],
  "type": "module",
  "main": "_gen_ide-extension/extension/main.cjs",
  "files": [
    "LICENSE",
    "README.md",
    "_gen_ide-extension/",
    "icons/",
    "ide-extension-syntaxes/_gen_syntaxes/tao.tmLanguage.json",
    "language-configuration.json",
    "package.json"
  ],
  "contributes": {
    "configurationDefaults": {
      "[tao]": {
        "editor.tabSize": 3,
        "editor.insertSpaces": true
      }
    },
    "grammars": [
      {
        "language": "tao",
        "scopeName": "source.tao",
        "path": "./ide-extension-syntaxes/_gen_syntaxes/tao.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.ts.tao": "typescriptreact"
        }
      }
    ],
    "languages": [
      {
        "id": "tao",
        "aliases": [
          "Tao",
          "Tao Lang",
          "tao"
        ],
        "extensions": [
          ".tao"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tao-light.svg",
          "dark": "./icons/tao-dark.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "tao.fixSource",
        "title": "Tao: Fix Source"
      },
      {
        "command": "tao.organizeSource",
        "title": "Tao: Organize Source"
      },
      {
        "command": "tao.removeUnusedImports",
        "title": "Tao: Remove Unused Imports"
      },
      {
        "command": "tao.moveRendersLast",
        "title": "Tao: Move Renders Last"
      },
      {
        "command": "tao.showTooling",
        "title": "Tao: Show Tooling"
      },
      {
        "command": "tao.openTypeScriptConfig",
        "title": "Tao: Open TypeScript Config"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tao.fixSource",
          "when": "editorLangId == tao"
        },
        {
          "command": "tao.organizeSource",
          "when": "editorLangId == tao"
        },
        {
          "command": "tao.removeUnusedImports",
          "when": "editorLangId == tao"
        },
        {
          "command": "tao.moveRendersLast",
          "when": "editorLangId == tao"
        },
        {
          "command": "tao.showTooling"
        },
        {
          "command": "tao.openTypeScriptConfig"
        }
      ]
    }
  },
  "dependencies": {
    "tao-formatter": "workspace:*",
    "tao-parser": "workspace:*",
    "tao-shared": "workspace:*",
    "tao-compiler": "workspace:*",
    "tao-source-actions": "workspace:*",
    "vscode-languageclient": "~10.1.1",
    "tao-project-tooling": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "~0.28.2"
  },
  "engines": {
    "vscode": "^1.104.0"
  }
}
