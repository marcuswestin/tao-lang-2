{
  "_info": "Merged onto Langium's auto-generated tao.tmLanguage.json. Adds TSX injection fence highlighting plus Tao string interpolation, numbers, keyed names, declaration names, tags and hex colors, identifiers, property access, operators, and punctuation.",
  "patterns": [
    {
      "include": "#ts-fenced-block"
    },
    {
      "include": "#string-template"
    },
    {
      "include": "#keyed-name"
    },
    {
      "include": "#hex-color"
    },
    {
      "include": "#tag"
    },
    {
      "include": "#number"
    },
    {
      "include": "#declaration-name"
    },
    {
      "include": "#property-access"
    },
    {
      "include": "#render-name"
    },
    {
      "include": "#pascal-identifier"
    },
    {
      "include": "#identifier"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "ts-fenced-block": {
      "name": "meta.embedded.block.ts.tao",
      "begin": "```\\s*ts\\s*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.codeblock.begin.tao"
        }
      },
      "end": "```",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.codeblock.end.tao"
        }
      },
      "patterns": [
        {
          "include": "source.tsx"
        }
      ]
    },
    "string-template": {
      "name": "string.quoted.double.tao",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tao"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tao"
        }
      },
      "patterns": [
        {
          "include": "#string-escape"
        },
        {
          "include": "#string-interpolation"
        }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.tao",
      "match": "\\\\(n|r|t|\\\\|\"|\\{)"
    },
    "string-interpolation": {
      "name": "meta.template.expression.tao",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.tao"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.tao"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-object-literal"
        },
        {
          "include": "#number"
        },
        {
          "include": "#string-template"
        },
        {
          "include": "#property-access"
        },
        {
          "include": "#pascal-identifier"
        },
        {
          "include": "#identifier"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "interpolation-object-literal": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.tao"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.tao"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-object-literal"
        },
        {
          "include": "#number"
        },
        {
          "include": "#string-template"
        },
        {
          "include": "#property-access"
        },
        {
          "include": "#pascal-identifier"
        },
        {
          "include": "#identifier"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.tao",
      "match": "\\b[0-9]+\\b"
    },
    "render-name": {
      "match": "^\\s*([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.tag.tao"
        }
      }
    },
    "pascal-identifier": {
      "name": "entity.name.type.tao",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "identifier": {
      "name": "variable.other.tao",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    },
    "property-access": {
      "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.tao"
        },
        "2": {
          "name": "variable.other.property.tao"
        }
      }
    },
    "operators": {
      "name": "keyword.operator.tao",
      "match": "\\+=|-=|\\*=|/=|=|\\+|-|\\*|/"
    },
    "punctuation": {
      "name": "punctuation.separator.tao",
      "match": "[,:()\\[\\]{}]"
    },
    "keyed-name": {
      "name": "entity.other.attribute-name.tao",
      "match": "@@?[A-Za-z_][A-Za-z0-9_]*"
    },
    "hex-color": {
      "name": "constant.other.color.tao",
      "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\\b"
    },
    "tag": {
      "name": "constant.other.tag.tao",
      "match": "#[A-Za-z0-9_]+"
    },
    "declaration-name": {
      "match": "\\b(action|app|command|data|datasource|design|function|let|nav|primitive|scene|state|type|view)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.tao"
        },
        "2": {
          "name": "entity.name.function.tao"
        }
      }
    }
  }
}
