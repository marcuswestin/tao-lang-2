use Http from @tao/data/providers/http
use StackNav from @tao/nav
use Col, FormButton, Text from @tao/ui

project {
   id "studio-network-simulation-smoke"
   name "Studio Network Simulation Smoke"
}

app NetworkSimApp {
   Name "Network Simulation"
   Navigator StackNav {
      Initial ItemsPage
   }
   Datasource NetSimSource { }
}

type NetSimSource is Http with {
   Adapter item is NetSimAdapter from ./NetSimAdapter.ts
}

data Items / Item {
   ItemId number (unique),
   Title text,

   order by ItemId,
}

scene ItemsPage() {
   Title "Items"
   query Items = Items with { }
   render Col() {
      guard Items {
         loading -> { Text("Loading items…") }
         error -> Message { Text(Message) }
      }
      loop Items / Item {
         Col() {
            Text(Item.Title)

            #removeItem
            FormButton("Remove") {
               on press -> { delete Item }
}  }  }  }  }

fixture SeedItems {
   FirstItem = create Item {
      ItemId: 1,
      Title: "Alpha item"
   }
   SecondItem = create Item {
      ItemId: 2,
      Title: "Beta item"
}  }

scenarios NetworkSimApp "cells" {
   fixture SeedItems
   device phone
   scenario "cellA" { }
   scenario "cellB" { }
}
