{
  "expo": {
    "name": "Tao Companion",
    "slug": "tao-studio-companion",
    "version": "1.0.0",
    "scheme": "taostudiocompanion",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.devtao.studio.companion",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Tao Studio on your Mac renders the app you are editing. Tao Companion uses the local network to load that app from Studio and keep it in sync while you work.",
        "NSBonjourServices": [
          "_tao-studio._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.devtao.studio.companion"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-dev-client",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "enableSceneSupport": true
          }
        }
      ],
      [
        "tao-icloud",
        {
          "services": [
            "CloudDocuments",
            "CloudKit"
          ]
        }
      ],
      "./plugins/with-ios-fmt-compat.cjs",
      "./plugins/with-jazz-podfile-properties.cjs"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
