{
  "extends": "../../tsconfig.base.json",
  "include": [
    "index.ts",
    "src/**/*"
  ],
  "exclude": [
    "**/node_modules/**/*",
    "ios",
    "android"
  ],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "composite": false,
    "declaration": false,
    "incremental": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": []
  }
}
