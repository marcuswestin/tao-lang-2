{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "rootDir": ".",
    "paths": {
      "@cli-kit": [
        "./cli/cli-kit/cli-kit-src/cli-kit.ts"
      ],
      "@cli-kit/*": [
        "./cli/cli-kit/cli-kit-src/*"
      ],
      "@host-control": [
        "./testing/host-control/host-control-src/host-control.ts"
      ],
      "@playwright-driver": [
        "./testing/playwright-driver/playwright-driver-src/host-control-playwright.ts"
      ],
      "@appium-driver": [
        "./testing/appium-driver/appium-driver-src/appium.ts"
      ],
      "@e2e-testing": [
        "./testing/e2e-testing/HostTestingCommand.ts"
      ],
      "@shared": [
        "./shared/shared-src/shared.ts"
      ],
      "@shared/test": [
        "./shared/shared-src/testing/Test-Bun.ts"
      ],
      "@shared/core": [
        "./shared/shared-src/core/shared-core.ts"
      ],
      "@shared/*": [
        "./shared/shared-src/*"
      ],
      "@parser": [
        "./language/parser/parser-src/parser.ts"
      ],
      "@parser/*": [
        "./language/parser/parser-src/*"
      ],
      "@ast-utils": [
        "./language/ast-utils/ast-utils-src/ast-utils.ts"
      ],
      "@validator": [
        "./language/validator/validator-src/validator.ts"
      ],
      "@validator/*": [
        "./language/validator/validator-src/*"
      ],
      "@compiler": [
        "./compiler/compiler-src/compiler.ts"
      ],
      "@compiler/workspace": [
        "./compiler/compiler-src/workspace/index.ts"
      ],
      "@compiler/*": [
        "./compiler/compiler-src/*"
      ],
      "@formatter": [
        "./language/formatter/formatter-src/formatter.ts"
      ],
      "@formatter/*": [
        "./language/formatter/formatter-src/*"
      ],
      "@source-actions": [
        "./language/source-actions/source-actions-src/source-actions.ts"
      ],
      "@source-actions/*": [
        "./language/source-actions/source-actions-src/*"
      ],
      "@runtime": [
        "./apps/runtime/TaoRuntime-src/TR.ts"
      ],
      "@runtime/TR": [
        "./apps/runtime/TaoRuntime-src/TR.ts"
      ],
      "@tao/runtime": [
        "./apps/runtime/TaoRuntime-src/TR.ts"
      ],
      "@tao/runtime/core": [
        "./apps/runtime/TaoRuntime-src/core/RuntimeCore.ts"
      ],
      "@runtime/*": [
        "./apps/runtime/TaoRuntime-src/*"
      ],
      "@expo-host": [
        "./apps/expo-host/expo-host-src/runtime.ts"
      ],
      "@expo-host/*": [
        "./apps/expo-host/expo-host-src/*"
      ],
      "@studio": [
        "./ides/studio/studio-src/studio.ts"
      ],
      "@studio/*": [
        "./ides/studio/studio-src/*"
      ],
      "@studio-tooling": [
        "./ides/studio-tooling/studio-tooling-src/StudioReview.ts"
      ],
      "@studio-tooling/*": [
        "./ides/studio-tooling/studio-tooling-src/*"
      ],
      "@generation": [
        "./ai/generation/generation-src/generation.ts"
      ],
      "@generation/*": [
        "./ai/generation/generation-src/*"
      ],
      "@update-server/types": [
        "./services/update-server/update-server-src/update-types.ts"
      ],
      "@stdlib": [
        "./apps/stdlib/stdlib-src/stdlib.ts"
      ],
      "@verification": [
        "./testing/verification/verification-src/verification.ts"
      ],
      "@verification/*": [
        "./testing/verification/verification-src/*"
      ]
    }
  },
  "include": [
    "./shared/shared-src/**/*"
  ],
  "exclude": [
    "**/node_modules/**/*"
  ]
}
