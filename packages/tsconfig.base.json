{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@shared": [
        "./shared/shared-src/shared.ts"
      ],
      "@shared/*": [
        "./shared/shared-src/*"
      ],
      "@parser": [
        "./parser/parser-src/parser.ts"
      ],
      "@parser/*": [
        "./parser/parser-src/*"
      ],
      "@validator": [
        "./validator/validator-src/validator.ts"
      ],
      "@validator/*": [
        "./validator/validator-src/*"
      ],
      "@compiler": [
        "./compiler/compiler-src/compiler.ts"
      ],
      "@compiler/*": [
        "./compiler/compiler-src/*"
      ],
      "@runtime": [
        "./runtime/runtime-src/runtime.ts"
      ],
      "@runtime/*": [
        "./runtime/runtime-src/*"
      ]
    }
  },
  "include": [
    "./shared/shared-src/**/*"
  ],
  "exclude": [
    "**/node_modules/**/*"
  ]
}
