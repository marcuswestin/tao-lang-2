{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "rootDir": ".",
    "paths": {
      "@host-control": [
        "./host-control/host-control-src/host-control.ts"
      ],
      "@host-control/playwright": [
        "./host-control-playwright/host-control-playwright-src/host-control-playwright.ts"
      ],
      "@host-control/appium": [
        "./host-control-appium/appium-src/appium.ts"
      ],
      "@e2e-testing": [
        "./e2e-testing/HostTestingCommand.ts"
      ],
      "@shared": [
        "./shared/shared-src/shared.ts"
      ],
      "@shared/test": [
        "./shared/shared-src/testing/Test-Bun.ts"
      ],
      "@shared/core": [
        "./shared/shared-src/core/shared-core.ts"
      ],
      "@shared/*": [
        "./shared/shared-src/*"
      ],
      "@parser": [
        "./parser/parser-src/parser.ts"
      ],
      "@parser/*": [
        "./parser/parser-src/*"
      ],
      "@ast-utils": [
        "./ast-utils/ast-utils-src/ast-utils.ts"
      ],
      "@validator": [
        "./validator/validator-src/validator.ts"
      ],
      "@validator/*": [
        "./validator/validator-src/*"
      ],
      "@compiler": [
        "./compiler/compiler-src/compiler.ts"
      ],
      "@compiler/*": [
        "./compiler/compiler-src/*"
      ],
      "@formatter": [
        "./formatter/formatter-src/formatter.ts"
      ],
      "@formatter/*": [
        "./formatter/formatter-src/*"
      ],
      "@source-actions": [
        "./source-actions/source-actions-src/source-actions.ts"
      ],
      "@source-actions/*": [
        "./source-actions/source-actions-src/*"
      ],
      "@workspace": [
        "./workspace/workspace-src/index.ts"
      ],
      "@workspace/*": [
        "./workspace/workspace-src/*"
      ],
      "@runtime": [
        "./runtime/TaoRuntime-src/TR.ts"
      ],
      "@runtime/TR": [
        "./runtime/TaoRuntime-src/TR.ts"
      ],
      "@tao/runtime": [
        "./runtime/TaoRuntime-src/TR.ts"
      ],
      "@tao/runtime/core": [
        "./runtime/TaoRuntime-src/core/RuntimeCore.ts"
      ],
      "@runtime/*": [
        "./runtime/TaoRuntime-src/*"
      ],
      "@runtime-toolchain": [
        "./runtime-toolchain/runtime-toolchain-src/runtime.ts"
      ],
      "@runtime-toolchain/*": [
        "./runtime-toolchain/runtime-toolchain-src/*"
      ],
      "@studio": [
        "./studio/studio-src/studio.ts"
      ],
      "@studio/*": [
        "./studio/studio-src/*"
      ],
      "@generation": [
        "./generation/generation-src/generation.ts"
      ],
      "@generation/*": [
        "./generation/generation-src/*"
      ],
      "@update-server/types": [
        "./update-server/update-server-src/update-types.ts"
      ],
      "@tao/code-editor": [
        "./code-editor/code-editor-src/CodeEditor.tsx"
      ],
      "@stdlib": [
        "./stdlib/stdlib-src/stdlib.ts"
      ],
      "@expo-dev-loop": [
        "./dev/dev-src/expo-dev-loop/expo-dev-loop.ts"
      ]
    }
  },
  "include": [
    "./shared/shared-src/**/*"
  ],
  "exclude": [
    "**/node_modules/**/*"
  ]
}
