{
  "expo": {
    "name": "Tao Runtime",
    "slug": "tao-runtime",
    "version": "1.0.0",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "17.0"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "jazz-rn",
      "./plugins/with-jazz-podfile-properties.cjs"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
