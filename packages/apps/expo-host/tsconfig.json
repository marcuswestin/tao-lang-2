{
  "extends": "../../tsconfig.base.json",
  "include": [
    "index.ts",
    "expo-host-src/**/*",
    "expo-host-tests/**/*",
    "../../../Apps/WordFlower/1 - Current/.tao/cache/_gen_tao-app/**/*"
  ],
  "exclude": [
    "**/node_modules/**/*"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "composite": false,
    "declaration": false,
    "incremental": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "../../..",
    "types": [
      "bun",
      "jest",
      "node"
    ]
  }
}
