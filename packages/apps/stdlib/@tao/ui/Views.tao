// A form's unfinished-field sentences, usually a row's or projection's `Problems`: one line each,
// in the order they arrive, and nothing at all when there are none. Clauses style every line.
public
view Problems(Items list of text) {
   render inject Items, Layout @@layout, Tag @@tag ```ts
      if (Items.length === 0) {
        return null
      }
      return TR.Views.Text({ children: [Items.join('\n')], layout: Layout, tag: Tag }, { nativeProps: {} })
   ```
}

public
view Number(Value number) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [String(Value)], layout: Layout, tag: Tag },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

public
view TextInput(mutable Value text, Change action(text), Submit action(), Label text, Placeholder text default "", Id text default "", Disabled boolean default false, Secure boolean default false, Description text default "") {
   render inject Value, Submit, Label, Placeholder, Id, Disabled, Secure, Description, Layout @@layout, Tag @@tag ```ts
      return TR.Views.TextInput(
        {
          layout: Layout,
          tag: Tag,
          value: Value.value,
          label: Label,
          description: Description || undefined,
          placeholder: Placeholder,
          id: Id,
          disabled: Disabled,
          secure: Secure,
          onChange: value => Value.change(value),
          onSubmit: event => TR.InvokeNativeEvent(Submit, event),
        },
      )
   ```
}
