public
view Image(Source text, Decorative boolean default false, Label text default "") {
   render inject Source, Decorative, Label, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Image({
        layout: Layout,
        tag: Tag,
        source: Source,
        decorative: Decorative,
        label: Label || undefined,
      })
   ```
}

public
view Checkbox(Value boolean, Change action(boolean), Label text, Disabled boolean default false, Description text default "") {
   render inject Value, Change, Label, Disabled, Description, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Checkbox({
        layout: Layout,
        tag: Tag,
        value: Value,
        label: Label,
        description: Description || undefined,
        disabled: Disabled,
        onChange: value => Change.invoke(TR.Value(value)),
      })
   ```
}

