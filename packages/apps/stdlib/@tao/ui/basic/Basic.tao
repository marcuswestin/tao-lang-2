// The wireframe tier: minimally-styled implementations that honor every Tao clause, the base a
// design styles up with element defaults. An app opts down deliberately with
// `use Button from @tao/ui/basic`; the bare `@tao/ui` names pass through to the native set.
// A tappable title, fully receptive to layout clauses and design bundles.
public
view Button(Title text, Press action(), Disabled boolean default false, Description text default "") {
   render inject Title, Press, Disabled, Description, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Pressable(
        { title: Title, action: Press, layout: Layout, tag: Tag, disabled: Disabled },
        {
          nativeProps: {
            accessibilityHint: Description || undefined,
            accessibilityRole: 'button',
            accessibilityState: { disabled: Disabled },
            disabled: Disabled,
          },
        },
      )
   ```
}

// The form button with its busy state, honoring every clause a design or call site applies.
public
view FormButton(Title text, Press action(), Id text default "", Disabled boolean default false, Submitting boolean default false, Description text default "") {
   render inject Title, Press, Id, Disabled, Submitting, Description, Layout @@layout, Tag @@tag ```ts
      const effectiveDisabled = Disabled || Submitting
      return TR.Views.Pressable(
        {
          layout: Layout,
          tag: Tag,
          title: Submitting ? 'Saving…' : Title,
          action: Press,
          defaultStyle: {
            backgroundColor: effectiveDisabled ? '#9aa49d' : '#2f6b4f',
            borderRadius: 8,
            color: '#ffffff',
          },
          disabled: effectiveDisabled,
        },
        {
          nativeProps: {
            accessibilityLabel: Title,
            accessibilityHint: Description || undefined,
            accessibilityRole: 'button',
            accessibilityState: { busy: Submitting, disabled: effectiveDisabled },
            disabled: effectiveDisabled,
            style: {
              alignItems: 'center',
              minHeight: 44,
              opacity: effectiveDisabled ? 0.5 : 1,
              paddingHorizontal: 16,
              paddingVertical: 11,
            },
            testID: Id || undefined,
          },
        },
      )
   ```
}

// The wireframe spinner, honoring layout clauses where the native one renders OS chrome.
public
view Spinner() {
   render inject Layout @@layout, Tag @@tag ```ts
      return TR.Views.Spinner({ layout: Layout, tag: Tag })
   ```
}
