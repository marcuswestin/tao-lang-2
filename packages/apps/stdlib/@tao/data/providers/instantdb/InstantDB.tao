use Clerk from @tao/auth/clerk
use InstantAuth from @tao/auth/instantdb

// InstantDB stores each entity as an InstantDB namespace, one InstantDB row per row. Push the app's
// generated schema and permission rules before running it. Signed in with InstantAuth at the same
// address, or with Clerk through the Clerk client registered with the InstantDB app under
// ClerkClientName, the account is the InstantDB user, and the first sign-in creates its Account row.
public
type InstantDB is datasource with {
   // Accepted for compatibility; namespaces are app-wide, so it does not separate stored rows.
   StorageKey text?
   AppId text
   ApiURI text?
   WebsocketURI text?
   ClerkClientName text?
   accepts { IdentityToken from Clerk, Session from InstantAuth }
   supports { Relations, UniqueFields, AccessRules, FieldUpdates, Migrations Additive }

   provider InstantDBProvider from ./InstantDB.ts
}
