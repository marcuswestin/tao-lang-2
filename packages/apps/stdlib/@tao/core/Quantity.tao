   static func *(Left Ratio, Right Ratio) -> Ratio {
      return RatioMultiply(Left, Right) from ./Quantity.ts
   }
   static func /(Left Ratio, Right Ratio) -> Ratio {
      return RatioDivide(Left, Right) from ./Quantity.ts
   }
   static func *(Left Ratio, Right number) -> Ratio {
      return RatioMultiplyNumber(Left, Right) from ./Quantity.ts
   }
   static func *(Left number, Right Ratio) -> Ratio {
      return NumberMultiplyRatio(Left, Right) from ./Quantity.ts
   }
   static func /(Left Ratio, Right number) -> Ratio {
      return RatioDivideNumber(Left, Right) from ./Quantity.ts
   }
   static func ==(Left Ratio, Right Ratio) -> boolean {
      return RatioEqual(Left, Right) from ./Quantity.ts
   }
   static func !=(Left Ratio, Right Ratio) -> boolean {
      return RatioNotEqual(Left, Right) from ./Quantity.ts
   }
   static func <(Left Ratio, Right Ratio) -> boolean {
      return RatioLess(Left, Right) from ./Quantity.ts
   }
   static func <=(Left Ratio, Right Ratio) -> boolean {
      return RatioLessEqual(Left, Right) from ./Quantity.ts
   }
   static func >(Left Ratio, Right Ratio) -> boolean {
      return RatioGreater(Left, Right) from ./Quantity.ts
   }
   static func >=(Left Ratio, Right Ratio) -> boolean {
      return RatioGreaterEqual(Left, Right) from ./Quantity.ts
   }
}
