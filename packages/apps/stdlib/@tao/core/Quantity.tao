public
abstract type Scalar is numeric with {
   func ToText() fails never -> text {
      return ScalarToText(Scalar) from ./Quantity.ts
   }

   static func +(Left Self, Right Self) -> Self {
      return ScalarAdd(Left, Right) from ./Quantity.ts
   }

   static func -(Left Self, Right Self) -> Self {
      return ScalarSubtract(Left, Right) from ./Quantity.ts
   }

   static func -(Value Self) -> Self {
      return ScalarNegate(Value) from ./Quantity.ts
   }

   static func *(Left Self, Right number) -> Self {
      return ScalarMultiplyNumber(Left, Right) from ./Quantity.ts
   }

   static func *(Left number, Right Self) -> Self {
      return NumberMultiplyScalar(Left, Right) from ./Quantity.ts
   }

   static func /(Left Self, Right number) -> Self {
      return ScalarDivideNumber(Left, Right) from ./Quantity.ts
   }

   static func ==(Left Self, Right Self) -> boolean {
      return ScalarEqual(Left, Right) from ./Quantity.ts
   }

   static func !=(Left Self, Right Self) -> boolean {
      return ScalarNotEqual(Left, Right) from ./Quantity.ts
   }

   static func <(Left Self, Right Self) -> boolean {
      return ScalarLess(Left, Right) from ./Quantity.ts
   }

   static func <=(Left Self, Right Self) -> boolean {
      return ScalarLessEqual(Left, Right) from ./Quantity.ts
   }

   static func >(Left Self, Right Self) -> boolean {
      return ScalarGreater(Left, Right) from ./Quantity.ts
   }

   static func >=(Left Self, Right Self) -> boolean {
      return ScalarGreaterEqual(Left, Right) from ./Quantity.ts
   }
}

public
type Duration is Scalar with {
   units {
      seconds 1 (default),
      milliseconds 0.001,
      minutes 60,
      hours 3600
   }
   static func +(Left Duration, Right Duration) -> Duration {
      return DurationAdd(Left, Right) from ./Quantity.ts
   }
   static func -(Left Duration, Right Duration) -> Duration {
      return DurationSubtract(Left, Right) from ./Quantity.ts
   }
   static func -(Value Duration) -> Duration {
      return DurationNegate(Value) from ./Quantity.ts
   }
   static func *(Left Duration, Right number) -> Duration {
      return DurationMultiplyNumber(Left, Right) from ./Quantity.ts
   }
   static func *(Left number, Right Duration) -> Duration {
      return NumberMultiplyDuration(Left, Right) from ./Quantity.ts
   }
   static func /(Left Duration, Right number) -> Duration {
      return DurationDivideNumber(Left, Right) from ./Quantity.ts
   }
   static func /(Left Duration, Right Duration) -> Ratio {
      return DurationDivideDuration(Left, Right) from ./Quantity.ts
   }
   static func *(Left Duration, Right Ratio) -> Duration {
      return DurationMultiplyRatio(Left, Right) from ./Quantity.ts
   }
   static func /(Left Duration, Right Ratio) -> Duration {
      return DurationDivideRatio(Left, Right) from ./Quantity.ts
   }
   static func ==(Left Duration, Right Duration) -> boolean {
      return DurationEqual(Left, Right) from ./Quantity.ts
   }
   static func !=(Left Duration, Right Duration) -> boolean {
      return DurationNotEqual(Left, Right) from ./Quantity.ts
   }
   static func <(Left Duration, Right Duration) -> boolean {
      return DurationLess(Left, Right) from ./Quantity.ts
   }
   static func <=(Left Duration, Right Duration) -> boolean {
      return DurationLessEqual(Left, Right) from ./Quantity.ts
   }
   static func >(Left Duration, Right Duration) -> boolean {
      return DurationGreater(Left, Right) from ./Quantity.ts
   }
   static func >=(Left Duration, Right Duration) -> boolean {
      return DurationGreaterEqual(Left, Right) from ./Quantity.ts
   }
}

public
type Ratio is Scalar with {
   units {
      unity 1 (default),
      percent 0.01,
      permille 0.001
   }
   static func +(Left Ratio, Right Ratio) -> Ratio {
      return RatioAdd(Left, Right) from ./Quantity.ts
   }
   static func -(Left Ratio, Right Ratio) -> Ratio {
      return RatioSubtract(Left, Right) from ./Quantity.ts
   }
   static func -(Value Ratio) -> Ratio {
      return RatioNegate(Value) from ./Quantity.ts
