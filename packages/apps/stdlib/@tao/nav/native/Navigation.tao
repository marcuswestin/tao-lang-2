// Platform navigation and chrome. The runtime keeps Tao's reducer and occurrence identities as the
// source of truth; native hosts render transitions, headers, gestures, and automatic tab bars.
public
type StackNav is nav with {
   Initial view

   nav StackNavKind from ./NavKinds.ts
}

public
type SlotNav is nav with {
   Initial view

   nav SlotNavKind from ./NavKinds.ts
}

// `Display` picks the surface: "automatic" is the platform tab bar, "tabs" and "drawer" are Tao-drawn
// controls, and "toggle" is one Safari-style bar floating over the bottom edge — Back, the visible
// screen's title and toolbar, and a control that switches to the next item. Under "toggle" a stack
// inside an item draws no header of its own, and on iOS 26 the bar is Liquid Glass.
public
type SelectionNav is nav with {
   Initial key
   Display text
   @key {
      Label text
      Icon text is ""
      Content view
   }

   nav SelectionNavKind from ./NavKinds.ts
}

public
type SplitNav is nav with {
   @key {
      Content view
      Width number
      Resizable boolean is false
   }

   nav SplitNavKind from ./NavKinds.ts
}
