use AuthProvider from @tao/auth

// Core primitives are compiler-known opaque types. `is` declares a nominal refinement, and `with`
// pins the supplied-slot contract that ordinary Tao declarations fill.
primitive item

primitive number

primitive text

primitive boolean

primitive list

primitive time

// A duration is a unit value of the `duration` family; `.unit` builds and reads it (Decisions §2).
primitive duration

// A color is a design color carried as a value: a view parameter whose argument or default names a
// color of the mounted design, read in a clause list as `background Tint` (Decisions §13). It is
// never built from text or data, so every color a clause can receive stays listed in a design.
primitive color

// An action is a private procedure. It names no title and no summary, because nothing lists an
// action: a `command` is the discoverable verb, and it is what carries the words a person reads.
primitive action

// A shortcut is the key a command answers to. It is written as a modifier chain ending in one key
// (`primary + "n"`), or as a bare key on its own ("s"). It is not a number and has no unit family.
primitive shortcut

// A command is the discoverable verb: one action invocation, the words a person reads, and the
// slots the invocation still needs, declared as its parameters. It is a configured value, so
// `Save with { ... }` derives one, and it invokes as an action does: `do Finish(Document)`. `Title`
// is required because a verb nothing can name is not discoverable; an unfilled `Label` reads as
// `Title`, written as empty text because a slot default is a literal rather than a reference to a
// sibling slot.
primitive command with {
   Title text,
   Description text is "",
   Summary text is "",
   Label text is "",
   Icon text is "",
   Key shortcut is none,
   Enabled boolean is true,
}

primitive design

// One renderable primitive. Every declaration made with `view` has this type; what a view can do
// is inferred from its body, and how it appears is chosen where it is presented.
primitive view with {
   Commands list of command is [],
}

// A scene is a view that is presented rather than composed, and the only declaration that may fill
// the slots a host reads. Keeping them here rather than on `view` is what makes chrome nothing
// reads unrepresentable: a declaration that is only ever composed cannot name a title. `Header` is
// the opt out, for a scene that owns its whole surface. Toolbar lists the commands a host offers
// on this scene's chrome.
primitive scene is view with {
   Title text is "",
   Toolbar list of command is [],
   Header boolean is true,
}

// A nav is a scene, so a mounted navigator goes wherever a view goes and supplies its own chrome.
primitive nav is scene with {
   implement,
}

// `Data` is the store's membership: the data collections this datasource owns. A datasource that
// names none owns every collection the app's other datasources leave unclaimed, which is why an app
// with one datasource never writes the slot.
primitive datasource with {
   implement,
   Data list of data is [],
}

primitive app with {
   id text,
   version text,
   name text,
   Navigator nav,
   AgentCommands list of command is [],
   Datasource list of datasource is [],
   Auth AuthProvider is none,
   Design design is none,
}
