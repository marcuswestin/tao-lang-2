public layout Box {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'left', 'center'], ['hug']]),
      })
   ```
}

public layout Stack {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'center'], ['hug']]),
      })
   ```
}

public layout Col {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
      })
   ```
}

public layout Row {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'baseline', 'left'], ['fill']]),
      })
   ```
}

public layout WrappingRow {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'baseline', 'left'], ['compress'], ['hug']]),
        style: { flexWrap: 'wrap' },
      })
   ```
}

public view Text Value is text {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [Value] },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

public view TextFrame Value is text {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [Value] },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'clip' } },
      )
   ```
}

public view TextMultiline Value is text {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [Value] },
        { nativeProps: {} },
      )
   ```
}

public view Number Value is number {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [String(Value)] },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

public view Button Title is text, Press is action() {
   render inject Title, Press ```ts
      return TR.Views.Pressable(
        { __tao: _ViewProps.__tao, title: Title, action: Press },
        { nativeProps: { accessibilityRole: 'button' } },
      )
   ```
}

public view TextInput Value is text, Change is action(text), Submit is action(), Label is text, Placeholder is text default "", Id is text default "", Disabled is boolean default false {
   render inject Value, Change, Submit, Label, Placeholder, Id, Disabled ```ts
      return TR.Views.TextInput(
        {
          __tao: _ViewProps.__tao,
          value: Value,
          label: Label,
          placeholder: Placeholder,
          id: Id,
          disabled: Disabled,
          onChange: value => Change.invoke(TR.Value(value)),
          onSubmit: () => Submit.invoke(),
        },
      )
   ```
}

public view FormButton Title is text, Press is action(), Id is text default "", Disabled is boolean default false, Submitting is boolean default false {
   render inject Title, Press, Id, Disabled, Submitting ```ts
      const effectiveDisabled = Disabled || Submitting
      return TR.Views.Pressable(
        {
          __tao: _ViewProps.__tao,
          title: Submitting ? 'Saving…' : Title,
          action: Press,
          disabled: effectiveDisabled,
        },
        {
          nativeProps: {
            accessibilityLabel: Title,
            accessibilityRole: 'button',
            accessibilityState: { busy: Submitting, disabled: effectiveDisabled },
            disabled: effectiveDisabled,
            style: {
              alignItems: 'center',
              backgroundColor: effectiveDisabled ? '#9aa49d' : '#2f6b4f',
              borderRadius: 8,
              minHeight: 44,
              paddingHorizontal: 16,
              paddingVertical: 11,
            },
            testID: Id || undefined,
          },
        },
      )
   ```
}
