      })
   ```
}

publish view SectionList Title is text {
   render inject Title ```ts
      return TR.NativeList.Section({
        keyExtractor: TR.NativeList.indexKey(),
        renderItem: ({ item }) => TR.Views.Text({ __tao: _ViewProps.__tao, children: [item.title] }),
        sections: [{ data: [{ title: Title }], title: Title }],
      })
   ```
}

publish view ResourceText Value is text {
   render inject Value ```ts
      const resource = TR.Resource.query({
        initialData: Value,
        key: ['tao-stdlib-resource-text', Value],
        load: async () => Value,
      })
      return TR.Views.Text({ __tao: _ViewProps.__tao, children: [resource.data ?? Value] })
   ```
}

publish view ResourceMutationButton Title is text {
   render inject Title ```ts
      const mutation = TR.Resource.mutation({
        save: async () => Title,
      })
      return TR.Views.Pressable(
        {
          __tao: _ViewProps.__tao,
          title: Title,
          loading: mutation.isLoading,
          action: TR.Resource.mutationAction(mutation, Title),
        },
        { nativeProps: { accessibilityRole: 'button' } },
      )
   ```
}

