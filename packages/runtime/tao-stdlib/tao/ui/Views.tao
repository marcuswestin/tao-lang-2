publish layout Box {
   render inject ```ts
      return TR.Views.Box(_ViewProps)
   ```
}

publish layout Stack {
   render inject ```ts
      return TR.Views.Stack(_ViewProps)
   ```
}

publish layout Col {
   render inject ```ts
      return TR.Views.Col(_ViewProps)
   ```
}

publish layout Row {
   render inject ```ts
      return TR.Views.Row(_ViewProps)
   ```
}

publish layout WrappingRow {
   render inject ```ts
      return TR.Views.WrappingRow(_ViewProps)
   ```
}

publish view Text text as Value {
   render inject Value ```ts
      return TR.Views.Text({ __tao: _ViewProps.__tao, children: [Value] })
   ```
}

publish view TextFrame text as Value {
   render inject Value ```ts
      return TR.Views.TextFrame({ __tao: _ViewProps.__tao, children: [Value] })
   ```
}

publish view TextMultiline text as Value {
   render inject Value ```ts
      return TR.Views.TextMultiline({ __tao: _ViewProps.__tao, children: [Value] })
   ```
}

publish view Number number as Value {
   render inject Value ```ts
      return TR.Views.Number({ __tao: _ViewProps.__tao, children: [String(Value)] })
   ```
}

publish view Button text as Title {
   render inject Title ```ts
      return TR.Views.Button({ __tao: _ViewProps.__tao, title: Title })
   ```
}
