publish layout Box {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'left', 'center'], ['hug']]),
      })
   ```
}

publish layout Stack {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'center'], ['hug']]),
      })
   ```
}

publish layout Col {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
      })
   ```
}

publish layout Row {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'baseline', 'left'], ['fill']]),
      })
   ```
}

publish layout WrappingRow {
   render inject ```ts
      return TR.Views.View(_ViewProps, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'baseline', 'left'], ['compress'], ['hug']]),
        style: { flexWrap: 'wrap' },
      })
   ```
}

publish view Text Value is text {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [Value] },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

publish view TextFrame Value is text {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [Value] },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'clip' } },
      )
   ```
}

publish view TextMultiline Value is text {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [Value] },
        { nativeProps: {} },
      )
   ```
}

publish view Number Value is number {
   render inject Value ```ts
      return TR.Views.Text(
        { __tao: _ViewProps.__tao, children: [String(Value)] },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

publish view Button Title is text, Action is action {
   render inject Title, Action ```ts
      return TR.Views.Pressable(
        { __tao: _ViewProps.__tao, title: Title, action: Action },
        { nativeProps: { accessibilityRole: 'button' } },
      )
   ```
}

publish view TextInput Value is text, Change is action, Submit is action, Label is text, Placeholder is text, Id is text, Disabled is boolean {
   render inject Value, Change, Submit, Label, Placeholder, Id, Disabled ```ts
      return TR.Views.TextInput(
        {
          __tao: _ViewProps.__tao,
          value: Value,
          label: Label,
          placeholder: Placeholder,
          id: Id,
          disabled: Disabled,
          onChange: value => Change.invoke(TR.Value(value)),
          onSubmit: () => Submit.invoke(),
        },
      )
   ```
}

publish view FormButton Title is text, Press is action, Id is text, Disabled is boolean, Submitting is boolean {
   render inject Title, Press, Id, Disabled, Submitting ```ts
      return TR.Views.Pressable(
        {
          __tao: _ViewProps.__tao,
          title: Submitting ? 'Saving…' : Title,
          action: Press,
        },
        {
          nativeProps: {
            accessibilityRole: 'button',
            accessibilityState: { busy: Submitting, disabled: Disabled },
            disabled: Disabled,
            style: {
              alignItems: 'center',
              backgroundColor: Disabled ? '#9aa49d' : '#2f6b4f',
              borderRadius: 8,
              minHeight: 44,
              paddingHorizontal: 16,
              paddingVertical: 11,
            },
            testID: Id,
          },
        },
      )
   ```
}
