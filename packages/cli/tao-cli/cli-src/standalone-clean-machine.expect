#!/usr/bin/expect -f
# The public vanilla Tart image uses admin/admin and has SSH, but no guest agent for tart exec.
set timeout 600
set address [lindex $argv 0]
set command [lindex $argv 1]
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PreferredAuthentications=password -o PubkeyAuthentication=no -o ConnectTimeout=10 admin@$address $command
expect {
  -re {(?i)password:} { send "admin\r"; exp_continue }
  timeout { puts stderr "SSH timed out while running $command"; exit 124 }
  eof
}
set result [wait]
exit [lindex $result 3]
