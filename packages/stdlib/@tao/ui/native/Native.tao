// The platform-native implementations behind `@tao/ui`'s published components. Each is an ordinary
// Tao view whose inject passes through to the platform's own control, so an app gets the OS's
// appearance and behavior by default — and swaps any of them by importing another package, since
// the published names in `../Components.tao` are pass-through aliases.
//
// Styling is best-effort: a native control renders the OS's own chrome and cannot honor layout
// clauses, so anything passed in is reported outside production rather than silently diverging.
//
// Every host is optional. Where a platform has no equivalent — the web, the Jest harness, an
// Android device asked for a segmented control — the component renders a portable equivalent that
// keeps the same behavior and reports the same events, so one journey covers every platform.
// The platform button: system-styled per OS, following its human-interface conventions.
public
view Button(Title text, Press action(), Disabled boolean default false) {
   render inject Title, Press, Disabled, Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('Button', Layout)
      const Interaction = TR.Interaction.FromVisualLayout(Layout)
      return TR.VisualNativeRoot(
        Layout,
        TR.Element(RN.Button, {
          accessibilityLabel: Title,
          disabled: Disabled,
          onBlur: () => TR.Interaction.Pressed(Interaction, false),
          onFocus: () => TR.Interaction.Target(Interaction),
          onPress: TR.Interaction.Activate(Interaction, () => Press.invoke()),
          testID: Tag,
          title: Title,
        }),
      )
   ```
}

// The form button: the same interface as the wireframe one, including its busy state, rendered as
// the platform's own button. A busy button shows the saving title and refuses presses.
public
view FormButton(Title text, Press action(), Id text default "", Disabled boolean default false, Submitting boolean default false) {
   render inject Title, Press, Id, Disabled, Submitting, Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('FormButton', Layout)
      const busy = Disabled || Submitting
      const Interaction = TR.Interaction.FromVisualLayout(Layout)
      return TR.VisualNativeRoot(
        Layout,
        TR.Element(RN.Button, {
          accessibilityLabel: Title,
          accessibilityState: { busy: Submitting, disabled: busy },
          disabled: busy,
          onBlur: () => TR.Interaction.Pressed(Interaction, false),
          onFocus: () => TR.Interaction.Target(Interaction),
          onPress: TR.Interaction.Activate(Interaction, () => Press.invoke()),
          testID: Tag || Id || undefined,
          title: Submitting ? 'Saving…' : Title,
        }),
      )
   ```
}

// The platform switch — a true native host control — paired with its label, since the platform
// switch renders no text of its own.
public
view Switch(Value boolean, Change action(boolean), Label text, Disabled boolean default false) {
   render inject Value, Change, Label, Disabled, Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('Switch', Layout)
      const Interaction = TR.Interaction.FromVisualLayout(Layout)
      return TR.Element(
        RN.View,
        { ...TR.VisualNativeProps(Layout, Tag), style: { alignItems: 'center', flexDirection: 'row', gap: 8 } },
        TR.Element(RN.Switch, {
          accessibilityLabel: Label,
          disabled: Disabled,
          key: 'control',
          onBlur: () => TR.Interaction.Disengage(Interaction),
          onFocus: () => TR.Interaction.Engage(Interaction),
          onValueChange: (value: boolean) => {
            TR.Interaction.Engage(Interaction)
            return Change.invoke(TR.Value(value))
          },
          value: Value,
        }),
        TR.Element(RN.Text, { key: 'label' }, Label),
      )
   ```
}

// The platform's continuous value control. Without the host it degrades to a stepped control that
// still reports through `Change`, so one journey drives every implementation.
public
view Slider(Value number, Change action(number), Label text, Minimum number default 0, Maximum number default 1, Disabled boolean default false) {
   render inject Value, Change, Label, Minimum, Maximum, Disabled, Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('Slider', Layout)
      const host = TR.Hosts.Slider()
      const Interaction = TR.Interaction.FromVisualLayout(Layout)
      if (!host) {
        const step = (Maximum - Minimum) / 10
        return TR.Element(
          RN.View,
          { ...TR.VisualNativeProps(Layout, Tag), style: { alignItems: 'center', flexDirection: 'row', gap: 8 } },
          TR.Element(RN.Button, {
            accessibilityLabel: `Decrease ${Label}`,
            disabled: Disabled,
            key: 'decrease',
            onFocus: () => TR.Interaction.Engage(Interaction),
            onPress: () => {
              TR.Interaction.Engage(Interaction)
              return Change.invoke(TR.Value(Math.max(Minimum, Value - step)))
            },
            title: '−',
          }),
          TR.Element(RN.Text, { key: 'reading' }, `${Label}: ${Value}`),
          TR.Element(RN.Button, {
            accessibilityLabel: `Increase ${Label}`,
            disabled: Disabled,
            key: 'increase',
            onFocus: () => TR.Interaction.Engage(Interaction),
            onPress: () => {
              TR.Interaction.Engage(Interaction)
              return Change.invoke(TR.Value(Math.min(Maximum, Value + step)))
            },
            title: '+',
          }),
        )
      }
      return TR.Element(host, {
        ...TR.VisualNativeProps(Layout, Tag),
        accessibilityLabel: Label,
        disabled: Disabled,
        maximumValue: Maximum,
        minimumValue: Minimum,
        onBlur: () => TR.Interaction.Disengage(Interaction),
        onFocus: () => TR.Interaction.Engage(Interaction),
        onValueChange: (value: number) => {
          TR.Interaction.Engage(Interaction)
          return Change.invoke(TR.Value(value))
        },
        value: Value,
      })
   ```
}

// The platform's spinner, sized by the OS rather than by clauses.
public
view Spinner() {
   render inject Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('Spinner', Layout)
      return TR.Element(RN.ActivityIndicator, {
        ...TR.VisualNativeProps(Layout, Tag),
        accessibilityLabel: 'Loading',
        accessibilityRole: 'progressbar',
        accessibilityState: { busy: true },
        animating: true,
      })
   ```
}

// The platform's selection control: a wheel on iOS, a dropdown on Android. Options arrive as a list
// of labels, and the change reports the chosen label rather than an index, so product code never
// carries positions.
public
view Picker(Value text, Change action(text), Options list of text, Label text) {
   render inject Value, Change, Options, Label, Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('Picker', Layout)
      const host = TR.Hosts.Picker()
      const Interaction = TR.Interaction.FromVisualLayout(Layout)
      if (!host) {
        return TR.Element(
          RN.View,
          TR.VisualNativeProps(Layout, Tag),
          ...Options.map((option: string) =>
            TR.Element(RN.Button, {
              accessibilityState: { selected: option === Value },
              key: option,
              onFocus: () => TR.Interaction.Engage(Interaction),
              onPress: () => {
                TR.Interaction.Engage(Interaction)
                return Change.invoke(TR.Value(option))
              },
              title: option,
            })
          ),
        )
      }
      return TR.Element(
        host.Picker,
        {
          ...TR.VisualNativeProps(Layout, Tag),
          accessibilityLabel: Label,
          onBlur: () => TR.Interaction.Disengage(Interaction),
          onFocus: () => TR.Interaction.Engage(Interaction),
          onValueChange: (option: string) => {
            TR.Interaction.Engage(Interaction)
            return Change.invoke(TR.Value(option))
          },
          selectedValue: Value,
        },
        ...Options.map((option: string) => TR.Element(host.Item, { key: option, label: option, value: option })),
      )
   ```
}

// The iOS segmented control. Android has no system equivalent, so it degrades to a labeled row of
// buttons that reports the same selection.
public
view SegmentedControl(Value text, Change action(text), Options list of text, Label text) {
   render inject Value, Change, Options, Label, Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('SegmentedControl', Layout)
      const host = RN.Platform?.OS === 'ios' ? TR.Hosts.SegmentedControl() : undefined
      const Interaction = TR.Interaction.FromVisualLayout(Layout)
      if (!host) {
        return TR.Element(
          RN.View,
          {
            ...TR.VisualNativeProps(Layout, Tag),
            accessibilityLabel: Label,
            style: { flexDirection: 'row', gap: 4 },
          },
          ...Options.map((option: string) =>
            TR.Element(RN.Button, {
              accessibilityState: { selected: option === Value },
              key: option,
              onFocus: () => TR.Interaction.Engage(Interaction),
              onPress: () => {
                TR.Interaction.Engage(Interaction)
                return Change.invoke(TR.Value(option))
              },
              title: option,
            })
          ),
        )
      }
      return TR.Element(host, {
        ...TR.VisualNativeProps(Layout, Tag),
        accessibilityLabel: Label,
        onBlur: () => TR.Interaction.Disengage(Interaction),
        onFocus: () => TR.Interaction.Engage(Interaction),
        onValueChange: (option: string) => {
          TR.Interaction.Engage(Interaction)
          return Change.invoke(TR.Value(option))
        },
        selectedIndex: Math.max(0, Options.indexOf(Value)),
        values: Options,
      })
   ```
}

// The platform's date picker. Its value is a `time`, so it composes with the rest of the language's
// calendar arithmetic rather than carrying its own format. Without the host it degrades to a
// day-stepping control that still reports through `Change`.
public
view DatePicker(Value time, Change action(time), Label text) {
   render inject Value, Change, Label, Layout @@layout, Tag @@tag ```ts
      TR.WarnUnhonoredLayout('DatePicker', Layout)
      const os = RN.Platform?.OS
      const host = os === 'ios' || os === 'android' ? TR.Hosts.DateTimePicker() : undefined
      const Interaction = TR.Interaction.FromVisualLayout(Layout)
      if (!host) {
        const day = 24 * 60 * 60 * 1000
        return TR.Element(
          RN.View,
          { ...TR.VisualNativeProps(Layout, Tag), style: { alignItems: 'center', flexDirection: 'row', gap: 8 } },
          TR.Element(RN.Button, {
            accessibilityLabel: `Previous ${Label}`,
            key: 'previous',
            onFocus: () => TR.Interaction.Engage(Interaction),
            onPress: () => {
              TR.Interaction.Engage(Interaction)
              return Change.invoke(TR.Value(Value - day))
            },
            title: '‹',
          }),
          TR.Element(RN.Text, { key: 'reading' }, `${Label}: ${new Date(Value).toISOString().slice(0, 10)}`),
          TR.Element(RN.Button, {
            accessibilityLabel: `Next ${Label}`,
            key: 'next',
            onFocus: () => TR.Interaction.Engage(Interaction),
            onPress: () => {
              TR.Interaction.Engage(Interaction)
              return Change.invoke(TR.Value(Value + day))
            },
            title: '›',
          }),
        )
      }
      return TR.Element(host, {
        ...TR.VisualNativeProps(Layout, Tag),
        accessibilityLabel: Label,
        mode: 'date',
        onChange: (_event: unknown, selected?: Date) => {
          if (selected) {
            TR.Interaction.Engage(Interaction)
            return Change.invoke(TR.Value(selected.getTime()))
          }
        },
        onBlur: () => TR.Interaction.Disengage(Interaction),
        onFocus: () => TR.Interaction.Engage(Interaction),
        value: new Date(Value),
      })
   ```
}
