layout Col() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
      })
