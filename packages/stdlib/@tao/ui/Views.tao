layout Panes() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Panes({ children: Content, layout: Layout, tag: Tag }, {
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
      })
   ```
}

public
layout ScrollView() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.ScrollView({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
        nativeProps: { horizontal: false },
      })
   ```
}

public
view Image(Source text, Decorative boolean default false, Label text default "") {
   render inject Source, Decorative, Label, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Image({
        layout: Layout,
        tag: Tag,
        source: Source,
        decorative: Decorative,
        label: Label || undefined,
      })
   ```
}

public
view Checkbox(Value boolean, Change action(boolean), Label text, Disabled boolean default false) {
   render inject Value, Change, Label, Disabled, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Checkbox({
        layout: Layout,
        tag: Tag,
        value: Value,
        label: Label,
        disabled: Disabled,
        onChange: value => Change.invoke(TR.Value(value)),
      })
   ```
}

public
view Spinner() {
   render inject Layout @@layout, Tag @@tag ```ts
      return TR.Views.Spinner({ layout: Layout, tag: Tag })
   ```
}

public
view Progress(Value number) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Progress({ layout: Layout, tag: Tag, value: Value })
   ```
}

public
view Text(Value text) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [Value], layout: Layout, tag: Tag },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

