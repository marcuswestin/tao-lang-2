      return TR.Views.Text(
        { children: [Value], layout: Layout, tag: Tag },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'clip' } },
      )
   ```
}

public
view TextMultiline(Value text) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [Value], layout: Layout, tag: Tag },
        { nativeProps: {} },
      )
   ```
}

public
view Number(Value number) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [String(Value)], layout: Layout, tag: Tag },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

public
view TextInput(Value text, Change action(text), Submit action(), Label text, Placeholder text default "", Id text default "", Disabled boolean default false) {
   render inject Value, Change, Submit, Label, Placeholder, Id, Disabled, Layout @@layout, Tag @@tag ```ts
      return TR.Views.TextInput(
        {
          layout: Layout,
          tag: Tag,
          value: Value,
          label: Label,
          placeholder: Placeholder,
          id: Id,
          disabled: Disabled,
          onChange: value => Change.invoke(TR.Value(value)),
          onSubmit: () => Submit.invoke(),
        },
      )
   ```
}

public
view FormButton(Title text, Press action(), Id text default "", Disabled boolean default false, Submitting boolean default false) {
   render inject Title, Press, Id, Disabled, Submitting, Layout @@layout, Tag @@tag ```ts
      const effectiveDisabled = Disabled || Submitting
      return TR.Views.Pressable(
        {
          layout: Layout,
          tag: Tag,
          title: Submitting ? 'Saving…' : Title,
          action: Press,
          disabled: effectiveDisabled,
        },
        {
          nativeProps: {
            accessibilityLabel: Title,
            accessibilityRole: 'button',
            accessibilityState: { busy: Submitting, disabled: effectiveDisabled },
            disabled: effectiveDisabled,
            style: {
              alignItems: 'center',
              backgroundColor: effectiveDisabled ? '#9aa49d' : '#2f6b4f',
              borderRadius: 8,
              minHeight: 44,
              paddingHorizontal: 16,
              paddingVertical: 11,
            },
            testID: Id || undefined,
          },
        },
      )
   ```
}
