public
view Box() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'left', 'center'], ['hug']]),
      })
   ```
}

public
view Stack() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'center'], ['hug']]),
      })
   ```
}

public
view Col() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
      })
   ```
}

public
view Row() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'baseline', 'left'], ['fill']]),
      })
   ```
}

public
view WrappingRow() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'row',
        layout: TR.Layout.create([['content', 'baseline', 'left'], ['compress'], ['hug']]),
        style: { flexWrap: 'wrap' },
      })
   ```
}

public
view Panes() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Panes({ children: Content, layout: Layout, tag: Tag }, {
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
      })
   ```
}

public
view ScrollView() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.ScrollView({ children: Content, layout: Layout, tag: Tag }, {
        direction: 'column',
        layout: TR.Layout.create([['content', 'top', 'stretch'], ['fill']]),
        nativeProps: { horizontal: false },
      })
   ```
}

public
view Image(Source text, Decorative boolean default false, Label text default "") {
   render inject Source, Decorative, Label, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Image({
        layout: Layout,
        tag: Tag,
        source: Source,
        decorative: Decorative,
        label: Label || undefined,
      })
   ```
}

public
view Checkbox(Value boolean, Change action(boolean), Label text, Disabled boolean default false) {
   render inject Value, Change, Label, Disabled, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Checkbox({
        layout: Layout,
        tag: Tag,
        value: Value,
        label: Label,
        disabled: Disabled,
        onChange: value => Change.invoke(TR.Value(value)),
      })
   ```
}

public
view Progress(Value number) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Progress({ layout: Layout, tag: Tag, value: Value })
   ```
}

public
view Text(Value text) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [Value], layout: Layout, tag: Tag },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

public
view TextFrame(Value text) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [Value], layout: Layout, tag: Tag },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'clip' } },
      )
   ```
}

public
view TextMultiline(Value text) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [Value], layout: Layout, tag: Tag },
        { nativeProps: {} },
      )
   ```
}

public
view Number(Value number) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text(
        { children: [String(Value)], layout: Layout, tag: Tag },
        { nativeProps: { numberOfLines: 1, ellipsizeMode: 'tail' } },
      )
   ```
}

public
view TextInput(Value text, Change action(text), Submit action(), Label text, Placeholder text default "", Id text default "", Disabled boolean default false) {
   render inject Value, Change, Submit, Label, Placeholder, Id, Disabled, Layout @@layout, Tag @@tag ```ts
      return TR.Views.TextInput(
        {
          layout: Layout,
          tag: Tag,
          value: Value,
          label: Label,
          placeholder: Placeholder,
          id: Id,
          disabled: Disabled,
          onChange: value => Change.invoke(TR.Value(value)),
          onSubmit: () => Submit.invoke(),
        },
      )
   ```
}
