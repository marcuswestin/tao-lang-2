// Dev is the development-only datasource. The Tao dev server — `tao dev` or Studio — stores each
// app's snapshots on the development machine and syncs them live to every device, browser tab,
// and simulator running that app's development build. Storage is scoped per app and survives a
// dev server restart; a schema edit that leaves the stored data unreadable clears that app's data.
// It needs the dev server running and never ships: `tao ship` refuses an app that configures it.
public
type Dev is datasource with {
   // Defaults to the mounted Tao data schema name when omitted.
   StorageKey text?

   provider DevProvider from ./Dev.ts
}
