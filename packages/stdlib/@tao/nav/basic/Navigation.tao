// Explicit deterministic and portable navigation. The contracts and reducer semantics match the
// native kit, while every surface is rendered by Tao runtime components.
public
type StackNav is nav with {
   Initial view

   nav StackNavKind from ./NavKinds.ts
}

public
type SlotNav is nav with {
   Initial view

   nav SlotNavKind from ./NavKinds.ts
}

public
type SelectionNav is nav with {
   Initial key
   Display text
   @key {
      Label text
      Icon text is ""
      Content view
   }

   nav SelectionNavKind from ./NavKinds.ts
}

public
type SplitNav is nav with {
   @key {
      Content view
      Width number
      Resizable boolean is false
   }

   nav SplitNavKind from ./NavKinds.ts
}

// Fixed chrome edges around one navigated center. Horizontal bars win the corners: @top and
// @bottom span the full width and @left/@right occupy the space between them. `left`/`right` are
// the language's layout terms, so they reverse with the writing direction.
//
// One @key template declares every slot; the five allowed names are a validator rule. `Size` is the
// one perpendicular dimension — height on @top/@bottom, width on @left/@right — and absent means
// content-derived, which is why there is no meaningless Width on a bar. A slot whose `Content`
// evaluates to none reserves no space and contributes no container.
public
type FrameNav is nav with {
   @key {
      Label text is ""
      Content view is none
      Size number is none
   }

   nav FrameNavKind from ./NavKinds.ts
}
