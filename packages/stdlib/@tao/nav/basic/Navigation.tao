// Explicit deterministic and portable navigation. The contracts and reducer semantics match the
// native kit, while every surface is rendered by Tao runtime components.
public
type StackNav is nav with {
   Initial view

   nav StackNavKind from ./NavKinds.ts
}

public
type SlotNav is nav with {
   Initial view

   nav SlotNavKind from ./NavKinds.ts
}

// `Display` picks the surface: "automatic" and "tabs" are a tab row, "drawer" is a column, and
// "toggle" is one Safari-style bar floating over the bottom edge — Back, the visible screen's title
// and toolbar, and a control that switches to the next item. Under "toggle" a stack inside an item
// draws no header of its own.
public
type SelectionNav is nav with {
   Initial key
   Display text
   @key {
      Label text
      Icon text is ""
      Content view
   }

   nav SelectionNavKind from ./NavKinds.ts
}

public
type SplitNav is nav with {
   @key {
      Content view
      Width number
      Resizable boolean is false
   }

   nav SplitNavKind from ./NavKinds.ts
}
