.DS_Store
# Watchman creates disposable query-synchronization files in watched roots.
.watchman-cookie-*
# Filesystem mutation leases are transient coordination state beside their targets.
*.tao-file-mutation.lock
*.tao-file-mutation.lock.reclaim
*.tao-file-mutation.lock.owner-*
*.tao-file-mutation.lock.stale-*
*.tao-file-mutation.lock.release-*
node_modules/
*.tsbuildinfo
.tao-ts/
# Ignore sidecars left by the previous generated-contract layout.
*.tao.ts

.devenv/
.direnv/
.claude/settings.local.json
.claude/agents/
.claude/worktrees/
.codex/agents/
.cursor/agents/

.android/
local.properties

# Every lane writes its logs, merge messages, and scratch state here, and a shell redirect into a
# directory that does not exist yet fails before the command it was redirecting ever runs — which
# reads as the lane failing rather than as a missing directory. Tracking `.gitkeep` makes the
# directory exist the moment a worktree does, however that worktree was created, so nothing has to
# have run first. Keep the negation: collapsing this back to a bare `.artifacts` reintroduces that.
.artifacts/*
!.artifacts/.gitkeep
_gen_*/
# Project-local state uses .tao/.gitignore; store/ is committed.

# Disposable package diagnostics. Scripts here inherit their package tsconfig and workspace context.
packages/*/.scratch/
packages/*/*/.scratch/

.expo/
packages/apps/expo-host/ios/
packages/apps/expo-host/android/

packages/ides/studio-companion-app/ios/
packages/ides/studio-companion-app/android/

# Decrypted repository-tool secrets, written by `just secrets`; encrypted originals live in secrets/.
.env.secrets
# Local overrides kept by hand. Nothing generates this, so nothing can overwrite it.
.env.local
