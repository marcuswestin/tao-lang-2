// Summarizes the settled presentation direction and the remaining open questions.
// This file is intentionally a checklist sketch so future edits can promote open items into concrete triage examples.

ui SettledPresentationModelSummary {
   render Stack [stack] {
      Text "Navigation is internal; presentation API is user-facing." [body]
      Text "Only ui is directly presentable; navs are native containers and dialogues are askable." [body]
      Text "UI parameters must be restorable, not merely serializable." [body]
      Text "Entity values can be accepted when Tao can restore equivalent semantic state." [body]
      Text "Navs are named presentation contexts." [body]
      Text "Platform differences belong in declarations, not call sites." [body]
      Text "Overlays are dismissible by default and stack by default." [body]
      Text "Presentation never suspends; asking a dialogue always does." [body] // Statement context no longer changes execution semantics.
      Text "Every dialogue response is optional at the ask site for now." [body] // A dialogue that responds T makes ask infer T?.
      Text "Compiler receives resolved, valid references only." [body]
      Text "Injected TS is isolated behind explicit imported functions." [body]
      Text "Fallback presentation should show UI and emit diagnostics." [body]
   }
}

