// decision: design tokens, recipes, variants, rules, and diagnostics
// depends on: 013-combined-style-layout-specs
// status: open

// option 1: flat tokens and specs with optional semantic/recipe sections
// This keeps simple projects simple while allowing richer design systems.
project design StillDesign {
   ink #121826
   canvas #f6f7f3
   md 12px

   body [size 16, weight 450, text ink, line 23]
   primaryAction [rowCenter, bg primary, text white, radius 16, pad horizontal lg vertical md]

   tokens semantic {
      color.intent.info primary
   }

   recipe ButtonRecipe for Button {
      base [primaryAction]
      variant quiet [quietAction]
      state disabled [opacity 45%]
   }

   rules {
      contrast minimum AA
      raw values forbid except tokens
   }
}

// option 2: categorized design blocks only
// This is more structured, but every small style needs a category home.
project design StillDesign {
   color {
      ink #121826
      canvas #f6f7f3
   }

   spacing {
      md 12px
   }

   component Button {
      primary [rowCenter, bg primary, text white]
      quiet [quietAction]
   }
}

// option 3: generated semantic components from recipes
// This makes call sites expressive, but increases generated API surface.
recipe PrimaryButton for Button {
   base [primaryAction]
}

project view RecipeGeneratedExample {
   render PrimaryButton "Save"
}
