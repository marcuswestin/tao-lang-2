// decision: mutations, default omission, transactions, and relationship writes
// depends on: 007-data-schema-fields-and-relationships, 008-query-guards-and-query-shape
// status: open

// option 1: simple create/update blocks omit defaulted fields after one explicit example
// Field names carry types, so only non-default data has to be written repeatedly.
create StillData.Note {
   Workspace CurrentWorkspace
   Title DraftTitle
   Body DraftBody
   Mood "clear"
   Pinned false
   Archived false
   CreatedAt now()
   UpdatedAt now()
}

create StillData.Task {
   Workspace CurrentWorkspace
   Title DraftTaskTitle
   CreatedAt now()
   UpdatedAt now()
}

update CurrentTask {
   Done true
   UpdatedAt now()
}

// option 2: transaction blocks own multi-row consistency
// This makes relationship updates atomic and obvious.
transaction "capture-task" {
   create StillData.Task as Task {
      Workspace CurrentWorkspace
      Title DraftTaskTitle
      CreatedAt now()
      UpdatedAt now()
   }

   link CurrentWorkspace.Tasks to Task
} on conflict "lastWriteWins"

// option 3: provider-specific write capabilities decide syntax availability
// waiting for 010-provider-capabilities-and-runtime-targets
