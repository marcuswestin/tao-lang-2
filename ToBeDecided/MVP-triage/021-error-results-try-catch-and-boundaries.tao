// decision: error values, try/catch/finally, and boundaries
// depends on: 019-state-actions-functions-and-inline-events, 020-custom-events-lifecycle-and-automation
// status: open

// option 1: result types plus try/catch/finally and boundary declarations
// This mirrors MVP-3 and keeps thrown errors mostly at external boundaries.
type FileError is item {
   Message text
   Cause text optional
   Recoverable boolean default true
}

type ExportResult is result text, FileError

action ReadLatestExport {
   try {
      ExportText = try File.read "exports/latest.txt"
      return ok ExportText
   } catch Error FileError {
      return error FileError {
         Message "Could not read latest export."
         Cause Error.Message
      }
   } finally {
      do File.closeAll "exports"
   }
}

project boundary SyncBoundary {
   catch loading -> { show Text "Syncing..." [quiet] }
   catch missing -> { show Text "Nothing to sync." [quiet] }
   catch error -> Error FileError { show Text Error.Message [body] }
}

// option 2: case-match every fallible operation without try syntax
// This is explicit and value-oriented, but can be verbose for imperative actions.
action SaveExport Value text {
   case File.write "exports/latest.txt", Value do
      ok Path text -> { LastExportPath = Path }
      error Reason FileError -> { LastExportError = Reason.Message }
   end
}

// option 3: boundaries only, no user-authored result types for MVP
// This is simpler initially, but pushes error typing into runtime/provider adapters.
project boundary SyncBoundary {
   catch error -> Error {
      show Text Error.Message [body]
   }
}
