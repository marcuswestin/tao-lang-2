use Bookmark, Bookmarks, Comment, Comments, ReadingEntries, ReadingEntry, Stories, Story from @model
use CloudKit from @tao/data/providers/cloudkit
use Http from @tao/data/providers/http
use Local from @tao/data/providers/local
use OpenUrl from @tao/linking
use SelectionNav, StackNav from @tao/nav
use Col, FormButton, Row, ScrollView, Spinner, Text, TextMultiline from @tao/ui

package {
   version 0.1.0
   license MIT
}

// A Hacker News reader over three datasources. Stories and comments come from query-driven Http,
// bookmarks follow the reader through iCloud, and reading history belongs to this device. Each
// datasource states the collections it stores, and cross-store rows name stories with a `reference`.
folder
app HNReader {
   id "hnreader"
   version "0.1.0"
   name "HNReader"
   Navigator HNNavigator
   // The shipped reader keeps its bookmarks under their own key. The patch derives this app's copy
   // where it is bound; the declaration stays as it is.
   Datasource {
      HackerNews,
      Personal with {
         StorageKey "HNReaderBookmarks"
      },
      ReadingHistory
   }
   Design HNDesign
}

// The stub variant swaps the feed while keeping bookmarks and reading history, so journeys exercise
// the real fill machinery and persistent local history deterministically, with no network.
app HNReaderStub = HNReader with {
   id "hnreader-stub",
   name "HNReader Stub",
   Datasource {
      StubNews,
      Personal,
      ReadingHistory
}  }

type HNSource is Http with {
   Adapter item is HNAdapter from ./HNAdapter.ts
   CacheFor duration is 5.min
}

type StubSource is Http with {
   Adapter item is StubAdapter from ./StubAdapter.ts
}

datasource HackerNews = HNSource {
   Data {
      Stories,
      Comments
}  }

datasource StubNews = StubSource {
   Data {
      Stories,
      Comments
}  }

// CloudKit is Apple-native, so off a device the bookmarks still work from their local checkpoint and
// the missing native side shows as a sync error. Checks replace it with an in-memory store.
datasource Personal = CloudKit {
   StorageKey "HNReaderBookmarksDev",
   Data {
      Bookmarks
}  }

// Reading history is device-owned rather than a field on the remote feed row. The real and stub
// variants bind this same declaration, so a feed refill cannot erase what this device opened.
datasource ReadingHistory = Local {
   StorageKey "HNReaderReadingHistory",
   Data {
      ReadingEntries
}  }

// Two stacks behind one bottom bar, the way Safari keeps its controls: the feed and the stories
// you have opened. The bar carries Back, the visible screen's title and toolbar, and a control that
// switches to the other stack, so no screen draws a header of its own.
nav TopStack = StackNav {
   Initial FrontPage
}

nav ReadingStack = StackNav {
   Initial ReadingPage
}

nav HNNavigator = SelectionNav {
   Initial @top,
   Display "toggle",
   @top {
      Label "Top",
      Icon "newspaper",
      Content TopStack
   },
   @reading {
      Label "Reading",
      Icon "book",
      Content ReadingStack
}  }

// Hacker News's warm paper and orange, tuned for reading: white story cards on the beige ground,
// rank and bylines in the brand orange, ink sized for scanning titles and reading comments. At night
// the ground turns to warm charcoal and the orange lifts so it still reads against it.
folder
design HNDesign {
   colors {
      paperLight #f6f6ef
      cardLight #ffffff
      inkLight #21211c
      inkMutedLight #6e6e66
      accentLight #ff6600
      accentDeepLight #c9560c
      lineLight #e7e7db
      railInkLight #d9d2ba
      paperDark #171714
      cardDark #22221e
      inkDark #eeeee6
      inkMutedDark #a8a89f
      accentDark #ff7a26
      accentDeepDark #ffa066
      lineDark #37372f
      railInkDark #4d4839

      paper when Scheme is Dark paperDark / not paperLight
      card when Scheme is Dark cardDark / not cardLight
      ink when Scheme is Dark inkDark / not inkLight
      inkMuted when Scheme is Dark inkMutedDark / not inkMutedLight
      accent when Scheme is Dark accentDark / not accentLight
      accentDeep when Scheme is Dark accentDeepDark / not accentDeepLight
      line when Scheme is Dark lineDark / not lineLight
      railInk when Scheme is Dark railInkDark / not railInkLight
   }
   sizes {
      sm 4.px
   }
   styles {
      // Chrome defaults, so the navigation host follows the palette instead of the runtime's white.
      Text [ink ink]
      AppSurface [background paper]
      NavigationHost [background paper]
      NavigationContent [background paper]
      NavigationHeader [background card, border line]
      NavigationTitle [size 18, weight 700, ink ink]
      NavigationTabs [gap 6, pad 6, background card, border line]
      NavigationTab [pad 10, radius 10, ink inkMuted, weight 600, ink accentDeep when selected]
      NavigationChromeButton [pad 8, radius 8, ink accentDeep, weight 600]

      screen [fill, content top stretch, background paper]
      feed [fill, content top stretch, pad 10, gap 8]
      threadWrap [fill, content center top]
      thread [claim 1, compress, width max 680, content top stretch, pad 10, gap 8]
      rail [width sm, radius 2, background railInk]
      storyCard [pad 12, radius 10, background card, border line]
      rank [rigid, size 15, weight 700, ink accent]
      storyTitle [size 16, weight 600, line 22, ink ink]
      meta [size 13, line 18, ink inkMuted]
      pageTitle [size 21, weight 700, line 27, ink ink]
      commentCard [pad 12, radius 10, background card, border line, gap sm]
      author [size 13, weight 700, ink accentDeep]
      commentText [size 15, line 21, ink ink]
      notice [size 13, ink inkMuted]
      problemTitle [size 16, weight 700, ink ink]
      stateBox [content center, pad 24]
   }
}

scene FrontPage() {
   Title "Hacker News"
   query TopStories = Stories with {
      where Rank >= 1
      limit 30
   }
   action ShowBookmarks() {
      present BookmarkList()
   }
   command Bookmarks() {
      Title "Bookmarks"
      Icon "bookmark"
      do ShowBookmarks()
   }
   Toolbar { Bookmarks }
   render Col() [screen] {
      guard TopStories {
         loading -> { Col() [stateBox] {
            Spinner()
         } }
         error -> Context { Col() [stateBox, gap 6] {
            Text("Couldn't reach Hacker News") [problemTitle]
            Text(Context.Message) [meta]
         } }
      }
      if TopStories is refreshing {
         Col() [pad 10] {
            Text("Refreshing…") [notice]
      }  }
      if TopStories is stale {
         Col() [pad 10] {
            Text("Offline — showing cached stories") [notice]
      }  }
      ScrollView() {
         Col() [feed] {
            #stories
            loop TopStories / Story {
               TrackedStoryRow(Story)
}  }  }  }  }

// Every story opened on this device, most recent first. These rows survive feed replacement and
// relaunches; each Story reference still reports honestly when its remote row is unavailable.
scene ReadingPage() {
   Title "Reading"
   query ReadingEntries = ReadingEntries with {
      order by OpenedAt desc
   }
   render Col() [screen] {
      when ReadingEntries {
         empty -> { Col() [stateBox, gap 6] {
            Text("Nothing opened yet") [problemTitle]
            Text("Stories you open from Top appear here.") [meta]
         } }
         otherwise -> { ScrollView() {
            Col() [feed] {
               Text("{ ReadingEntries.Count } opened") [notice]

               #reading
               loop ReadingEntries / ReadingEntry {
                  ReadingHistoryRow(ReadingEntry)
            }  }
         } }
}  }  }

// A feed row either creates its one history record or refreshes the existing record's recency. The
// query keeps repeat opens on the update path, and the unique scalar gives the row stable identity.
folder
view TrackedStoryRow(Story) {
   query ExistingHistory = ReadingEntries with {
      where Story == Story
      limit 1
   }
   render Col() [content top stretch] {
      when ExistingHistory {
         empty -> { loop [Story] / NewStory {
            StoryRow(NewStory)
            on select -> {
               create ReadingEntry {
                  StoryHnId: NewStory.HnId,
                  Story: NewStory,
                  OpenedAt: now
               }
               present StoryScreen(NewStory)
            }
         } }
         otherwise -> { loop ExistingHistory / ReadingEntry {
            StoryRow(Story)
            on select -> {
               update ReadingEntry {
                  OpenedAt: now
               }
               present StoryScreen(Story)
            }
         } }
}  }  }

// Missing feed data never erases the local history row. It renders the reference state instead of
// an empty card; when the adapter can resolve the story again, the same row becomes selectable.
folder
view ReadingHistoryRow(ReadingEntry) {
   render Col() [content top stretch] {
      when ReadingEntry.Story {
         loading -> { Col() [storyCard] {
            Text("Loading story…") [notice]
         } }
         missing -> { Col() [storyCard] {
            Text("This story is not in the feed right now.") [notice]
         } }
         error -> Message { Col() [storyCard] {
            Text(Message) [notice]
         } }
         otherwise -> { loop [ReadingEntry] / AvailableEntry {
            StoryRow(AvailableEntry.Story)
            on select -> {
               update AvailableEntry {
                  OpenedAt: now
               }
               present StoryScreen(AvailableEntry.Story)
            }
         } }
}  }  }

folder
view StoryRow(Story) {
   render Row() [storyCard, gap 10] {
      Text("{ Story.Rank }.") [rank]
      Col() [gap sm, claim 1, compress] {
         Text("{ Story.Score } points by { Story.Author } · { Story.CommentCount } comments") [meta]
         TextMultiline(Story.Title) [storyTitle]
}  }  }

scene StoryScreen(Story) {
   Title Story.Title
   action OpenStoryLink() {
      do OpenUrl(Story.Url)
   }
   command Open() {
      Title "Open story"
      Icon "safari"
      Enabled Story.Url is not empty
      do OpenStoryLink()
   }
   // The write lands in the other datasource, and the story it names stays where the feed put it. The
   // query reads that other datasource by the story's own id, so a kept story cannot be kept twice.
   query Kept = Bookmarks with {
      where Story == Story
   }
   action KeepStory() {
      create Bookmark {
         Story
   }  }
   command Keep() {
      Title "Bookmark story"
      Icon "bookmark"
      Enabled Kept is empty
      do KeepStory()
   }
   Toolbar { Open, Keep }
   query Thread = Story.Comments with { }
   render Col() [screen] {
      ScrollView() {
         Row() [threadWrap] {
            Col() [thread] {
               Col() [storyCard, gap 4] {
                  Text("{ Story.Score } points by { Story.Author } · { Story.CommentCount } comments") [meta]
                  TextMultiline(Story.Title) [pageTitle]
               }
               guard Thread {
                  loading -> { Col() [stateBox] {
                     Spinner()
                  } }
                  error -> Context { Col() [stateBox, gap 6] {
                     Text("Couldn't load comments") [problemTitle]
                     Text(Context.Message) [meta]
                  } }
               }
               when Thread {
                  empty -> { Col() [pad 10] {
                     Text("No comments yet") [notice]
                  } }
                  otherwise -> {
                     #comments
                     loop Thread / Comment {
                        CommentRow(Comment)
}  }  }  }  }  }  }  }

// The reader's own screen, reading the other datasource. Its query, its rows, and its writes never
// touch the feed; only the story each bookmark names comes from there.
scene BookmarkList() {
   Title "Bookmarks"
   query Bookmarks = Bookmarks with { }
   render Col() [screen] {
      when Bookmarks {
         empty -> { Col() [pad 10] {
            Text("Nothing kept yet") [notice]
         } }
         otherwise -> { ScrollView() {
            Col() [feed] {
               #bookmarks
               loop Bookmarks / Bookmark {
                  BookmarkRow(Bookmark)
            }  }
         } }
}  }  }

// A reference is a handle with availability, so the row says plainly when the feed no longer holds
// the story it names rather than rendering an empty card. The bookmark itself is untouched: nothing
// deletes across a datasource boundary, and the story returns as soon as the feed serves it again.
view BookmarkRow(Bookmark) {
   render Col() [storyCard, gap 4] {
      guard Bookmark.Story {
         loading -> { Text("Loading story…") [notice] }
         missing -> { Text("This story is not in the feed right now.") [notice] }
         error -> Context { Text(Context.Message) [notice] }
      }
      TextMultiline(Bookmark.Story.Title) [storyTitle]
      Text("{ Bookmark.Story.Score } points by { Bookmark.Story.Author }") [meta]

      #removeBookmark
      FormButton("Remove") {
         on press -> { delete Bookmark }
}  }  }

// The store keeps the thread flat with a Depth per row (the adapter flattens the tree). One rail
// renders per ancestor level, so replies indent under their parents with the thread lines drawn;
// nesting past four levels aligns at the fourth.
view CommentRow(Comment) {
   render Row() [fill, gap 8] {
      if Comment.Depth >= 1 {
         Col() [rail] { }
      }
      if Comment.Depth >= 2 {
         Col() [rail] { }
      }
      if Comment.Depth >= 3 {
         Col() [rail] { }
      }
      if Comment.Depth >= 4 {
         Col() [rail] { }
      }
      Col() [commentCard, claim 1, compress] {
         TextMultiline(Comment.Text) [commentText]
         Text(Comment.Author) [author]
}  }  }
