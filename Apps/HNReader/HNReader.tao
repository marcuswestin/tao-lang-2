project {
   id "hnreader"
   name "HNReader"
   version "0.1.0"
   app HNReader
   remote none
   license MIT
}

// A Hacker News reader. The app shell names its parts, each in its own file: Data.tao the
// datasources, Navigation.tao the navigator, Design.tao the palette and styles, and Feed, Story,
// Reading, and Bookmarks the screens. Each file compiles to its own module, so a design or screen
// edit leaves the datasource declarations alone.
folder
app HNReader {
   Name "HNReader"
   Navigator HNNavigator
   // The shipped reader keeps its bookmarks under their own key. The patch derives this app's copy
   // where it is bound; the declaration stays as it is.
   Datasource {
      HackerNews,
      Personal with {
         StorageKey "HNReaderBookmarks"
      },
      ReadingHistory
   }
   Design HNDesign
}

// The stub variant swaps the feed while keeping bookmarks and reading history, so journeys exercise
// the real fill machinery and persistent local history deterministically, with no network.
app HNReaderStub = HNReader with {
   Name "HNReader Stub"
   Datasource {
      StubNews,
      Personal,
      ReadingHistory
}  }
