use View1 from @/studio
use CloudKit from @tao/data/providers/cloudkit
use Http from @tao/data/providers/http
use OpenUrl from @tao/linking
use StackNav from @tao/nav
use Col, FormButton, Row, ScrollView, Spinner, Text, TextMultiline from @tao/ui

project {
   id "hnreader"
   name "HNReader"
   version "0.1.0"
   DefaultApp HNReader
   remote none
   license MIT
}

// A Hacker News reader over two datasources. Stories and comments are filled from the query-driven
// Http datasource; bookmarks are the reader's own and follow them across their devices in iCloud. Each datasource states
// the collections it stores, the app binds both, and a bookmark names its story across the boundary
// with a `reference`.
folder
app HNReader {
   Name "HNReader"
   Navigator StackNav {
      Initial FrontPage
   }
   // The shipped reader keeps its bookmarks under their own key. The patch derives this app's copy
   // where it is bound; the declaration stays as it is.
   Datasource {
      HackerNews,
      Personal with {
         StorageKey "HNReaderBookmarks"
   }  }
   Design HNDesign
}

// The stub variant swaps the feed and keeps the bookmarks, so journeys exercise the real fill
// machinery — loading, upsert-by-unique, relation resolution — deterministically, with no network,
// and a bookmark still reaches the story the feed filled.
app HNReaderStub = HNReader with {
   Name "HNReader Stub"
   Datasource {
      StubNews,
      Personal
}  }

type HNSource is Http with {
   Adapter item is HNAdapter from ./HNAdapter.ts
   CacheFor duration is 5.min
}

type StubSource is Http with {
   Adapter item is StubAdapter from ./StubAdapter.ts
}

datasource HackerNews = HNSource {
   Data {
      Stories,
      Comments
}  }

datasource StubNews = StubSource {
   Data {
      Stories,
      Comments
}  }

// CloudKit is Apple-native, so off a device the bookmarks still work from their local checkpoint and
// the missing native side shows as a sync error. Checks replace it with an in-memory store.
datasource Personal = CloudKit {
   StorageKey "HNReaderBookmarksDev"
   Data {
      Bookmarks
}  }

// Hacker News's warm paper and orange, tuned for reading: white story cards on the beige ground,
// rank and bylines in the brand orange, ink sized for scanning titles and reading comments.
design HNDesign {
   colors {
      paper #f6f6ef
      card #ffffff
      ink #21211c
      inkMuted #82827a
      accent #ff6600
      accentDeep #c9560c
      line #e7e7db
      railInk #d9d2ba
      snow #ffffff
   }
   sizes {
      sm 4.px
      med 14.px
   }
   screen [fill, content top stretch, bg paper]
   header [hug, pad med, bg accent]
   headerTitle [size 19, weight 800, fg snow]
   feed [fill, content top stretch, pad 10, gap 8]
   threadWrap [fill, content center top]
   thread [claim 1, compress, width max 680, content top stretch, pad 10, gap 8]
   rail [width sm, radius 2, bg railInk]
   storyCard [pad 12, radius 10, bg card, border line]
   rank [rigid, size 15, weight 700, fg accent]
   storyTitle [size 16, weight 600, line 22, fg ink]
   meta [size 13, line 18, fg inkMuted]
   pageTitle [size 21, weight 700, line 27, fg ink]
   commentCard [pad 12, radius 10, bg card, border line, gap sm]
   author [size 13, weight 700, fg accentDeep]
   commentText [size 15, line 21, fg ink]
   notice [size 13, fg inkMuted]
   problemTitle [size 16, weight 700, fg ink]
   stateBox [content center, pad 24]
}

folder
data Stories / Story {
   HnId number (unique)
   Title text
   Url text (default "")
   Score number
   Author text
   CommentCount number
   // A story's front-page rank, or 0 for a story that reached the store some other way. Feeds over
   // one entity share its rows, so a feed's query filters on its own materialized field.
   Rank number (default 0)
   Comments (owned)

   order by Rank
}

folder
data Comments / Comment {
   Story
   HnId number (unique)
   Author text
   Text text
   Depth number
   Ordering number

   order by Ordering
}

// The reader's own rows, in the other datasource. `reference` is what a link across that boundary
// is: the story's unique HnId is what a bookmark stores, so it names a story the feed holds without
// the two stores needing to know about each other. A story that drops out of the feed leaves the
// bookmark alone, reading as missing until the feed serves it again.
data Bookmarks / Bookmark {
   Story (reference)
   Note text (default "")
   CreatedAt time (default now)

   order by CreatedAt
}

scene FrontPage() {
   Title "Hacker News"
   query Stories as TopStories {
      where Rank >= 1
      limit 30
   }
   action ShowBookmarks() {
      present BookmarkList()
   }
   command Bookmarks() {
      Title "Bookmarks"
      Icon "bookmark"
      do ShowBookmarks()
   }
   Toolbar { Bookmarks }
   render Col() [screen] {
      Row() [header] {
         Text("Hacker News") [headerTitle]
      }
      guard TopStories {
         loading -> { Col() [stateBox] {
            Spinner()
         } }
         error -> Message { Col() [stateBox, gap 6] {
            Text("Couldn't reach Hacker News") [problemTitle]
            Text(Message) [meta]
         } }
      }
      if TopStories is refreshing {
         Col() [pad 10] {
            Text("Refreshing…") [notice]
      }  }
      if TopStories is stale {
         Col() [pad 10] {
            Text("Offline — showing cached stories") [notice]
      }  }
      ScrollView() {
         Col() [feed] {
            #stories
            loop TopStories / Story {
               StoryRow(Story)
               on select -> { present StoryScreen(Story) }
}  }  }  }  }

folder
view StoryRow(Story) {
   render Row() [storyCard, gap 10] {
      Text("{ Story.Rank }.") [rank]
      Col() [gap sm, claim 1, compress] {
         Text("{ Story.Score } points by { Story.Author } · { Story.CommentCount } comments") [meta]
         TextMultiline(Story.Title) [storyTitle]
}  }  }

scene StoryScreen(Story) {
   Title Story.Title
   action OpenStoryLink() {
      do OpenUrl(Story.Url)
   }
   command Open() {
      Title "Open story"
      Icon "safari"
      Enabled Story.Url is not empty
      do OpenStoryLink()
   }
   // The write lands in the other datasource, and the story it names stays where the feed put it. The
   // query reads that other datasource by the story's own id, so a kept story cannot be kept twice.
   query Bookmarks as Kept {
      where Story == Story
   }
   action KeepStory() {
      create Bookmark {
         Story
   }  }
   command Keep() {
      Title "Bookmark story"
      Icon "bookmark"
      Enabled Kept is empty
      do KeepStory()
   }
   Toolbar { Open, Keep }
   query Thread from Story.Comments { }
   render Col() [screen] {
      Col() [header] {
         Text("Hacker News") [headerTitle]
      }
      ScrollView() {
         Row() [threadWrap] {
            Col() [thread] {
               Col() [storyCard, gap 4] {
                  Text("{ Story.Score } points by { Story.Author } · { Story.CommentCount } comments") [meta]
                  TextMultiline(Story.Title) [pageTitle]
               }
               guard Thread {
                  loading -> { Col() [stateBox] {
                     Spinner()
                  } }
                  error -> Message { Col() [stateBox, gap 6] {
                     Text("Couldn't load comments") [problemTitle]
                     Text(Message) [meta]
                  } }
               }
               when Thread {
                  empty -> { Col() [pad 10] {
                     Text("No comments yet") [notice]
                  } }
                  otherwise -> {
                     #comments
                     loop Thread / Comment {
                        CommentRow(Comment)
}  }  }  }  }  }  }  }

// The reader's own screen, reading the other datasource. Its query, its rows, and its writes never
// touch the feed; only the story each bookmark names comes from there.
scene BookmarkList() {
   Title "Bookmarks"
   query Bookmarks { }
   render Col() [screen] {
      Col() [header] {
         Text("Bookmarks") [headerTitle]
      }
      when Bookmarks {
         empty -> { Col() [pad 10] {
            Text("Nothing kept yet") [notice]
         } }
         otherwise -> { ScrollView() {
            Col() [feed] {
               #bookmarks
               loop Bookmarks / Bookmark {
                  BookmarkRow(Bookmark)
            }  }
         } }
}  }  }

// A reference is a handle with availability, so the row says plainly when the feed no longer holds
// the story it names rather than rendering an empty card. The bookmark itself is untouched: nothing
// deletes across a datasource boundary, and the story returns as soon as the feed serves it again.
view BookmarkRow(Bookmark) {
   render Col() [storyCard, gap 4] {
      guard Bookmark.Story {
         loading -> { Text("Loading story…") [notice] }
         missing -> { Text("This story is not in the feed right now.") [notice] }
         error -> Message { Text(Message) [notice] }
      }
      TextMultiline(Bookmark.Story.Title) [storyTitle]
      Text("{ Bookmark.Story.Score } points by { Bookmark.Story.Author }") [meta]

      #removeBookmark
      FormButton("Remove") {
         on press -> { delete Bookmark }
}  }  }

// The store keeps the thread flat with a Depth per row (the adapter flattens the tree). One rail
// renders per ancestor level, so replies indent under their parents with the thread lines drawn;
// nesting past four levels aligns at the fourth.
view CommentRow(Comment) {
   render Row() [fill, gap 8] {
      if Comment.Depth >= 1 {
         Col() [rail] { }
      }
      if Comment.Depth >= 2 {
         Col() [rail] { }
      }
      if Comment.Depth >= 3 {
         Col() [rail] { }
      }
      if Comment.Depth >= 4 {
         Col() [rail] { }
      }
      Col() [commentCard, claim 1, compress] {
         TextMultiline(Comment.Text) [commentText]
         Text(Comment.Author) [author]
}  }  }
