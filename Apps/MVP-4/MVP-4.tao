use Button, Screen, Stack, Text from @tao/ui
use TextInput from @tao/ui // this will be auto-moved to the previous use line by `tao fmt`
use InstantDB from @instantdb

project {
   name "Still MVP 4" // optional
   version "0.1" // optional
   remote none // optional
}

app StillMVP4 {
   name "Still"
   view Home // Root view
   design StillDesign // all object properties can be referenced by name, or like:
   datasource { // this, which inlines the declaration
      // a datasource is a data schema + configuration for where the data is provided from (e.g memory, instantdb, custom postgres, etc)
      data StillData // schema
      provider InstantDB with { // take the default InstantDB provider, and configure it with overrides
         appId "still-mvp4-local" // added: review whether datasource IDs belong here or in app/runtime targets.
      }
   }
}

app StillMVPNav = StillMVP4 with {
   nav StillRootNavigation
}

nav StillRootNavigation {} // Agent: Help me flesh this out

data StillData { // data schema
   type Description is text
   Tasks/Task { // entities are declared in their plural and singular
      // For this entity, IDs are assumed to be generated by the provider. (Must be supported in datasource def)
      Title text indexed // concise field syntax without `is`. Indexed (datasources using this schema must use a provider that supports text indexing)
      Done yes TBD no default no // instead of "boolean", we define two names - one for true, one for false. If value is true, then Done is true and TBD is false; otherwise Done is false and TBD is true.
      CreatedAt time indexed default now() // time type represents a moment in time
   }
}

design StillDesign {
   token whiteChalk #f6f7f3 // create named color token
   style screen [fill, pad 24, bg whiteChalk] // create named styles spec
   style stack [screen, gap 12] // create named styles spec by extending another
   font title { // create named typography token
      size 34
      weight 800
      color "#121826"
   }
   font body {
      size 16
      line 22
      color "#344054"
   }
   style primary [pad 12, radius 14, bg "#2f6b4f", body]
   style secondary [pad 12, radius 14, bg white, body, border "#d0d5dd"]
}

view Home {
   state Intent = "capture" // text literal infers type `text`
   state DraftTitle = StillData.Task.Title "" // Specify state type to that of the entity field

   render Screen [screen] {
      Stack [stack] {
         Text "Still" [title] // typematched prop to font
         Text "A calm place to catch what matters and choose the next step." [font body] // explicit named prop font
         Text when Intent is // TBD: I don't love this when inlined like this. But perhaps it's just nice to have as a possibility.
            "capture" -> "Ready to capture."
            otherwise -> "Ready to plan.", [body] // [body] could also have gone before `when Intent is ...`

         // Button "Capture" [Intent == "capture" ? primary : secondary] // TBD: Support ternary if/else? don't add yet, and research possible alternatives first if tackling this.
         TextInput DraftTitle, .Label "Task title", .Placeholder "Capture something", [secondary] // Since TextInput's .Label and .Placeholder have been type-specified, DraftTitle is the remaining value to type-resolve - which resolves to StillData.Task.Title if that conversion is type-valid.
            on submit -> Value text { set DraftTitle = StillData.Task.Title Value } // The value type can be specified at assignment
         Button "Save task" [primary]
            on press -> {
               create StillData.Task { Title DraftTitle } // Create a Task. Default Done and CreatedAt are filled by default.
            }
         Button "Plan"
            on longPress do action { // register an action statement "do <ACTION>" for event
               set Intent = "capture" // update state with "set"
               alias Foo = "foo" // aliases work in actions
               set Intent = "{Foo}"
            }
            // Short-hand `do action { ... }` form:
            on press -> { set Intent = "plan" } // one-line actions format to one line
}  }  } // multiple closing blocks are auto-formatted onto one line
