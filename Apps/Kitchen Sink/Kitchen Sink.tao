app KitchenSink {
    ui MainView
}

alias Greeting = "Hello, World!"
alias LaunchCount = 3

ui MainView {
    alias LocalText = "Text from a local alias"
    alias OuterGreeting = Greeting
    render Stack {
        alias Greeting = "Nested scope greeting"
        Text OuterGreeting { }
        Text LocalText
        Text Greeting
        Text "Hello World"
        CountText LaunchCount
    }
}

layout Stack {
    render inject ```ts
        return <RN.View style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
            {_ViewProps.children}
        </RN.View>
    ```
}

ui Text Value text {
    render inject Value ```ts
        return <RN.Text>{Value}</RN.Text>
    ```
}

ui CountText Count number {
    render inject Count ```ts
        return <RN.Text>Launch count: {Count}</RN.Text>
    ```
}
