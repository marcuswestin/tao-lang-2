use Button, Number, Stack, Text from @tao/ui

app KitchenSink {
   view MainView
}

alias Greeting = "Hello, World!"
alias LaunchCount = 3

type SinkName is text

type SinkTags is list

type SinkProfile is {
   SinkName
   SinkTags
}

alias FixedSinkName = SinkName "Fixed Kitchen type"
alias SinkProfileValue = SinkProfile {
   SinkName "Typed Kitchen"
   SinkTags ["item" "list" "type"]
}

view MainView {
   state KitchenCount = 0
   alias LocalText = "Text from a local alias"
   alias OuterGreeting = Greeting
   render Stack [gap 8, pad 12, fill] {
      alias Greeting = "Nested scope greeting"
      Text OuterGreeting { }
      Text LocalText
      Text Greeting
      Text "Hello World" [width fill]
      Text "Claimed space" [claim 2]
      CountText LaunchCount
      Text FixedSinkName
      Text SinkProfileValue.SinkName
      TagText SinkProfileValue.SinkTags
      Number KitchenCount
      Button "Add kitchen count", action {
         set KitchenCount += 1
}  }  }

view CountText Count is number {
   render inject Count ```ts
      return <RN.Text>Launch count: {Count}</RN.Text>
   ```
}

view TagText Tags is list {
   render inject Tags ```ts
      return <RN.Text>{Tags.join(', ')}</RN.Text>
   ```
}
