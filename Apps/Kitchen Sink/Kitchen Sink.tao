use AccessibilityPreferencesText, ActionSheetButton, AlertButton, AndroidPermissionText, AnimatedText, AppExitButton, AppStateText, AppearanceText, AsyncActionStatusText, BoundaryLoading, Button, ConfirmButton, CopyButton, DeferredButton, DisabledButton, DisabledToggleSwitch, EasingText, EmailInput, EmptyState, ErrorState, FeedbackButton, FormRoot, I18nText, Image, ImageStatusText, InputAccessoryBar, InputAccessoryText, KeyboardAvoidingStack, KeyboardDismissButton, LargeSpinner, LayoutAnimationButton, LinkButton, LoadingButton, LoadingState, LocationButton, MediaPickerButton, ModalOptionsText, ModalSheet, NativeColorText, NativeList, NavigationRoot, NetworkText, Number, NumericInput, OneTimeCodeInput, PanResponderText, PasswordInput, PhoneInput, PixelRatioText, PlatformText, RefreshStack, RefreshingText, ResourceMutationButton, ResourceText, SafeAreaPaddingText, SafeAreaStack, Screen, ScrollStack, SearchInput, SectionList, SecureDeleteButton, SecureSaveButton, ShareButton, Spinner, Stack, StatusBar, StorageSaveButton, StorageText, StyleSheetText, Text, TextArea, TextInput, ThemedStack, ToastButton, ToggleSwitch, ToggleValueText, URLInput, VibrationButton, ViewportText from @tao/ui

app KitchenSink {
   view MainView
}

alias Greeting = "Hello, World!"
alias LaunchCount = 3

type SinkName is text

type SinkTags is list

type SinkProfile is {
   SinkName
   SinkTags
}

alias FixedSinkName = SinkName "Fixed Kitchen type"
alias SinkProfileValue = SinkProfile {
   SinkName "Typed Kitchen"
   SinkTags ["item" "list" "type"]
}

view MainView {
   state KitchenCount = 0
   state KitchenName = "Kitchen input"
   alias LocalText = "Text from a local alias"
   alias OuterGreeting = Greeting
   action RenameKitchenName Next is text {
      set KitchenName = Next
   }
   action AddKitchenCount {
      set KitchenCount += 1
   }
   render Stack [gap 8, pad 12, fill] {
      alias Greeting = "Nested scope greeting"
      Text OuterGreeting { }
      Text LocalText
      Text Greeting
      Text "Hello World" [width fill]
      Text "Claimed space" [claim 2]
      CountText LaunchCount
      Text FixedSinkName
      Text SinkProfileValue.SinkName
      TagText SinkProfileValue.SinkTags
      Image "https://tao.dev/kitchen.png" [id kitchenImage, label "Kitchen image"]
      ImageStatusText { }
      IndicatorStatusText { }
      ResourceStatusText { }
      ResourceMutationStatusText { }
      ResourceText "Resource text row" [id kitchenResourceText, label "Kitchen resource text"]
      ResourceMutationButton "Mutate resource row" [id kitchenResourceMutationButton, label "Kitchen resource mutation button"]
      StorageText "Stored text row" [id kitchenStorageText, label "Kitchen storage text"]
      StorageSaveButton "Save stored text" [id kitchenStorageSaveButton, label "Kitchen storage save"]
      NetworkStatusText { }
      NetworkText { }
      NativeColorStatusText { }
      NativeColorText { }
      NativeListStatusText { }
      NativeList "Native list row" [id kitchenNativeList, label "Kitchen native list"]
      SectionList "Native section row" [id kitchenSectionList, label "Kitchen section list"]
      RefreshStack [height 80, width fill] {
         Text "Refresh stack bridge ready"
      }
      ScrollStack [height 80, width fill] {
         Text "Scrollable bridge ready"
      }
      KeyboardAvoidingStack [height 80, width fill] {
         Text "Keyboard avoiding bridge ready"
      }
      SafeAreaStack [height 80, width fill] {
         Text "Safe area stack bridge ready"
      }
      Screen [height 80, width fill] {
         Text "Screen bridge ready"
      }
      ModalSheet {
         Text "Modal sheet bridge ready"
      }
      PermissionsAndroidStatusText { }
      AndroidPermissionText { }
      AnimatedStatusText { }
      AnimatedText { }
      DeviceStatusText { }
      ViewportText { }
      EasingStatusText { }
      EasingText { }
      PixelRatioStatusText { }
      PixelRatioText { }
      PanResponderStatusText { }
      PanResponderText { }
      PlatformStatusText { }
      PlatformText { }
      I18nStatusText { }
      I18nText { }
      InputAccessoryStatusText { }
      InputAccessoryText { }
      SafeAreaStatusText { }
      SafeAreaPaddingText { }
      StatusBarStatusText { }
      StatusBar "Kitchen status bar" [id kitchenStatusBar, label "Kitchen status bar"]
      StyleSheetStatusText { }
      StyleSheetText { }
      ModalStatusText { }
      ModalOptionsText { }
      RefreshControlStatusText { }
      RefreshingText { }
      ToggleStatusText { }
      ToggleValueText { }
      BoundaryStatusText [id kitchenBoundaryStatus, label "Kitchen boundary status"] { }
      BoundaryLoading {
         Text "Boundary loading bridge ready"
      }
      NavigationRoot {
         Text "Navigation root bridge ready"
      }
      SurfaceStatusText { }
      ThemedStatusText { }
      ThemedStack {
         Text "Themed stack bridge ready"
      }
      FormRoot {
         Text "Form root bridge ready"
      }
      FormValidationStatusText { }
      AsyncActionStatusText { }
      PressableStateStatusText { }
      ClipboardStatusText { }
      LinkingStatusText { }
      FeedbackStatusText { }
      MediaStatusText { }
      SecureStoreStatusText { }
      LocationStatusText { }
      ShareStatusText { }
      ActionSheetIOSStatusText { }
      AlertStatusText { }
      KeyboardStatusText { }
      ToastAndroidStatusText { }
      VibrationStatusText { }
      InteractionManagerStatusText { }
      LayoutAnimationStatusText { }
      AppStateStatusText { }
      AppStateText { }
      AppearanceStatusText { }
      AppearanceText { }
      AccessibilityInfoStatusText { }
      AccessibilityPreferencesText { }
      BackHandlerStatusText { }
      TextInput KitchenName, RenameKitchenName [id kitchenNameInput, label "Kitchen name"]
      TextArea KitchenName, RenameKitchenName [id kitchenNotesInput, label "Kitchen notes"]
      PasswordInput KitchenName, RenameKitchenName [id kitchenPasswordInput, label "Kitchen password"]
      EmailInput KitchenName, RenameKitchenName [id kitchenEmailInput, label "Kitchen email"]
      SearchInput KitchenName, RenameKitchenName [id kitchenSearchInput, label "Kitchen search"]
      PhoneInput KitchenName, RenameKitchenName [id kitchenPhoneInput, label "Kitchen phone"]
      URLInput KitchenName, RenameKitchenName [id kitchenURLInput, label "Kitchen URL"]
      NumericInput KitchenName, RenameKitchenName [id kitchenNumericInput, label "Kitchen numeric"]
      OneTimeCodeInput KitchenName, RenameKitchenName [id kitchenCodeInput, label "Kitchen code"]
      Text KitchenName
      Number KitchenCount
      Button "Add kitchen count", AddKitchenCount [id addKitchenCount, label "Add kitchen count"]
      DisabledButton "Unavailable kitchen action" [id unavailableKitchenAction, label "Unavailable kitchen action"]
      LoadingButton "Saving kitchen" [id savingKitchenButton, label "Saving kitchen"]
      Spinner "Loading kitchen row" [id kitchenSpinner, label "Loading kitchen row"]
      LargeSpinner "Loading kitchen report" [id kitchenLargeSpinner, label "Loading kitchen report"]
      EmptyState "No kitchen orders" [id kitchenEmptyState, label "Kitchen empty state"]
      LoadingState "Loading kitchen state" [id kitchenLoadingState, label "Kitchen loading state"]
      ErrorState "Kitchen error" [id kitchenErrorState, label "Kitchen error state"]
      InputAccessoryBar "Kitchen accessory actions" [id kitchenInputAccessoryBar, label "Kitchen accessory actions"]
      ToggleSwitch "Kitchen toggle" [id kitchenToggleSwitch, label "Kitchen toggle"]
      DisabledToggleSwitch "Locked kitchen toggle" [id kitchenDisabledToggleSwitch, label "Locked kitchen toggle"]
      CopyButton "Copy kitchen token" [id kitchenCopyButton, label "Copy kitchen token"]
      FeedbackButton "Confirm kitchen tap" [id kitchenFeedbackButton, label "Confirm kitchen tap"]
      AlertButton "Alert kitchen" [id kitchenAlertButton, label "Alert kitchen"]
      ConfirmButton "Confirm kitchen" [id kitchenConfirmButton, label "Confirm kitchen"]
      KeyboardDismissButton "Hide kitchen keyboard" [id kitchenKeyboardDismissButton, label "Hide kitchen keyboard"]
      VibrationButton "Pulse kitchen device" [id kitchenVibrationButton, label "Pulse kitchen device"]
      MediaPickerButton "Choose kitchen image" [id kitchenMediaPickerButton, label "Choose kitchen image"]
      LocationButton "Locate kitchen" [id kitchenLocationButton, label "Locate kitchen"]
      ToastButton "Toast kitchen" [id kitchenToastButton, label "Toast kitchen"]
      LayoutAnimationButton "Animate kitchen layout" [id kitchenLayoutAnimationButton, label "Animate kitchen layout"]
      SecureSaveButton "Save kitchen secret action" [id kitchenSecureSaveButton, label "Save kitchen secret action"]
      SecureDeleteButton "Delete kitchen secret action" [id kitchenSecureDeleteButton, label "Delete kitchen secret action"]
      AppExitButton "Exit kitchen app" [id kitchenAppExitButton, label "Exit kitchen app"]
      DeferredButton "Defer kitchen work" [id kitchenDeferredButton, label "Defer kitchen work"]
      ActionSheetButton "Choose kitchen option" [id kitchenActionSheetButton, label "Choose kitchen option"]
      LinkButton "https://tao.dev/kitchen" [id kitchenLinkButton, label "Open kitchen URL"]
      ShareButton "Kitchen share message" [id kitchenShareButton, label "Share kitchen message"]
}  }

view CountText Count is number {
   render inject Count ```ts
      return <RN.Text>Launch count: {Count}</RN.Text>
   ```
}

view TagText Tags is list {
   render inject Tags ```ts
      return <RN.Text>{Tags.join(', ')}</RN.Text>
   ```
}

view IndicatorStatusText {
   render inject ```ts
      return (
        <>
          {TR.Indicator.Spinner({ size: 'small' })}
          <RN.Text>Indicator bridge ready</RN.Text>
        </>
      )
   ```
}

view ResourceStatusText {
   render inject ```ts
      const resource = TR.Resource.query({
        key: ['kitchen-sink-resource-status'],
        initialData: 'Resource bridge ready',
        load: async () => 'Resource bridge ready',
      })
      return <RN.Text>{resource.data}</RN.Text>
   ```
}

view ResourceMutationStatusText {
   render inject ```ts
      const mutation = TR.Resource.mutation({
        save: async () => 'Resource mutation saved',
      })
      return <RN.Text>Resource mutation {mutation.status}</RN.Text>
   ```
}

view NetworkStatusText {
   render inject ```ts
      const network = TR.Network.status()
      void network
      return <RN.Text>Network bridge ready</RN.Text>
   ```
}

view NativeColorStatusText {
   render inject ```ts
      const color = TR.NativeColor.platform('labelColor')
      void color
      return <RN.Text>Native color bridge ready</RN.Text>
   ```
}

view NativeListStatusText {
   render inject ```ts
      const key = TR.NativeList.itemKey('id')({ id: 'kitchen' }, 0)
      void key
      return <RN.Text>Native list bridge ready</RN.Text>
   ```
}

view PermissionsAndroidStatusText {
   render inject ```ts
      const permission = TR.PermissionsAndroid.permission('CAMERA')
      void permission
      return <RN.Text>Android permissions bridge ready</RN.Text>
   ```
}

view AnimatedStatusText {
   render inject ```ts
      const value = TR.Animated.value(0)
      const animation = TR.Animated.timing(value, { toValue: 1, duration: 150 })
      const action = TR.Animated.action(animation)
      void action
      return <RN.Text>Animated bridge ready</RN.Text>
   ```
}

