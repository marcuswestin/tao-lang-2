   ```
}

view PanResponderStatusText {
   render inject ```ts
      const responder = TR.PanResponder.create({
        onMoveShouldSetPanResponder: TR.PanResponder.shouldSet(false),
      })
      const handlers = TR.PanResponder.handlers(responder)
      void handlers
      return <RN.Text>PanResponder bridge ready</RN.Text>
   ```
}

