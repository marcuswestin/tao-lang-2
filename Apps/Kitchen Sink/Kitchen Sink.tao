view StatusBarStatusText {
   render inject ```ts
      return (
        <>
          {TR.StatusBar.Bar({ style: 'dark-content', backgroundColor: '#f8fafc' })}
          <RN.Text>Status bar bridge ready</RN.Text>
        </>
      )
   ```
}

view StyleSheetStatusText {
   render inject ```ts
      const styles = TR.StyleSheet.create({ text: { padding: TR.StyleSheet.hairlineWidth() } })
      const flat = TR.StyleSheet.flatten(styles.text)
      void flat
      return <RN.Text>StyleSheet bridge ready</RN.Text>
   ```
}

view ModalStatusText {
   render inject ```ts
      return (
        <>
          {TR.Modal.Root({
            animation: 'fade',
            visible: false,
            children: <RN.Text>Hidden kitchen modal</RN.Text>,
          })}
          <RN.Text>Modal bridge ready</RN.Text>
        </>
      )
   ```
}

view RefreshControlStatusText {
   render inject ```ts
      const refreshControl = TR.RefreshControl.Control({
        action: TR.RefreshControl.action(TR.Noop()),
        title: 'Refresh kitchen',
      })
      void refreshControl
      return <RN.Text>Refresh control bridge ready</RN.Text>
   ```
}

view ToggleStatusText {
   render inject ```ts
      return (
        <>
          {TR.Toggle.Control({ value: true })}
          <RN.Text>Toggle bridge ready</RN.Text>
        </>
      )
   ```
}

view BoundaryStatusText {
   render inject ```ts
      function Pending() {
        throw new Promise(() => undefined)
        return null
      }
      return (
        <TR.Boundary.Loading fallback={<RN.Text>Boundary recovered</RN.Text>}>
          <Pending />
        </TR.Boundary.Loading>
      )
   ```
}

view SurfaceStatusText {
   render inject ```ts
      return TR.Surface.Empty({
        title: 'No kitchen alerts',
        message: 'Default empty surface ready',
      })
   ```
}

view ThemedStatusText {
   render inject ```ts
      return (
        <TR.Style.Provider palette={{ accent: '#059669', surface: '#ecfdf5', border: '#34d399' }}>
          {TR.Surface.Empty({ title: 'Themed bridge ready' })}
        </TR.Style.Provider>
      )
   ```
}

view FormValidationStatusText {
   render inject ```ts
      const form = TR.Form.use({ defaultValues: { kitchen: '' } })
      const kitchen = TR.Form.textField(form, 'kitchen', { required: 'Kitchen form required' })
      const submit = TR.Form.submitAction(form, TR.NoopAction())
      return (
        <>
          {TR.Views.TextInput(
            {
              __tao: _ViewProps.__tao,
              value: kitchen.value,
              placeholder: 'Kitchen form value',
              onBlur: TR.Form.textBlurAction(kitchen),
              onChangeText: TR.Form.textInputAction(kitchen),
            },
            { nativeProps: { accessibilityLabel: 'Kitchen form value' } },
          )}
          {TR.Views.Pressable({ title: 'Validate kitchen form', action: submit }, {
            nativeProps: { accessibilityRole: 'button' },
          })}
          {kitchen.error ? <RN.Text>{kitchen.error}</RN.Text> : null}
        </>
      )
   ```
}

view PressableStateStatusText {
   render inject ```ts
      return TR.Views.Pressable(
        {
          title: 'Save kitchen action',
          loadingTitle: 'Saving kitchen action',
          loading: true,
          action: TR.NoopAction(),
        },
        { nativeProps: { accessibilityRole: 'button' } },
      )
   ```
}

