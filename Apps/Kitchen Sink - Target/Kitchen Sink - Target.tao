app KitchenSink {
    ui MainView
}

alias Greeting = "Hello, World!"
alias LaunchCount = 3

ui MainView {
    render Stack {
        render Text Greeting { }
        render StatTile "Launch count", LaunchCount { }
    }
}

ui Stack {
    render inject ```ts
        return <>{_ViewProps.children}</>
    ```
}

ui Text Value text {
    render inject Value ```ts
        return <RN.Text>{Value}</RN.Text>
    ```
}

ui StatTile Label text, Count number {
    render inject Label, Count ```ts
        return <RN.Text>{Label}: {Count}</RN.Text>
    ```
}
