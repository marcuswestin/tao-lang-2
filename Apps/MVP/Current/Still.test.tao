use Still, StillData from ./

test "Still functional MVP" {
   check "starts empty and keeps invalid creates inert" {
      run Still

      expect text "Still"
      expect text "No workspaces yet"
      expect text "Workspace name is required"
      expect placeholder "Home"
      expect input placeholder "Home" value ""
      press id "add-workspace"
      submit placeholder "Home"
      expect text "No workspaces yet"
   }

   check "uses live workspaces and preserves covered screen state" {
      run Still
      enter "Home" into placeholder "Home"
      submit placeholder "Home"
      expect text "Home"
      enter "Unsent workspace" into placeholder "Home"
      press id "open-workspace-Workspace-1"
      expect text "Workspace: Home"
      expect input label "Workspace title" value "Home"
      enter "" into label "Workspace title"
      submit label "Workspace title"
      expect text "Workspace: Home"
      enter "Renamed workspace" into label "Workspace title"
      press id "save-workspace"
      expect text "Workspace: Renamed workspace"
      expect text "No open tasks"
      back
      expect text "Still"
      expect text "Renamed workspace"
      expect input placeholder "Home" value "Unsent workspace"
      expect missing text "Workspace: Renamed workspace"
   }

   check "edits a related task on its own live destination" {
      run Still
      enter "Home" into placeholder "Home"
      press id "add-workspace"
      press id "open-workspace-Workspace-1"
      submit placeholder "Plan the next step"
      expect text "No open tasks"
      enter "Plan the launch" into placeholder "Plan the next step"
      submit placeholder "Plan the next step"
      expect text "Plan the launch"
      expect text "Open tasks: 1"
      press id "open-task-Task-2"
      expect text "Edit task"
      expect text "Workspace: Home"
      expect input label "Task title" value "Plan the launch"
      enter "" into label "Task title"
      submit label "Task title"
      expect text "Saved title: Plan the launch"
      enter "Ship the launch" into label "Task title"
      enter "Coordinate the release" into placeholder "Notes for this task"
      press id "save-task"
      expect text "Saved title: Ship the launch"
      expect text "Saved notes: Coordinate the release"
      back
      expect text "Ship the launch"
      press id "complete-task-Task-2"
      expect text "Open tasks: 0"
      expect text "No open tasks"
      expect text "Completed"
      expect text "Ship the launch"
      press id "delete-completed-task-Task-2"
      expect text "No completed tasks"
   }

   check "deletes related tasks transitively with their workspace" {
      run Still
      enter "Temporary" into id "workspace-name"
      press id "add-workspace"
      press id "open-workspace-Workspace-1"
      enter "Related task" into id "new-task-title"
      press id "add-task"
      expect text "Related task"
      back
      press id "delete-workspace-Workspace-1"
      expect text "No workspaces yet"
      enter "Replacement" into id "workspace-name"
      press id "add-workspace"
      press id "open-workspace-Workspace-3"
      expect missing text "Related task"
      expect text "No open tasks"
   }

   check "renders deterministic loading, failure, and recovery states" {
      run Still
      data StillData loading
      expect text "Loading workspaces…"
      expect missing text "Workspace name is required"
      data StillData error "Local storage is unavailable"
      expect text "Could not load Still"
      expect text "Local storage is unavailable"
      data StillData ready
      expect text "No workspaces yet"
      expect text "Workspace name is required"
   }
}
