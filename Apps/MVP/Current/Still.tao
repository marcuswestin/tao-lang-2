use Button, Col, Number, Text from @tao/ui

project {
   name "Still MVP Current"
   remote none
   license MIT
}

app StillCurrent {
   view Home
}

type WorkspaceName is text

let InboxName = WorkspaceName "Inbox"

view Home {
   state CaptureCount = 0
   action Capture {
      set CaptureCount += 1
   }
   render Col() [fill, gap 8, pad 12] {
      Text("Still")
      Text(InboxName)
      Text("Capture what matters.")
      Number(CaptureCount)
      Button("Capture", Capture)
}  }
