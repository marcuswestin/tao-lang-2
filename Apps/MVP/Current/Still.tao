use Col, FormButton, Text, TextInput from @tao/ui

project {
   name "Still"
   remote none
   license MIT
}

app Still {
   datasource StillData through Local
   stack StillNavigation
}

project data StillData {
   Workspaces Workspace {
      Name text
      CreatedAt time indexed default now()
   }
   Tasks Task {
      Title text
      Body text default ""
      Done boolean default false
      CreatedAt time indexed default now()
      Workspace relation Workspace on delete cascade
}  }

project stack StillNavigation {
   initial WorkspaceList
   destination WorkspaceList
   destination WorkspaceDetail
   destination TaskDetail
}

project view WorkspaceList {
   state WorkspaceDraft = ""
   query StillData.Workspaces as Workspaces {
      order by CreatedAt asc
   }
   action ChangeWorkspaceDraft Value is text {
      set WorkspaceDraft = Value
   }
   action AddWorkspace {
      when
         WorkspaceDraft.Empty -> { }
         otherwise -> {
            create StillData.Workspace {
               Name WorkspaceDraft
            }
            set WorkspaceDraft = ""
   }  }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text("Still")
      Text("A quiet place for work that matters.")
      when
         Workspaces.Loading -> {
            Text("Loading workspaces…")
         }
         not Workspaces.Error.Empty -> {
            Text("Could not load Still")
            Text(Workspaces.Error)
         }
         otherwise -> {
            TextInput(.Value WorkspaceDraft, .Change ChangeWorkspaceDraft, .Submit AddWorkspace, .Label "Workspace name", .Placeholder "Home", .Id "workspace-name")
            when
               WorkspaceDraft.Empty -> {
                  Text("Workspace name is required")
               }
               otherwise -> {
                  Text(WorkspaceDraft)
               }
            FormButton(.Title "Add workspace", .Press AddWorkspace, .Id "add-workspace", .Disabled WorkspaceDraft.Empty)
            when
               Workspaces.Empty -> {
                  Text("No workspaces yet")
                  Text("Create one to start capturing tasks.")
               }
               otherwise -> {
                  for Workspace in Workspaces {
                     Col() [gap 6, pad 10] {
                        Text(Workspace.Name)
                        FormButton(.Title "Open workspace", .Press action { present StillNavigation.WorkspaceDetail(.Workspace Workspace) }, .Id (interpolate "open-workspace-", Workspace.Id))
                        FormButton(.Title "Delete workspace", .Press action { delete Workspace }, .Id (interpolate "delete-workspace-", Workspace.Id))
}  }  }  }  }  }

project view WorkspaceDetail Workspace is StillData.Workspace {
   state WorkspaceNameDraft = Workspace.Name
   state TaskDraft = ""
   query StillData.Tasks as OpenTasks {
      where Workspace == Workspace
      where Done == false
      order by CreatedAt asc
   }
   query StillData.Tasks as CompletedTasks {
      where Workspace == Workspace
      where Done == true
      order by CreatedAt asc
   }
   action ChangeTaskDraft Value is text {
      set TaskDraft = Value
   }
   action ChangeWorkspaceNameDraft Value is text {
      set WorkspaceNameDraft = Value
   }
   action SaveWorkspace {
      when
         WorkspaceNameDraft.Empty -> { }
         otherwise -> {
            update Workspace {
               Name WorkspaceNameDraft
   }  }  }
   action AddTask {
      when
         TaskDraft.Empty -> { }
         otherwise -> {
            create StillData.Task {
               Title TaskDraft
               Workspace Workspace
            }
            set TaskDraft = ""
   }  }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text(interpolate "Workspace: ", Workspace.Name)
      TextInput(.Value WorkspaceNameDraft, .Change ChangeWorkspaceNameDraft, .Submit SaveWorkspace, .Label "Workspace title", .Placeholder "Workspace title", .Id "workspace-title")
      FormButton(.Title "Save workspace", .Press SaveWorkspace, .Id "save-workspace", .Disabled WorkspaceNameDraft.Empty)
      Text(interpolate "Open tasks: ", OpenTasks.Count)
      when
         OpenTasks.Loading or CompletedTasks.Loading -> {
            Text("Loading tasks…")
         }
         not OpenTasks.Error.Empty -> {
            Text("Could not load tasks")
            Text(OpenTasks.Error)
         }
         not CompletedTasks.Error.Empty -> {
            Text("Could not load tasks")
            Text(CompletedTasks.Error)
         }
         otherwise -> {
            TextInput(.Value TaskDraft, .Change ChangeTaskDraft, .Submit AddTask, .Label "New task title", .Placeholder "Plan the next step", .Id "new-task-title")
            when
               TaskDraft.Empty -> {
                  Text("Task title is required")
               }
               otherwise -> {
                  Text(TaskDraft)
               }
            FormButton(.Title "Add task", .Press AddTask, .Id "add-task", .Disabled TaskDraft.Empty)
            when
               OpenTasks.Empty -> {
                  Text("No open tasks")
               }
               otherwise -> {
                  for Task in OpenTasks {
                     Col() [gap 6, pad 10] {
                        Text(Task.Title)
                        FormButton(.Title "Edit task", .Press action { present StillNavigation.TaskDetail(.Task Task) }, .Id (interpolate "open-task-", Task.Id))
                        FormButton(.Title "Complete task", .Press action { update Task {
                           Done true
                        } }, .Id (interpolate "complete-task-", Task.Id))
                        FormButton(.Title "Delete task", .Press action { delete Task }, .Id (interpolate "delete-open-task-", Task.Id))
               }  }  }
            when
               CompletedTasks.Empty -> {
                  Text("No completed tasks")
               }
               otherwise -> {
                  Text("Completed")
                  for Task in CompletedTasks {
                     Col() [gap 6, pad 10] {
                        Text(Task.Title)
                        FormButton(.Title "Reopen task", .Press action { update Task {
                           Done false
                        } }, .Id (interpolate "reopen-task-", Task.Id))
                        FormButton(.Title "Delete completed task", .Press action { delete Task }, .Id (interpolate "delete-completed-task-", Task.Id))
}  }  }  }  }  }

project view TaskDetail Task is StillData.Task {
   state TitleDraft = Task.Title
   state BodyDraft = Task.Body
   action ChangeTitleDraft Value is text {
      set TitleDraft = Value
   }
   action ChangeBodyDraft Value is text {
      set BodyDraft = Value
   }
   action SaveTask {
      when
         TitleDraft.Empty -> { }
         otherwise -> {
            update Task {
               Title TitleDraft
               Body BodyDraft
   }  }  }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text("Edit task")
      Text(interpolate "Workspace: ", Task.Workspace.Name)
      TextInput(.Value TitleDraft, .Change ChangeTitleDraft, .Submit SaveTask, .Label "Task title", .Placeholder "Task title", .Id "edit-task-title")
      TextInput(.Value BodyDraft, .Change ChangeBodyDraft, .Submit SaveTask, .Label "Task notes", .Placeholder "Notes for this task", .Id "edit-task-notes")
      FormButton(.Title "Save task", .Press SaveTask, .Id "save-task", .Disabled TitleDraft.Empty)
      Text(interpolate "Saved title: ", Task.Title)
      Text(interpolate "Saved notes: ", Task.Body)
}  }
