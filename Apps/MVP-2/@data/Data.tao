data StillData {
   type CaptureKind is enum {
      "note",
      "task",
   }

   type TaskStatus is enum {
      "open",
      "done",
   }

   type FocusTone is enum {
      "calm",
      "clear",
   }

   Workspaces/Workspace {
      Title is text indexed,
      Summary is text,
      Slug is text unique indexed,
      Pinned is boolean indexed default false,
      Ordering is number indexed,
      Focus is FocusTone indexed default "calm",
      Notes,
      Tasks,
   }

   Notes/Note {
      Workspace,
      Title is text indexed,
      Body is text,
      Mood is FocusTone indexed default "clear",
      Pinned is boolean indexed default false,
      Archived is boolean indexed default false,
      CreatedAt is number indexed,
      UpdatedAt is number indexed,
      RelatedTasks is Tasks,
   }

   Tasks/Task {
      Workspace,
      SourceNote is Note optional,
      Title is text indexed,
      Done is boolean indexed default false,
      Status is TaskStatus indexed default "open",
      Intent is text indexed default "next",
      Ordering is number indexed,
      CreatedAt is number indexed,
      UpdatedAt is number indexed,
   }
}

project alias DefaultWorkspaceTitle = StillData.Workspace.Title "Inbox"
project alias DefaultWorkspaceSummary = StillData.Workspace.Summary "One quiet place for the thoughts and next actions that should not run your day."
project alias DefaultWorkspaceSlug = StillData.Workspace.Slug "inbox"
project alias DefaultWorkspaceOrdering = StillData.Workspace.Ordering 1

datasource StillLocalDatasource {
   data StillData
   provider Memory

   appId "still-mvp-local"
}
