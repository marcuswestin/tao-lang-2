use RuntimeShowcase from @ui/showcase
use StillCompleteDesign from ./DesignSystem
use StagingTarget, ProductionTarget from ./Capabilities

project scaffold StillCompleteScaffold {
      tao create "still-complete" {
         template default project
         packages @data, @ui, @nav, @theme, @assets, @permissions
         design preview true
   }
}

project dev StillCompleteDev {
   tao dev {
      app switching true
      watch imports all
      ios device lan true
      android true
      web true
      staging target StagingTarget
      production target ProductionTarget
      ide live preview true
      goToDefinition true
      references true
      sourceActions importOrganization, renameSymbol
   }
}

project test StillCompleteTest {
   tao test "." {
      grep "runtime"
      watch true
      json true
      failFast true
      runtime web, ios, android
      headless true
      packages true
   }
}

project showcase CompleteKitchenSink {
   include KitchenSink
   include RuntimeShowcase
   include StillCompleteDesign
}
