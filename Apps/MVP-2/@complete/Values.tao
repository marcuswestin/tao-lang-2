use StillData from @data
use StillStrings from ./Capabilities

type Priority is enum {
   "low",
   "normal",
   "high",
}

type PriorityList is [Priority]

type CaptureFlags is item {
   Pinned is boolean optional
   Offline is boolean optional
}

type Searchable is like {
   Title is text
   UpdatedAt is number
}

type CaptureTarget is StillData.Note | StillData.Task

type EnhancedTask is StillData.Task + {
   Priority
   Tags is [text] optional
}

alias BooleanTruth = true
alias BooleanFalsehood = false
alias DefaultPriorities = PriorityList ["normal", "high"]
alias CaptureDefaults = CaptureFlags {
   Pinned false
   Offline true
}
alias ExplicitItem = {
   Title StillData.Note.Title "Standalone item"
   UpdatedAt 0
}
alias ExplicitList = [StillData.Task.Intent "next", StillData.Task.Intent "follow-up"]
alias DefaultWorkspace = StillData.Workspace {
   Title StillData.Workspace.Title "Overlay workspace"
   Summary StillData.Workspace.Summary "Used by complete value examples."
   Slug StillData.Workspace.Slug "overlay-workspace"
   Ordering StillData.Workspace.Ordering 3
}
alias OverlayedTask = StillData.Task {
   Title StillData.Task.Title "Overlay base"
   Workspace DefaultWorkspace
} with {
   Intent StillData.Task.Intent "later"
}
alias StringKey = strings.home.capture
alias StringKeyReplacement = StillStrings.home.capture
alias MergedTags = ["local", "typed"] + ["offline"]
alias RemovedTags = MergedTags - ["typed"]
alias AppendedTags = MergedTags append "quiet"
alias WithoutQuiet = AppendedTags remove "quiet"

function HasOffline FlagSet CaptureFlags {
   return FlagSet has Offline
}

function PriorityLabel Priority {
   match Priority {
      "low" -> "Low"
      "normal" -> "Normal"
      "high" -> "High"
   }
}

function TypeRelationLabel Value Searchable {
   return when Value is Searchable -> "searchable" otherwise -> "unknown"
}

function RepeatText Value text, Count number {
   return Value * Count
}

function JoinTitle Title StillData.Note.Title, Suffix text {
   return Title + Suffix
}

function IsSearchable Value {
   return Value is Searchable
}
