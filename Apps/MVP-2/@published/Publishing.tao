requires @tao/ui >= 1.0
requires @still/analytics >= 0.4

use RuntimeShowcase from @ui/showcase
use StillDesign from @ui
use RemoteTrendCard from @still/analytics

publish package StillMVPKit {
   exports StillDesign
   exports RuntimeShowcase
   exports RemoteTrendCard
}

publish app StillMVPRelease {
   installName "@ro/still-mvp"
   package StillMVPKit
   channel public
}

project app InstalledStillMVP = install @ro/still-mvp "1.0.0" {
   datasource appId "still-mvp-installed"
}
