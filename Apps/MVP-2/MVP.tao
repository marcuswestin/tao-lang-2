requires @tao/ui >= 1.0
requires @still/analytics >= 0.4

use StillLocalDatasource from @data
use StillRootNavigation from @nav
use StillAssets from @assets
use StillPermissions from @permissions
use StillTheme from @theme
use StillStrings, StillLocale, ProductionTarget, AppStoreBuild, StillSecrets from @complete/Capabilities
use StillCompleteDesign from @complete/DesignSystem
use StillClock from @complete/Events
use StillDeepLinks, PreviewRoutes from @complete/NavigationRuntime
use StillScenarioCheck from @complete/Scenarios
use StillCompleteDev, CompleteKitchenSink from @complete/Tooling

project {
   name "Still MVP"
   tagline "A calm local command center for notes, tasks, and the next right thing."
   remote none
   license MIT
}

project app StillMVP {
   design StillCompleteDesign
   theme StillTheme
   assets StillAssets
   permissions StillPermissions
   strings StillStrings
   locale StillLocale
   datasource StillLocalDatasource
   runtime ProductionTarget
   build AppStoreBuild
   secrets StillSecrets
   navigator StillRootNavigation
   deepLinks StillDeepLinks
   routes PreviewRoutes
   automation StillClock
   scenarios StillScenarioCheck
   dev StillCompleteDev
   showcase CompleteKitchenSink

   on push notification -> Notification { navigation tab Capture }

   on network failure -> Failure { navigation tab Settings }
}
