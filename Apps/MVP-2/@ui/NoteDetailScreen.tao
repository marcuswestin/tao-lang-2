use Badge, Button, Row, Stack, Text, Toggle from @tao/ui
use StillData from @data
use AppShell, EmptyState, ErrorState, HeroPanel, LoadingState, Section, TaskRow

project screen NoteDetailScreen Note {
   query Note as CurrentNote {
      Title, Body, Mood, Pinned, Archived, UpdatedAt,
      Workspace {
         Title, Slug,
      },
      RelatedTasks {
         Title, Done, Status, Intent,
      }
   }

   action AddFollowUpTask {
      create StillData.Task {
         Workspace CurrentNote.Workspace,
         SourceNote CurrentNote,
         Title StillData.Task.Title "Follow up on ${ CurrentNote.Title }",
         Intent "follow-up",
         Ordering CurrentNote.RelatedTasks.count + 1,
         CreatedAt now(),
         UpdatedAt now(),
      }
   }

   action ArchiveNote {
      update CurrentNote {
         Archived true,
         UpdatedAt now(),
      }
      navigation pop
   }

   guard CurrentNote when
      loading -> AppShell "Note", "Opening" {
         LoadingState "Opening note..."
      }
      missing -> AppShell "Note", "Missing" {
         ErrorState "That note is not available anymore.", -> navigation tab Today
      }

   render AppShell CurrentNote.Title, CurrentNote.Workspace.Title {
      HeroPanel {
         Row [rowSpread] {
            Stack [gap sm, width fill] {
               Badge CurrentNote.Mood [badge]
               Text CurrentNote.Body [body]
            }
            Toggle CurrentNote.Pinned, .Label "Toggle pinned note", [badge]
               on change -> Value boolean {
                  update CurrentNote {
                     Pinned Value,
                     UpdatedAt now(),
                  }
               }
         }
      }

      Row [actionRow] {
         Button "Pin", .Label "Toggle pinned note", [secondaryAction, width fill, selected CurrentNote.Pinned]
            on press -> {
               update CurrentNote {
                  Pinned not CurrentNote.Pinned,
                  UpdatedAt now(),
               }
            }
         Button "Add follow-up", .Label "Add follow-up task", [primaryAction, width fill]
            on press -> { do AddFollowUpTask }
         Button "Archive", .Label "Archive note", [dangerAction, width fill]
            on press -> { do ArchiveNote }
      }

      Section "Related tasks" {
         if CurrentNote.RelatedTasks.Empty {
            EmptyState "No tasks are connected to this note yet."
         } else {
            Stack [sectionStack] {
               for Task in CurrentNote.RelatedTasks {
                  TaskRow Task
               }
            }
         }
      }
   }
}
