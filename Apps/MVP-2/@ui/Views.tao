use Badge, Button, Checkbox, Col, Icon, Row, Screen, Stack, Text, WrappingRow from @tao/ui
use StillData from @data

project alias PlatformName = inject text ```ts
   return RN.Platform.OS
```

package function CountLabel Count number {
   return when Count = 0 -> "None yet" otherwise -> "${ Count } saved"
}

package function CaptureActionTitle Kind StillData.CaptureKind {
   return when Kind = "task" -> "Save task" otherwise -> "Save note"
}

package function DraftEditLabel Count number {
   return when Count = 0 -> "Draft untouched" otherwise -> "Draft changed ${ Count } times"
}

package function DoneLabel Done boolean {
   return when Done -> "Done" otherwise -> "Open"
}

project layout AppShell Title text, Eyebrow text = "Still" {
   render Screen [screen] {
      Col [shell] {
         Row [shellHeader] {
            Stack [gap xs] {
               Text Eyebrow [quiet]
               Text Title [display]
            }
            Icon "leaf" [badge]
         }
         @@content
      }
   }
}

project layout HeroPanel {
   render Stack [hero, heroGlow] {
      @@content
   }
}

project layout Section Title text {
   render Stack [sectionStack] {
      Row [sectionHeader] {
         Text Title [section]
         @@actions
      }
      @@content
   }
}

project view WorkspaceCard Workspace {
   render Stack [workspaceCard] {
      Row [rowSpread] {
         Stack [gap xs, width fill] {
            Text Workspace.Title [label]
            Text Workspace.Summary [body]
            WrappingRow [gap xs] {
               Badge "${ Workspace.Notes.count } notes" [badgeMuted]
               Badge "${ Workspace.Tasks.count } tasks" [badgeMuted]
            }
         }
         Button "Open", .Label "Open workspace ${ Workspace.Title }", [quietAction, width hug]
            on press -> {
               navigation push WorkspaceDetail {
                  Workspace Workspace,
               }
            }
      }
   }
}

project view NoteRow Note {
   render Stack [noteCard] {
      Row [rowSpread] {
         Stack [gap xs, width fill] {
            Text Note.Title [label]
            Text Note.Body [body]
            Badge Note.Mood [badgeMuted]
         }
         Stack [gap xs, width hug] {
            Button "Open", .Label "Open note ${ Note.Title }", [quietAction]
               on press -> {
                  navigation push NoteDetail {
                     Note Note,
                  }
               }
            Button "Archive", .Label "Archive note ${ Note.Title }", [dangerAction]
               on press -> {
                  update Note {
                     Archived true,
                     UpdatedAt now(),
                  }
               }
         }
      }
   }
}

project view TaskRow Task {
   render Row [Task.Done ? taskDone : taskCard] {
      Checkbox Task.Done
      Stack [gap xs, width fill] {
         Text Task.Title [label]
         Row [gap xs] {
            Badge call DoneLabel Task.Done [badge]
            Badge Task.Intent [badgeMuted]
         }
      }
      Row [gap xs, width hug] {
         Button "Toggle", .Label "Toggle task ${ Task.Title }", [quietAction]
            on press -> {
               update Task {
                  Done not Task.Done,
                  Status when not Task.Done -> "done" otherwise -> "open",
                  UpdatedAt now(),
               }
            }
         Button "Edit", .Label "Edit task ${ Task.Title }", [secondaryAction]
            on press -> {
               navigation push TaskEdit {
                  Task Task,
               }
            }
      }
   }
}

project view EmptyState Message text {
   render Stack [empty] {
      Icon "sparkles" [badge]
      Text Message [body]
   }
}

project view LoadingState Message text {
   render Row [loading, role status] {
      Icon "loader" [spin]
      Text Message [body]
   }
}

project view ErrorState Message text, RetryAction action {
   render Stack [error, role alert] {
      Text Message [body]
      Button "Try again", .Label "Retry loading", [secondaryAction, width fill]
         on press -> { do RetryAction }
   }
}
