use Button, Icon, Number, Row, Stack, Text, WrappingRow from @tao/ui
use DefaultWorkspaceOrdering, DefaultWorkspaceSlug, DefaultWorkspaceSummary, DefaultWorkspaceTitle, StillData from @data
use AppShell, CountLabel, EmptyState, ErrorState, HeroPanel, LoadingState, NoteRow, PlatformName, Section, TaskRow, WorkspaceCard
use WorkloadScore from @logic

project screen DashboardScreen {
   state ShowDone = false

   query StillData.Workspaces as Workspaces {
      Title, Summary, Slug, Pinned, Ordering, Focus,
      Notes {
         Title, Body, Mood, Pinned, Archived, UpdatedAt,
         where Archived = false
         order by UpdatedAt desc
      },
      Tasks {
         Title, Done, Status, Intent, Ordering,
         where Done = ShowDone or Done = false
         order by Ordering asc
      },
      order by Ordering asc
   }

   query StillData.Notes as RecentNotes {
      Title, Body, Mood, Pinned, Archived, UpdatedAt,
      Workspace {
         Title,
      },
      where Archived = false
      order by UpdatedAt desc
   }

   query StillData.Tasks as OpenTasks {
      Title, Done, Status, Intent, Ordering,
      Workspace {
         Title,
      },
      where Done = false
      order by Ordering asc
   }

   action CreateInboxWorkspace {
      create StillData.Workspace {
         Title DefaultWorkspaceTitle,
         Summary DefaultWorkspaceSummary,
         Slug DefaultWorkspaceSlug,
         Pinned true,
         Ordering DefaultWorkspaceOrdering,
      }
   }

   guard Workspaces when
      loading -> AppShell "Still", "Today" {
         LoadingState "Loading your quiet workspace..."
      }
      error -> AppShell "Still", "Today" {
         ErrorState "Still could not load your local workspace.", -> do CreateInboxWorkspace
      }

   render AppShell "Still", "Today" {
      HeroPanel {
         Row [rowSpread] {
            Stack [gap sm, width fill] {
               Text "Local first" [section]
               Text "Make the day readable" [display]
               Text "Capture the stray thought, connect it to one next action, and come back to the work with less noise." [body]
            }
            Icon "sunrise" [badge]
         }

         WrappingRow [metricRow] {
            Stack [metricTile] {
               Text "Notes" [quiet]
               Number RecentNotes.count [metric]
               Text call CountLabel RecentNotes.count [quiet]
            }
            Stack [metricTile] {
               Text "Open tasks" [quiet]
               Number OpenTasks.count [metric]
               Text "next actions" [quiet]
            }
            Stack [metricTile] {
               Text "Runtime" [quiet]
               Text PlatformName [label]
               Text "Expo target" [quiet]
            }
            Stack [metricTile] {
               Text "Focus score" [quiet]
               Number call WorkloadScore OpenTasks.count, RecentNotes.count [metric]
               Text "weighted" [quiet]
            }
         }
      }

      Row [actionRow] {
         Button "Capture something", .Label "Capture tab", [primaryAction, width fill]
            on press -> { navigation tab Capture }
         Button "Show done", .Label "Toggle done tasks", [secondaryAction, width hug, selected ShowDone]
            on press -> { toggle ShowDone }
      }

      Section "Workspaces" {
         actions {
            Button "New inbox", .Label "Create first workspace", [quietAction]
               on press -> { do CreateInboxWorkspace }
         }

         if Workspaces.Empty {
            EmptyState "Nothing captured yet. Create the inbox workspace, then save a note or task."
         } else {
            Stack [sectionStack] {
               for Workspace in Workspaces {
                  WorkspaceCard Workspace
               }
            }
         }
      }

      Section "Recent notes" {
         if RecentNotes.Empty {
            EmptyState "No notes yet. Capture one thought before it disappears."
         } else {
            Stack [sectionStack] {
               for Note in RecentNotes {
                  NoteRow Note
               }
            }
         }
      }

      Section "Open tasks" {
         if OpenTasks.Empty {
            EmptyState "No open tasks. Add one next action when the note asks for it."
         } else {
            Stack [sectionStack] {
               for Task in OpenTasks {
                  TaskRow Task
               }
            }
         }
      }
   }
}
