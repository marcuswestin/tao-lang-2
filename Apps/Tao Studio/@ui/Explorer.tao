view ProjectViewsPanel() {
   query ProjectViews = Views
   render StudioPanelSurface("Project views") {
      guard ProjectViews {
         loading -> { Text("Loading compiled views…") }
         error -> Context { Text(Context.Message) }
      }
      loop ProjectViews / View {
         ProjectViewRow(View)
}  }  }

