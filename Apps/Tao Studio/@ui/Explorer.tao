view ComponentPaletteItem(Name text, Label text, Kind text) {
   action Insert() {
      do InsertComponent(Name)
   }
   render StudioPaletteRow(Label: Label, Detail: Kind, Kind: "component", Name: Name, Insert: Insert)
}

