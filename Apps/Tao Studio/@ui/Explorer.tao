view FilesPanel(CollapsedFolders list of text, ToggleFolder action(text)) {
   state NewPath = ""
   action Create() {
      do CreateFile(NewPath)
      set NewPath = ""
   }
   action ChangeNewPath(Value text) {
      set NewPath = Value
   }
   render FilesPanelSurface() {
      FileCreateBar(NewPath, ChangeNewPath, Create)
      FileTree(FolderPath: "", CollapsedFolders: CollapsedFolders, ToggleFolder: ToggleFolder)
}  }

view FilesPanelSurface() accepts content from ../../../packages/ides/studio/studio-src/TaoStudioProductHost.tsx

view FileCreateBar(Path text, Change action(text), Create action()) from ../../../packages/ides/studio/studio-src/TaoStudioProductHost.tsx

// Disclosure stays Studio-local: Tao has no generic tree construct. The app owns its device-local
// collapsed-path set, so recursive occurrences have explicit stable identity without ambient state.
view Disclosure(Label text, FolderPath text, CollapsedFolders list of text, ToggleFolder action(text)) {
   let Expanded = StudioFolderIsExpanded(CollapsedFolders, FolderPath)
   action Toggle() {
      do ToggleFolder(FolderPath)
   }
   render TreeFolder(Label, Expanded, Toggle) {
      when Expanded {
         true -> { @@content }
         otherwise -> { }
}  }  }

view TreeFolder(Label text, Expanded boolean, Toggle action()) accepts content from ../../../packages/ides/studio/studio-src/TaoStudioProductHost.tsx

view FileTree(FolderPath text, CollapsedFolders list of text, ToggleFolder action(text)) {
   query Children = Files with {
      where ParentPath == FolderPath
   }
   render Col() {
      guard Children {
         loading -> { Text("Loading Studio files…") }
         error -> Context { Text(Context.Message) }
      }
      loop Children / File {
         when File.Folder {
            true -> { Disclosure(Label: File.Name, FolderPath: File.Path, CollapsedFolders: CollapsedFolders, ToggleFolder: ToggleFolder) {
               FileTree(FolderPath: File.Path, CollapsedFolders: CollapsedFolders, ToggleFolder: ToggleFolder)
            } }
            otherwise -> { FileRow(File) }
}  }  }  }

view FileRow(File) {
   state RenamePath = File.Path
   state Renaming = false
   state ConfirmDelete = false
   state Moving = false
   state TargetPackage = ""
   state RelocateScenarios = true
   action Open() {
      do OpenFile(File.Path)
   }
   action ChangeRenamePath(Value text) {
      set RenamePath = Value
   }
   action BeginRename() {
      set ConfirmDelete = false
      set Moving = false
      set Renaming = true
   }
   action CancelRename() {
      set RenamePath = File.Path
      set Renaming = false
   }
   action Rename() {
      do RenameFile(Path: File.Path, SourceVersion: File.Version, TargetPath: RenamePath)
      set Renaming = false
   }
   action BeginDelete() {
      set Renaming = false
      set Moving = false
      set ConfirmDelete = true
   }
   action CancelDelete() {
      set ConfirmDelete = false
   }
   action Delete() {
      do DeleteFile(Path: File.Path, SourceVersion: File.Version)
   }
   action BeginMove() {
      set ConfirmDelete = false
      set Renaming = false
      set Moving = true
   }
   action ChangeTargetPackage(Value text) {
      set TargetPackage = Value
   }
   action ChangeRelocateScenarios(Value boolean) {
      set RelocateScenarios = Value
   }
   action Move() {
      do MoveGeneratedSource(Path: File.Path, SourceVersion: File.Version, TargetPackage: TargetPackage, RelocateScenarios: RelocateScenarios)
      set Moving = false
   }
   render TreeFileRow(Name: File.Name, Path: File.Path, Dirty: File.Dirty, DiagnosticCount: File.DiagnosticCount, RenamePath: RenamePath, Renaming: Renaming, ConfirmDelete: ConfirmDelete, Moving: Moving, TargetPackage: TargetPackage, Open: Open, ChangeRenamePath: ChangeRenamePath, BeginRename: BeginRename, CancelRename: CancelRename, Rename: Rename, BeginDelete: BeginDelete, CancelDelete: CancelDelete, Delete: Delete, BeginMove: BeginMove, ChangeTargetPackage: ChangeTargetPackage, RelocateScenarios: RelocateScenarios, ChangeRelocateScenarios: ChangeRelocateScenarios, Move: Move)
}

view TreeFileRow(Name text, Path text, Dirty boolean, DiagnosticCount number, RenamePath text, Renaming boolean, ConfirmDelete boolean, Moving boolean, TargetPackage text, Open action(), ChangeRenamePath action(text), BeginRename action(), CancelRename action(), Rename action(), BeginDelete action(), CancelDelete action(), Delete action(), BeginMove action(), ChangeTargetPackage action(text), RelocateScenarios boolean, ChangeRelocateScenarios action(boolean), Move action()) from ../../../packages/ides/studio/studio-src/TaoStudioProductHost.tsx

