view DesignTokenRow(DesignToken) {
   action Open() {
      do OpenSource(Path: DesignToken.SourcePath, SourceVersion: DesignToken.SourceVersion, Start: DesignToken.Start)
   }
   render StudioDesignTokenRow(Label: DesignToken.Name, Detail: DesignToken.Value, Kind: DesignToken.Kind, Open: Open)
}

view DesignTokenKindGroup(TokenKind text, Title text) {
   query Tokens = DesignTokens with {
      where Kind == TokenKind
   }
   render Col() {
      when Tokens {
         empty -> { }
         otherwise -> { StudioDesignTokenSection(Title) {
            loop Tokens / DesignToken {
               DesignTokenRow(DesignToken)
            }
         } }
}  }  }

folder
view DesignTokensPanel() {
   query Tokens = DesignTokens
   render StudioPanelSurface("Design") {
      guard Tokens {
         loading -> { Text("Loading parser-owned design values…") }
         error -> Context { Text(Context.Message) }
      }
      DesignTokenKindGroup(TokenKind: "color", Title: "colors")
      DesignTokenKindGroup(TokenKind: "bundle", Title: "bundles")
      DesignTokenKindGroup(TokenKind: "size", Title: "sizes")
      DesignTokenKindGroup(TokenKind: "text", Title: "text")
      DesignTokenKindGroup(TokenKind: "screen", Title: "screens")
      DesignTokenKindGroup(TokenKind: "style", Title: "styles")
      DesignTokenKindGroup(TokenKind: "default", Title: "defaults")
      DesignTokenKindGroup(TokenKind: "token", Title: "tokens")
}  }
