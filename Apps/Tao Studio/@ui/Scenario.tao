use Checkbox, Text, TextInput from @tao/ui

folder
view StudioScenarioPanel(State text, JourneyRecording text, JourneyRecordable boolean, ResolvedAppearance text) {
   state Drafts = StudioScenarioArgumentDrafts(State)
   state FixtureName = "CapturedState"
   state RetainSensitiveText = false
   action Dispatch(Name text, Payload text) {
      do ProductPanelAction(Name: Name, Payload: Payload)
   }
   action ChangeDrafts(Value text) {
      set Drafts = Value
   }
   action ChangeFixtureName(Value text) {
      set FixtureName = Value
   }
   action SubmitFixtureName() { }
   action ApplyArguments() {
      do Dispatch(Name: "scenario-apply-arguments", Payload: StudioScenarioArgumentsPayload(State: State, Drafts: Drafts, Appearance: ResolvedAppearance))
   }
   action SaveArguments() {
      do Dispatch(Name: "scenario-save-arguments", Payload: StudioScenarioArgumentsPayload(State: State, Drafts: Drafts, Appearance: ResolvedAppearance))
   }
   action CaptureFixture() {
      do Dispatch(Name: "scenario-capture-fixture", Payload: StudioScenarioFixturePayload(State: State, FixtureName: FixtureName))
   }
   action ReplayFailure() {
      do Dispatch(Name: "scenario-replay-failure", Payload: StudioScenarioIdentityPayload(State))
   }
   action ReplayCapture(Capture text) {
      do Dispatch(Name: "scenario-replay-capture", Payload: StudioScenarioReplayPayload(State: State, Capture: Capture))
   }
   action ChangeRetainSensitiveText(Value boolean) {
      set RetainSensitiveText = Value
   }
   action ToggleJourneyRecording() {
      do Dispatch(Name: StudioScenarioJourneyCommand(JourneyRecording), Payload: StudioScenarioJourneyPayload(State: State, CaptureSensitiveText: RetainSensitiveText))
   }
   action SaveJourney() {
      do Dispatch(Name: "scenario-save-journey", Payload: StudioScenarioJourneyPayload(State: State, CaptureSensitiveText: RetainSensitiveText))
   }
   action DiscardJourney() {
      do Dispatch(Name: "scenario-discard-journey", Payload: StudioScenarioJourneyPayload(State: State, CaptureSensitiveText: RetainSensitiveText))
   }
   render StudioScenarioPanelSurface(StudioScenarioAvailable(State)) {
      when StudioScenarioAvailable(State) {
         false -> { Text("Select a scenario preview cell to edit its arguments.") }
         otherwise -> {
            StudioScenarioIdentity() {
               StudioScenarioInspectorLabel(Label: StudioScenarioEntryLabel(State))
               StudioScenarioSource(Group: StudioScenarioGroupLabel(State), Subject: StudioScenarioSubjectId(State), Cell: StudioScenarioCellIdentity(State))
            }
            StudioScenarioControlGroup("View arguments") {
               when StudioScenarioArgumentIds(State) {
                  empty -> { Text("This scenario has no view arguments.") }
                  otherwise -> { loop StudioScenarioArgumentIds(State) / ParameterId {
                     StudioScenarioArgument(State: State, Drafts: Drafts, ParameterId: ParameterId, ChangeDrafts: ChangeDrafts)
                  } }
               }
               Text(StudioScenarioArgumentIssues(State: State, Drafts: Drafts))
               StudioActions() {
                  StudioButton(Label: "Apply & remount", Press: ApplyArguments, Disabled: not StudioScenarioArgumentsValid(State: State, Drafts: Drafts), Variant: "primary")
                  StudioButton(Label: "Save to scenario", Press: SaveArguments, Disabled: not StudioScenarioArgumentsValid(State: State, Drafts: Drafts), Variant: "secondary")
            }  }
            StudioScenarioControlGroup("Captured state") {
               when StudioScenarioCapturedLayers(State) {
                  empty -> { Text("None") }
                  otherwise -> { loop StudioScenarioCapturedLayers(State) / Layer {
                     Text(Layer)
                  } }
               }
               StudioInspectorField("Fixture") {
                  TextInput(Value: FixtureName, Change: ChangeFixtureName, Submit: SubmitFixtureName, Label: "Captured fixture name", Placeholder: "CapturedState")
               }
               StudioActions() {
                  StudioButton(Label: "Capture fixture", Press: CaptureFixture, Disabled: not StudioScenarioFixtureNameValid(FixtureName), Variant: "secondary")
                  StudioButton(Label: "Replay captured state", Press: ReplayFailure, Disabled: not StudioScenarioFailureAvailable(State), Variant: "ghost")
               }
               StudioFailureCaptureInput(Replay: ReplayCapture)
            }
            StudioScenarioControlGroup("Record interaction") {
               Checkbox(Value: RetainSensitiveText, Change: ChangeRetainSensitiveText, Label: "Retain sensitive text", Disabled: StudioScenarioJourneyAvailable(JourneyRecording) or StudioScenarioJourneyBusy(JourneyRecording))
               StudioButton(Label: StudioScenarioJourneyButtonLabel(JourneyRecording), Press: ToggleJourneyRecording, Disabled: not StudioScenarioJourneyActive(JourneyRecording) and not StudioScenarioJourneyCanRecord(State: State, Recording: JourneyRecording, Ready: JourneyRecordable), Variant: "primary")
               when StudioScenarioJourneyAvailable(JourneyRecording) {
                  true -> {
                     loop StudioScenarioJourneyLines(JourneyRecording) / Line {
                        Text(Line)
                     }
                     Text(StudioScenarioJourneyStatus(JourneyRecording))
                     StudioActions() {
                        StudioButton(Label: "Save steps to scenario", Press: SaveJourney, Disabled: not StudioScenarioJourneyCanSave(JourneyRecording), Variant: "secondary")
                        StudioButton(Label: "Discard", Press: DiscardJourney, Disabled: StudioScenarioJourneyBusy(JourneyRecording), Variant: "ghost")
                  }  }
                  otherwise -> { }
}  }  }  }  }  }

view StudioScenarioPanelSurface(Available boolean) accepts content from ../../../packages/ides/studio/studio-src/TaoStudioProductHost.tsx

view StudioScenarioArgument(State text, Drafts text, ParameterId text, ChangeDrafts action(text)) {
   action Change(Value text) {
      do ChangeDrafts(StudioScenarioUpdateArgumentDraft(Drafts: Drafts, ParameterId: ParameterId, Value: Value))
   }
   action Submit() { }
   render StudioInspectorField(StudioScenarioArgumentLabel(State: State, ParameterId: ParameterId)) {
      when StudioScenarioArgumentUsesPicker(State: State, ParameterId: ParameterId) {
         true -> { StudioChoice(Value: StudioScenarioArgumentDraft(Drafts: Drafts, ParameterId: ParameterId), Change: Change, Options: StudioScenarioArgumentOptions(State: State, ParameterId: ParameterId), Label: StudioScenarioArgumentLabel(State: State, ParameterId: ParameterId)) }
         otherwise -> { TextInput(Value: StudioScenarioArgumentDraft(Drafts: Drafts, ParameterId: ParameterId), Change: Change, Submit: Submit, Label: StudioScenarioArgumentLabel(State: State, ParameterId: ParameterId)) }
}  }  }

