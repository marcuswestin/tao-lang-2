folder
type StudioPanelAction is {
   Name text,
   Payload text,
}

folder
type StudioProblemPanelRow is {
   Action StudioPanelAction,
   Actionable boolean,
   Column number,
   Detail text,
   HasPosition boolean,
   Label text,
   Line number,
   Path text,
   SourceVersion text,
}

folder
type StudioCompilePanel is {
   AppliedRevision number,
   CompileRevision number,
   DiagnosticCount number,
   Diagnostics list of StudioProblemPanelRow,
   Message text,
   Status text,
}

folder
type StudioProblemsPanel is {
   Rows list of StudioProblemPanelRow,
}

folder
type StudioDataPanelTable is {
   Datasource text,
   Entity text,
   RetainedRowCount number,
   Rows list of text,
   TotalRowCount number,
}

type StudioFeedField is {
   Label text,
   Value text,
   DragPayload text,
}

folder
type StudioFeedRow is {
   RowId text,
   Label text,
   Selected boolean,
   SelectAction StudioPanelAction,
   DragPayload text,
   Fields list of StudioFeedField,
}

folder
type StudioFeedPanel is {
   Notice text,
   Entities list of text,
   Entity text,
   Source text,
   Sources list of text,
   Seed text,
   Rows list of StudioFeedRow,
   Loading boolean,
   Pending boolean,
   Error text,
   CanUndo boolean,
   UndoAction StudioPanelAction,
   CanKeep boolean,
   CanDiscard boolean,
   KeepAction StudioPanelAction,
   DiscardAction StudioPanelAction,
}

folder
type StudioDataPanel is {
   CaptureAction StudioPanelAction,
   Feed StudioFeedPanel,
   Error text,
   Loading boolean,
   RefreshAction StudioPanelAction,
   Source text,
   Tables list of StudioDataPanelTable,
}

type StudioTestFailure is {
   Action StudioPanelAction,
   Column number,
   Detail text,
   HasPosition boolean,
   Label text,
   Line number,
   Path text,
}

folder
type StudioTestsPanel is {
   Available boolean,
   Error text,
   Failures list of StudioTestFailure,
   Output text,
   Reason text,
   RunAction StudioPanelAction,
   Running boolean,
   Summary text,
   Watch boolean,
   WatchAction StudioPanelAction,
}

type StudioLogPanelRow is {
   Level text,
   Message text,
   Timestamp number,
}

folder
type StudioLogsPanel is {
   ClearAction StudioPanelAction,
   RetainedCount number,
   Rows list of StudioLogPanelRow,
   Source text,
   TotalCount number,
}

type StudioDebugJournalRow is {
   Action text,
   Detail text,
   Outcome text,
}

type StudioDebugBinding is {
   Name text,
   Value text,
}

type StudioDebugPendingWrite is {
   Committed text,
   Kind text,
   Pending text,
   Target text,
}

folder
type StudioDebugPanel is {
   BreakAction StudioPanelAction,
   ClearAction StudioPanelAction,
   ContinueAction StudioPanelAction,
   Frames list of text,
   Journal list of StudioDebugJournalRow,
   Paused boolean,
   PausedAt text,
   PendingWrites list of StudioDebugPendingWrite,
   Scope list of StudioDebugBinding,
   Source text,
   StepIntoAction StudioPanelAction,
   StepOutAction StudioPanelAction,
   StepOverAction StudioPanelAction,
}

folder
type StudioSearchPanelRow is {
   Action StudioPanelAction,
   Column number,
   Detail text,
   End number,
   Kind text,
   Label text,
   Line number,
   Path text,
   SourceVersion text,
   Start number,
}

