view StudioRoot(CollapsedFolders list of text, ToggleFolder action(text)) {
   render ProductHostBoundary() {
      @files: FilesPanel(CollapsedFolders: CollapsedFolders, ToggleFolder: ToggleFolder)
      @components: ComponentsPanel()
      @projectViews: ProjectViewsPanel()
      @screens: ScreensPanel()
      @tokens: DesignTokensPanel()
      @data Data -> StudioDataRailPanel(Data: Data)
      @search Rows -> StudioSearchPanel(Rows: Rows)
      @drawer Tab, Compile, Problems, Data, Debug, Tests, Logs -> StudioDrawerPanel(Tab: Tab, Compile: Compile, Problems: Problems, Data: Data, Debug: Debug, Tests: Tests, Logs: Logs)
      @scenario State, JourneyRecording, JourneyRecordable, ResolvedAppearance -> StudioScenarioPanel(State: State, JourneyRecording: JourneyRecording, JourneyRecordable: JourneyRecordable, ResolvedAppearance: ResolvedAppearance)
      @environment FocusedCellId, CellRevision, ViewportPresetId, ViewportWidth, ViewportHeight, NetworkOutcome, NetworkLatencyMs, NetworkErrorMessage, NetworkErrorStatus, SchemeRequested, SchemeResolved, SchemeSource, SchemeCapability -> StudioEnvironmentPanel(FocusedCellId: FocusedCellId, CellRevision: CellRevision, ViewportPresetId: ViewportPresetId, ViewportWidth: ViewportWidth, ViewportHeight: ViewportHeight, NetworkOutcome: NetworkOutcome, NetworkLatencyMs: NetworkLatencyMs, NetworkErrorMessage: NetworkErrorMessage, NetworkErrorStatus: NetworkErrorStatus, SchemeRequested: SchemeRequested, SchemeResolved: SchemeResolved, SchemeSource: SchemeSource, SchemeCapability: SchemeCapability)
      @editor: StudioCodeEditor()
      @inspector Revision, ProjectRoot, ActiveFilePath, ActiveFileContent, ActiveFileVersion, SelectionAnchor, SelectionHead, SelectedRenderId, SelectedRenderPath, SelectedRenderVersion, FocusedCellId, CellRevision, FocusedScenarioId, ViewportWidth, ViewportHeight, InspectorBusy, InspectorCanUndo, InspectorInspection, InspectorSelection, LensLines, LensJourneyPath -> StudioContextPanel(Revision: Revision, ProjectRoot: ProjectRoot, ActiveFilePath: ActiveFilePath, ActiveFileContent: ActiveFileContent, ActiveFileVersion: ActiveFileVersion, SelectionAnchor: SelectionAnchor, SelectionHead: SelectionHead, SelectedRenderId: SelectedRenderId, SelectedRenderPath: SelectedRenderPath, SelectedRenderVersion: SelectedRenderVersion, FocusedCellId: FocusedCellId, CellRevision: CellRevision, FocusedScenarioId: FocusedScenarioId, ViewportWidth: ViewportWidth, ViewportHeight: ViewportHeight, InspectorBusy: InspectorBusy, InspectorCanUndo: InspectorCanUndo, InspectorInspection: InspectorInspection, InspectorSelection: InspectorSelection, LensLines: LensLines, LensJourneyPath: LensJourneyPath)
}  }

