use StillMVP

app StillMVPTest = StillMVP with {
   datasource {
      appId "still-mvp-test"
   }
}

test "Still MVP" {
   check "renders the initial dashboard and empty state" {
      run StillMVPTest

      expect text "Make the day readable"
      expect text "Nothing captured yet. Create the inbox workspace, then save a note or task."
      expect missing text "Edit task"
   }

   check "creates the inbox workspace" {
      run StillMVPTest with {
         datasource.appId "still-mvp-workspace"
      }

      press label "Create first workspace"

      expect text "Inbox"
      expect text "One quiet place for the thoughts and next actions that should not run your day."
      expect text "calm"
   }

   check "creates a note from the capture tab" {
      run StillMVPTest with {
         datasource.appId "still-mvp-note"
      }

      press label "Create first workspace"
      press label "Capture tab"
      press id CaptureTitleInput
      write "First calm note"
      press id CaptureBodyInput
      write "Remember the thing while it is small."
      expect text "Draft changed 2 times"
      press label "Save capture"

      expect text "First calm note"
      expect text "Remember the thing while it is small."
      expect text "clear"
      expect missing text "No notes yet. Capture one thought before it disappears."
   }

   check "creates and toggles a task" {
      run StillMVPTest with {
         datasource.appId "still-mvp-task"
      }

      press label "Create first workspace"
      press label "Capture tab"
      press label "Capture task mode"
      press id CaptureTitleInput
      write "Send the weekly note"
      press label "Save capture"
      expect text "Send the weekly note"
      expect text "Open"
      expect text "next"

      press label "Toggle task Send the weekly note"
      expect text "Done"
      expect missing text "Open"
   }

   check "opens a note detail and returns home" {
      run StillMVPTest with {
         datasource.appId "still-mvp-note-detail"
      }

      press label "Create first workspace"
      press label "Capture tab"
      press id CaptureTitleInput
      write "Openable note"
      press id CaptureBodyInput
      write "Detail screen body"
      press label "Save capture"
      press label "Open note Openable note"

      expect text "Openable note"
      expect text "Detail screen body"

      press label "Archive note"
      expect text "Recent notes"
      expect missing text "Detail screen body"
   }

   check "creates a follow-up task from note detail" {
      run StillMVPTest with {
         datasource.appId "still-mvp-follow-up"
      }

      press label "Create first workspace"
      press label "Capture tab"
      press id CaptureTitleInput
      write "Follow-up source"
      press id CaptureBodyInput
      write "This note needs one next action."
      press label "Save capture"
      press label "Open note Follow-up source"
      press label "Add follow-up task"

      expect text "Related tasks"
      expect text "Follow up on Follow-up source"
      expect text "follow-up"

      press label "Toggle task Follow up on Follow-up source"
      expect text "Done"
   }

   check "edits a task through navigation" {
      run StillMVPTest with {
         datasource.appId "still-mvp-task-edit"
      }

      press label "Create first workspace"
      press label "Capture tab"
      press label "Capture task mode"
      press id CaptureTitleInput
      write "Draft task title"
      press label "Save capture"
      press label "Edit task Draft task title"

      expect text "Edit task"
      press id TaskTitleInput
      write "Edited task title"
      press label "Save task"

      expect text "Edited task title"
      expect missing text "Draft task title"
   }

   check "uses future selector helpers and direct actions" {
      run StillMVPTest with {
         datasource.appId "still-mvp-selector-actions"
      }

      invoke action DashboardScreen.CreateInboxWorkspace
      expect text "Inbox"
      expect id CaptureTitleInput
      expect missing id LegacyCaptureTitleInput

      press label "Capture tab"
      press label "Capture task mode"
      expect button "Save capture" disabled
      press placeholder "A thing worth remembering"
      write into placeholder "A thing worth remembering" "Selector task"
      expect input id CaptureTitleInput value "Selector task"
      submit id CaptureTitleInput
      expect button "Save capture" enabled
      press text "Save task"

      scroll until text "Runtime Surface"
      back
      press label "Toggle task Selector task"
      expect checkbox "Selector task" checked

      press label "Capture tab"
      clear id CaptureTitleInput
      expect input id CaptureTitleInput value ""
   }
}
