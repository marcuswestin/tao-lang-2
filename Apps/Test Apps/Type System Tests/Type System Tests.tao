use StackNav from @tao/nav

app TypeSystemTests {
   id "type-system-tests"
   version "0.1.0"
   name "Type System Tests"
   Navigator StackNav {
      Initial Demo
}  }

type Name is text

type Age is number

type Count is number

type Tags is list of text

type Job is {
   Title text,
   Level number,
}

type Person is {
   Name,
   Age,
   Tags,
   Job,
}

let FirstTitle = "Open"
let FirstCount = 1
let SecondTitle = "Done"
let SecondCount = 2
let DisplayName = Name "Ada"
let TypedDisplayName = Name "Grace"
let DemoTags = Tags ["types", "items", "lists"]
let EmptyTags = Tags []
let DemoJob = Job {
   Level: 2,
   Title: "Compiler engineer"
}
let DemoPerson = Person {
   Tags: DemoTags,
   Job: DemoJob,
   Age: 40,
   Name: DisplayName
}
let ScopeLabel = "File scope label"
let Team = [
   DemoPerson, Person {
   Name: "the Developer",
   Age: 41,
   Tags: EmptyTags,
   Job: Job {
      Title: "Language designer",
      Level: 5
}  }
]

scene Demo() {
   Title "Type System Tests"
   let OuterScopeLabel = ScopeLabel
   render Stack() {
      let ScopeLabel = "Nested scope label"
      Tile(FirstTitle, FirstCount)
      Tile(SecondTitle, SecondCount)
      ProfileCard(DemoPerson)
      ProfileCard(Person {
         Tags: Tags ["runtime", "mobile"],
         Job: Job {
            Level: 3,
            Title: "Runtime engineer"
         },
         Age: 29,
         Name: "Kai"
      })
      SummaryLine(Count: 2, "People in the team")
      MemberLine(DemoPerson.Job.Title, DemoPerson.Name)
      TeamList(Team)
      TextValue(TypedDisplayName)
      TextValue("Constructed primitive text")
      TextValue(OuterScopeLabel)
      TextValue(ScopeLabel)
}  }

view Stack() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag })
   ```
}

view Tile(Title text, Count number) {
   render inject Title, Count, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [`${Title}: ${Count}`], layout: Layout, tag: Tag })
   ```
}

view ProfileCard(Person) {
   render Stack() {
      TextValue(Person.Name)
      NumberValue(Person.Age)
      TextValue(Person.Job.Title)
      TagList(Person.Tags)
}  }

view MemberLine(RoleTitle Job.Title, Name) {
   render Stack() {
      TextValue(Name)
      TextValue(RoleTitle)
}  }

view SummaryLine(Label text, Count) {
   render inject Label, Count, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [`${Label}: ${Count}`], layout: Layout, tag: Tag })
   ```
}

view TextValue(Value text) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [Value], layout: Layout, tag: Tag })
   ```
}

view NumberValue(Value number) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [String(Value)], layout: Layout, tag: Tag })
   ```
}

view TagList(Values list of text) {
   render inject Values, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [Values.join(', ')], layout: Layout, tag: Tag })
   ```
}

view TeamList(People list of Person) {
   render inject People, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [`${People.length} team member(s)`], layout: Layout, tag: Tag })
   ```
}
