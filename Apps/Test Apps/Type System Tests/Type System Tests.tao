app TypeSystemTiles {
    ui TileBoard
}

alias FirstTitle = "Open"
alias FirstCount = 1
alias SecondTitle = "Done"
alias SecondCount = 2

ui TileBoard {
    render TileBoardPanel FirstTitle, FirstCount, SecondTitle, SecondCount { }
}

ui TileBoardPanel FirstTitle text, FirstCount number, SecondTitle text, SecondCount number {
    render inject ```ts
        const firstTitle = _ViewProps.FirstTitle.evaluate();
        const firstCount = _ViewProps.FirstCount.evaluate();
        const secondTitle = _ViewProps.SecondTitle.evaluate();
        const secondCount = _ViewProps.SecondCount.evaluate();
        return <>
            <RN.Text>{firstTitle.jsValue}: {firstCount.jsValue}</RN.Text>
            <RN.Text>{secondTitle.jsValue}: {secondCount.jsValue}</RN.Text>
        </>
    ```
}
