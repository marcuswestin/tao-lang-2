app TypeSystemTiles {
   view TileBoard
}

alias FirstTitle = "Open"
alias FirstCount = 1
alias SecondTitle = "Done"
alias SecondCount = 2

view TileBoard {
   render Stack {
      Tile FirstTitle, FirstCount
      Tile SecondTitle, SecondCount
}  }

layout Stack {
   render inject ```ts
      return <>{_ViewProps.children}</>
   ```
}

view Tile Title text, Count number {
   render inject Title, Count ```ts
      return <RN.Text>{Title}: {Count}</RN.Text>
   ```
}
