app ItemListCustomTypeMVP {
   view Demo
}

type Name is text

type Age is number

type Count is number

type Tags is list

type Job is {
   Title is text
   Level is number
}

type Person is {
   Name
   Age
   Tags
   Job
}

alias FirstTitle = "Open"
alias FirstCount = 1
alias SecondTitle = "Done"
alias SecondCount = 2
alias DisplayName = "Ada" as Name
alias TypedDisplayName = text."Grace" as Name
alias DemoTags = Tags.["types" "items" "lists"]
alias EmptyTags = Tags.[]
alias DemoJob = Job.{
   Level.2
   Title."Compiler engineer"
}
alias DemoPerson = Person.{
   DemoTags
   DemoJob
   Age.40
   DisplayName
}
alias Team = [
   DemoPerson
   Person.{
      Name."Ro"
      Age.41
      EmptyTags
      Job.{
         Title."Language designer"
         Level.5
   }  }
]

view Demo {
   render Stack {
      Tile FirstTitle, FirstCount
      Tile SecondTitle, SecondCount
      ProfileCard DemoPerson
      ProfileCard Person.{
         Tags.["runtime" "mobile"]
         Job.{
            Level.3
            Title."Runtime engineer"
         }
         Age.29
         Name."Kai"
      }
      SummaryLine Count.2, "People in the team"
      MemberLine DemoPerson.Job.Title, DemoPerson.Name
      TeamList Team
      TextValue TypedDisplayName
      TextValue text."Constructed primitive text"
}  }

layout Stack {
   render inject ```ts
      return <>{_ViewProps.children}</>
   ```
}

view Tile text as Title, number as Count {
   render inject Title, Count ```ts
      return <RN.Text>{Title}: {Count}</RN.Text>
   ```
}

view ProfileCard Person {
   render Stack {
      TextValue Person.Name
      NumberValue Person.Age
      TextValue Person.Job.Title
      TagList Person.Tags
}  }

view MemberLine Job.Title as RoleTitle, Name {
   render Stack {
      TextValue Name
      TextValue RoleTitle
}  }

view SummaryLine text as Label, Count {
   render inject Label, Count ```ts
      return <RN.Text>{Label}: {Count}</RN.Text>
   ```
}

view TextValue text as Value {
   render inject Value ```ts
      return <RN.Text>{Value}</RN.Text>
   ```
}

view NumberValue number as Value {
   render inject Value ```ts
      return <RN.Text>{Value}</RN.Text>
   ```
}

view TagList list as Values {
   render inject Values ```ts
      return <RN.Text>{Values.join(', ')}</RN.Text>
   ```
}

view TeamList list as People {
   render inject People ```ts
      return <RN.Text>{People.length} team member(s)</RN.Text>
   ```
}
