use StackNav from @tao/nav
use Box, Button, Col, Number, Row, Stack, Text, TextFrame, TextMultiline, WrappingRow from @tao/ui

app RuntimeStdlibTests {
   Name "Runtime Stdlib Tests"
   Navigator StackNav {
      Initial MainView
}  }

let LaunchCount = 3

ui MainView {
   action Ignore { }
   render Stack() {
      Text("Runtime stdlib smoke")
      Number(LaunchCount)
      Button("Tap me") {
         on press Ignore
      }
      Box() {
         Col() {
            TextFrame("Label")
      }  }
      Row() {
         WrappingRow() {
            TextMultiline("Wrapped")
}  }  }  }
