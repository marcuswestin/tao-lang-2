use Box, Button, Col, MultiLineText, Number, Row, Stack, Text, TextLabel, WrappingRow from @tao/ui

app RuntimeStdlibTests {
   ui MainView
}

alias LaunchCount = 3

ui MainView {
   render Stack {
      Text "Runtime stdlib smoke"
      Number LaunchCount
      Button "Tap me"
      Box {
         Col {
            TextLabel "Label"
      }  }
      Row {
         WrappingRow {
            MultiLineText "Wrapped"
}  }  }  }
