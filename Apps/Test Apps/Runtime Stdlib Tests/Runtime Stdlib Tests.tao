use StackNav from @tao/nav
use Box, Button, Col, Image, Number, Progress, Row, Spinner, Stack, Text, TextFrame, TextMultiline, WrappingRow from @tao/ui

app RuntimeStdlibTests {
   Name "Runtime Stdlib Tests"
   Navigator StackNav {
      Initial MainView
}  }

let LaunchCount = 3

view MainView() {
   action Ignore() { }
   render Stack() {
      Text("Runtime stdlib smoke")
      Number(LaunchCount)
      Text("Media and status primitives")

      #informativeImage
      Image("./images/runtime-stdlib.png", Label: "Runtime stdlib illustration")

      #decorativeImage
      Image("./images/divider.png", Decorative: true)

      #loadingIndicator
      Spinner()

      #completionProgress
      Progress(Value: 2)
      Button("Tap me") {
         on press Ignore
      }
      Box() {
         Col() {
            TextFrame("Label")
      }  }
      Row() {
         WrappingRow() {
            TextMultiline("Wrapped")
}  }  }  }
