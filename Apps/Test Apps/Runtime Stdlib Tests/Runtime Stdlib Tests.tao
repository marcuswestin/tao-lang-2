use StackNav from @tao/nav
use Box, Button, Col, Image, Layer, Number, Progress, Row, Spinner, Stack, Text, TextFrame, TextMultiline, WrappingRow from @tao/ui

project {
   id "runtime-stdlib-tests"
   name "Runtime Stdlib Tests"
   version "0.1.0"
}

app RuntimeStdlibTests {
   Name "Runtime Stdlib Tests"
   Navigator StackNav {
      Initial MainView
}  }

let LaunchCount = 3

scene MainView() {
   Title "Runtime Stdlib Tests"
   action Ignore() { }
   render Stack() {
      Text("Runtime stdlib smoke")
      Number(LaunchCount)
      Text("Media and status primitives")

      #informativeImage
      Image("./images/runtime-stdlib.png", Label: "Runtime stdlib illustration")

      #decorativeImage
      Image("./images/divider.png", Decorative: true)

      #loadingIndicator
      Spinner()

      #completionProgress
      Progress(Value: 2)
      Button("Tap me") {
         on press Ignore
      }
      Box() [width 200, height 48] {
         Col() {
            TextFrame("Label")
         }
         Layer(InsetTop: 4, InsetRight: 4) {
            Text("Floating badge")
      }  }
      Row() {
         WrappingRow() {
            TextMultiline("Wrapped")
}  }  }  }
