use StackNav from @tao/nav
use Col, Text from @tao/ui

use package @widgets

app ComponentAliases {
   Name "Component Aliases"
   Navigator StackNav {
      Initial MainView
}  }

// A pass-through alias publishes an implementation package's view under this file's own name,
// without bringing that name into scope first — which is what lets the names match.
public
view Badge = widgets.Badge

view Renamed = widgets.Tagline

ui MainView() {
   render Col() [gap 6] {
      Text("Component Aliases")
      Badge("shipped")
      Renamed("aliases keep the target's interface")
}  }
