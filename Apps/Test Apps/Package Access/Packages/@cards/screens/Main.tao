use CardTitle, ChildFolderTitle, SiblingFileTitle, SiblingFolderTitle
use ProjectNotice from @copy
use ProjectWidget from @copy/widgets

workspace
view MainView() {
   render Stack() {
      Text(CardTitle)
      Text(SiblingFileTitle)
      Text(SiblingFolderTitle)
      Text(ChildFolderTitle)
      Text(ProjectNotice)
      ProjectWidget()
}  }

view Stack() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({ children: Content, layout: Layout, tag: Tag })
   ```
}

view Text(Value text) {
   render inject Value, Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [Value], layout: Layout, tag: Tag })
   ```
}
