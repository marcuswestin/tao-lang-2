use Col, FormButton, Text, TextInput from @tao/ui

app FormsInteractionMVP {
   view MainView
}

function SubmittedLabel Title is text returns text = interpolate "Submitted: ", Title

view MainView {
   state Draft = ""
   state Submitted = ""
   state Submitting = false
   action ChangeDraft Value is text {
      set Draft = Value
   }
   action Submit {
      set Submitted = Draft
      set Submitting = true
   }
   render Col() [gap 10, pad 16] {
      Text("New task")
      TextInput(.Value Draft, .Change ChangeDraft, .Submit Submit, .Label "Task title", .Placeholder "Capture something", .Id "task-title", .Disabled false)
      if (Draft.Empty) {
         Text("Title is required")
      } else {
         Text(Draft)
      }
      FormButton(.Title "Save", .Press Submit, .Id "save", .Disabled Draft.Empty, .Submitting Submitting)
      if (not Submitted.Empty) {
         Text(SubmittedLabel(Submitted))
      } else {
         Text("")
}  }  }
