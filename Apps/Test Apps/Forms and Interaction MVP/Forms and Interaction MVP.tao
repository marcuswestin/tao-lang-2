use StackNav from @tao/nav
use Checkbox, Col, FormButton, Text, TextInput from @tao/ui

app FormsInteractionMVP {
   Name "Forms and Interaction MVP"
   Navigator StackNav {
      Initial MainView
}  }

function SubmittedLabel(Title text) returns text {
   return "Submitted: { Title }"
}

scene MainView() {
   Title "Forms and Interaction MVP"
   state Draft = ""
   state Submitted = ""
   state NamedChange = ""
   state InlineChange = ""
   state Completed = false
   state Submitting = false
   state SubmissionCount = 0
   action RecordNamedChange(Value text) {
      set NamedChange = "Named: { Value }"
   }
   action SetCompleted(Value boolean) {
      set Completed = Value
   }
   action Submit() {
      check Draft is not empty
      set Submitted = Draft
      set SubmissionCount += 1
      set Submitting = true
   }
   render Col() [gap 10, pad 16] {
      Text("New task")
      // With no explicit `on change`, Value: Draft gets a synthesized writable-state binding.
      #taskTitle
      TextInput(Value: Draft, Label: "Task title", Placeholder: "Capture something") {
         on submit Submit
      }

      #namedChange
      TextInput(Value: NamedChange, Label: "Named change") {
         on change RecordNamedChange
         on submit Submit
      }

      #inlineChange
      TextInput(Value: InlineChange, Label: "Inline change") {
         on change -> Entered { set InlineChange = "Inline: { Entered }" }
         on submit Submit
      }
      Text("Named value: { NamedChange }")
      Text("Inline value: { InlineChange }")

      #completed
      Checkbox(Value: Completed, Label: "Complete") {
         on change SetCompleted
      }
      when Completed {
         true -> { Text("Checkbox: checked") }
         otherwise -> { Text("Checkbox: unchecked") }
      }
      when Draft {
         empty -> { Text("Title is required") }
         otherwise -> { Text(Draft) }
      }

      #clear
      FormButton(Title: "Clear", Disabled: Draft is empty) {
         on press -> { set Draft = "" }
      }

      #save
      FormButton(Title: "Save", Disabled: Draft is empty, Submitting: Submitting) {
         on press Submit
      }
      Text("Submissions: { SubmissionCount }")
      when Submitted {
         empty -> { Text("") }
         otherwise -> { Text(SubmittedLabel(Submitted)) }
}  }  }
