use SelectionNav, StackNav from @tao/nav
use Button, Col, Text from @tao/ui

// This complete harness exists only to prove that a view can be an app shell around an ordinary
// rendered navigator. Keeping its three configurations beside their checks prevents implementation-
// only apps from crowding the interactive picker.
app ShellApp {
   id "navigation-shell-variants"
   version "0.1.0"
   name "Shell"
   view Shell(CenterStack, "Primary shell")
}

// A variant rebinds the root: the same shell, a different navigator inside it. The label the
// variant passes is what proves the arguments reach the view.
app OtherShellApp = ShellApp with {
   id "navigation-other-shell-app"
   name "Shell - Other"
   view Shell(OtherStack, "Other shell")
}

// The rendered navigator may itself be a selection, and `present @key` reaches it through the
// shell: the app asks its root, and the root reaches the navigator its view renders.
app SelectionShellApp {
   id "navigation-selection-shell-app"
   version "0.1.0"
   name "Shell - Selection"
   view Shell(ShellTabs, "Selection shell")
}

nav CenterStack = StackNav {
   Initial CenterHome
}

nav OtherStack = StackNav {
   Initial OtherHome
}

nav ShellTabs = SelectionNav {
   Initial @first
   Display "tabs"
   @first {
      Label "First"
      Content FirstTab
   }
   @second {
      Label "Second"
      Content SecondTab
}  }

// The shell: the navigator and a status bar laid out as ordinary content. The bar is conditional on
// view state; the navigator never is, because its history lives on its mount and a branch that
// unmounted it would drop where the person was.
scene Shell(Navigator nav, Label text) {
   state ShowStatus = true
   render Col() [fill] {
      Text(Label)
      Navigator() [fill]
      when ShowStatus {
         true -> {
            #hideStatus
            Button("Hide status") {
               on press -> { set ShowStatus = false }
            }
            StatusBar()
         }
         otherwise -> {
            #showStatus
            Button("Show status") {
               on press -> { set ShowStatus = true }
}  }  }  }  }

view StatusBar() {
   render Col() {
      Text("Shell status")
}  }

scene CenterHome() {
   Title "Center"
   render Col() [gap 8] {
      Text("Center home")

      #openCenterDetail
      Button("Open center detail") {
         on press -> { present CenterDetail() }
}  }  }

scene CenterDetail() {
   Title "Center detail"
   render Col() {
      Text("Center pushed")
}  }

scene OtherHome() {
   Title "Other"
   render Col() {
      Text("Other home")
}  }

scene FirstTab() {
   Title "First"
   render Col() [gap 8] {
      Text("First tab")

      #goSecond
      Button("Go to second") {
         on press -> { present @second }
}  }  }

scene SecondTab() {
   Title "Second"
   render Col() {
      Text("Second tab")
}  }

test "Shell" {
   // The navigator is rendered by the shell as ordinary content, and Back still reaches it: the app
   // asks its root, and the root reaches the navigator its view renders.
   test "pushes and pops inside a navigator the shell renders" {
      run ShellApp

      expect text "Primary shell"
      expect text "Center home"
      expect text "Shell status"
      press "Open center detail"
      expect text "Center pushed"
      expect missing text "Center home"
      back
      expect text "Center home"
      expect missing text "Center pushed"
   }
   // A rendered navigator restores by its own identity, so its position survives a relaunch, and
   // `relaunch fresh` opens it at its root.
   test "keeps the rendered navigator's position across a relaunch" {
      run ShellApp
      press "Open center detail"
      expect text "Center pushed"
      relaunch
      expect text "Center pushed"
      expect missing text "Center home"
      relaunch fresh
      expect text "Center home"
      expect missing text "Center pushed"
   }
   // The bar beside the navigator is conditional; the navigator is not. Mounting and unmounting the
   // bar leaves the navigator's position where it was.
   test "mounts and unmounts a sibling while the navigator keeps its position" {
      run ShellApp
      press "Open center detail"
      expect text "Center pushed"
      press #hideStatus
      expect missing text "Shell status"
      expect text "Center pushed"
      press #showStatus
      expect text "Shell status"
      expect text "Center pushed"
   }
   // Selection activation reaches a rendered SelectionNav through the shell.
   test "activates a key on a rendered selection navigator" {
      run SelectionShellApp

      expect text "Selection shell"
      expect text "First tab"
      expect missing text "Second tab"
      press #goSecond
      expect text "Second tab"
      expect missing text "First tab"
   }
   // The app root is a view with arguments, and a variant rebinds them: the same shell shows the
   // label and the navigator the variant handed it.
   test "renders the arguments a variant binds to the root view" {
      run OtherShellApp

      expect text "Other shell"
      expect text "Other home"
      expect missing text "Primary shell"
      expect missing text "Center home"
   }
}
