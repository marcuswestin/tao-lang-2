use ToggleNavigation, ToggleWithView from ./

test "Toggle Navigation" {
   // The stack's header moves into the bar, so the title and the toolbar each appear exactly once —
   // a second copy would make these single-match expectations fail.
   test "shows the visible screen's title and toolbar in the bottom bar" {
      run ToggleNavigation
      expect navigation title "Top stories"
      press "Open story"
      expect navigation title "Story"
      expect toolbar command "Save story" enabled
      expect text "Story is unsaved"
      press toolbar command "Save story"
      expect text "Story is saved"
   }
   // Back is the bar's own control, and it walks the active stack through the same reducer as the
   // platform gesture.
   test "goes back from the bar" {
      run ToggleNavigation
      press "Open story"
      expect text "Story body"
      press label "Back"
      expect navigation title "Top stories"
      expect missing text "Story body"
   }
   // The right-hand control names the item it switches to, and each stack keeps its place while
   // the other one shows.
   test "alternates between the two stacks and keeps each position" {
      run ToggleNavigation
      press "Open story"
      press label "Reading"
      expect navigation title "Reading list"
      expect text "Nothing saved yet"
      press label "Top"
      expect navigation title "Story"
      expect text "Story body"
   }
   // A plain-view item has no slots to hand over, so its label titles the bar, and switching still
   // wraps back to it.
   test "titles a plain-view item by its label" {
      run ToggleWithView
      expect navigation title "Notes"
      expect text "No notes"
      press label "Stories"
      expect navigation title "Top stories"
      press label "Notes"
      expect navigation title "Notes"
   }
   // The selection and the stack inside it restore together.
   test "reopens on the stack and screen it left" {
      run ToggleNavigation
      press "Open story"
      press label "Reading"
      press label "Top"
      relaunch
      expect navigation title "Story"
      press label "Reading"
      expect navigation title "Reading list"
   }
}
