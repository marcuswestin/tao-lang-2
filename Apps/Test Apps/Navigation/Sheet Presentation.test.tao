use SheetPresentation from ./

test "Sheet presentation" {
   test "keeps a sheet showing beneath a cover presented from inside it, until the cover dismisses" {
      run SheetPresentation
      press #openSheet
      press #openCover
      expect {
         text "Cover content"
         text "Sheet content"
      }
      press #closeCover
      expect {
         missing text "Cover content"
         text "Sheet content"
}  }  }
