use NavigationMVPApp from ./

test "Navigation MVP" {
   test "presents a typed destination, preserves covered state, and returns through automatic back" {
      run NavigationMVPApp
      expect navigation title "Navigation MVP"
      expect text "Home visits: 0"
      press #countVisit
      expect text "Home visits: 1"
      press #openDetail
      expect navigation title "Typed workspace"
      expect missing text "Navigation MVP"
      expect text "Detail"
      expect text "Typed workspace"
      back
      expect navigation title "Navigation MVP"
      expect text "Home visits: 1"
      expect missing text "Detail"
   }
   // A relaunch is a real relaunch, so the new instance restores where the person was — including
   // the typed argument the presented screen was opened with. `relaunch fresh` is the explicit
   // opt-out, and is the only way a journey sees the launch a device that has never run the app
   // gives. View-local state is the launched instance's either way and does not come back.
   test "reopens the presented screen after a relaunch and the initial one after a fresh relaunch" {
      run NavigationMVPApp
      press #countVisit
      press #openDetail
      expect navigation title "Typed workspace"
      relaunch
      expect navigation title "Typed workspace"
      expect text "Typed workspace"
      back
      expect text "Home visits: 0"
      press #openDetail
      relaunch fresh
      expect navigation title "Navigation MVP"
      expect text "Home visits: 0"
      expect missing text "Detail"
      // The fresh instance recorded where it opened, so the device now remembers the initial
      // screen rather than the Detail the run before it left behind.
      relaunch
      expect navigation title "Navigation MVP"
      expect missing text "Detail"
   }
   // An `ask` is the one presentation that suspends the action that made it. These two checks are a
   // pair: the first says the action really does open a screen once the dialogue answers, so the
   // absence the second asserts is one this app is otherwise capable of producing.
   test "presents the screen an asking action names once the dialogue answers" {
      run NavigationMVPApp
      press #confirmOpen
      expect text "Open the detail?"
      press #answerConfirm
      expect navigation title "Answered workspace"
      expect text "Answered workspace"
   }
   // Quitting the app ends the action that was waiting on the dialogue. It does not answer it and
   // let the rest of that action run on: the screen it would have opened belongs to the launch the
   // person quit, and the instance that opens next never shows it. `fresh` keeps the assertion
   // about the abandoned action alone, because an ordinary relaunch rebuilds the stack from the
   // device afterwards and would hide whatever the old action left on it.
   test "drops an action left suspended on a dialogue when the app is quit and opened again" {
      run NavigationMVPApp
      press #confirmOpen
      expect text "Open the detail?"
      relaunch fresh
      expect navigation title "Navigation MVP"
      expect missing text "Open the detail?"
      expect missing text "Answered workspace"
   }
   // A scene is the way to add chrome, not a requirement for being presented. A plain view pushed
   // on a Stack is legal, shows Back-only header chrome, and Back reaches it the same way — the
   // reducer owns Back, not the header.
   test "pushes a plain view with Back-only chrome" {
      run NavigationMVPApp
      expect navigation title "Navigation MVP"
      press #openChromeless
      expect text "Chromeless detail"
      // Back-only chrome: the bar is there and carries the Back affordance, with no title of its own.
      expect label "Back"
      back
      expect navigation title "Navigation MVP"
      expect missing text "Chromeless detail"
   }
   // `Header false` is the explicit opt out of header chrome, for a scene that owns its whole
   // surface. The bar goes, including the Back affordance drawn in it; Back itself does not, so
   // the reducer still takes you home.
   test "presents a headerless scene and still leaves by Back" {
      run NavigationMVPApp
      expect navigation title "Navigation MVP"
      press #openFullBleed
      expect text "Full bleed detail"
      // The bar is gone, and with it the Back affordance drawn in it.
      expect missing label "Back"
      back
      expect navigation title "Navigation MVP"
      expect missing text "Full bleed detail"
   }
}
