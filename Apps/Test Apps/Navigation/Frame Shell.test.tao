use FrameShellApp from ./

test "Frame Shell" {
   test "renders every edge and the center at the same time" {
      run FrameShellApp

      expect text "Frame toolbar"
      expect text "Frame status"
      expect text "Frame inspector"
      expect text "Sidebar home"
      expect text "Center home"
   }
   // The empty-slot rule is semantic: an absent `Content` is not a zero-sized pane, it is no pane.
   // The check watches the slot leave and come back while every other edge stays exactly where it
   // was, which is what separates an emptied slot from a re-laid-out frame.
   test "drops a slot whose Content is absent and grows it back" {
      run FrameShellApp

      expect text "Sidebar home"
      press "Hide sidebar"
      expect missing text "Sidebar home"
      expect text "Frame toolbar"
      expect text "Frame inspector"
      press "Show sidebar"
      expect text "Sidebar home"
   }
   // Back belongs to the center. An edge keeps whatever position it reached, and a Back with an
   // empty center changes nothing rather than reaching into the sidebar's stack.
   test "routes back to the center and never into an edge" {
      run FrameShellApp
      press "Open sidebar detail"
      expect text "Sidebar pushed"
      press "Open center detail"
      expect text "Center pushed"
      back
      expect text "Center home"
      expect text "Sidebar pushed"
      back
      expect text "Center home"
      expect text "Sidebar pushed"
   }
   // A frame's own state is each slot's nav state, edges included, so an edge's position is part of
   // what the relaunched instance reads back.
   test "restores each slot's own navigation across a relaunch" {
      run FrameShellApp
      press "Open sidebar detail"
      press "Open center detail"
      expect text "Sidebar pushed"
      expect text "Center pushed"
      relaunch
      expect text "Sidebar pushed"
      expect text "Center pushed"
      // `fresh` opts one launch out of restoring navigation, so both slots open at their roots.
      relaunch fresh
      expect text "Sidebar home"
      expect text "Center home"
   }
}
