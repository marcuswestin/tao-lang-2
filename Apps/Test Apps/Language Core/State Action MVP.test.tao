use StateActionMVP from ./

test "State Action MVP" {
   test "presses action buttons and rerenders count" {
      run StateActionMVP

      expect text "0"
      press "Add twice"
      expect text "2"
      press "Reset"
      expect text "0"
      press "Inline add one"
      expect text "1"
      press "Add five"
      expect text "6"
      press "Double"
      expect text "12"
      press "Halve"
      expect text "6"
      press "Decrement"
      expect text "5"
   }
}
