use FunctionalCoreMVP from ./

test "Functional Core MVP" {
   // REMOVAL CANDIDATE: Lower suites own these language rules; removal drops their combined compiled-app execution smoke.
   test "evaluates functions, control flow, and collection rendering" {
      run FunctionalCoreMVP

      expect text "Ready"
      expect text "Visible"
      expect text "Count: 2"
      expect text "Next: 3"
      expect text "Inbox"
      expect text "Today"
      expect text "Async idle"
      expect text "Continuation idle"
      expect missing text "Empty"
      press "Hide count"
      expect text "Hidden"
      expect missing text "Count: 2"
      expect text "Empty"
      press "Launch async"
      expect text "Async launched"
      expect text "Action continued"
   }
}
