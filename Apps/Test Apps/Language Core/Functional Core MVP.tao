use StackNav from @tao/nav
use Button, Col, Text from @tao/ui

app FunctionalCoreMVP {
   id "language-core"
   version "0.1.0"
   name "Functional Core MVP"
   Navigator StackNav {
      Initial MainView
}  }

func HasCount(Count number) -> boolean {
   return Count > 0 and not false
}

func CountLabel(Count number) -> text {
   return "Count: { Count }"
}

func NextLabel(Count number) -> text {
   return "Next: { Count + 1 }"
}

func PresenceLabel(Present boolean) -> text {
   return when Present {
      true -> "Ready"
      otherwise -> "Missing{ none }"
}  }

scene MainView() {
   Title "Functional Core MVP"
   state Count = 2
   state Visible = true
   state AsyncStarted = false
   state AsyncContinued = false
   action HideCount() {
      if HasCount(Count) {
         toggle Visible
         set Count = 0
   }  }
   action LaunchAsync() {
      async {
         set AsyncStarted = true
      }
      set AsyncContinued = true
   }
   render Col() [gap 8, pad 12] {
      Text("Functional core")
      Text(PresenceLabel(true))
      when Visible {
         true -> { Text("Visible") }
         otherwise -> { Text("Hidden") }
      }
      when HasCount(Count) {
         true -> {
            Text(CountLabel(Count))
            Text(NextLabel(Count))
         }
         otherwise -> { Text("Empty") }
      }
      loop ["Inbox", "Today"] / Label {
         Text(Label)
      }
      when AsyncStarted {
         true -> { Text("Async launched") }
         otherwise -> { Text("Async idle") }
      }
      when AsyncContinued {
         true -> { Text("Action continued") }
         otherwise -> { Text("Continuation idle") }
      }
      Button("Hide count") {
         on press HideCount
      }
      Button("Launch async") {
         on press LaunchAsync
}  }  }
