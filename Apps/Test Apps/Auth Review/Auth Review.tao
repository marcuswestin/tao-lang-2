use Account, AccountView, LoginFlow, Session, SignIn, SignInFlow, SignInView, SignOut from @tao/auth
use Clerk from @tao/auth/clerk
use InstantAuth from @tao/auth/instantdb
use LocalAuth from @tao/auth/local
use TestAuth from @tao/auth/testing
use InstantDB from @tao/data/providers/instantdb
use Memory from @tao/data/providers/memory
use Reference from @tao/data/providers/reference
use StackNav from @tao/nav
use Col, FormButton, Row, ScrollView, Text, TextInput, TextMultiline from @tao/ui

app AuthReview {
   Name "Auth Review"
   Auth TestAuth { }
   action Leave() {
      do SignOut()
   }
   Datasource Memory { }
   Navigator StackNav {
      Initial Authentication(Leave: Leave)
}  }

app AuthReviewLocal = AuthReview with {
   Auth LocalAuth {
      Endpoint "http://127.0.0.1:4738"
      Resource "auth-review"
   }
   Datasource Reference {
      ServerURL "http://127.0.0.1:4738"
      Resource "auth-review"
      Offline {
         Me,
         Me.Notes
}  }  }

// Configure a Clerk development instance and a trusted gateway before running this variant.
app AuthReviewClerk = AuthReviewLocal with {
   Auth Clerk {
      PublishableKey "pk_test_REPLACE_WITH_YOUR_KEY"
}  }

// Replace the App ID with your Instant Cloud app's and push its schema and rules before running.
app AuthReviewInstant = AuthReview with {
   Auth InstantAuth {
      AppId "REPLACE_WITH_INSTANT_APP_ID"
   }
   Datasource InstantDB {
      AppId "REPLACE_WITH_INSTANT_APP_ID"
}  }

let Me = Account
let ReviewEmail = "narcvs+tao-clerk-test@gmail.com"
let ReviewPassword = "TaoReview!Violet-27-River"

scenarios AuthReviewClerk "Clerk and InstantDB" {
   scenario "iPhone" {
      device phone
      appearance light
      network online
      locale "en"
}  }

folder
data Accounts / Account {
   DisplayName text (required "Enter your name"),
   Notes (owned),
}

folder
data Notes / Note {
   Owner Account,
   Body text (required "Write something"),
   CreatedAt time (default now),

   index CreatedAt,
}

access Account {
   Account can read
   Account can update DisplayName
}

access Note {
   Owner can read, create, delete
   Owner can update Body
}

// Authenticated does not imply that the application profile has finished loading.
guard default {
   loading -> Text("Opening account…")
   missing -> Text("Account data is missing")
   unauthorized -> Text("You do not have access")
   error -> Message { Text(Message) }
}

scene Authentication(Leave action()) {
   Title "Auth Review"
   render ScrollView() {
      Col() [hug, gap 12, pad 16] {
         when Session.State
            | SignedIn -> {
               Text("Signed in")

               #signOut
               FormButton(Title: "Sign out") {
                  on press -> { do Leave() }
               }
               when Me {
                  otherwise -> { NotesHome() }
            }  }
            | Restoring -> Text("Restoring session…")
            | otherwise -> Login()
}  }  }

view Login() {
   state Flow = SignInFlow()
   state CodeFlow = SignInFlow(Method: "EmailCode")
   state Supplied = false
   state EmailCode = false
   state PresentedProblem = ""
   action ExistingAccount() {
      set Flow.Registration = false
      do Flow.Submit()
   }
   action PresentLogin() {
      when do SignIn()
         | cancelled -> { set PresentedProblem = "Presented sign in cancelled" }
         | error -> Message { set PresentedProblem = Message }
         | otherwise -> { }
   }
   render Col() [hug, gap 12] {
      Text("Sign in to your notes")

      #presentSignIn
      FormButton(Title: "Open sign-in dialog") {
         on press PresentLogin
      }
      if PresentedProblem is not empty {
         TextMultiline(PresentedProblem)
      }

      #toggleSignIn
      FormButton(Title: "Switch sign-in UI") {
         on press -> { toggle Supplied }
      }

      #toggleMethod
      FormButton(Title: "Use email code") {
         on press -> { toggle EmailCode }
      }
      when EmailCode
         | true -> CodeLogin(CodeFlow, Supplied)
         | otherwise -> { when Supplied
            | true -> SignInView(Flow)
            | otherwise -> {
               if Flow.Step == "Code" or Flow.Step == "Cancelled" {
                  CodeLogin(Flow, false)
               }
               if Flow.Step != "Code" and Flow.Step != "Cancelled" {
                  Row() [hug, gap 8, content left bottom] {
                     #email
                     TextInput(Value: Flow.Email, Label: "Account email") [claim 1] {
                        on submit ExistingAccount
                     }

                     #fillEmail
                     FormButton(Title: "Fill email") [hug] {
                        on press -> { set Flow.Email = ReviewEmail }
                  }  }
                  Row() [hug, gap 8, content left bottom] {
                     #password
                     TextInput(Value: Flow.Password, Label: "Password", Secure: true) [claim 1] {
                        on submit ExistingAccount
                     }

                     #fillPassword
                     FormButton(Title: "Fill password") [hug] {
                        on press -> { set Flow.Password = ReviewPassword }
                  }  }

                  #submitSignIn
                  FormButton(Title: "Sign in", Disabled: Flow.Running) {
                     on press ExistingAccount
                  }

                  #register
                  FormButton(Title: "Create account", Disabled: Flow.Running) {
                     on press -> {
                        set Flow.Registration = true
                        do Flow.Submit()
                  }  }
                  if Flow.Problem is not empty {
                     TextMultiline(Flow.Problem)
                  }

                  #cancelSignIn
                  FormButton(Title: "Cancel sign in") {
                     on press -> { do Flow.Cancel() }
               }  }
            } }
}  }

view CodeLogin(Flow LoginFlow, Supplied boolean) {
   render Col() [hug, gap 12] {
      when Supplied
         | true -> SignInView(Flow)
         | otherwise -> {
            if Flow.Step == "Cancelled" {
               Text("Sign in cancelled")

               #retryCode
               FormButton(Title: "Try again") {
                  on press -> { do Flow.Reset() }
            }  }
            if Flow.Step == "Code" {
               Text("Enter your code")

               #code
               TextInput(Value: Flow.Code, Label: "Code", Secure: true) {
                  on submit -> { do Flow.Verify() }
               }

               #verifyCode
               FormButton(Title: "Verify code", Disabled: Flow.Running) {
                  on press -> { do Flow.Verify() }
               }

               #resendCode
               FormButton(Title: "Resend code", Disabled: Flow.Running or Flow.RetryAfter > 0) {
                  on press -> { do Flow.Resend() }
            }  }
            if Flow.Step != "Code" and Flow.Step != "Cancelled" {
               Text("Email-code sign in")
               Row() [hug, gap 8, content left bottom] {
                  #codeEmail
                  TextInput(Value: Flow.Email, Label: "Email for code") [claim 1] {
                     on submit -> { do Flow.SendCode() }
                  }

                  #fillCodeEmail
                  FormButton(Title: "Fill email") [hug] {
                     on press -> { set Flow.Email = ReviewEmail }
               }  }

               #sendCode
               FormButton(Title: "Send code", Disabled: Flow.Running) {
                  on press -> { do Flow.SendCode() }
            }  }
            if Flow.Problem is not empty {
               TextMultiline(Flow.Problem)
            }

            #cancelCode
            FormButton(Title: "Cancel code sign in") {
               on press -> { do Flow.Cancel() }
}  }  }  }

view NotesHome() {
   state Body = ""
   query Mine = Me.Notes with {
      order by CreatedAt desc
   }
   action Add() {
      check Body is not empty
      create Note {
         Owner: Me,
         Body: Body
      }
      set Body = ""
   }
   render Col() {
      Text("Hello { Me.DisplayName }")
      if Me.IsIncomplete {
         Text("Complete your profile")
      }
      AccountView()

      #newNote
      TextInput(Value: Body, Label: "New note") {
         on submit Add
      }

      #addNote
      FormButton(Title: "Add note") {
         on press Add
      }
      loop Mine / Note {
         Text(Note.Body)
}  }  }
