use AuthReview from ./

test "Auth review" {
   test "fills review credentials without submitting either sign-in flow" {
      run AuthReview
      press #fillEmail
      expect #email input value "narcvs+tao-clerk-test@gmail.com"
      expect #password input value ""
      press #fillPassword
      expect #password input value "TaoReview!Violet-27-River"
      expect missing text "Signed in"
      press #toggleMethod
      press #fillCodeEmail
      expect #codeEmail input value "narcvs+tao-clerk-test@gmail.com"
      expect missing text "Enter your code"
      expect missing text "Signed in"
   }
   test "reports cancellation from the presented sign-in action" {
      run AuthReview
      press #presentSignIn
      expect text "Sign in"
      press "Cancel"
      expect text "Presented sign in cancelled"
      expect missing text "Signed in"
   }
   test "completes the presented sign-in action" {
      run AuthReview
      press #presentSignIn
      enter "alice@example.com" into label "Email"
      press "Send code"
      enter "123456" into label "Code"
      press "Verify"
      expect text "Signed in"
   }
   test "signs in with the headless action and signs out" {
      run AuthReview
      enter "alice@example.com" into #email
      enter "test-password" into #password
      press #submitSignIn
      expect text "Signed in"
      press #signOut
      expect text "Sign in to your notes"
      expect missing text "Signed in"
   }
   test "retries a rejected code in custom UI" {
      run AuthReview
      press #toggleMethod
      enter "alice@example.com" into #codeEmail
      press #sendCode
      expect text "Enter your code"
      expect text "Resend code"
      expect missing text "Send code"
      expect missing text "Signed in"
      enter "wrong" into #code
      press #verifyCode
      expect text "The code was not accepted. Try again."
      enter "123456" into #code
      press #verifyCode
      expect text "Signed in"
   }
   test "cancels a pending email challenge" {
      run AuthReview
      press #toggleMethod
      enter "alice@example.com" into #codeEmail
      press #sendCode
      press #cancelCode
      expect text "Sign in cancelled"
      expect missing text "Enter your code"
      press #retryCode
      expect text "Email-code sign in"
      press #sendCode
      expect text "Enter your code"
      expect missing text "Signed in"
   }
   test "completes the same email flow through supplied UI" {
      run AuthReview
      press #toggleMethod
      press #toggleSignIn
      enter "alice@example.com" into label "Email"
      press "Send code"
      enter "123456" into label "Code"
      press "Verify"
      expect text "Signed in"
   }
}

fixture AliceNotes {
   account Alice {
      DisplayName: "Alice"
   }
   account Bob {
      DisplayName: "Bob"
   }
   signed in as Alice
   create Note {
      Owner: Alice,
      Body: "Alice private note"
   }
   create Note {
      Owner: Bob,
      Body: "Bob private note"
   } for Bob
}

test "Account data" with AliceNotes {
   test "keeps profile edits local until submission" {
      run AuthReview
      enter "Alicia" into label "Display name"
      expect text "Hello Alice"
      expect missing text "Hello Alicia"
      press "Save profile"
      expect text "Hello Alicia"
   }
   test "loads the signed-in profile and only its linked notes" {
      run AuthReview

      expect text "Hello Alice"
      expect text "Alice private note"
      expect missing text "Bob private note"
   }
   test "creates a note with the bound account and clears it on sign-out" {
      run AuthReview
      enter "New private note" into #newNote
      press #addNote
      expect text "New private note"
      press #signOut
      expect missing text "New private note"
      expect missing text "Alice private note"
      expect text "Sign in to your notes"
   }
}
