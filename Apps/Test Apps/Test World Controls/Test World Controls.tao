use CloudKit from @tao/data/providers/cloudkit
use Dev from @tao/data/providers/dev
use ICloud from @tao/data/providers/icloud
use StackNav from @tao/nav
use Col, FormButton, Text, TextInput from @tao/ui

project {
   id "test-world-controls"
   name "Test World Controls"
   version "0.1.0"
}

app TestWorldApp {
   Name "Test World"
   Navigator StackNav {
      Initial Main
   }
   Datasource CloudKit { }
}

app TestWorldICloudApp {
   Name "Test World iCloud"
   Navigator StackNav {
      Initial Main
   }
   Datasource ICloud { }
}

app TestWorldDevApp {
   Name "Test World Dev"
   Navigator StackNav {
      Initial Main
   }
   Datasource Dev { }
}

data Notes / Note {
   Title text,
}

scene Main() {
   Title "Test World"
   state Draft = ""
   query Notes = Notes with { }
   action Add() {
      create Note {
         Title: Draft
      }
      set Draft = ""
   }
   render Col() {
      guard Notes {
         error -> Message { Text(Message) }
      }

      #draft
      TextInput(Value: Draft, Label: "Title") {
         on submit Add
      }

      #add
      FormButton("Add") {
         on press Add
      }
      loop Notes / Note {
         Col() {
            Text(Note.Title)
            Text("Queued { Note.WritesQueued }")
            Text("Failed { Note.WritesFailed }")
            Text(Note.WriteError)

            #retry
            FormButton("Retry") {
               on press -> { retry Note }
}  }  }  }  }
