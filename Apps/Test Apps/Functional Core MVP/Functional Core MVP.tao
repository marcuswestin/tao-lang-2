use StackNav from @tao/nav
use Button, Col, Text from @tao/ui

app FunctionalCoreMVP {
   Name "Functional Core MVP"
   Navigator StackNav {
      Initial MainView
}  }

function HasCount(Count number) returns boolean {
   return Count > 0 and not false
}

function CountLabel(Count number) returns text {
   return "Count: { Count }"
}

function NextLabel(Count number) returns text {
   return "Next: { Count + 1 }"
}

function PresenceLabel(Present boolean) returns text {
   return when Present {
      true -> "Ready"
      otherwise -> "Missing{ none }"
}  }

ui MainView() {
   state Count = 2
   state Visible = true
   state AsyncStarted = false
   state AsyncContinued = false
   action HideCount() {
      guard HasCount(Count) true -> {
         toggle Visible
         set Count = 0
   }  }
   action LaunchAsync() {
      async {
         set AsyncStarted = true
      }
      set AsyncContinued = true
   }
   render Col() [gap 8, pad 12] {
      Text("Functional core")
      Text(PresenceLabel(true))
      when Visible {
         true -> { Text("Visible") }
         otherwise -> { Text("Hidden") }
      }
      when HasCount(Count) {
         true -> {
            Text(CountLabel(Count))
            Text(NextLabel(Count))
         }
         otherwise -> { Text("Empty") }
      }
      loop ["Inbox", "Today"] / Label {
         Text(Label)
      }
      when AsyncStarted {
         true -> { Text("Async launched") }
         otherwise -> { Text("Async idle") }
      }
      when AsyncContinued {
         true -> { Text("Action continued") }
         otherwise -> { Text("Continuation idle") }
      }
      Button("Hide count") {
         on press HideCount
      }
      Button("Launch async") {
         on press LaunchAsync
}  }  }
