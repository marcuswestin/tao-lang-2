use Button, Col, Text from @tao/ui

app FunctionalCoreMVP {
   view MainView
}

function HasCount Count is number returns boolean = Count > 0 and not false

function CountLabel Count is number returns text = interpolate "Count: ", Count

function NextLabel Count is number returns text = interpolate "Next: ", Count + 1

function PresenceLabel Present is boolean returns text = when
   Present -> "Ready"
   otherwise -> interpolate "Missing", none

view MainView {
   state Count = 2
   state Visible = true
   action HideCount {
      when
         HasCount(Count) -> {
            toggle Visible
            set Count = 0
         }
         otherwise -> { }
   }
   render Col() [gap 8, pad 12] {
      Text("Functional core")
      Text(PresenceLabel(true))
      when
         Visible -> {
            Text("Visible")
         }
         otherwise -> {
            Text("Hidden")
         }
      when
         HasCount(Count) -> {
            Text(CountLabel(Count))
            Text(NextLabel(Count))
         }
         otherwise -> {
            Text("Empty")
         }
      for Label in ["Inbox" "Today"] {
         Text(Label)
      }
      Button("Hide count", HideCount)
}  }
