use Memory from @tao/data/providers/memory
use StackNav from @tao/nav
use Col, Panes, Text from @tao/ui

project {
   id "test-device-and-fixture"
   name "Test Device and Fixture"
   version "0.1.0"
}

app WordFlower {
   Name "WordFlower"
   Navigator StackNav {
      Initial MainView
   }
   Datasource Memory { }
}

workspace
data Workspaces / Workspace {
   Name text,
}

workspace
data FocusSessions / FocusSession {
   Label text,

   local only,
}

scene MainView() {
   Title "WordFlower"
   query Workspaces = Workspaces with { }
   query FocusSessions = FocusSessions with { }
   render Panes() [gap 16] {
      #workspaceList
      Col() [claim 2] {
         when Workspaces {
            empty -> { Text("No workspaces yet") }
            otherwise -> { loop Workspaces / Workspace {
               Text(Workspace.Name)
            } }
      }  }

      #detailPane
      Col() [claim 1] {
         Text("Detail pane")
         loop FocusSessions / FocusSession {
            Text(FocusSession.Label)
}  }  }  }
