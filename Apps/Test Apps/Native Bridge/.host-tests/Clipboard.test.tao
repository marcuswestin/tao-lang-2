use NativeBridge from ../App.tao

test "Native Clipboard acceptance" {
   test "round trips native clipboard formats and manages change subscriptions" {
      run NativeBridge
      press "Clipboard · Expo"
      press "Copy text"
      expect text "Status: Text write returned: true"
      press "Read text"
      expect text "Read result: Hello from Native Bridge"
      press "Has text?"
      expect text "Status: Has text: true"
      press "Has image?"
      expect text "Status: Has image: false"
      press "Read PNG"
      expect text "Status: PNG read complete"
      expect text "No image read"
      press "Copy sample HTML"
      expect text "Status: HTML write returned: true"
      press "Read HTML"
      expect text "Status: HTML read complete"
      press "Read text"
      expect text "Status: Text read complete"
      expect text "Read result: HTML from Native Bridge"
      press "Copy sample image"
      expect text "Status: Copied a 1 × 1 sample image"
      press "Has image?"
      expect text "Status: Has image: true"
      press "Read PNG"
      expect text "Status: PNG read complete"
      expect text "Image: 1 × 1"
      // REMOVAL CANDIDATE: PNG already covers image readback; JPEG retains native format-enum propagation acceptance.
      press "Read JPEG"
      expect text "Status: JPEG read complete"
      expect text "Image: 1 × 1"
      press "Copy sample URL"
      press "Read URL"
      expect text "Status: URL read complete"
      expect text "URL: https://example.com/native-bridge"
      press "Has URL?"
      expect text "Status: Has URL: true"
      press "Start listening"
      expect text "Listening"
      press "Copy text"
      expect text "Change listener"
      expect text "Clipboard change received"
      press "Stop listening"
      expect text "Not listening"
      press "Reset change count"
      expect text "Clipboard changes: 0"
      press "Copy sample URL"
      press "Read URL"
      expect text "Status: URL read complete"
      expect text "Clipboard changes: 0"
      press "Start listening"
      press "Copy text"
      expect text "Clipboard change received"
      press "Stop via deprecated API"
      expect text "Not listening"
      press "Reset change count"
      expect text "Clipboard changes: 0"
      press "Copy sample URL"
      press "Read URL"
      expect text "Status: URL read complete"
      expect text "Clipboard changes: 0"
      press "Start listening"
      back
      press "Clipboard · Expo"
      expect text "Not listening"
      expect text "Clipboard changes: 0"
      press "Start listening"
      press "Copy text"
      expect text "Clipboard change received"
      back
}  }
