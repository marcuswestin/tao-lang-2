use StackNav from @tao/nav
use Box, Col, Panes, Row, ScrollView, Stack, Text, TextFrame, TextMultiline, WrappingRow from @tao/ui
// This app exercises layout clauses on a control, so it binds the tier that honors them rather than
// the platform-native default, which renders the OS's own chrome.
use Button from @tao/ui/basic

app LayoutAndAppShell {
   id "layout-app-shell"
   version "0.1.0"
   name "Layout and App Shell"
   Navigator StackNav {
      Initial MainView
}  }

let PageTitle = "Layout and app shell"
let BodyCopy = "This screen should sit inside the default Tao app shell."

scene MainView() {
   Title PageTitle
   action Noop() { }
   render Col() [fill, content top stretch, gap 12, pad 16] {
      Text(PageTitle) [width fill]
      TextMultiline(BodyCopy) [width fill]
      TextFrame("Safe default app frame") [width fill]
      Stack() [content top stretch, gap 8, pad 12, margin bottom 4, width fill, hug] {
         Text("Stack uses column content defaults, gap, pad, margin, width fill, and hug.")
         Button("Primary action") [centered] {
            on press Noop
      }  }
      Row() [content spread center, gap 8, pad horizontal 12 vertical 8, width fill, rigid] {
         Text("Left")
         Text("Right") [aligned center]
      }
      Box() [content center, gap 6, pad 8, margin horizontal 4, hug, rigid] {
         Text("Box frame")
      }
      Col() [content top stretch, gap 8, pad top 8 bottom 12 left 10 right 10, width fill, compress] {
         Text("Compressible body row below.")
         Row() [content left center, gap 8, width fill, compress] {
            Text("Flexible text") [claim 2, compress]
            Button("Rigid") [rigid] {
               on press Noop
      }  }  }
      WrappingRow() [content top left, gap 8, pad 8, width fill, hug, compress] {
         Text("Safe area")
         Text("Keyboard")
         Text("Deterministic")
         Text("Cross-platform")
      }

      // A declaration's header clause is its public default: the first frame keeps it, the second
      // replaces the padding with zero, the third clears it with `none`. The frame's own `gap` is
      // private to its root and stays whatever a caller says.
      Frame("Default frame") {
         Text("Padded by the header")
      }
      Frame("Zero frame") [pad 0] {
         Text("Padding set to zero by the caller")
      }
      Frame("Flush frame") [pad none, gap 0] {
         Text("Padding cleared by the caller; the gap is the frame's own")
      }

      #layoutPanes
      Panes() [gap 16, width fill] {
         #layoutScroll
         ScrollView() [claim 2, gap 6, pad 8] {
            #layoutReadable
            Col() [width max 720] {
               Text("Adaptive primary pane")
         }  }

         #layoutSecondary
         Col() [claim 1] {
            Text("Adaptive secondary pane")
}  }  }  }

// A labelled frame whose padding is public (the header) and whose gap is private (the root).
view Frame(Label text) [pad 12] {
   render Col() [gap 6, width fill] {
      Text(Label)
      @@content
}  }
