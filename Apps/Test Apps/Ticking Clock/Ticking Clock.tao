use StackNav from @tao/nav
use Interval from @tao/time
use Col, FormButton, Text from @tao/ui

app TickingClock {
   Name "Ticking Clock"
   Navigator StackNav {
      Initial MainView
}  }

// A ticker is held like any other view-local value. `Elapsed` is an ordinary derivation over it, so
// it recomputes on every tick rather than being evaluated once.
ui MainView() {
   state Tick = Interval(1.s)
   state StartedAt = now
   let Elapsed = Tick.Value - StartedAt
   action Pause() {
      do Tick.Stop()
   }
   action Resume() {
      do Tick.Start()
   }
   render Col() [gap 6] {
      Text("Elapsed: { Elapsed.Clock }")
      Text("Elapsed seconds: { Elapsed.s }")
      Text(when Tick.Running "Running" / not "Paused")

      #pause
      FormButton("Pause") {
         on press Pause
      }

      #resume
      FormButton("Resume") {
         on press Resume
}  }  }
