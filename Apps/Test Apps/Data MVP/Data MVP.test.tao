use DataMVPApp from ./

test "Data MVP" {
   test "runs reactive related CRUD with filtering and ordering" {
      run DataMVPApp

      expect text "No workspaces yet"
      enter "Home" into #workspaceName
      press #addWorkspace
      expect text "Home"
      expect text "No open tasks"
      enter "Plan launch" into #taskTitle
      press #addTask
      expect text "Plan launch"
      press #renameTask
      expect missing text "Plan launch"
      expect text "Updated task"
      press #completeTask
      expect text "No open tasks"
      expect text "Updated task"
      press #deleteTask
      expect text "No completed tasks"
   }
   test "keeps stored rows across a relaunch" {
      run DataMVPApp

      expect text "No workspaces yet"
      enter "Kept" into #workspaceName
      press #addWorkspace
      expect text "Kept"
      relaunch
      // A relaunch is the person quitting and reopening the app, so the rows they stored are still
      // there. Only the launched instance's own state is dropped.
      expect text "Kept"
   }
   test "cascades relationship rows when a workspace is deleted" {
      run DataMVPApp
      enter "Work" into #workspaceName
      press #addWorkspace
      enter "Related task" into #taskTitle
      press #addTask
      expect text "Related task"
      press #deleteWorkspace
      expect missing text "Related task"
      expect text "No workspaces yet"
   }
   test "saves Memory rows while offline" {
      run DataMVPApp
      network offline
      enter "Offline" into #workspaceName
      press #addWorkspace
      expect text "Offline"
   }
   test "shows a declared snapshot save failure" {
      run DataMVPApp
      datasource fails after create Workspace "save was rejected"
      enter "Rejected" into #workspaceName
      press #addWorkspace
      expect text "Could not save data: save was rejected"
   }
}
