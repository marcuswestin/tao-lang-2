use Memory from @tao/data
use StackNav from @tao/nav
use Col, FormButton, Text, TextInput from @tao/ui

app DataMVPApp {
   Name "Data MVP"
   Navigator StackNav {
      Initial MainView
   }
   Datasource Memory { }
}

workspace
data Workspaces / Workspace {
   Name text
   CreatedAt time (default now)
   Tasks (owned)

   index CreatedAt
   order by Name
}

workspace
data Tasks / Task {
   Title text
   Done yes / Open no
   Workspace

   order by Title
}

view MainView() {
   Title "Data MVP"
   state WorkspaceDraft = ""
   state TaskDraft = ""
   query Workspaces { }
   query Tasks as OpenTasks {
      where is Open
   }
   query Tasks as CompletedTasks {
      where is Done
   }
   action AddWorkspace() {
      create Workspace {
         Name: WorkspaceDraft
      }
      set WorkspaceDraft = ""
   }
   render Col() [gap 10, pad 16] {
      Text("Data MVP")
      guard Workspaces {
         loading -> { Text("Loading local data…") }
         error -> Message { Text(Message) }
      }

      #workspaceName
      TextInput(Value: WorkspaceDraft, Label: "Workspace name") {
         on submit AddWorkspace
      }

      #addWorkspace
      FormButton("Add workspace") {
         on press AddWorkspace
      }

      #taskTitle
      TextInput(Value: TaskDraft, Label: "Task title") {
         on submit -> { }
      }
      when Workspaces {
         empty -> { Text("No workspaces yet") }
         otherwise -> {
            #workspaces
            loop Workspaces / Workspace {
               Col() {
                  Text(Workspace.Name)

                  #addTask
                  FormButton("Add task") {
                     on press -> {
                        create Task {
                           Title: TaskDraft
                           Workspace
                        }
                        set TaskDraft = ""
                  }  }

                  #deleteWorkspace
                  FormButton("Delete workspace") {
                     on press -> { delete Workspace }
      }  }  }  }  }
      when OpenTasks {
         empty -> { Text("No open tasks") }
         otherwise -> {
            #openTasks
            loop OpenTasks / Task {
               Col() {
                  Text(Task.Title)

                  #renameTask
                  FormButton("Rename task") {
                     on press -> { update Task {
                        Title: "Updated task"
                     } }
                  }

                  #completeTask
                  FormButton("Complete task") {
                     on press -> { update Task {
                        Done
                     } }
      }  }  }  }  }
      when CompletedTasks {
         empty -> { Text("No completed tasks") }
         otherwise -> {
            #completedTasks
            loop CompletedTasks / Task {
               Col() {
                  Text(Task.Title)

                  #deleteTask
                  FormButton("Delete task") {
                     on press -> { delete Task }
}  }  }  }  }  }  }
