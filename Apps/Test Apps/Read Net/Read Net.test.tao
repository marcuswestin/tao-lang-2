use ReadNetApp from ./

test "Read Net" {
   test "shows the project's net for a deleted note behind a bare guard" {
      run ReadNetApp
      enter "Groceries" into #noteTitle
      press #addNote
      press #openNetNote
      expect text "Groceries"
      press #deleteNote
      expect text "Read Net: this note is gone"
      expect missing text "Groceries"
   }
   test "lets a guard that names missing win over the net" {
      run ReadNetApp
      enter "Errands" into #noteTitle
      press #addNote
      press #openSiteNote
      press #deleteNote
      expect text "Deleted here"
      expect text "The deleted note kept its id"
      expect missing text "Read Net: this note is gone"
   }
}
