use Memory from @tao/data/providers/memory
use StackNav from @tao/nav
use Col, FormButton, Spinner, Text, TextInput from @tao/ui

app ReadNetApp {
   id "read-net"
   version "0.1.0"
   name "Read Net"
   Navigator StackNav {
      Initial NotesView
   }
   Datasource Memory { }
   guard {
      none -> { Text("Read Net: this note is gone") }
}  }

// This app replaces only `none`; every other exceptional case keeps the runtime's.
app ReadNetMissingVariant = ReadNetApp with {
   id "read-net-missing",
   name "Read Net Missing Variant"
   guard {
      none -> { Text("Variant: this note is gone") }
}  }

app ReadNetErrorVariant = ReadNetApp with {
   id "read-net-error",
   name "Read Net Error Variant"
   guard {
      error -> Context { Text("Read Net error: { Context.Message }") }
}  }

// An independent app in this project replaces loading and error while leaving none to the runtime.
app RuntimeDefaultApp {
   id "read-net-runtime-default"
   version "0.1.0"
   name "Read Net Runtime Default"
   Navigator StackNav {
      Initial RuntimeNotesView
   }
   Datasource Memory { }
   guard {
      loading -> Spinner()
      error -> Context { Text("Runtime Default: { Context.Message }") }
}  }

project
data Notes / Note {
   Title text,
}

scene NotesView() {
   Title "Notes"
   state TitleDraft = ""
   query Notes = Notes with { }
   action AddNote() {
      create Note {
         Title: TitleDraft
      }
      set TitleDraft = ""
   }
   render Col() {
      #noteTitle
      TextInput(Value: TitleDraft, Label: "Note title") {
         on submit AddNote
      }

      #addNote
      FormButton("Add note") {
         on press AddNote
      }
      guard Notes
      loop Notes / Note {
         Col() {
            Text(Note.Title)

            #openNetNote
            FormButton("Open behind a bare guard") {
               on press -> { present NetNoteView(Note) }
            }

            #openSiteNote
            FormButton("Open behind a missing guard") {
               on press -> { present SiteNoteView(Note) }
}  }  }  }  }

// A bare guard names no case, so a deleted note reaches the app's net.
scene NetNoteView(Note) {
   Title "Bare guard"
   render Col() {
      guard Note
      Text(Note.Title)

      #deleteNote
      FormButton("Delete note") {
         on press -> { delete Note }
}  }  }

// A guard that names `none` handles it itself; the net keeps the cases it leaves unnamed.
scene SiteNoteView(Note) {
   Title "Missing guard"
   render Col() {
      guard Note {
         none -> {
            Text("Deleted here")
            if Note.Id is not empty {
               Text("The deleted note kept its id")
      }  }  }
      Text(Note.Title)

      #deleteNote
      FormButton("Delete note") {
         on press -> { delete Note }
}  }  }

project
data RuntimeNotes / RuntimeNote {
   Title text,
}

scene RuntimeNotesView() {
   Title "Notes"
   state TitleDraft = ""
   query RuntimeNotes = RuntimeNotes with { }
   action AddRuntimeNote() {
      create RuntimeNote {
         Title: TitleDraft
      }
      set TitleDraft = ""
   }
   render Col() {
      #runtimeNoteTitle
      TextInput(Value: TitleDraft, Label: "Note title") {
         on submit AddRuntimeNote
      }

      #addRuntimeNote
      FormButton("Add note") {
         on press AddRuntimeNote
      }
      guard RuntimeNotes
      loop RuntimeNotes / RuntimeNote {
         Col() {
            Text(RuntimeNote.Title)

            #openRuntimeNote
            FormButton("Open") {
               on press -> { present RuntimeNoteView(RuntimeNote) }
}  }  }  }  }

scene RuntimeNoteView(RuntimeNote) {
   Title "Note"
   render Col() {
      guard RuntimeNote
      Text(RuntimeNote.Title)

      #deleteRuntimeNote
      FormButton("Delete note") {
         on press -> { delete RuntimeNote }
}  }  }
