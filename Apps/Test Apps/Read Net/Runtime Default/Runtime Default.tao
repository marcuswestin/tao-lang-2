use Memory from @tao/data/providers/memory
use StackNav from @tao/nav
use Col, FormButton, Spinner, Text, TextInput from @tao/ui

// A separate project, so its net can differ from the enclosing Read Net project's: it replaces
// `loading` and `error` and leaves `missing` to the runtime.
app RuntimeDefaultApp {
   Name "Read Net Runtime Default"
   Navigator StackNav {
      Initial NotesView
   }
   Datasource Memory { }
}

guard default {
   loading -> Spinner()
   error -> Message { Text("Runtime Default: { Message }") }
}

workspace
data Notes / Note {
   Title text
}

scene NotesView() {
   Title "Notes"
   state TitleDraft = ""
   query Notes { }
   action AddNote() {
      create Note {
         Title: TitleDraft
      }
      set TitleDraft = ""
   }
   render Col() {
      #noteTitle
      TextInput(Value: TitleDraft, Label: "Note title") {
         on submit AddNote
      }

      #addNote
      FormButton("Add note") {
         on press AddNote
      }
      guard Notes
      loop Notes / Note {
         Col() {
            Text(Note.Title)

            #openNote
            FormButton("Open") {
               on press -> { present NoteView(Note) }
}  }  }  }  }

scene NoteView(Note) {
   Title "Note"
   render Col() {
      guard Note
      Text(Note.Title)

      #deleteNote
      FormButton("Delete note") {
         on press -> { delete Note }
}  }  }
