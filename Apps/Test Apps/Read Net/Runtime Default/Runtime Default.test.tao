use RuntimeDefaultApp from ./

test "Read Net runtime default" {
   test "keeps the runtime's missing handling when the project's net replaces other cases" {
      run RuntimeDefaultApp
      enter "Receipts" into #noteTitle
      press #addNote
      press #openNote
      expect text "Receipts"
      press #deleteNote
      expect text "This is gone"
      expect missing text "Receipts"
   }
}
