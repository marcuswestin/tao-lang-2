use AbortController, Directory, DirectoryCreateOptions, File, FileCreateOptions, NativeValueKind, NativeValueNumber, PathInfoIsDirectoryTrue, PathsCacheGet, ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultAsReadableStreamReadDoneResultUint8ArrayArrayBuffer, ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultAsReadableStreamReadValueResultUint8ArrayArrayBuffer, ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultIsReadableStreamReadDoneResultUint8ArrayArrayBuffer, ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultIsReadableStreamReadValueResultUint8ArrayArrayBuffer, ReadableStreamUint8ArrayArrayBuffer, ReleaseNativeValue, RelocationOptions from @tao/device/files
use Button, Col, ScrollView, TextMultiline from @tao/ui

public
scene FilesAcceptance() {
   Title "Files acceptance"
   state Status = "Ready"
   state ReadText = "Not read"
   state ByteSize = 0
   state Bytes is list of number = []
   state HandleBytes is list of number = []
   state CopyName = "Not copied"
   state StreamLocked = no
   state StreamLockedBefore = no
   state StreamBytes is list of number = []
   state StreamChunk = no
   state StreamEnd = no
   state AbortedBefore = no
   state AbortedAfter = no
   state ReasonKind = "Not read"
   state ReasonNumber = 0
   state AbortCheck = "Not checked"
   action Roundtrip() {
      set StreamBytes = []
      set StreamChunk = no
      set StreamEnd = no
      do Cleanup()
      let Cache = do PathsCacheGet()
      defer Cache.ReleaseReference()
      let CacheUri = do Cache.UriGet()
      let Root = do Directory.Construct(Uris: [CacheUri, "tao-modern-photos-files-acceptance"])
      defer Root.ReleaseReference()
      do Root.Create(Options: DirectoryCreateOptions {
         Idempotent: true
      })
      let RootUri = do Root.UriGet()
      let Document = do File.Construct(Uris: [RootUri, "text.txt"])
      defer Document.ReleaseReference()
      do Document.Create(Options: FileCreateOptions {
         Overwrite: true
      })
      do Document.Write(Content: "Hello native")
      let TextResult = do Document.Text()
      set ReadText = TextResult
      let Copy = do File.Construct(Uris: [RootUri, "copy.txt"])
      defer Copy.ReleaseReference()
      do Document.Copy(Destination: Copy, Options: RelocationOptions {
         Overwrite: true
      })
      do Copy.Rename(NewName: "renamed.txt")
      let Name = do Copy.NameGet()
      set CopyName = Name
      let ByteFile = do File.Construct(Uris: [RootUri, "bytes.bin"])
      defer ByteFile.ReleaseReference()
      do ByteFile.Create(Options: FileCreateOptions {
         Overwrite: true
      })
      do ByteFile.Write(Content: [0, 1, 127, 128, 255])
      let ByteResult = do ByteFile.Bytes()
      let Size = do ByteFile.SizeGet()
      set Bytes = ByteResult
      set ByteSize = Size
      let Handle = do ByteFile.Open()
      defer Handle.ReleaseReference()
      defer Handle.Close()
      do Handle.OffsetSet(Value: 0)
      do Handle.WriteBytes(Bytes: [0, 1, 127, 128, 255])
      do Handle.OffsetSet(Value: 0)
      let HandleResult = do Handle.ReadBytes(Length: 5)
      set HandleBytes = HandleResult
      let Stream = do ByteFile.ReadableStream()
      defer Stream.ReleaseReference()
      do InspectStream(Stream)
      let Locked = do Stream.LockedGet()
      set StreamLocked = Locked
   }
   action InspectStream(Stream ReadableStreamUint8ArrayArrayBuffer) {
      let Reader = do Stream.GetReaderWithNoArguments()
      defer Reader.ReleaseReference()
      defer Reader.ReleaseLock()
      defer Reader.Cancel()
      let LockedBefore = do Stream.LockedGet()
      set StreamLockedBefore = LockedBefore
      let Result = do Reader.Read()
      let IsChunk = do ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultIsReadableStreamReadValueResultUint8ArrayArrayBuffer(Result)
      set StreamChunk = IsChunk
      if IsChunk {
         let Chunk = do ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultAsReadableStreamReadValueResultUint8ArrayArrayBuffer(Result)
         set StreamBytes = Chunk.Value
      }
      let EndResult = do Reader.Read()
      let IsEnd = do ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultIsReadableStreamReadDoneResultUint8ArrayArrayBuffer(EndResult)
      if IsEnd {
         let End = do ReadableStreamBYOBReaderReadForUint8ArrayArrayBufferResultAsReadableStreamReadDoneResultUint8ArrayArrayBuffer(EndResult)
         set StreamEnd = End.Done is True
   }  }
   action CancelResource() {
      let Cache = do PathsCacheGet()
      defer Cache.ReleaseReference()
      let CacheUri = do Cache.UriGet()
      let Root = do Directory.Construct(Uris: [CacheUri, "tao-modern-photos-files-acceptance"])
      defer Root.ReleaseReference()
      do Root.Create(Options: DirectoryCreateOptions {
         Idempotent: true
      })
      let RootUri = do Root.UriGet()
      let ReasonFile = do File.Construct(Uris: [RootUri, "reason.json"])
      defer ReasonFile.ReleaseReference()
      do ReasonFile.Create(Options: FileCreateOptions {
         Overwrite: true
      })
      do ReasonFile.Write(Content: "7")
      let Reason = do ReasonFile.Json()
      defer ReleaseNativeValue(Reason)
      let Controller = do AbortController.Construct()
      defer Controller.ReleaseReference()
      let Signal = do Controller.SignalGet()
      defer Signal.ReleaseReference()
      let Before = do Signal.AbortedGet()
      set AbortedBefore = Before
      do Controller.Abort(Reason: Reason)
      let After = do Signal.AbortedGet()
      let ReturnedReason = do Signal.ReasonGet()
      defer ReleaseNativeValue(ReturnedReason)
      let Kind = do NativeValueKind(ReturnedReason)
      let Number = do NativeValueNumber(ReturnedReason)
      set AbortedAfter = After
      set ReasonKind = Kind
      set ReasonNumber = Number
      do Signal.ThrowIfAborted() then {
         done -> { set AbortCheck = "Unexpectedly accepted" }
         error Problem -> { set AbortCheck = "Abort rejected" }
   }  }
   action Cleanup() {
      let Cache = do PathsCacheGet()
      defer Cache.ReleaseReference()
      let CacheUri = do Cache.UriGet()
      let Root = do Directory.Construct(Uris: [CacheUri, "tao-modern-photos-files-acceptance"])
      defer Root.ReleaseReference()
      let Exists = do Root.ExistsGet()
      if Exists {
         do Root.Delete()
   }  }
   render ScrollView() {
      Col() {
         TextMultiline("Only the tao-modern-photos-files-acceptance directory inside this app's cache is written or removed.")
         TextMultiline("Status: { Status }")

         #roundtrip
         Button("Run file roundtrip") {
            on press -> do Roundtrip() then {
               done -> { set Status = "File roundtrip complete" }
               error Problem -> { set Status = "File roundtrip failed: { Problem.Message }" }
         }  }
         "Text: { ReadText }"
         "Copy name: { CopyName }"
         "Byte size: { ByteSize }"
         loop Bytes / Byte {
            "Byte: { Byte }"
         }
         loop HandleBytes / Byte {
            "Handle byte: { Byte }"
         }
         "Stream locked before release: { StreamLockedBefore }"
         "Stream chunk received: { StreamChunk }"
         loop StreamBytes / Byte {
            "Stream byte: { Byte }"
         }
         "Stream end reached: { StreamEnd }"
         "Stream locked after release: { StreamLocked }"

         #cancel
         Button("Run cancellation resource") {
            on press -> do CancelResource() then {
               done -> { set Status = "Cancellation complete" }
               error Problem -> { set Status = "Cancellation failed: { Problem.Message }" }
         }  }
         "Aborted before: { AbortedBefore }"
         "Aborted after: { AbortedAfter }"
         "Reason kind: { ReasonKind }"
         "Reason number: { ReasonNumber }"
         "Abort check: { AbortCheck }"

         #cleanup
         Button("Remove owned files") {
            on press -> do Cleanup() then {
               done -> { set Status = "Owned files removed" }
               error Problem -> { set Status = "Cleanup failed: { Problem.Message }" }
}  }  }  }  }
