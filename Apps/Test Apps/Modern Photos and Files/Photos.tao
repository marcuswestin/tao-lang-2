use AssetField, AssetMetadata, GetPermissionsAsync, GranularPermission, MediaType, PermissionResponseAccessPrivilegesAll, PermissionResponseAccessPrivilegesLimited, PermissionResponseAccessPrivilegesNone, Query, RequestPermissionsAsync, SortDescriptor from @tao/device/photos
use Button, Col, ScrollView, TextMultiline from @tao/ui

public
scene PhotosAcceptance() {
   Title "Photos acceptance"
   state Status = "Ready"
   state Permission = "Not checked"
   state Access = "Not checked"
   state Granted = no
   state CanAskAgain = no
   state Offset = 0
   state Count = 0
   state Assets is list of AssetMetadata = []
   action CheckPermissions() {
      let Result = do GetPermissionsAsync(GranularPermissions: [GranularPermission_Photo])
      set Permission = pick Result.Status {
         GRANTED -> "granted"
         UNDETERMINED -> "undetermined"
         otherwise -> "denied"
      }
      set Access = "not reported"
      if Result.AccessPrivileges == All {
         set Access = "all"
      }
      if Result.AccessPrivileges == Limited {
         set Access = "limited"
      }
      if Result.AccessPrivileges == None {
         set Access = "none"
      }
      set Granted = Result.Granted
      set CanAskAgain = Result.CanAskAgain
   }
   action AskPermission() {
      do RequestPermissionsAsync(GranularPermissions: [GranularPermission_Photo])
      do CheckPermissions()
   }
   action QueryPage() {
      check Granted
      let AssetQuery = do Query.Construct()
      defer AssetQuery.ReleaseReference()
      do AssetQuery.EqForAssetFieldMEDIATYPE(Value: IMAGE)
      do AssetQuery.OrderBy(SortDescriptors: SortDescriptor {
         Key: CREATION_TIME,
         Ascending: true
      })
      do AssetQuery.Limit(Limit: 2)
      do AssetQuery.Offset(Offset: Offset)
      let Result = do AssetQuery.ExeForMetadata()
      set Assets = Result
      set Count = Result.Count
   }
   render ScrollView() {
      Col() {
         TextMultiline("Permissions are checked without prompting. Request access opens the platform consent flow. Queries only read existing photo metadata.")
         TextMultiline("Status: { Status }")

         #permission
         Button("Check current permission") {
            on press -> do CheckPermissions() then {
               done -> { set Status = "Permission check complete" }
               error Problem -> { set Status = "Permission check failed: { Problem.Message }" }
         }  }

         #request
         Button("Request photo access") {
            on press -> do AskPermission() then {
               done -> { set Status = "Permission request complete" }
               error Problem -> { set Status = "Permission request failed: { Problem.Message }" }
         }  }
         "Permission: { Permission }"
         "Access: { Access }"
         "Can ask again: { CanAskAgain }"

         #firstPage
         Button("Read first photo page", Disabled: not Granted) {
            on press -> {
               set Offset = 0
               do QueryPage() then {
                  done -> { set Status = "Photo query complete" }
                  error Problem -> { set Status = "Photo query failed: { Problem.Message }" }
         }  }  }

         #nextPage
         Button("Read next photo page", Disabled: not Granted) {
            on press -> {
               set Offset += 2
               do QueryPage() then {
                  done -> { set Status = "Photo query complete" }
                  error Problem -> { set Status = "Photo query failed: { Problem.Message }" }
         }  }  }
         "Offset: { Offset }"
         "Returned photos: { Count }"

         #photos
         loop Assets / Asset {
            Col() {
               "Photo id: { Asset.Id }"
               "Photo filename: { Asset.Filename }"
}  }  }  }  }
