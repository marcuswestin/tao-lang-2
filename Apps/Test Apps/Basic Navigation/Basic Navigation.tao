use StackNav from @tao/nav/basic
use Col, FormButton, Text from @tao/ui

app BasicNavigation {
   Name "Basic Navigation"
   Navigator StackNav {
      Initial BasicHome
}  }

view BasicHome() {
   Title "Basic navigation"
   state Confirmed = false
   let Confirmation = when Confirmed "yes" / not "no"
   action ConfirmBasicNavigation() {
      Title "Confirm basic navigation"
      set Confirmed = true
   }
   command Confirm = ConfirmBasicNavigation() with {
      Icon "checkmark"
   }
   Toolbar { Confirm }
   render Col() [gap 8] {
      Text("Basic navigation host")
      Text("Confirmed: { Confirmation }")

      // The same intent stays available as in-content product UI; the host toolbar is additive.
      FormButton("Confirm basic navigation") {
         on press ConfirmBasicNavigation
}  }  }
