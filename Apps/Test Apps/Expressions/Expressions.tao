use Button, Col, Number, Text from @tao/ui

app Expressions {
   view MainView
}

view MainView {
   state Count = 2
   state Ready = false
   let Doubled = Count * 2
   let Total = Count + Doubled * 2 - 1
   let Half = Count / 4
   let Negated = -Count
   let Grouped = (Count + 1) * 5
   let Greeting = "Expr" + "essions"
   let Ordering = Count < 3 and Doubled >= 4
   let Either = Count == 99 or Ready
   let Blocked = not Ready
   let ReadyLabel = when
      Ready -> "Ready"
      otherwise -> "Waiting"
   let Size = when
      Count > 4 -> "large"
      Count > 1 -> "medium"
      otherwise -> "small"
   let GateLabel = when
      Blocked and Either -> "gated and either"
      Blocked -> "gated"
      otherwise -> "open"
   action Advance {
      set Count += 3
   }
   action Flip {
      toggle Ready
   }
   render Col() [fill, gap 8, pad 12] {
      Text("Operator MVP")
      Text(Greeting)
      Number(Doubled)
      Number(Total)
      Number(Half)
      Number(Negated)
      Number(Grouped)
      Text(ReadyLabel)
      Text(Size)
      Text(GateLabel)
      Button("Advance", Advance)
      Button("Flip", Flip)
}  }
