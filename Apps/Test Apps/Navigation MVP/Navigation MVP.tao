use StackNav from @tao/nav
use Col, FormButton, Text from @tao/ui

app NavigationMVPApp {
   Name "Navigation MVP"
   Navigator StackNav {
      Initial Home
}  }

workspace
ui Home() {
   state Visits = 0
   action CountVisit() {
      set Visits += 1
   }
   action OpenDetail() {
      present Detail(Name: "Typed workspace")
   }
   render Col() [gap 10, pad 16] {
      Text("Navigation MVP")
      Text("Home visits: { Visits }")

      #countVisit
      FormButton("Count visit") {
         on press CountVisit
      }

      #openDetail
      FormButton("Open detail") {
         on press OpenDetail
}  }  }

workspace
ui Detail(Name text) {
   render Col() [gap 10, pad 16] {
      Text("Detail")
      Text(Name)
}  }
