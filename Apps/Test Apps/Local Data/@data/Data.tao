// The catalog spans both stores. `Note` follows whatever the app configures as its `Datasource`;
// `FocusSession` declares `local only`, so it lives in the device-local store either way.
workspace
data Notes / Note {
   Title text

   order by Title
}

workspace
data FocusSessions / FocusSession {
   Label text
   StartedAt time (default now)

   order by Label
   local only
}

// A module-level query is a named, app-lifetime read of the store: one live value the screens share
// rather than a per-view read each of them repeats.
workspace
query FocusSessions as CurrentSession {
   limit 1
}
