use LocalData, LocalDataMemory from ./

test "Local Data" {
   test "keeps local-only rows across a relaunch" {
      run LocalData

      expect text "No focus session"
      enter "Deep work" into #sessionLabel
      press #startSession
      expect text "Focus: Deep work"
      relaunch
      // The public behavior proves that a local-only row survives quitting and reopening.
      expect text "Focus: Deep work"
   }
   test "keeps both entity kinds across a relaunch with Memory configured" {
      // This is an integration smoke test for both catalogs under the Memory variant. Compiler
      // tests, rather than this black-box journey, prove that the entities route separately.
      run LocalDataMemory

      expect text "No notes yet"
      expect text "No focus session"
      enter "Synced note" into #noteTitle
      press #addNote
      enter "Deep work" into #sessionLabel
      press #startSession
      expect text "Note: Synced note"
      expect text "Focus: Deep work"
      relaunch
      expect text "Note: Synced note"
      expect text "Focus: Deep work"
   }
}
