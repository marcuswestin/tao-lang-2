use LocalData, LocalDataMemory from ./

test "Local Data" {
   test "keeps local-only rows across a relaunch" {
      run LocalData

      expect text "No focus session"
      enter "Deep work" into #sessionLabel
      press #startSession
      expect text "Focus: Deep work"
      relaunch
      // The focus session lives in the companion device-local catalog, so quitting and reopening
      // the app finds it exactly where a synced row would be found.
      expect text "Focus: Deep work"
   }
   test "keeps a local-only entity device-local under a different datasource" {
      // The same program, same catalog, different `Datasource`. A `local only` entity does not
      // follow that choice: it is stored and read back the same way here as it is above.
      run LocalDataMemory

      expect text "No notes yet"
      expect text "No focus session"
      enter "Synced note" into #noteTitle
      press #addNote
      enter "Deep work" into #sessionLabel
      press #startSession
      expect text "Note: Synced note"
      expect text "Focus: Deep work"
      relaunch
      expect text "Note: Synced note"
      expect text "Focus: Deep work"
   }
}
