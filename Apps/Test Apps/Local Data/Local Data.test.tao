use LocalDataMemory from ./

test "Local Data" {
   test "keeps both entity kinds across a relaunch with Memory configured" {
      // This is an integration smoke test for both catalogs under the Memory variant. Because both
      // connections are memory-backed here, compiler tests prove that the entities route separately.
      run LocalDataMemory

      expect text "No notes yet"
      expect text "No focus session"
      enter "Synced note" into #noteTitle
      press #addNote
      enter "Deep work" into #sessionLabel
      press #startSession
      expect text "Note: Synced note"
      expect text "Focus: Deep work"
      relaunch
      expect text "Note: Synced note"
      expect text "Focus: Deep work"
   }
}
