// Journeys, as a person would take them. Every check starts from a fresh store, clock, and network.

fixture KyotoPlan {
   account Alex { Name: "Alex Morgan", Email: "alex@example.com" }
   account Maya { Name: "Maya Chen", Email: "maya@example.com" }
   account Rowan { Name: "Rowan Lee", Email: "rowan@example.com" }
   signed in as Alex

   let FushimiInari = Place { Name: "Fushimi Inari Taisha", Address: "68 Fukakusa Yabunouchicho, Kyoto", Coordinate: 34.9671, 135.7727 }
   let Vermillion = Place { Name: "Vermillion", Address: "15-1 Fukakusa Kaidoguchicho, Kyoto", Coordinate: 34.9680, 135.7707 }

   let Kyoto = Trip { Name: "Kyoto", Summary: "Temples, long lunches, and room to wander.", Begins: 2027-04-12, Ends: 2027-04-15, HomeZone: "Asia/Tokyo" }
   let AlexSeat = Member { Trip: Kyoto, Person: Alex, Email: "alex@example.com", Name: "Alex Morgan", Owner, Joined }
   let MayaSeat = Member { Trip: Kyoto, Person: Maya, Email: "maya@example.com", Name: "Maya Chen", Editor, Joined }
   let RowanSeat = Member { Trip: Kyoto, Person: Rowan, Email: "rowan@example.com", Name: "Rowan Lee", Viewer, Joined }
   update Alex { CurrentTrip: Kyoto }
   update Maya { CurrentTrip: Kyoto }
   update Rowan { CurrentTrip: Kyoto }

   let Monday = Day { Trip: Kyoto, Date: 2027-04-12, Title: "Southern Kyoto" }
   let Tuesday = Day { Trip: Kyoto, Date: 2027-04-13 }
   let Inari = Stop { Day: Monday, Title: "Fushimi Inari", Kind: Visit, Place: FushimiInari, Starts: 09:00, Duration: 2 hours, Notes: "Take the quiet trail beyond the first overlook." }
   let Lunch = Stop { Day: Monday, Title: "Lunch at Vermillion", Kind: Meal, Place: Vermillion, Starts: 12:30, Duration: 1 hour, Reservation: "WF-7391" }
   let Nap = Stop { Day: Monday, Title: "Back to the ryokan", Kind: Stay }

   let RailPass = Document { Trip: Kyoto, Kind: Ticket, Title: "Rail pass", File: file "rail-pass.pdf", AddedBy: Alex }
   let Passport = Document { Trip: Kyoto, Kind: Identity, Title: "Alex's passport", File: file "passport.pdf", PrivateTo: Alex, AddedBy: Alex }
}

fixture Nobody { signed out }

test "Wayfare" {
   check "a trip begins whole: owner seat and first day in one write" on laptop with KyotoPlan {
      run Wayfare
      press button "New trip"
      enter "Montreal" into #tripName
      choose 2027-06-18 in field "Begins"
      choose 2027-06-21 in field "Ends"
      press #createTrip
      expect heading "Montreal"
      expect stored exactly one Trip where Name is "Montreal"
      expect stored exactly one Member where Trip.Name is "Montreal" and Person is Alex and Role is Owner and is Joined
      expect stored exactly one Day where Trip.Name is "Montreal" and Date is 2027-06-18
   }

   check "a trip cannot end before it starts, and a day cannot fall outside it" on laptop with KyotoPlan {
      run Wayfare
      press button "New trip"
      enter "Backwards" into #tripName
      choose 2027-06-21 in field "Begins"
      choose 2027-06-18 in field "Ends"
      press #createTrip
      expect text "A trip cannot end before it starts"
      press button "Cancel"

      press row "Kyoto"
      press button "Add a day"
      choose 2027-05-01 in field "Date"
      press #addDay
      expect text "This day falls outside the trip"
   }

   check "the workspace is three panes wide, two on a tablet, a stack on a phone" with KyotoPlan {
      on laptop {
         run Wayfare at StopLink(Inari)
         expect navigation { selection as sidebar; split TripWorkspace expanded }
         expect { heading "Kyoto"; heading "Southern Kyoto"; heading "Fushimi Inari" }
      }
      on tablet {
         run Wayfare at StopLink(Inari)
         expect navigation { split TripWorkspace showing @day, @details }
      }
      on phone {
         run Wayfare at StopLink(Inari)
         expect navigation { selection as tabs; split TripWorkspace collapsed }
         expect heading "Fushimi Inari"
         go back
         expect heading "Southern Kyoto"
         go back
         expect heading "Kyoto"
   }  }

   check "dragging a stop reorders the day for everyone, and the pins follow" on laptop with KyotoPlan {
      run Wayfare at DayLink(Monday)
      select #stops { expect rows in order "1. Fushimi Inari", "2. Lunch at Vermillion", "3. Back to the ryokan" }
      move #stops[3] before #stops[1]
      select #stops { expect rows in order "1. Back to the ryokan", "2. Fushimi Inari", "3. Lunch at Vermillion" }
      expect Nap.Position is 1
      collaborator Maya { expect Nap.Position is 1 }
   }

   check "a viewer can read the day and not rewrite it" on tablet with KyotoPlan {
      signed in as Rowan
      run Wayfare at DayLink(Monday)
      expect missing field "A name for the day"
      expect missing button "Add a stop"
      press row "1. Fushimi Inari"
      expect missing button "Save"
      expect missing button "Delete stop"
   }

   check "the stop editor is a draft; a day's title writes through" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      // Not saved yet: the trip has not seen it.
      expect Inari.Title is "Fushimi Inari"
      collaborator Maya { expect Inari.Title is "Fushimi Inari" }
      press button "Save"
      expect status "Saved"
      expect Inari.Title is "Fushimi Inari at dawn"

      enter "Fushimi and lunch" into field "A name for the day"
      // A keystroke is a write.
      expect Monday.Title is "Fushimi and lunch"
   }

   check "walking away loses nothing: a draft is durable" on phone with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      go back
      relaunch Wayfare
      run Wayfare at StopLink(Inari)
      expect field "Stop" value "Fushimi Inari at dawn"
      expect status "Unsaved changes"
   }

   check "two people edit the same stop: the conflict is a conversation, field by field" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      choose 08:00 in #stopStarts
      collaborator Maya { update Inari { Title: "Fushimi Inari early", Notes: "Bring the good camera." } }
      press button "Save"
      expect dialogue "Someone else changed this stop"
      // A draft tracks the fields I changed; a conflict is one of those changed remotely too. Maya's
      // notes are not mine to argue with — they simply apply.
      select #comparison { expect rows in order "Title" }
      press #keepMine
      expect Inari.Title is "Fushimi Inari at dawn"
      expect Inari.Starts is 08:00
      expect Inari.Notes is "Bring the good camera."
      expect missing dialogue
   }

   check "a third edit mid-decision updates the comparison in place" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      collaborator Maya { update Inari { Title: "Fushimi Inari early" } }
      press button "Save"
      expect dialogue "Someone else changed this stop"
      collaborator Maya { update Inari { Title: "Fushimi Inari before breakfast" } }
      select #comparison { expect text "Fushimi Inari before breakfast" }
      press #discardMine
      expect field "Stop" value "Fushimi Inari before breakfast" // the draft re-read the row
   }

   check "visited stands alone and does not wait on the draft" on phone with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      press button "Mark as visited"
      expect Inari.Visited is yes
      expect Inari.Title is "Fushimi Inari" // the draft is still unsaved
   }

   check "the departure reminder reaches every traveler in the trip's zone" on phone with KyotoPlan {
      clock 2027-04-12 08:29 Asia/Tokyo
      signed in as Rowan
      run Wayfare
      advance 1 minute
      expect notification "Fushimi Inari starts in 30 minutes"
      open notification
      expect heading "Fushimi Inari"
   }

   check "Today shows the day you are standing in, not the day at home" on phone with KyotoPlan {
      clock 2027-04-11 20:00 America/New_York // already the 12th in Tokyo
      run Wayfare
      press tab "Today"
      expect heading "Southern Kyoto"
      expect row "1. Fushimi Inari"
   }

   check "a private document is only its person's, and the access rule does the filtering" on phone with KyotoPlan {
      run Wayfare
      press tab "Documents"
      expect { row "Rail pass"; row "Alex's passport" }
      signed in as Rowan
      run Wayfare
      press tab "Documents"
      expect row "Rail pass"
      expect missing row "Alex's passport"
      expect stored no Document where Title is "Alex's passport" readable by Rowan
   }

   check "sharing publishes exactly the projection and revoking kills the link" on laptop with KyotoPlan {
      run Wayfare at TripLink(Kyoto)
      press button "Share itinerary"
      expect dialogue "Share itinerary" { text "Fushimi Inari"; missing text "Take the quiet trail beyond the first overlook."; missing text "WF-7391"; missing text "Maya Chen" }
      press #createLink
      capture shared link as Public
      expect public content behind Public includes only {
         Name, Summary, Begins, Ends, HomeZone, Cover
         Days { Date, Title, Stops { Title, Kind, Place, Starts, Duration } }
      }
      signed out
      open Public
      expect { heading "Kyoto"; text "Fushimi Inari"; text "Shared from Wayfare" }
      signed in as Alex
      run Wayfare at TripLink(Kyoto)
      press button "Manage link"
      press #revokeLink
      signed out
      open Public
      expect heading "This is gone"
   }

   check "an invitation is a seat: one use, only for its email, and the roles an editor may grant" on phone with KyotoPlan {
      signed in as Maya // an editor
      run Wayfare at TripLink(Kyoto)
      press button "Invite a traveler"
      expect field "Role" options "Editor", "Viewer"
      enter "sam@example.com" into #inviteEmail
      press #sendInvite
      capture shared link as Invitation

      account "Mallory"
      open Invitation
      press #join
      expect text "This invitation was sent to someone else."

      account "Sam" email "sam@example.com"
      open Invitation
      press #join
      expect heading "Kyoto"
      expect stored exactly one Member where Email is "sam@example.com" and is Joined

      account "Mallory"
      open Invitation
      press #join
      expect text "This invitation has already been used."
   }

   check "the last owner cannot leave" on phone with KyotoPlan {
      run Wayfare at TripLink(Kyoto)
      press button "Leave trip"
      press #confirm
      expect text "A trip needs an owner"
      expect stored exactly one Member where Person is Alex and Trip is Kyoto
   }

   check "offline work survives relaunch and reconciles once" on phone with KyotoPlan {
      run Wayfare at DayLink(Monday)
      network offline
      expect status "Offline — your changes are safe on this device"
      press button "Add a stop"
      enter "Evening walk along the canal" into #newStopTitle
      press #addStop
      go back // on a phone the new stop's details came up over the day
      expect row "4. Evening walk along the canal"
      relaunch Wayfare
      run Wayfare at DayLink(Monday)
      expect row "4. Evening walk along the canal"
      network online
      wait for sync current within 5 seconds
      expect stored exactly one Stop where Title is "Evening walk along the canal"
   }

   check "a file attaches to a stop and shows for everyone on the trip" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      attach file "menu.pdf" to button "Add a file"
      expect row "menu.pdf"
      collaborator Maya { open StopLink(Inari); expect row "menu.pdf" }
   }

   check "losing access mid-session is an honest state" on laptop with KyotoPlan {
      signed in as Rowan
      run Wayfare at StopLink(Inari)
      collaborator Alex { delete RowanSeat }
      expect heading "You don't have access to this"
   }

   check "Spanish changes the words and nothing else" on phone with KyotoPlan {
      prepare { update Me { Language: "es" } }
      run Wayfare at DayLink(Monday)
      expect tab "Viajes"
      expect button "Añadir una parada"
      expect navigation identity WayfareNavigator@trips
   }
}
