// Journeys, as a person would take them. Every test starts from a fresh store, clock, and network.
//
// Steps select by visible text or `#tag` only; store checks are ordinary queries over plain values.

fixture KyotoPlan {
   account Alex { Name: "Alex Morgan", Email: "alex@example.com" }
   account Maya { Name: "Maya Chen", Email: "maya@example.com" }
   account Rowan { Name: "Rowan Lee", Email: "rowan@example.com" }
   signed in as Alex

   FushimiInari = create Place { Name: "Fushimi Inari Taisha", Address: "68 Fukakusa Yabunouchicho, Kyoto", Coordinate: 34.9671, 135.7727 }
   Vermillion = create Place { Name: "Vermillion", Address: "15-1 Fukakusa Kaidoguchicho, Kyoto", Coordinate: 34.9680, 135.7707 }

   Kyoto = create Trip { Name: "Kyoto", Summary: "Temples, long lunches, and room to wander.", Begins: 2027-04-12, Ends: 2027-04-15, HomeZone: "Asia/Tokyo" } through CreateTrip(Alex)
   AlexSeat = exactly one Kyoto.Members where Person is Alex
   MayaSeat = create Member { Trip: Kyoto, Person: Maya, Email: "maya@example.com", Name: "Maya Chen", Role: Editor, Joined } for Alex
   RowanSeat = create Member { Trip: Kyoto, Person: Rowan, Email: "rowan@example.com", Name: "Rowan Lee", Role: Viewer, Joined } for Alex

   Monday = exactly one Kyoto.Days where Date is 2027-04-12
   Tuesday = create Day { Trip: Kyoto, Date: 2027-04-13 } for Alex
   Inari = create Stop { Day: Monday, Title: "Fushimi Inari", Kind: Visit, Place: FushimiInari, Starts: 09:00, Duration: 2.hours, Notes: "Take the quiet trail beyond the first overlook." } for Alex
   Lunch = create Stop { Day: Monday, Title: "Lunch at Vermillion", Kind: Meal, Place: Vermillion, Starts: 12:30, Duration: 1.hour, Reservation: "WF-7391" } for Alex
   Nap = create Stop { Day: Monday, Title: "Back to the ryokan", Kind: Stay } for Alex

   RailPass = create Document { Trip: Kyoto, Kind: Ticket, Title: "Rail pass", File: file "rail-pass.pdf", AddedBy: Alex } for Alex
   Passport = create Document { Trip: Kyoto, Kind: Identity, Title: "Alex's passport", File: file "passport.pdf", PrivateTo: Alex, AddedBy: Alex } for Alex

   prepare { update Monday { Title: "Southern Kyoto" } }
}

fixture Nobody { signed out }

// Alex's unsaved draft beside Maya's newer row: the conflict conversation's own state.
fixture KyotoConflict {
   fixture KyotoPlan
   Mine = create draft of Inari { Title: "Fushimi Inari at dawn" } for Alex
   Theirs = update Inari { Title: "Fushimi Inari early" } for Maya
}

// The itinerary already published, so the public link is a fixture handle rather than a prepared effect.
fixture KyotoShared {
   fixture KyotoPlan
   KyotoPublic = do ShareTrip(Kyoto) for Alex
}

test "Wayfare" {
   test "a trip begins whole: owner seat and first day in one write" on laptop with KyotoPlan {
      run Wayfare
      press "New trip"
      enter "Montreal" into #tripName
      enter 2027-06-18 into #tripBegins
      enter 2027-06-21 into #tripEnds
      press #createTrip
      expect text "Montreal"
      expect (Trips where Name is "Montreal").Count is 1
      expect (Members where Trip.Name is "Montreal" and Person is Alex and Role is Owner and is Joined).Count is 1
      expect (Days where Trip.Name is "Montreal" and Date is 2027-06-18).Count is 1
   }

   test "a trip cannot end before it starts, and a day cannot fall outside it" on laptop with KyotoPlan {
      run Wayfare
      press "New trip"
      enter "Backwards" into #tripName
      enter 2027-06-21 into #tripBegins
      enter 2027-06-18 into #tripEnds
      press #createTrip
      expect text "A trip cannot end before it starts"
      press "Cancel"

      press "Kyoto"
      press "Add a day"
      enter 2027-05-01 into #dayDate
      press #addDay
      expect text "This day falls outside the trip"
   }

   test "the workspace fits the room it is in" with KyotoPlan {
      test "a laptop shows three panes at once" on laptop {
         run Wayfare at StopLink(Inari)
         expect text "Kyoto"
         expect text "Southern Kyoto"
         expect text "Fushimi Inari"
      }
      test "a tablet keeps the day and its stop" on tablet {
         run Wayfare at StopLink(Inari)
         expect text "Southern Kyoto"
         expect text "Fushimi Inari"
      }
      test "a phone walks the progression and reverses it on Back" on phone {
         run Wayfare at StopLink(Inari)
         expect text "Fushimi Inari"
         back
         expect text "Southern Kyoto"
         back
         expect text "Kyoto"
      }
   }

   test "dragging a stop reorders the day for everyone, and the pins follow" on laptop with KyotoPlan {
      run Wayfare at DayLink(Monday)
      select #stops[1] { expect text "1. Fushimi Inari" }
      select #stops[3] { expect text "3. Back to the ryokan" }
      move #stops[3] before #stops[1]
      select #stops[1] { expect text "1. Back to the ryokan" }
      expect Nap.Position is 1
      collaborator Maya { expect Nap.Position is 1 }
   }

   test "a viewer can read the day and not rewrite it" on tablet with KyotoPlan {
      signed in as Rowan
      run Wayfare at DayLink(Monday)
      expect missing text "A name for the day"
      expect missing text "Add a stop"
      press "1. Fushimi Inari"
      expect missing text "Save"
      expect missing text "Delete stop"
      // A hidden control is not proof of security: the store refuses the write too.
      as Rowan update Inari { Title: "Not mine to rename" }
      expect refused
      expect Inari.Title is "Fushimi Inari"
   }

   test "the stop editor is a draft; a day's title writes through" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      // Not saved yet: the trip has not seen it.
      expect Inari.Title is "Fushimi Inari"
      collaborator Maya { expect Inari.Title is "Fushimi Inari" }
      press "Save"
      expect text "Saved"
      expect Inari.Title is "Fushimi Inari at dawn"

      enter "Fushimi and lunch" into #dayTitle
      // A keystroke is a write.
      expect Monday.Title is "Fushimi and lunch"
   }

   test "walking away loses nothing: a draft is durable" on phone with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      back
      relaunch Wayfare
      run Wayfare at StopLink(Inari)
      select #stopTitle { expect text "Fushimi Inari at dawn" }
      expect text "Unsaved changes"
   }

   test "two people edit the same stop: the conflict is a conversation, field by field" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      enter 08:00 into #stopStarts
      collaborator Maya { update Inari { Title: "Fushimi Inari early", Notes: "Bring the good camera." } }
      press "Save"
      // The comparison is generated from the entity: one row per field where the draft and the row now
      // disagree. Maya's notes are not mine to argue with — they simply apply.
      select #comparison[1] { expect text "Fushimi Inari early" }
      press #keepMine
      expect Inari.Title is "Fushimi Inari at dawn"
      expect Inari.Starts is 08:00
      expect Inari.Notes is "Bring the good camera."
   }

   test "a third edit mid-decision updates the comparison in place" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      collaborator Maya { update Inari { Title: "Fushimi Inari early" } }
      press "Save"
      collaborator Maya { update Inari { Title: "Fushimi Inari before breakfast" } }
      select #comparison { expect text "Fushimi Inari before breakfast" }
      press #discardMine
      select #stopTitle { expect text "Fushimi Inari before breakfast" } // the draft re-read the row
   }

   test "visited stands alone and does not wait on the draft" on phone with KyotoPlan {
      run Wayfare at StopLink(Inari)
      enter "Fushimi Inari at dawn" into #stopTitle
      press "Mark as visited"
      expect Inari.Visited is yes
      expect Inari.Title is "Fushimi Inari" // the draft is still unsaved
   }

   test "the departure reminder reaches every traveler in the trip's zone" on phone with KyotoPlan {
      clock 2027-04-12 08:29 Asia/Tokyo
      signed in as Rowan
      run Wayfare
      advance 1.minute
      expect notification "Fushimi Inari starts in 30 minutes"
      open notification
      expect text "Fushimi Inari"
   }

   test "Today shows the day you are standing in, not the day at home" on phone with KyotoPlan {
      clock 2027-04-11 20:00 America/New_York // already the 12th in Tokyo
      run Wayfare
      press "Today"
      expect text "Southern Kyoto"
      expect text "1. Fushimi Inari"
   }

   test "a private document is only its person's, and the access rule does the filtering" on phone with KyotoPlan {
      run Wayfare
      press "Documents"
      expect text "Rail pass"
      expect text "Alex's passport"
      signed in as Rowan
      run Wayfare
      press "Documents"
      expect text "Rail pass"
      expect missing text "Alex's passport"
      // Nothing on the screen filters by PrivateTo; the store refuses the read.
      as Rowan let Seen = Passport
      expect refused
   }

   test "sharing publishes exactly the projection and revoking kills the link" on laptop with KyotoPlan {
      run Wayfare at TripLink(Kyoto)
      press "Share itinerary"
      expect text "Fushimi Inari"
      expect missing text "Take the quiet trail beyond the first overlook."
      expect missing text "WF-7391"
      expect missing text "Maya Chen"
      press #createLink
      capture shared link as Public
      expect public content behind Public includes only {
         Name, Summary, Begins, Ends, HomeZone, Cover
         Days { Date, Title, Stops { Title, Kind, Place, Starts, Duration } }
      }
      signed out
      open Public
      expect text "Kyoto"
      expect text "Fushimi Inari"
      expect text "Shared from Wayfare"
      signed in as Alex
      run Wayfare at TripLink(Kyoto)
      press "Manage link"
      press #revokeLink
      signed out
      open Public
      expect text "This is gone"
   }

   test "an invitation is a seat: one use, only for its email, and the roles an editor may grant" on phone with KyotoPlan {
      signed in as Maya // an editor
      run Wayfare at TripLink(Kyoto)
      press "Invite a traveler"
      // The grantable roles come from the access rule, not from a hand-written role test.
      expect missing text "Owner"
      expect text "Editor"
      enter "sam@example.com" into #inviteEmail
      press #sendInvite
      capture shared link as Invitation

      account "Mallory"
      open Invitation
      press #join
      expect text "This invitation was sent to someone else."

      account "Sam" email "sam@example.com"
      open Invitation
      press #join
      expect text "Kyoto"
      expect (Members where Email is "sam@example.com" and is Joined).Count is 1

      account "Mallory"
      open Invitation
      press #join
      expect text "This invitation has already been used."
   }

   test "the last owner cannot leave" on phone with KyotoPlan {
      run Wayfare at TripLink(Kyoto)
      press "Leave trip"
      press #confirm
      expect text "A trip needs an owner"
      expect (Members where Person is Alex and Trip is Kyoto).Count is 1
   }

   test "offline work survives relaunch and reconciles once" on phone with KyotoPlan {
      run Wayfare at DayLink(Monday)
      network offline
      expect text "Offline — your changes are safe on this device"
      press "Add a stop"
      enter "Evening walk along the canal" into #newStopTitle
      press #addStop
      back // on a phone the new stop's details came up over the day
      expect text "4. Evening walk along the canal"
      relaunch Wayfare
      run Wayfare at DayLink(Monday)
      expect text "4. Evening walk along the canal"
      network online
      wait for sync current within 5.seconds
      expect (Stops where Title is "Evening walk along the canal").Count is 1
   }

   test "a file attaches to a stop and shows for everyone on the trip" on laptop with KyotoPlan {
      run Wayfare at StopLink(Inari)
      attach file "menu.pdf" to "Add a file"
      expect text "menu.pdf"
      collaborator Maya { open StopLink(Inari); expect text "menu.pdf" }
   }

   test "losing access mid-session is an honest state" on laptop with KyotoPlan {
      signed in as Rowan
      run Wayfare at StopLink(Inari)
      collaborator Alex { delete RowanSeat }
      expect text "You don't have access to this"
   }
}
