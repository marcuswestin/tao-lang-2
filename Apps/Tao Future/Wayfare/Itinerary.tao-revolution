// The planning workspace: one day's stops, the stop editor, its conflict conversation, and Today.
//
// This file is where the rule about where inputs bind earns its keep. A day's title writes through,
// because it stands on its own. A stop is edited through a draft, because its fields travel together and
// because the person beside you may be editing the same stop — which is why drafts carry a `conflict`
// outcome at all.

use primary from @tao/keys

view NoStopSelected() {
   render EmptyState(Icon: "signpost.right", Title: "Pick a stop", Body: "Its details open here, beside the day.")
}

// -- One day ---------------------------------------------------------------------------------------------------

scene DayPlan(Day) {
   Title when Day.Title is empty Day.Date.Long / not Day.Title
   Toolbar { AddStop }
   query DayStops from Day.Stops { }

   action CreateStop() runs single {
      // Visibility follows permission to create a Stop in Day.Stops, resolved by the store.
      let Stop = ask NewStopSheet(Day)
      check Stop is not none
      reveal StopDetails(Stop) in @details
   }
   command AddStop() {
      Title "Add a stop"
      Icon "plus"
      Key primary + "n"
      do CreateStop()
   }

   render ScrollView [screen] {
      guard Day
      Col [page, width max 900] {
         Row [content right center, gap xs, wrap] { Button(AddStop) }
         if Day.Title is not empty { Text(Day.Date.Long) [caption] }
         // The day's name and date stand on their own, so they write through — no draft, no save; the
         // entity's `validate` keeps the date inside the trip.
         if can change Day {
            Row [gap md] {
               #dayTitle
               TextInput(Value: bind Day.Title, Label: "A name for the day") [claim 2]
               DateInput(Value: bind Day.Date, Label: "Date") [claim 1]
         }  }
         OfflineNotice()

         guard DayStops
         if DayStops is empty {
            EmptyState(Icon: "signpost.right", Title: "Shape the day", Body: "Add the first stop; drag to put the day in order.") { Button(AddStop) [primary] }
         }

         // The list and the map side by side on a wide screen, one column on a phone. The pins follow
         // the collection's order, so the route reads like the day, and the map names the list as its
         // non-map alternative over the same rows.
         Panes [gap lg] {
            Col [claim 2] {
               #stops
               Col(Reorderable: can change Day) [gap xs] {
                  loop DayStops / Stop {
                     StopCard(Stop)
                     on select -> { reveal StopDetails(Stop) in @details }
            }  }  }
            if DayStops[Place is not none] is not empty {
               Map(DayStops, Place: Stop.Place, Label: "The day on the map") [height min 320, radius lg] {
                  pin label "{ Stop.Position }. { Stop.Title }"
                  route
               } alternative {
                  loop DayStops / Stop { StopCard(Stop) }
}  }  }  }  }  }

// Creating: a draft, because the row does not exist yet. It commits once, so an abandoned stop never
// syncs to the whole trip.
file view NewStopSheet(Day) responds Stop {
   draft New = Stop for new { Day, Kind: Visit }
   action Add() runs single { when save New { saved -> Stop { respond Stop } } }
   render Col [card, width max 520, gap md] {
      Text("New stop") [sectionTitle]
      #newStopTitle
      TextInput(Value: bind New.Title, Label: "Stop", Placeholder: "Fushimi Inari", Focus: initial) { on submit -> { do Add() } }
      Row [gap md] {
         Choice(Value: bind New.Kind, Label: "Kind") [claim 1]
         TimeInput(Value: bind New.Starts, Label: "Starts") [claim 1]
      }
      Problems(New)
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> { respond } }
         #addStop
         Button("Add", Disabled: New.Incomplete) [primary, busy when Add.Running] { on press -> { do Add() } }
}  }  }

// -- One stop ---------------------------------------------------------------------------------------------------
//
// The editor works on a draft of the row, not the row: `Mine` starts as the stop, keeps what you type,
// and lands as one write when you save. A draft is durable — it belongs to the row and the account, not
// the screen — so walking away loses nothing and there is no discard-changes dialogue. If a co-traveler
// changed the stop meanwhile, `save` answers `conflict` and the choice is a person's, field by field.

scene StopDetails(Stop) {
   Title Stop.Title
   Toolbar { SaveStop ToggleVisited DeleteStop }
   draft Mine = Stop from Stop
   presence Editors on Stop
   query Attached from Stop.Attachments { }

   action SaveStopChanges() runs single {
      when save Mine {
               saved -> present Notice("Saved") as toast (Key: "stop")
               // Offline is not failure: the draft commits locally and syncs when the connection returns.
               queued -> present Notice("Saved on this device — it syncs when you're back online") as toast (Key: "stop")
               conflict -> present ResolveStopConflict(Mine) as sheet
      }
   }
   command SaveStop() {
      Title "Save"
      Icon "checkmark"
      Key primary + "s"
      Enabled Mine.Changed
      do SaveStopChanges()
   }
   action ToggleVisitedState() {
      // Visibility follows permission to change Stop, resolved by the store.
      // Visited is a fact about the road, not part of the edit: it writes through directly and never
      // waits on the draft.
      toggle Stop.Visited
   }
   command ToggleVisited() {
      Title "Toggle visited"
      Label when Stop is Visited "Mark as planned" / not "Mark as visited"
      Icon "checkmark.circle"
      do ToggleVisitedState()
   }
   action ConfirmDeleteStop() runs single {
      // Store-derived delete permission controls visibility. The delete effect and explicit
      // confirmation carry destructive behavior; the command adds no separate role marker.
      let Sure = ask Confirm("Delete { Stop.Title }?", Body: "It leaves the day for everyone.", Verb: "Delete")
      check Sure
      delete Stop
      dismiss
   }
   command DeleteStop() {
      Title "Delete stop"
      Icon "trash"
      do ConfirmDeleteStop()
   }
   action Attach(Chosen file) {
      create Attachment { Stop, File: Chosen, AddedBy: Me }
   }

   render ScrollView [screen] {
      guard Stop
      Col [page, width max 680] {
         Text("{ Stop.Day.Date.Long } · Stop { Stop.Position } of { Stop.Day.Stops.Count }") [caption]
         Row [content right center, gap xs, wrap] {
            Button(SaveStop)
            Button(ToggleVisited)
            Button(DeleteStop)
         }
         loop Editors.Others / Other { Status("{ Other.Name } is editing this stop", Announce: yes) }
         if Mine.Changed { Status("Unsaved changes") }

         Col [card, gap lg] {
            #stopTitle
            TextInput(Value: bind Mine.Title, Label: "Stop")
            Row [gap md] {
               Choice(Value: bind Mine.Kind, Label: "Kind") [claim 1]
               #stopStarts
               TimeInput(Value: bind Mine.Starts, Label: "Starts") [claim 1]
               DurationInput(Value: bind Mine.Duration, Label: "How long") [claim 1]
            }
            PlaceInput(Value: bind Mine.Place, Label: "Place")
            TextInput(Value: bind Mine.Notes, Label: "Notes", Lines: 4)
            TextInput(Value: bind Mine.Reservation, Label: "Reservation or confirmation number")
            Problems(Mine)
         }

         Section("Attachments") {
            @actions FileInput(Label: "Add a file", Kinds: image, pdf) [quiet] { on change -> Chosen { do Attach(Chosen) } }
            guard Attached
            if Attached is empty { Text("Tickets, screenshots, a menu — anything for this stop.") [caption] }
            loop Attached / Attachment {
               Row [line] {
                  Icon(when Attachment.File.Kind is image "photo" / not "doc") [lead]
                  Text(Attachment.File.Name, Lines: 1) [body, main]
                  Text(Attachment.AddedBy.Name) [caption, trail]
                  Button(Icon: "arrow.down.circle", Label: "Open { Attachment.File.Name }") [quiet, trail] { on press -> { open Attachment.File } }
                  if can delete Attachment { Button(Icon: "minus.circle", Label: "Remove { Attachment.File.Name }") [quiet, trail] { on press -> { delete Attachment } } }
}  }  }  }  }  }

// The conflict conversation. `ConflictComparison` is generated from the entity, like PublicationPreview:
// one row per field where the draft and the row now disagree — my value beside theirs, with a control that
// takes theirs into the draft field by field. It reads the row live, so a third edit mid-decision updates
// the comparison in place; saving again runs the same outcomes.
file view ResolveStopConflict(Mine draft of Stop) {
   action Resolve() runs single {
      when save Mine {
         saved -> { dismiss; present Notice("Saved") as toast (Key: "stop") }
         conflict -> { } // the comparison below is already showing the newer edit
   }  }
   render Col [card, width max 620, gap md] {
      Text("Their changes are on the right, for the fields you both touched. Take theirs field by field, or keep yours and save again.") [body, muted]
      #comparison
      ConflictComparison(Mine)
      Problems(Mine)
      Row [content right center, gap sm] {
         #discardMine
         Button("Discard mine") [secondary] { on press -> { discard Mine; dismiss } } // the draft re-reads the row
         #keepMine
         Button("Keep mine") [primary, busy when Resolve.Running] { on press -> { do Resolve() } }
}  }  }

// -- Today ------------------------------------------------------------------------------------------------------

scene TodayScreen() {
   Title "Today"
   render ScrollView [screen] {
      guard Me { none -> { Text("Sign in to see today's plan.") [body]; SignInPanel() } }
      when MyTrip {
         loading -> Status("Opening Wayfare…")
         none -> EmptyState(Icon: "sun.max", Title: "No trip open", Body: "Open a trip and Today follows it.")
         otherwise -> TodayForTrip(MyTrip)
}  }  }

file view TodayForTrip(Trip) {
   // Today in the trip's own zone: a traveler whose phone is still on home time sees the day they are
   // standing in.
   let TodayPlan = exactly one Trip.Days where Date is today in Trip.HomeZone
   query TodayStops from TodayPlan.Stops { }

   render Col [page, width max 900] {
      // Named cases override the safety net with a way forward; everything else still falls to it.
      guard Trip { missing -> LostTrip(); unauthorized -> LostTrip() }
      Text(Trip.Name) [caption]
      OfflineNotice()
      guard TodayPlan { missing -> {
         EmptyState(Icon: "sun.max", Title: "Nothing planned today", Body: "Enjoy the day, or open the trip and add one.") {
            Button("Open { Trip.Name }") [secondary] { on press -> { open TripLink(Trip) } }
      }  }  }
      Text(when TodayPlan.Title is empty TodayPlan.Date.Long / not TodayPlan.Title) [title]
      Panes [gap lg] {
         Col [claim 2] {
            guard TodayStops
            if TodayStops is empty { Text("Nothing planned today.") [muted] }
            #todayStops
            loop TodayStops / Stop {
               StopCard(Stop)
               on select -> { open StopLink(Stop) }
         }  }
         if TodayStops[Place is not none] is not empty {
            Map(TodayStops, Place: Stop.Place, Label: "Today's map") [height min 280, radius lg] {
               pin label "{ Stop.Position }. { Stop.Title }"
               route
               me
            } alternative {
               loop TodayStops / Stop { StopCard(Stop) }
}  }  }  }  }

file view LostTrip() {
   render EmptyState(Icon: "sun.max", Title: "That trip is no longer yours", Body: "Pick another one from your trips.") {
      Button("Choose another trip") [primary] { on press -> { update Me { CurrentTrip: none } } } // the tab re-reads `MyTrip`
}  }
