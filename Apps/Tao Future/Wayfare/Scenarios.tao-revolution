// The states this app is reviewed, screenshotted, and audited in.
//
// Group clauses are inherited defaults; an entry clause of the same kind replaces the group's wholesale.
// `prepare` is the scenario-local data delta — ordered updates to fixture handles — and an entry may
// continue with an ordered interaction prefix spelled exactly like a test body.

scenarios "Library" {
   fixture KyotoPlan
   run Wayfare
   device phone

   scenario "signedOut" { fixture Nobody }
   scenario "laptop" { device laptop 1440 x 900 }
}

scenarios "Workspace" {
   fixture KyotoPlan
   run Wayfare at StopLink(Inari)

   scenario "threePanes" { device laptop 1440 x 900 }
   scenario "tabletTwoPanes" { device tablet landscape }
   scenario "phoneStack" { device phone }
}

scenarios "Stop" {
   fixture KyotoConflict
   run Wayfare at StopLink(Inari)
   device tablet landscape

   // The draft and the newer row are both in the fixture, so the comparison is the state under review.
   scenario "conflict" { press "Save" }
}

scenarios "Day" {
   fixture KyotoPlan
   run Wayfare at DayLink(Monday)
   device tablet landscape

   scenario "mapDark" { appearance dark }
   scenario "reducedMotionHighContrast" { network offline; contrast high; motion reduced }
}

scenarios "Today" {
   fixture KyotoPlan
   clock 2027-04-12 08:00 Asia/Tokyo
   run Wayfare
   press "Today"
   device phone

   scenario "inTokyo" { }
   scenario "spanishLargeText" {
      locale "es"
      textScale 200%
   }
   // Pseudolanguages are review modes, never shipped languages, and mirrored layout is reviewed with them.
   scenario "pseudolocale" {
      locale pseudolocale
      direction rightToLeft
   }
}

scenarios "Documents" {
   fixture KyotoPlan
   run Wayfare
   press "Documents"
   device phone

   scenario "private" { }
   scenario "asViewer" { signed in as Rowan }
}

scenarios "Shared" {
   fixture KyotoShared
   device phone

   scenario "public" {
      signed out
      run Wayfare at SharedTripLink(KyotoPublic)
   }
}

// A focused view render rather than an app run.
scenarios StopCard "card" {
   fixture KyotoPlan
   device phone

   scenario "eachKind" { render StopCard(Stop: Inari) }
   scenario "visited" {
      prepare { update Inari { Visited } }
      render StopCard(Stop: Inari)
   }
}
