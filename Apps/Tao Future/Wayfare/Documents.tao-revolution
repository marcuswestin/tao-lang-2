// Travel documents: the trip's, and the ones that are yours alone.
//
// A document with `PrivateTo` set is readable by that person only. Nothing in this screen filters by it —
// the access rule does — so the list a viewer sees IS the list they may see.

scene DocumentsScreen() {
   Title "Documents"
   Toolbar { AddDocument }
   query TripDocuments from MyTrip.Documents { order by Kind, AddedAt }
   // A second grouped query is how a screen groups a presentation: `loop` iterates and never groups.
   query DocumentKinds from MyTrip.Documents { group by Kind; order by Kind }

   action OpenNewDocument() {
      // Visibility requires an open trip and store permission to create that person's Document.
      // The current minimal command members cannot spell hidden-vs-disabled independently.
      present NewDocumentSheet(MyTrip) as sheet
   }
   command AddDocument() {
      Title "Add a document"
      Icon "doc.badge.plus"
      Enabled MyTrip is not none
      do OpenNewDocument()
   }

   render ScrollView [screen] {
      guard Me { none -> { Text("Sign in to keep travel documents with the trip.") [body]; SignInPanel() } }
      Col [page, width max 760] {
         when MyTrip {
            loading -> Status("Opening Wayfare…")
            none -> EmptyState(Icon: "doc.text", Title: "No trip open", Body: "Open a trip; its documents live here.")
            otherwise -> {
               guard TripDocuments
               if TripDocuments is empty {
                  EmptyState(Icon: "doc.text", Title: "Nothing filed yet", Body: "Tickets, bookings, and the things you would rather not lose.") { Button(AddDocument) [primary] }
               }
               loop DocumentKinds / KindGroup {
                  Section(KindGroup.Kind) {
                     loop TripDocuments / Document where Document.Kind is KindGroup.Kind {
                        Row [line] {
                           Icon(when Document.File.Kind is image "photo" / not "doc") [lead]
                           Col [main, gap xxs] {
                              Text(Document.Title) [body]
                              Text(when Document.PrivateTo is none "Everyone on the trip" / not "Only you") [caption]
                           }
                           Button(Icon: "arrow.down.circle", Label: "Open { Document.Title }") [quiet, trail] { on press -> { open Document.File } }
                           if can delete Document { Button(Icon: "trash", Label: "Remove { Document.Title }") [quiet, trail] { on press -> { delete Document } } }
}  }  }  }  }  }  }  }  }

file view NewDocumentSheet(Trip) responds Document {
   draft New = Document for new { Trip, AddedBy: Me }
   state OnlyMe = no
   action Add() runs single {
      set New.PrivateTo = when OnlyMe Me / not none // a draft's field is a place, like state
      when save New { saved -> Document { respond Document } }
   }
   render Col [card, width max 520, gap md] {
      Text("Add a document") [sectionTitle]
      #documentTitle
      TextInput(Value: bind New.Title, Label: "What is it?", Placeholder: "Rail pass", Focus: initial)
      Choice(Value: bind New.Kind, Label: "Kind")
      FileInput(Value: bind New.File, Label: "File", Kinds: image, pdf)
      Toggle(Value: bind OnlyMe, Label: "Only I can see this")
      Problems(New)
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> { respond } }
         #addDocument
         Button("Add", Disabled: New.Incomplete) [primary, busy when Add.Running] { on press -> { do Add() } }
}  }  }
