// Travel documents: the trip's, and the ones that are yours alone.
//
// A document with `PrivateTo` set is readable by that person only. Nothing in this screen filters by it —
// the access rule does — so the list a viewer sees IS the list they may see.

ui DocumentsScreen() {
   Title "Documents"
   Toolbar { AddDocument [primary] }
   query TripDocuments from MyTrip.Documents { order by Kind, AddedAt }

   command AddDocument {
      Label "Add a document"
      Icon "doc.badge.plus"
      Available when MyTrip is not none and can create Document in MyTrip.Documents // a viewer may: their own, private
      does { present NewDocumentSheet(MyTrip) as sheet }
   }

   render ScrollView [screen] {
      guard Me signed out -> { Text("Sign in to keep travel documents with the trip.") [body]; SignInPanel }
      Col [page, width max 760] {
         when MyTrip {
            loading -> Status("Opening Wayfare…")
            none -> EmptyState(Icon: "doc.text", Title: "No trip open", Body: "Open a trip; its documents live here.")
            otherwise -> {
               guard TripDocuments
               if TripDocuments is empty {
                  EmptyState(Icon: "doc.text", Title: "Nothing filed yet", Body: "Tickets, bookings, and the things you would rather not lose.") { AddDocument [primary] }
               }
               loop TripDocuments by Kind as Group {
                  Section(Group.Key) {
                     List(Group.Rows as Document) {
                        Row [pattern Line] {
                           Icon(if Document.File.Kind is image then "photo" else "doc") [@leading]
                           Col [@content, gap xxs] {
                              Text(Document.Title) [body]
                              Text(if Document.PrivateTo is none then "Everyone on the trip" else "Only you") [caption]
                           }
                           Button(Icon: "arrow.down.circle", Label: "Open { Document.Title }") [quiet, @trailing] { on press -> open Document.File }
                           if can delete Document { Button(Icon: "trash", Label: "Remove { Document.Title }") [quiet, @trailing] { on press -> delete Document } }
}  }  }  }  }  }  }  }  }

file dialogue NewDocumentSheet(Trip) responds Document {
   draft New = Document for new { Trip, AddedBy: Me }
   state OnlyMe = no
   action Add() runs single {
      set New.PrivateTo = if OnlyMe then Me else none // a draft's field is a place, like state
      when save New { saved -> Document { respond Document } }
   }
   render Col [card, width max 520, gap md] {
      Text("Add a document") [sectionTitle]
      #documentTitle
      TextInput(Value: New.Title, Label: "What is it?", Placeholder: "Rail pass", Focus: initial)
      Choice(Value: New.Kind, Label: "Kind")
      FileInput(Value: New.File, Label: "File", Kinds: image, pdf)
      Toggle(Value: OnlyMe, Label: "Only I can see this")
      Problems(New)
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> respond }
         #addDocument
         Button("Add", Disabled: New.Incomplete, Busy: Add running) [primary] { on press Add }
}  }  }
