// The vocabulary every screen uses: the open trip, the safety net, frames, the stop card, sign-in, and
// the one question.

use Account, SignIn, SignOut from @tao/auth

// -- Live handles ------------------------------------------------------------------------------------------
//
// Identity is a library with swappable providers, not language surface: one binding at the app root,
// and every screen reads `Me` from here (a handle with availability — loading, none, available).
let Me = Account
let MyTrip = Me.CurrentTrip

// -- The safety net -----------------------------------------------------------------------------------------
guard default {
   loading -> Spinner(Label: "Opening Wayfare…")
   missing -> EmptyState(Icon: "questionmark.folder", Title: "This is gone", Body: "Someone on the trip may have removed it.")
   unauthorized -> EmptyState(Icon: "lock", Title: "You don't have access to this", Body: "Ask the trip's owner to invite you back.")
   rejected -> Problem { Text(Problem) [caption, danger] }
   error -> Message { Text(Message) [body] }
}

// -- Frames --------------------------------------------------------------------------------------------------
view Section(Title text) {
   @actions = empty
   render Col [gap sm] {
      Row [content spread center, gap sm] {
         Text(Title) [sectionTitle]
         Row [content right center, gap xs] { @actions }
      }
      Col [gap xs] { @@content }
}  }

view EmptyState(Icon icon, Title text, Body text) {
   render Col [content center center, gap md, pad xl, width max 520] {
      Icon(Icon) [size 34, ink muted, decorative]
      Text(Title) [title, center]
      Text(Body) [body, muted, center]
      Col [gap sm] { @@content }
}  }

// -- Views ------------------------------------------------------------------------------------------------------
type Tone is one of Neutral, Good, Warning

view Status(Message text, Tone default Neutral, Announce yes / no default no) {
   let Symbol = when Tone { Neutral -> "circle"; Good -> "checkmark.circle"; Warning -> "exclamationmark.triangle" }
   render Row [content left center, gap sm, announce when Announce] {
      Icon(Symbol) [muted, ink good when Tone is Good, ink danger when Tone is Warning]
      Text(Message) [caption]
}  }

view OfflineNotice() {
   render if Connection is Offline { Status("Offline — your changes are safe on this device", Tone: Warning, Announce: yes) }
}

view SyncBadge() {
   render when Sync {
      Current -> Status("Up to date", Tone: Good)
      Syncing -> Status("Saving for everyone…")
      Error -> Message { Status(Message, Tone: Warning) }
}  }

// A stop, wherever it is listed: the day plan, Today, search. Pins on the map follow the same order.
view StopCard(Stop) {
   render Row [line] {
      Col [size 10, radius pill, background kind(Stop.Kind), lead, decorative]
      Col [main, gap xxs] {
         Text("{ Stop.Position }. { Stop.Title }", Lines: 1) [body, strike when Stop is Visited]
         Row [gap xs] {
            Text(when Stop.Starts is none "Flexible" / not Stop.Starts.Time) [caption]
            Text(Stop.Duration) [caption]
            if Stop.Place is not none { Text(Stop.Place.Name, Lines: 1) [caption] }
      }  }
      Text(Stop.Kind) [chip, trail]
      if Stop.Attachments is not empty { Icon("paperclip", Label: "Has attachments") [muted, trail] }
}  }

// -- Sign in ---------------------------------------------------------------------------------------------------
view SignInPanel() {
   state Email = ""
   action SendLink() runs single {
      check Email is not empty
      when do SignIn(Email) {
         saved -> present Notice("Check your inbox — the link signs you in on this device.") as toast (Key: "sign-in")
   }  }
   render Col [card, gap sm] {
      #email
      TextInput(Value: bind Email, Label: "Email", Placeholder: "you@example.com", Keyboard: email) { on submit -> { do SendLink() } }
      Button("Email me a sign-in link", Disabled: Email is empty, Busy: SendLink running) [primary] { on press -> { do SendLink() } }
}  }

// -- The one question -----------------------------------------------------------------------------------------
view Confirm(Question text, Body text, Verb text) responds yes / no {
   render Col(Label: Question) [card, width max 480, gap md] {
      Text(Question) [sectionTitle]
      Text(Body) [body]
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> { respond no } }
         #confirm
         Button(Verb) [destructive] { on press -> { respond yes } }
}  }  }

view Notice(Message text) {
   render Text(Message) [toast]
}
