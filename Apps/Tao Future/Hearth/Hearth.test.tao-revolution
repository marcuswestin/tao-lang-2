// Journeys, as a person would take them. Every check starts from a fresh store, clock, and network.

fixture PineStreet {
   account Ro { Name: "Ro", Email: "ro@example.com" }
   account Sam { Name: "Sam", Email: "sam@example.com" }
   signed in as Ro

   let Garden = Place { Name: "Community garden", Coordinate: 40.7122, -74.0064 }
   let Pharmacy = Place { Name: "Canal Pharmacy", Coordinate: 40.7180, -74.0002 }

   let PineStreet = Home { Name: "Pine Street", TimeZone: "America/New_York", Accent: Moss }
   let RoMember = Membership { Home: PineStreet, Person: Ro, Owner }
   let SamMember = Membership { Home: PineStreet, Person: Sam, Adult }
   update Ro { CurrentHome: PineStreet } // a fixture is setup statements; rows are handles

   let ChoresList = HearthList { Home: PineStreet, Name: "Things to do", Kind: Chores, Color: Moss }
   let ShoppingList = HearthList { Home: PineStreet, Name: "Shopping", Kind: Shopping, Color: Clay }
   let PlansList = HearthList { Home: PineStreet, Name: "Plans", Kind: Plans, Color: Sky }

   let EggsBreakfast = HearthItem { HearthList: ShoppingList, Title: "Eggs", Quantity: 4, Unit: "piece", CreatedBy: Ro }
   let EggsBaking = HearthItem { HearthList: ShoppingList, Title: "Eggs", Quantity: 2, Unit: "piece", CreatedBy: Sam }
   let Milk = HearthItem { HearthList: ShoppingList, Title: "Milk", Quantity: 1, Unit: "l", CreatedBy: Ro }
   let Plants = HearthItem { HearthList: PlansList, Title: "Water the plants", Note: "The fern likes the rain barrel.", Due: 2027-04-12 09:00 America/New_York, Place: Garden, Assignee: Sam, CreatedBy: Ro }
   let Prescription = HearthItem { HearthList: PlansList, Title: "Collect prescription", Due: 2027-04-12 17:00 America/New_York, Place: Pharmacy, CreatedBy: Sam }
   let Bins = HearthItem { HearthList: ChoresList, Title: "Take the bins out", Due: 2027-04-13 07:30 America/New_York, CreatedBy: Ro }
}

fixture NewPerson {
   account Alex { Name: "Alex", Email: "alex@example.com" }
   signed in as Alex
}

test "Hearth" {
   check "making a home is one write, and the root follows it" on phone with NewPerson {
      run Hearth
      expect heading "Make a home"
      enter "Foxglove House" into #homeName
      press #createHome
      expect tab "Today"
      expect stored exactly one Home where Name is "Foxglove House"
      expect stored exactly one Membership where Person is Alex and Role is Owner
      expect stored exactly one HearthList where Name is "Things to do"
   }

   check "capture from anywhere is a draft until it is added" on phone with PineStreet {
      run Hearth
      press key "cmd+n"
      expect dialogue "Add something"
      choose "Things to do" in field "List"
      enter "Fix the gate latch" into #captureTitle
      // Half-typed, nothing has synced: an abandoned capture never reaches the home.
      expect stored no HearthItem where Title is "Fix the gate latch"
      press #captureAdd
      expect stored exactly one HearthItem where Title is "Fix the gate latch"
   }

   check "the shopping list folds equal lines and one tick buys them all" on phone with PineStreet {
      run Hearth at ListLink(ShoppingList)
      expect row "Eggs" { text "6 piece" }
      expect row "Eggs" { text "from 2" }
      select #needed { expect exactly 2 rows }
      select #needed { press checkbox "Mark Eggs done" }
      expect section "Bought" { row "Eggs" }
      expect EggsBreakfast.Complete is yes
      expect EggsBaking.Complete is yes
      expect stored exactly one HearthItem where Title is "Eggs" and CompletedBy is Ro and CreatedBy is Sam
   }

   check "an item's fields write through, and a remote change lands without a dialogue" on laptop with PineStreet {
      run Hearth at ItemLink(Plants)
      enter "Water every planter" into #itemTitle
      collaborator Sam { update Plants { Note: "Skip the rosemary." } }
      expect field "What needs doing?" value "Water every planter"
      expect field "Notes" value "Skip the rosemary."
      expect Plants.Title is "Water every planter"
      expect missing dialogue
   }

   check "ticking is for everyone; removing is not" on phone with PineStreet {
      prepare { update SamMember { Role: YoungPerson } }
      signed in as Sam
      run Hearth at ItemLink(Bins)
      expect checkbox "Mark Take the bins out done"
      expect missing button "Delete"
      press checkbox "Mark Take the bins out done"
      expect Bins.Complete is yes
      expect Bins.CompletedBy is Sam
   }

   check "the reminder reaches whoever is taking care of it, on their devices" on phone with PineStreet {
      clock 2027-04-12 08:29 America/New_York
      signed in as Sam
      run Hearth
      advance 1 minute
      expect notification "Water the plants is due at 9:00 AM" // `.Time` in the reader's locale
      open notification
      expect heading "Water the plants"
      // The reminder fires once, even after a relaunch.
      relaunch Hearth
      advance 1 minute
      expect exactly one notification
   }

   check "the week is seven columns wide and one column narrow, and a drop moves the due day" with PineStreet {
      clock 2027-04-12 08:00 America/New_York // a Monday
      on laptop {
         run Hearth
         press tab "Week"
         expect heading "Week of Apr 12"
         select #week { expect exactly 7 columns }
         move row "Water the plants" onto list "Tuesday"
         expect Plants.Due is 2027-04-13 09:00 America/New_York
      }
      on phone {
         run Hearth
         press tab "Week"
         select #week { expect exactly 1 column }
      }
   }

   check "errands sort by distance and the map has an equal list" on tablet with PineStreet {
      location 40.7175, -74.0010 // beside the pharmacy
      run Hearth
      press tab "Around"
      select #errands { expect rows in order "Collect prescription", "Water the plants" }
      press row "Water the plants"
      expect map selection "Water the plants"
   }

   check "without location, Around is still an honest list" on phone with PineStreet {
      location denied
      run Hearth
      press tab "Around"
      expect status "Errands stay available as a list without location access."
      expect row "Water the plants"
   }

   check "the same item is one window, however many times it is opened" on laptop with PineStreet {
      run Hearth at ItemLink(Plants)
      press button "Open separately"
      expect window "Water the plants"
      press button "Open separately"
      expect exactly one window
   }

   check "a shared list is exactly the projection, and revoking kills the link" on laptop with PineStreet {
      run Hearth at ListLink(PlansList)
      press button "Share list"
      expect dialogue "Share list" { text "Water the plants"; missing text "The fern likes the rain barrel."; missing text "Sam" }
      press #createLink
      capture shared link as Public
      expect public content behind Public includes only {
         Name, Kind, Color
         Items { Title, Quantity, Unit, Place { Name, Coordinate } }
      }
      signed out
      open Public
      expect { heading "Plans"; text "Water the plants"; text "Community garden" }
      expect missing text "The fern likes the rain barrel."
      signed in as Ro
      run Hearth at ListLink(PlansList)
      press button "Manage link"
      press #revokeLink
      signed out
      open Public
      expect heading "This is gone"
   }

   check "an invitation is one use and only for the person invited" on phone with PineStreet {
      run Hearth
      press tab "People"
      press button "Invite someone"
      enter "lee@example.com" into #inviteEmail
      press #sendInvite
      capture shared link as Invitation
      account "Mallory"
      open Invitation
      press #join
      expect text "This invitation was sent to someone else."
      account "Lee" email "lee@example.com"
      open Invitation
      press #join
      expect tab "Today"
      expect stored exactly one Membership where Person is Lee and Home is PineStreet
   }

   check "the last owner cannot leave, and an adult cannot mint an owner" on phone with PineStreet {
      run Hearth
      press tab "Settings"
      press #leave
      press #confirm
      expect text "A home needs an owner. Make someone else an owner first."
      signed in as Sam
      run Hearth
      press tab "People"
      press button "Invite someone"
      expect field "Role" options "Adult", "Young person" // a case prints as its name, split into words
   }

   check "work done offline survives relaunch and reconciles once" on phone with PineStreet {
      run Hearth at ListLink(ChoresList)
      network offline
      expect status "Offline — your changes are safe on this device"
      enter "Sweep the porch" into #newItem
      submit #newItem
      expect row "Sweep the porch"
      relaunch Hearth
      run Hearth at ListLink(ChoresList)
      expect row "Sweep the porch"
      network online
      wait for sync current within 5 seconds
      expect stored exactly one HearthItem where Title is "Sweep the porch"
   }

   check "an incoming link wins over what was restored" on phone with PineStreet {
      run Hearth at ListLink(ChoresList)
      relaunch Hearth opening ItemLink(Prescription)
      expect heading "Collect prescription"
   }

   check "the same graph is a stack on a phone and two panes on a laptop" with PineStreet {
      on phone {
         run Hearth
         press tab "Lists"
         press row "Plans"
         expect navigation { selection as tabs; split ListsWorkspace collapsed }
         go back
         expect heading "Lists"
      }
      on laptop {
         run Hearth
         press tab "Lists"
         expect navigation { selection as sidebar; split ListsWorkspace expanded }
         expect heading "Choose a list"
         press row "Plans"
         expect { heading "Plans"; heading "Lists" }
   }  }

   check "a person with two homes switches by a write" on phone with PineStreet {
      prepare {
         let Cabin = create Home { Name: "The cabin", TimeZone: "America/Denver" }
         create Membership { Home: Cabin, Person: Ro, Owner }
      }
      run Hearth
      press tab "Settings"
      press #switchHome
      expect heading "Choose a home"
      press row "The cabin"
      expect heading "Today at The cabin"
   }

   check "Spanish changes the words and nothing else" on phone with PineStreet {
      prepare { update Me { Language: "es" } }
      run Hearth
      expect tab "Listas"
      press tab "Listas"
      press row "Plans"
      expect navigation identity HomeNavigator@lists
   }
}
