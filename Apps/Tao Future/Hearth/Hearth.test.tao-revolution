// Journeys, as a person would take them. Every test starts from a fresh store, clock, and network.
//
// Steps select by visible text or `#tag` only; store checks are ordinary queries over plain values.

fixture PineStreet {
   account Ro { Name: "Ro", Email: "ro@example.com" }
   account Sam { Name: "Sam", Email: "sam@example.com" }
   signed in as Ro

   Garden = create Place { Name: "Community garden", Coordinate: 40.7122, -74.0064 }
   Pharmacy = create Place { Name: "Canal Pharmacy", Coordinate: 40.7180, -74.0002 }

   PineStreet = create Home { Name: "Pine Street", TimeZone: "America/New_York", Accent: Moss } through CreateHome(Ro)
   RoMember = exactly one PineStreet.Memberships where Person is Ro
   SamMember = create Membership { Home: PineStreet, Person: Sam, Role: Adult } for Ro

   // `CreateHome` seeds "Things to do" and "Shopping"; the plans list is this fixture's own.
   ChoresList = exactly one PineStreet.Lists where Name is "Things to do"
   ShoppingList = exactly one PineStreet.Lists where Name is "Shopping"
   PlansList = create HearthList { Home: PineStreet, Name: "Plans", Kind: Plans, Color: Sky } for Ro

   EggsBreakfast = create HearthItem { HearthList: ShoppingList, Title: "Eggs", Quantity: 4, Unit: "piece", CreatedBy: Ro } for Ro
   EggsBaking = create HearthItem { HearthList: ShoppingList, Title: "Eggs", Quantity: 2, Unit: "piece", CreatedBy: Sam } for Sam
   Milk = create HearthItem { HearthList: ShoppingList, Title: "Milk", Quantity: 1, Unit: "l", CreatedBy: Ro } for Ro
   Plants = create HearthItem { HearthList: PlansList, Title: "Water the plants", Note: "The fern likes the rain barrel.", Due: 2027-04-12 09:00 America/New_York, Place: Garden, Assignee: Sam, CreatedBy: Ro } for Ro
   Prescription = create HearthItem { HearthList: PlansList, Title: "Collect prescription", Due: 2027-04-12 17:00 America/New_York, Place: Pharmacy, CreatedBy: Sam } for Sam
   Bins = create HearthItem { HearthList: ChoresList, Title: "Take the bins out", Due: 2027-04-13 07:30 America/New_York, CreatedBy: Ro } for Ro
}

fixture NewPerson {
   account Alex { Name: "Alex", Email: "alex@example.com" }
   signed in as Alex
}

test "Hearth" {
   test "making a home is one write, and the root follows it" on phone with NewPerson {
      run Hearth
      expect text "Make a home"
      enter "Foxglove House" into #homeName
      press #createHome
      expect text "Today"
      expect (Homes where Name is "Foxglove House").Count is 1
      expect (Memberships where Person is Alex and Role is Owner).Count is 1
      expect (HearthLists where Name is "Things to do").Count is 1
   }

   test "capture from anywhere is a draft until it is added" on phone with PineStreet {
      run Hearth
      press key primary + "n"
      expect text "Add something"
      press "Things to do"
      enter "Fix the gate latch" into #captureTitle
      // Half-typed, nothing has synced: an abandoned capture never reaches the home.
      expect (HearthItems where Title is "Fix the gate latch").Count is 0
      press #captureAdd
      expect (HearthItems where Title is "Fix the gate latch").Count is 1
   }

   test "the shopping list folds equal lines and one tick buys them all" on phone with PineStreet {
      run Hearth at ListLink(ShoppingList)
      select #needed[1] { expect text "Eggs"; expect text "6 piece"; expect text "from 2" }
      select #needed[2] { expect text "Milk" }
      select #needed[1] { press #tick }
      expect text "Bought"
      expect EggsBreakfast.Complete is yes
      expect EggsBaking.Complete is yes
      // The stamp is on every source row, including the one Sam created.
      expect (HearthItems where Title is "Eggs" and CompletedBy is Ro and CreatedBy is Sam).Count is 1
   }

   test "an item's fields write through, and a remote change lands without a dialogue" on laptop with PineStreet {
      run Hearth at ItemLink(Plants)
      enter "Water every planter" into #itemTitle
      collaborator Sam { update Plants { Note: "Skip the rosemary." } }
      expect Plants.Title is "Water every planter"
      expect Plants.Note is "Skip the rosemary."
      select #itemTitle { expect text "Water every planter" }
   }

   test "ticking is for everyone; removing is not" on phone with PineStreet {
      update SamMember { Role: YoungPerson }
      signed in as Sam
      run Hearth at ItemLink(Bins)
      expect missing text "Delete"
      press "Mark Take the bins out done"
      expect Bins.Complete is yes
      expect Bins.CompletedBy is Sam
      // A hidden button is not proof of security: the store refuses the delete too.
      as Sam delete Bins
      expect refused
   }

   test "the reminder reaches whoever is taking care of it, on their devices" on phone with PineStreet {
      clock 2027-04-12 08:29 America/New_York
      signed in as Sam
      run Hearth
      advance 1.minute
      expect notification "Water the plants is due at 9:00 AM" // `.Time` in the reader's locale
      open notification
      expect text "Water the plants"
      // The reminder fires once, even after a relaunch: `once per Item.Due` is the deduplication key.
      relaunch Hearth
      advance 1.minute
      expect exactly one notification
   }

   test "the week is seven columns wide and one column narrow, and a drop moves the due day" with PineStreet {
      clock 2027-04-12 08:00 America/New_York // a Monday
      test "a laptop lays the week out across" on laptop {
         run Hearth
         press "Week"
         expect text "Week of Apr 12"
         select #week { expect text "Monday"; expect text "Sunday" }
         move "Water the plants" onto "Tuesday"
         expect Plants.Due is 2027-04-13 09:00 America/New_York
      }
      test "a phone reads it one day at a time" on phone {
         run Hearth
         press "Week"
         expect text "Week of Apr 12"
         expect text "Water the plants"
      }
   }

   test "errands sort by distance and the map has an equal list" on tablet with PineStreet {
      location 40.7175, -74.0010 // beside the pharmacy
      run Hearth
      press "Around"
      select #errands[1] { expect text "Collect prescription" }
      select #errands[2] { expect text "Water the plants" }
      // Selecting a row marks the same errand on the map beside it.
      press "Water the plants"
      select #errands[2] { expect text "Water the plants" }
   }

   test "without location, Around is still an honest list" on phone with PineStreet {
      location denied
      run Hearth
      press "Around"
      expect text "Errands stay available as a list without location access."
      expect text "Water the plants"
   }

   test "the same item is one window, however many times it is opened" on laptop with PineStreet {
      run Hearth at ItemLink(Plants)
      press "Open separately"
      expect window "Water the plants"
      press "Open separately"
      expect exactly one window
   }

   test "a shared list is exactly the projection, and revoking kills the link" on laptop with PineStreet {
      run Hearth at ListLink(PlansList)
      press "Share list"
      expect text "Water the plants"
      expect missing text "The fern likes the rain barrel."
      expect missing text "Sam"
      press #createLink
      capture shared link as Public
      expect public content behind Public includes only {
         Name, Kind, Color
         Items { Title, Quantity, Unit, Place { Name, Coordinate } }
      }
      signed out
      open Public
      expect text "Plans"
      expect text "Water the plants"
      expect text "Community garden"
      expect missing text "The fern likes the rain barrel."
      signed in as Ro
      run Hearth at ListLink(PlansList)
      press "Manage link"
      press #revokeLink
      signed out
      open Public
      expect text "This is gone"
   }

   test "an invitation is one use and only for the person invited" on phone with PineStreet {
      run Hearth
      press "People"
      press "Invite someone"
      enter "lee@example.com" into #inviteEmail
      press #sendInvite
      capture shared link as Invitation
      account "Mallory"
      open Invitation
      press #join
      expect text "This invitation was sent to someone else."
      account "Lee" email "lee@example.com"
      open Invitation
      press #join
      expect text "Today"
      expect (Memberships where Person is Lee and Home is PineStreet).Count is 1
   }

   test "the last owner cannot leave, and an adult cannot mint an owner" on phone with PineStreet {
      run Hearth
      press "Settings"
      press #leave
      press #confirm
      expect text "A home needs an owner. Make someone else an owner first."
      signed in as Sam
      run Hearth
      press "People"
      press "Invite someone"
      // The grantable roles come from the access rule, not from a hand-written role test.
      expect missing text "Owner"
      expect text "Adult"
      // And the store refuses an owner seat even when the screen is bypassed.
      as Sam create Invite { Home: PineStreet, Role: Owner, InvitedBy: Sam }
      expect refused
   }

   test "work done offline survives relaunch and reconciles once" on phone with PineStreet {
      run Hearth at ListLink(ChoresList)
      network offline
      expect text "Offline — your changes are safe on this device"
      enter "Sweep the porch" into #newItem
      submit #newItem
      expect text "Sweep the porch"
      relaunch Hearth
      run Hearth at ListLink(ChoresList)
      expect text "Sweep the porch"
      network online
      wait for sync current within 5.seconds
      expect (HearthItems where Title is "Sweep the porch").Count is 1
   }

   test "an incoming link wins over what was restored" on phone with PineStreet {
      run Hearth at ListLink(ChoresList)
      relaunch Hearth opening ItemLink(Prescription)
      expect text "Collect prescription"
   }

   test "the same graph adapts to the room it is in" with PineStreet {
      test "it walks as a stack on a phone" on phone {
         run Hearth
         press "Lists"
         press "Plans"
         expect missing text "Choose a list"
         back
         expect text "Lists"
      }
      test "it shows the index beside the list on a laptop" on laptop {
         run Hearth
         press "Lists"
         expect text "Choose a list"
         press "Plans"
         expect text "Plans"
         expect text "Things to do"
      }
   }

   test "a person with two homes switches by a write" on phone with PineStreet {
      Cabin = create Home { Name: "The cabin", TimeZone: "America/Denver" } through CreateHome(Ro)
      run Hearth
      press "Settings"
      press #switchHome
      expect text "Choose a home"
      press "The cabin"
      expect text "Today at The cabin"
   }
}
