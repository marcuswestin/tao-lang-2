// Lists, their items, the shopping fold, one item, and sharing.

use primary from @tao/keys

phrase ItemCount(Count number) = one "{ Count } item" / other "{ Count } items"

scene HearthListIndex() {
   Title "Lists"
   Toolbar { NewList }
   query Lists from MyHome.Lists { }

   action CreateNewList() runs single {
      // Visibility follows permission to create a HearthList in MyHome.Lists, resolved by the store.
      let HearthList = ask NewListSheet(MyHome)
      check HearthList is not none
      open ListLink(HearthList)
   }
   command NewList() {
      Title "New list"
      Icon "plus"
      Key primary + "l"
      do CreateNewList()
   }

   render ScrollView [screen] {
      Col [page] {
         OfflineNotice()
         guard Lists
         if Lists is empty {
            EmptyState(Icon: "checklist", Title: "No lists yet", Body: "Make a list for what your home is tending.") {
               Button(NewList) [primary]
         }  }
         // A container wraps and `loop` iterates. Dragging is possible because the collection is
         // `(ordered)` — the store keeps the positions, and the reorder affordance is the container's.
         #lists
         Col(Reorderable: can change MyHome) [gap xs] {
            loop Lists / HearthList {
               Row [line] {
                  // The palette keyed by the case type: one design line, not a product-code branch.
                  Col [size 12, radius pill, background listAccent(HearthList.Color), lead, decorative]
                  Col [main, gap xxs] {
                     Text(HearthList.Name) [body]
                     Text("{ HearthList.Kind } · { ItemCount(HearthList.Items.Count) }") [caption]
                  }
                  if HearthList is Shared { Icon("link", Label: "Shared") [muted, trail] }
                  Icon("chevron.right") [muted, trail]
               }
               on select -> { open ListLink(HearthList) }
}  }  }  }  }

view HearthListWelcome() {
   render EmptyState(Icon: "sidebar.left", Title: "Choose a list", Body: "Your lists stay here while their details open beside them, or on the next screen.")
}

file view NewListSheet(Home) responds HearthList {
   draft New = HearthList for new { Home, Kind: Chores, Color: Home.Accent }
   action Add() runs single {
      when save New { saved -> HearthList { respond HearthList } }
   }
   render Col [card, width max 520, gap md] {
      Text("New list") [sectionTitle]
      #listName
      TextInput(Value: bind New.Name, Label: "List name", Focus: initial) { on submit -> { do Add() } }
      Choice(Value: bind New.Kind, Label: "Kind")
      Choice(Value: bind New.Color, Label: "Color")
      Problems(New)
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> { respond } }
         #addList
         Button("Add", Disabled: New.Incomplete) [primary, busy when Add.Running] { on press -> { do Add() } }
}  }  }

// -- One list -----------------------------------------------------------------------------------------------

scene HearthListScreen(HearthList) {
   Title HearthList.Name
   // An alias, so a bulk write naming the entity does not read `HearthList is HearthList`.
   let ThisList = HearthList
   Toolbar { Rename ShareThis DeleteThis }
   state Find = ""
   state NewTitle = ""
   state ShowFinished = no
   query OpenItems from HearthList.Items {
      where is Open
      search Find
   }
   query FinishedItems from HearthList.Items {
      where is Complete
      search Find
      order by CompletedAt descending
   }
   // A shopping list folds equal lines: "Eggs, piece" from two people is one row whose Quantity is the
   // total, and ticking it completes every row inside.
   query Needed from HearthList.Items {
      where is Open
      group by Title, Unit
      Quantity = sum(Quantity)
      order by Title
   }

   // The title is known and the row can be finished later — `required` is completeness, not a blocked
   // write — so quick capture from the list head is one create, no draft.
   action AddItem() runs single {
      check NewTitle is not empty
      let Item = create HearthItem { HearthList, Title: NewTitle, CreatedBy: Me }
      set NewTitle = ""
      if HearthList.Kind is not Shopping { open ItemLink(Item) }
   }

   action OpenRename() {
      // Visibility follows permission to change HearthList, resolved by the store.
      present RenameList(HearthList) as sheet
   }
   command Rename() {
      Title "Rename"
      Icon "pencil"
      do OpenRename()
   }
   action OpenSharing() {
      // Visibility follows permission to change HearthList, resolved by the store.
      present ShareListSheet(HearthList) as sheet
   }
   command ShareThis() {
      Title "Share this"
      Label when HearthList is Shared "Manage link" / not "Share list"
      Icon "square.and.arrow.up"
      do OpenSharing()
   }
   action ConfirmDeleteList() runs single {
      // Store-derived delete permission controls visibility. The delete effect and explicit
      // confirmation carry destructive behavior; the command adds no separate role marker.
      let Sure = ask Confirm("Delete { HearthList.Name }?", Body: "Its items, notes, and photos will be removed for everyone.", Verb: "Delete")
      check Sure
      delete HearthList
      dismiss
   }
   command DeleteThis() {
      Title "Delete list"
      Icon "trash"
      do ConfirmDeleteList()
   }

   // A view declared inside the screen sees its queries: the shopping fold and the finished items.
   view ShoppingContent() {
      render Col [gap lg] {
         Section("Needed") {
            guard Needed
            if Needed is empty { EmptyState(Icon: "basket", Title: "Nothing to buy", Body: "Add an item above; equal items from everyone fold into one line.") }
            #needed
            loop Needed / Line {
               Row [line] {
                  #tick
                  // The fold stands for its rows, so `SetDone` stamps who and when on every source.
                  Checkbox(Value: Line.Complete, Label: MarkDone(Line.Title)) [lead] { on change -> Done { do SetDone(Line, Done) } }
                  Text(Line.Title) [body, main]
                  if Line.Quantity is not none { Text("{ Line.Quantity } { Line.Unit }") [caption, trail] }
                  if Line.HearthItems.Count > 1 { Text("from { Line.HearthItems.Count }") [caption, trail] }
         }  }  }
         if FinishedItems is not empty {
            Section("Bought") {
               // A bulk write is one write: `each` takes every row the filter names, and it is refused whole.
               @actions Button("Clear", Icon: "trash") [quiet] { on press -> { delete each HearthItem where HearthList is ThisList and is Complete } }
               loop FinishedItems / Item { HearthItemRow(Item); on select -> { open ItemLink(Item) } }
   }  }  }  }

   render ScrollView [screen] {
      guard HearthList
      Col [page] {
         Row [content left center, gap sm] {
            Col [size 12, radius pill, background listAccent(HearthList.Color), decorative]
            Col [gap xxs, claim 1] {
               Text(HearthList.Name) [pageTitle]
               Text("Shared with { HearthList.Home.Memberships.Count } people at home") [caption]
         }  }
         Row [content right center, gap xs, wrap] {
            Button(Rename)
            Button(ShareThis)
            Button(DeleteThis)
         }

         if can create HearthItem in HearthList.Items {
            Row [surface, pad xs, gap xs] {
               #newItem
               TextInput(Value: bind NewTitle, Label: "What needs doing?", Placeholder: "Add something") [claim 1] { on submit -> { do AddItem() } }
               #addItem
               Button("Add", Icon: "plus", Disabled: NewTitle is empty) [primary, busy when AddItem.Running] { on press -> { do AddItem() } }
         }  }

         when HearthList.Kind {
            Shopping -> ShoppingContent()
            otherwise -> {
               guard OpenItems
               if OpenItems is empty { EmptyState(Icon: "checkmark.circle", Title: "This list is clear", Body: "Add the next thing when you are ready.") }
               #openItems
               Col(Reorderable: can change HearthList) [gap xs] {
                  loop OpenItems / HearthItem { HearthItemRow(HearthItem); on select -> { open ItemLink(HearthItem) } }
               }
               Toggle(Value: bind ShowFinished, Label: "Show finished") [caption]
               if ShowFinished {
                  guard FinishedItems
                  if FinishedItems is empty { Text("Nothing finished yet.") [muted] }
                  loop FinishedItems / Item { HearthItemRow(Item); on select -> { open ItemLink(Item) } }
   }  }  }  }  }  }

// Renaming needs no draft: the row exists and each field stands on its own.
file view RenameList(HearthList) {
   action DismissRename() {
      dismiss
   }
   command Done() {
      Title "Done"
      Icon "checkmark"
      do DismissRename()
   }
   render Col [card, width max 480, gap md] {
      TextInput(Value: bind HearthList.Name, Label: "List name")
      Choice(Value: bind HearthList.Color, Label: "Color")
      Problems(HearthList)
      Row [content right center] { Button(Done) [primary] }
}  }

// -- One item ------------------------------------------------------------------------------------------------

scene HearthItemScreen(Item) {
   Title Item.Title
   Toolbar { OpenSeparately DeleteItem }
   presence Lookers on Item
   query ItemComments from Item.Comments { }
   query ItemPhotos from Item.Photos { }
   state NewComment = ""

   action AddComment() {
      check NewComment is not empty
      create Comment { Item, Author: Me, Body: NewComment }
      set NewComment = ""
   }
   action AddPhoto(Picture image) {
      create Photo { Item, Image: Picture, AddedBy: Me }
   }

   action OpenItemSeparately() {
      // A window on a laptop; where there are no windows, a full-screen sheet. The key means opening
      // the same item twice focuses the one window instead of stacking a second.
      present HearthItemScreen(Item) as window (Key: Item)
   }
   command OpenSeparately() {
      Title "Open separately"
      Icon "rectangle.on.rectangle"
      do OpenItemSeparately()
   }
   action ConfirmDeleteItem() runs single {
      // Store-derived delete permission controls visibility. The delete effect and explicit
      // confirmation carry destructive behavior; the command adds no separate role marker.
      let Sure = ask Confirm("Delete { Item.Title }?", Body: "Its notes and photos go with it.", Verb: "Delete")
      check Sure
      delete Item
      dismiss
   }
   command DeleteItem() {
      Title "Delete"
      Icon "trash"
      do ConfirmDeleteItem()
   }

   render ScrollView [screen] {
      guard Item
      Col [page] {
         Text(Item.HearthList.Name) [caption]
         Row [content right center, gap xs, wrap] {
            Button(OpenSeparately)
            Button(DeleteItem)
         }
         loop Lookers.Others / Looker { Status("{ Looker.Name } is looking at this too") }

         Panes [gap lg] {
            Col [gap md, claim 2] {
               Section("Details") {
                  Col [card] {
                     // The row exists and each field stands on its own, so every input writes through as
                     // you type — a keystroke is a write; `together` and `validate` on the entity still
                     // hold; the honest concurrent policy is the datasource's field-wise latest. There is
                     // no save button to forget.
                     #itemTitle
                     TextInput(Value: bind Item.Title, Label: "What needs doing?")
                     TextInput(Value: bind Item.Note, Label: "Notes", Lines: 4)
                     DateTimeInput(Value: bind Item.Due, Label: "When")
                     Choice(Value: bind Item.Assignee, Options: Item.HearthList.Home.Memberships.Person, Placeholder: "Nobody yet", Label: "Who")
                     if Item.HearthList.Kind is Shopping {
                        Row [gap md] {
                           NumberInput(Value: bind Item.Quantity, Label: "Quantity") [claim 1]
                           Choice(Value: bind Item.Unit, Label: "Unit") [claim 1]
                     }  }
                     PlaceInput(Value: bind Item.Place, Label: "Place")
                     Problems(Item)
               }  }
               Section("Photos") {
                  guard ItemPhotos
                  Grid [cell min 120, gap sm] {
                     loop ItemPhotos / Photo {
                        Image(Photo.Image, Description: when Photo.Caption is empty Item.Title / not Photo.Caption) [height 120, fit cover, radius sm]
                     }
                  }
                  ImageInput(Label: "Add a photo", Sources: camera, library) { on change -> Picture { do AddPhoto(Picture) } }
            }  }

            Col [gap md] {
               Section("Conversation") {
                  guard ItemComments
                  if ItemComments is empty { Text("No notes yet.") [muted] }
                  loop ItemComments / Comment {
                     Col [card, gap xs] {
                        Row [content left center, gap xs] {
                           Image(Comment.Author.Photo, Description: Comment.Author.Name) [size 28, radius pill]
                           Text(Comment.Author.Name) [caption]
                           Text(Comment.CreatedAt.Relative) [caption, claim 1, align right]
                        }
                        Text(Comment.Body) [body]
                  }  }
                  Row [surface, pad xs, gap xs] {
                     #newComment
                     TextInput(Value: bind NewComment, Label: "Add a note") [claim 1] { on submit -> { do AddComment() } }
                     #addComment
                     Button("Add", Icon: "arrow.up", Disabled: NewComment is empty) [primary] { on press -> { do AddComment() } }
}  }  }  }  }  }  }

// -- Sharing --------------------------------------------------------------------------------------------------

file view ShareListSheet(HearthList) {
   action Start() runs single {
      when do ShareList(HearthList) {
         saved -> Published { share SharedListLink(Published); dismiss }
   }  }
   action Revoke() runs single { do StopSharingList(HearthList); dismiss }
   render Col [gap lg, pad lg, width max 620] {
      when HearthList.Shared {
         Private -> {
            Text("Anyone with the link sees the open items, their quantities, and their places. Notes, who is doing what, comments, and photos stay home.") [body]
            PublicationPreview(HearthList, As: SharedList)
            Row [content right center, gap sm] {
               Button("Cancel") [quiet] { on press -> { dismiss } }
               #createLink
               Button("Create read-only link") [primary, busy when Start.Running] { on press -> { do Start() } }
         }  }
         Shared -> {
            Status("Anyone with the link can see this list", Tone: Good)
            PublicationPreview(HearthList, As: SharedList)
            Row [content right center, gap sm] {
               Button("Close") [quiet] { on press -> { dismiss } }
               #revokeLink
               Button("Stop sharing") [destructive, busy when Revoke.Running] { on press -> { do Revoke() } }
               Button("Share link") [primary] { on press -> { share SharedListLink(publish HearthList as SharedList) } }
}  }  }  }  }

public scene SharedListScreen(SharedList) {
   Title SharedList.Name
   render ScrollView [screen] {
      guard SharedList
      Col [page, width max 720] {
         Text(SharedList.Name) [pageTitle]
         Text("Shared read-only from Hearth") [caption]
         loop SharedList.Items / Item {
            Row [line] {
               Text(Item.Title) [body, main]
               if Item.Quantity is not none { Text("{ Item.Quantity } { Item.Unit }") [caption, trail] }
               if Item.Place is not none { Text(Item.Place.Name) [caption, trail] }
}  }  }  }  }
