// Writes that have to land together, and work the provider owns.

transaction CreateHome(Name text) for Me returns Home {
   let Home = create Home { Name, TimeZone: device.timeZone }
   create Membership in Home.Memberships { Person: Me, Owner }
   create HearthList in Home.Lists { Name: "Things to do", Chores }
   create HearthList in Home.Lists { Name: "Shopping", Shopping }
   update Me { CurrentHome: Home } // the app root follows this write
   return Home
}

transaction InviteToHome(Home, Role, Email text (optional)) for Me returns Invite {
   refuse when cannot create Invite in Home.Invites { Role } "Only an adult can invite someone."
   return create Invite { Home, Role, Email, InvitedBy: Me }
}

transaction JoinWithInvite(Secret secret) for Me returns Home {
   let Invite = exactly one Invites where Code is Secret
   refuse when Invite is missing "This invitation is no longer available."
   refuse when Invite is Used "This invitation has already been used."
   refuse when Invite.ExpiresAt < now "This invitation has expired."
   refuse when Invite.Email is not none and Invite.Email is not Me.Email "This invitation was sent to someone else."
   refuse when Invite.Home.Memberships has any where Person is Me "You already live here."

   create Membership { Home: Invite.Home, Person: Me, Role: Invite.Role }
   update Invite { Used }
   update Me { CurrentHome: Invite.Home }
   return Invite.Home
}

transaction LeaveHome(Membership) for Me {
   // The `validate at least one Memberships where Role is Owner` on Home does the real work.
   delete Membership
   update Me { CurrentHome: none }
}

// Deleting an account ends in `delete Me`; the homes' owner invariant still holds, so a sole owner is
// stopped with the home's own sentence. What the person wrote stays: references to a deleted account
// (`CreatedBy`, `CompletedBy`, `Author`) keep a redacted stand-in that reads "Former member".
transaction DeleteMyAccount() for Me {
   delete Me.Memberships
   delete Me
}

// Completion stamps who and when — one fact, `together` on the entity — and is `runs latest per Item`
// at the call site, so a quick tick-untick settles on the last state.
transaction SetDone(Item HearthItem, Done yes / no) for Me {
   if Done { update Item { Complete, CompletedBy: Me, CompletedAt: now } }
   else { update Item { Open, CompletedBy: none, CompletedAt: none } }
}

transaction ShareList(HearthList) for Me returns SharedList {
   update HearthList { Shared }
   return publish HearthList as SharedList
}

transaction StopSharingList(HearthList) for Me {
   // Rotating the code is the revocation: every link already sent stops resolving.
   update HearthList { Private, ShareCode: new secret }
}

// -- Automations ----------------------------------------------------------------------------------------------

// A quiet reminder before something is due, for whoever is taking care of it — otherwise the adults, who
// are keeping the home running. Provider-owned, so it reaches the assignee's devices, not the device that
// created the item.
automation DueSoon for HearthItem as Item {
   schedule when Item.Due { none -> never; otherwise -> at Item.Due - 30 minutes }
   while Item is Open
   once per Item.Due
   to Item.Assignee otherwise Stewards of Item.HearthList.Home
   notify {
      Title Item.HearthList.Name
      Body "{ Item.Title } is due at { Item.Due.Time }"
   }
   opens ItemLink(Item)
}
