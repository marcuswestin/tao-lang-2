// The states this app is reviewed, screenshotted, and audited in.

scenarios "Today" {
   scenario "phone" { fixture PineStreet; run Hearth; at @today; device phone }
   scenario "spanishLargeText" {
      fixture PineStreet
      prepare { update Me { Language: "es" } }
      run Hearth
      at @today
      device phone
      textScale 200%
   }
}

scenarios "Lists" {
   scenario "laptopSplit" { fixture PineStreet; run Hearth at ListLink(PlansList); device laptop 1440 x 900; pointer precise; keyboard present }
   scenario "emptyHome" {
      fixture NewPerson
      run Hearth
      prepare { do CreateHome("Foxglove House") }
      at @lists
      device tablet
   }
}

scenarios "Item" {
   scenario "window" { fixture PineStreet; run Hearth at ItemLink(Plants); device laptop 1440 x 900 }
   scenario "darkOffline" { fixture PineStreet; run Hearth at ItemLink(Plants); device phone; appearance dark; network offline }
   scenario "reducedMotionHighContrast" { fixture PineStreet; run Hearth at ItemLink(Plants); device tablet landscape; contrast high; motion reduced }
}

scenarios "Shopping" {
   scenario "folded" { fixture PineStreet; run Hearth at ListLink(ShoppingList); device phone }
}

scenarios "Week" {
   scenario "wide" { fixture PineStreet; run Hearth; at @week; device laptop 1440 x 900 }
   scenario "narrow" { fixture PineStreet; run Hearth; at @week; device phone }
}

scenarios "Around" {
   scenario "granted" { fixture PineStreet; run Hearth; at @around; device tablet landscape; location granted }
   scenario "denied" { fixture PineStreet; run Hearth; at @around; device phone; location denied }
}

scenarios "People" {
   scenario "youngPerson" {
      fixture PineStreet
      prepare { update SamMember { Role: YoungPerson } }
      signed in as Sam
      run Hearth
      at @people
      device phone
   }
}

scenarios "Recovery" {
   scenario "removedList" { fixture PineStreet; run Hearth at ListLink(PlansList); prepare { delete PlansList }; device phone }
}

// Every rule in HearthDesign's `rules { }` is checked in every scenario; these are the check-only requirements.
design check HearthDesign across all scenarios {
   require no clipped text at 200%
   require no horizontal scroll except maps
   require meaning survives without colour or motion
}
