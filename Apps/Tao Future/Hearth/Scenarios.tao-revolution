// The states this app is reviewed, screenshotted, and audited in.
//
// Group clauses are inherited defaults; an entry clause of the same kind replaces the group's wholesale.
// `prepare` is the scenario-local data delta — ordered updates to fixture handles — and an entry may
// continue with an ordered interaction prefix spelled exactly like a test body. Every rule in
// HearthDesign's `rules { }` runs over these, so `tao review` and the design's criteria cannot drift.

scenarios "Today" {
   fixture PineStreet
   run Hearth
   device phone

   scenario "phone" { }
   scenario "spanishLargeText" {
      locale "es"
      textScale 200%
   }
   // Pseudolanguages are review modes, never shipped languages, and mirrored layout is reviewed with them.
   scenario "pseudolocale" {
      locale pseudolocale
      direction rightToLeft
   }
}

scenarios "Lists" {
   fixture PineStreet

   scenario "laptopSplit" {
      run Hearth at ListLink(PlansList)
      device laptop 1440 x 900
   }
   scenario "emptyHome" {
      fixture NewPerson
      run Hearth
      device tablet
   }
}

scenarios "Item" {
   fixture PineStreet
   run Hearth at ItemLink(Plants)

   scenario "window" { device laptop 1440 x 900 }
   scenario "darkOffline" { device phone; appearance dark; network offline }
   scenario "reducedMotionHighContrast" { device tablet landscape; contrast high; motion reduced }
}

scenarios "Shopping" {
   fixture PineStreet
   run Hearth at ListLink(ShoppingList)
   device phone

   scenario "folded" { }
}

scenarios "Week" {
   fixture PineStreet
   run Hearth
   press "Week"

   scenario "wide" { device laptop 1440 x 900 }
   scenario "narrow" { device phone }
}

scenarios "Around" {
   fixture PineStreet
   run Hearth
   press "Around"

   scenario "granted" { device tablet landscape }
   scenario "denied" { device phone }
}

scenarios "People" {
   fixture PineStreet
   run Hearth
   device phone

   scenario "youngPerson" {
      prepare { update SamMember { Role: YoungPerson } }
      signed in as Sam
      press "People"
   }
}

// A focused view render rather than an app run: one parameterized view with fixture-handle arguments.
scenarios HearthItemRow "row" {
   fixture PineStreet
   device phone

   scenario "assignedAndDue" { render HearthItemRow(Item: Plants) }
   scenario "finished" {
      prepare { update Plants { Complete } }
      render HearthItemRow(Item: Plants)
   }
}
