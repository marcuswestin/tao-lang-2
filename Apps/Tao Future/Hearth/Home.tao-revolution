// Getting in, Today, who lives here, and settings.

use primary from @tao/keys
use SignIn, SignOut from @tao/auth

scene Loading() {
   Title "Hearth"
   render Col [screen, content center center] { Spinner(Label: "Opening Hearth…") }
}

scene Welcome() {
   Title "Hearth"
   render ScrollView [screen] {
      Col [page, width max 560, content center center] {
         Icon("flame") [size 48, ink accent, decorative]
         Text("Hearth") [pageTitle]
         Text("A shared place for the life you tend together.") [body, muted]
         when Me {
            loading -> Status("Opening Hearth…")
            none -> SignInPanel()
            error -> Message { Status(Message, Tone: Warning) }
            otherwise -> HomePicker()
}  }  }  }

file view SignInPanel() {
   state Email = ""
   action SendLink() runs single {
      check Email is not empty
      when do SignIn(Email) {
         saved -> present Notice("Check your inbox — the link signs you in on this device.") as toast (Key: "sign-in")
   }  }
   render Col [card, gap sm] {
      #email
      TextInput(Value: bind Email, Label: "Email", Placeholder: "you@example.com", Keyboard: email) { on submit -> { do SendLink() } }
      Button("Email me a sign-in link", Disabled: Email is empty) [primary, busy when SendLink.Running] { on press -> { do SendLink() } }
}  }

// A person with two homes picks one; a person with none makes one. Choosing is a write to a preference.
file view HomePicker() {
   query MyMemberships from Me.Memberships { order by JoinedAt }
   render Col [gap lg] {
      guard MyMemberships
      if MyMemberships is not empty {
         Text("Choose a home") [sectionTitle]
         loop MyMemberships / Membership {
            Row [line, surface, pad md] {
               Col [size 12, radius pill, background listAccent(Membership.Home.Accent), lead, decorative]
               Col [main, gap xxs] {
                  Text(Membership.Home.Name) [sectionTitle]
                  Text(Membership.Role) [caption]
               }
               Icon("chevron.right") [muted, trail]
            }
            on select -> { update Me { CurrentHome: Membership.Home } }
      }  }
      StartHomePanel()
}  }

file view StartHomePanel() {
   draft New = Home for new
   action Create() runs single {
      check New.Incomplete is no
      when do CreateHome(New.Name) {
         saved -> discard New // the root follows `MyHome`; nothing to navigate
         rejected -> Problem { invalidate New with Problem }
   }  }
   render Col [card, gap md] {
      Text("Make a home") [sectionTitle]
      Text("One calm place for everything your household tends.") [body, muted]
      #homeName
      TextInput(Value: bind New.Name, Label: "Home name", Focus: initial) { on submit -> { do Create() } }
      Problems(New)
      #createHome
      Button("Create home", Disabled: New.Incomplete) [primary, busy when Create.Running] { on press -> { do Create() } }
}  }

view JoinHome(Code secret) {
   let Invited = InvitedHome by Code
   state Refusal = ""
   action Join() runs single {
      when do JoinWithInvite(Code) {
         saved -> dismiss // the root follows the account; the home appears behind the sheet
         rejected -> Problem { set Refusal = Problem }
   }  }
   render Col [gap lg, pad lg, width max 520] {
      guard Me { none -> {
         Text("Sign in first — this invitation will be waiting.") [body]
         SignInPanel()
      }  }
      guard Invited // loading and missing fall to `guard default`; an expired invitation is refused with a sentence on Join
      Text("You're invited to { Invited.Name }") [title]
      Text("You'll see its lists, add to them, and take care of things together.") [body, muted]
      if Refusal is not empty { Status(Refusal, Tone: Warning, Announce: yes) }
      #join
      Button("Join { Invited.Name }") [primary, busy when Join.Running] { on press -> { do Join() } }
      Button("Not now") [quiet] { on press -> { dismiss } }
}  }

// -- Today ---------------------------------------------------------------------------------------------------

scene TodayScreen() {
   Title "Today at { MyHome.Name }"
   Toolbar { AddSomething }
   query DueToday from MyHome.Lists.Items {
      where is Open
      where Due < end of today in MyHome.TimeZone or (Due is none and CreatedAt during today in MyHome.TimeZone)
      order by Due
   }
   query Mine from MyHome.Lists.Items {
      where is Open and Assignee is Me and Due is none
      order by CreatedAt descending
      limit 5
   }
   render ScrollView [screen] {
      Col [page] {
         Text(today.Long) [muted] // a date prints in the reader's language
         OfflineNotice()
         guard DueToday
         Section("Due today") {
            if DueToday is empty {
               EmptyState(Icon: "sun.max", Title: "Nothing due today", Body: "The day has room to breathe.") {
                  Button(AddSomething) [secondary]
            }  }
            #todayItems
            loop DueToday / Item { HearthItemRow(Item); on select -> { open ItemLink(Item) } }
         }
         if Mine is not empty { // a query read before its guard is empty while unavailable
            Section("Yours, whenever") {
               loop Mine / Item { HearthItemRow(Item); on select -> { open ItemLink(Item) } }
}  }  }  }  }

// -- People -----------------------------------------------------------------------------------------------------

scene PeopleScreen() {
   Title "People"
   Toolbar { InviteSomeone }
   query Members from MyHome.Memberships { order by JoinedAt }

   action CreateInviteLink() runs single {
      // Visibility is derived from whether the store permits creating an Invite in MyHome.Invites;
      // the command adds no second authorization rule.
      let Invite = ask InviteSheet(MyHome)
      check Invite is not none
      share JoinLink(Invite.Code)
      present Notice("Invite link ready — it works once, for seven days") as toast (Key: "invite")
   }
   command InviteSomeone() {
      Title "Invite someone"
      Icon "person.badge.plus"
      Key primary + "i"
      do CreateInviteLink()
   }

   // `ask` belongs in an action and `check` is the action-only early exit, so the confirmed removal is
   // one procedure rather than a conditional at the press site.
   action ConfirmRemove(Member Membership) runs single {
      let Sure = ask Confirm("Remove { Member.Person.Name }?", Body: "They will lose access to this home.", Verb: "Remove")
      check Sure
      delete Member
   }

   render ScrollView [screen] {
      Col [page, width max 760] {
         OfflineNotice()
         Section("Who lives here") {
            @actions Button(InviteSomeone)
            guard Members
            loop Members / Member {
               Row [line] {
                  Image(Member.Person.Photo, Description: Member.Person.Name) [size 32, radius pill, lead]
                  Col [main, gap xxs] {
                     Text(Member.Person.Name) [body]
                     Text(Member.Role) [caption]
                  }
                  if can change Member.Role { Choice(Value: bind Member.Role, Label: "Role for { Member.Person.Name }") [trail] }
                  if Member.Person is Me { Text("You") [chip, trail] }
                  if can delete Member and Member.Person is not Me {
                     Button(Icon: "minus.circle", Label: "Remove { Member.Person.Name }") [quiet, trail] {
                        on press -> { do ConfirmRemove(Member) }
}  }  }  }  }  }  }  }

file view InviteSheet(Home) responds Invite {
   draft New = Invite for new { Home, Role: Adult }
   let Grantable = Role.Cases where can create Invite in Home.Invites { Role } // only an owner may mint an owner
   action Send() runs single {
      when do InviteToHome(Home, New.Role, New.Email) {
         saved -> Invite { respond Invite }
         rejected -> Problem { invalidate New with Problem }
   }  }
   render Col [card, width max 480, gap md] {
      Text("Invite someone") [sectionTitle]
      #inviteEmail
      TextInput(Value: bind New.Email, Label: "Email (optional — leave blank for a link anyone may use once)", Keyboard: email)
      Choice(Value: bind New.Role, Label: "Role", Options: Grantable)
      Problems(New)
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> { respond } }
         #sendInvite
         Button("Create invite link") [primary, busy when Send.Running] { on press -> { do Send() } }
}  }  }

// -- Settings ------------------------------------------------------------------------------------------------------

scene SettingsScreen() {
   Title "Settings"

   action ConfirmLeave() runs single {
      let Sure = ask Confirm("Leave { MyHome.Name }?", Body: "You will lose access to its lists.", Verb: "Leave")
      check Sure
      when do LeaveHome(MyMembership) { // a last owner is refused with the home's own sentence
         rejected -> Problem { present Notice(Problem) as toast (Key: "problem") }
      }
   }
   command Leave() {
      Title "Leave this home"
      Icon "rectangle.portrait.and.arrow.right"
      do ConfirmLeave()
   }
   action ConfirmDeleteAccount() runs single {
      // The delete effect and explicit confirmation carry destructive behavior; the command needs
      // no separate role marker.
      let Sure = ask Confirm("Delete your account?", Body: "Your homes stay with the people in them. This cannot be undone.", Verb: "Delete account")
      check Sure
      when do DeleteMyAccount() {
         rejected -> Problem { present Notice(Problem) as toast (Key: "problem") }
      }
   }
   command DeleteAccount() {
      Title "Delete my account"
      Icon "person.crop.circle.badge.xmark"
      do ConfirmDeleteAccount()
   }

   render ScrollView [screen] {
      Col [page, width max 720] {
         Section("This home") {
            if can change MyHome {
               #homeName
               TextInput(Value: bind MyHome.Name, Label: "Home name")
               Choice(Value: bind MyHome.Accent, Label: "Accent")
               Choice(Value: bind MyHome.TimeZone, Label: "Time zone")
               Problems(MyHome)
         }  }
         Section("Reminders") {
            Text("A quiet reminder shortly before something is due, for whoever is taking care of it — never during quiet hours.") [caption]
            PermissionRow(NotificationAccess, Label: "Upcoming items")
         }
         Section("Around") {
            PermissionRow(LocationAccess, Label: "Errands near you")
         }
         Section("You") {
            Toggle(Value: bind Me.KeepOffline, Label: "Keep this home on my device")
            Text(Me.Email) [caption]
            #switchHome
            Button("Switch home", Icon: "house") [quiet] { on press -> { update Me { CurrentHome: none } } } // the root re-reads `MyHome`
            #leave
            Button(Leave) [quiet]
            Button("Sign out") [quiet] { on press -> { do SignOut() } }
            Button(DeleteAccount) [quiet]
}  }  }  }
