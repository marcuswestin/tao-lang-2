// Who may read and write what, and what crosses the public boundary.
//
// Everything below is enforced by the store. No screen decides whether a person may do something — it
// asks (`can change Item`) and the answer comes from here.

// -- Audiences -------------------------------------------------------------------------------------------

audience Family for Home = Home.Memberships.Person
audience Stewards for Home = Home.Memberships[Role in Owner, Adult].Person
audience Owners for Home = Home.Memberships[Role is Owner].Person

// -- Access ------------------------------------------------------------------------------------------------

access Home {
   read to Family
   create through CreateHome // the only path that can satisfy the owner invariant
   change to Stewards
   delete to Owners
}

access Membership {
   read to Family of Home
   create through JoinWithInvite or CreateHome
   change Role to Owners of Home
   delete to Owners of Home or Person // an owner may remove you; you may always leave
}

access Invite {
   read to Stewards of Home or holder of Code
   create to Stewards of Home where Role in Adult, YoungPerson
   create to Owners of Home // only an owner may mint an owner
   change Used to holder of Code
   delete to Stewards of Home
}

access HearthList {
   read to Family of Home
   create, change, delete to Stewards of Home
   change Shared, ShareCode through ShareList or StopSharingList // a field named in a `through` grant changes only that way
}

// Ticking is for everyone — a young person saying "done" is the point. Removing is not.
access HearthItem {
   read, create, change to Family of HearthList.Home
   delete to Stewards of HearthList.Home or CreatedBy
}

access Comment {
   read, create to Family of Item.HearthList.Home
   change to Author
   delete to Author or Stewards of Item.HearthList.Home
}

access Photo as HearthItem

// -- The public boundary ------------------------------------------------------------------------------------
//
// A shared list is an exact projection: open items, their quantities, and their places — never notes,
// assignments, comments, photos, people, or completion history. Behind a rotating capability.

public publish HearthList when HearthList is Shared as SharedList by capability HearthList.ShareCode {
   Name
   Kind
   Color
   Items where is Open { Title, Quantity, Unit, Place { Name, Coordinate } }
}

// An invitation shows the home's name before you belong to it, and nothing else.
public publish Home as InvitedHome by capability Invite.Code {
   Name
   Anyone = Invite.Email is none
}
