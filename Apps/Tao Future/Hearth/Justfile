# Hearth — the `tao` CLI as a Hearth developer would use it once Tao is Tao.
#
# A specification artifact, like the `.tao-revolution` files beside it: nothing here runs today.

set quiet

TAO := justfile_directory() + "/../../../tao"

# Print available recipes
help:
    just --list

# Check everything: syntax, types, access rules, design rules, words coverage, canonical form.
check:
    {{ TAO }} check .

# Apply every source fix in place, then format.
fix:
    {{ TAO }} fix .

# Run every journey on every device a check names.
test:
    {{ TAO }} test .

# Run one journey, on one device, and watch it.
test-one CHECK DEVICE="phone":
    {{ TAO }} test . --check "{{ CHECK }}" --device {{ DEVICE }} --watch

# Live-develop: pick a simulator, an emulator, a browser, or the desktop app.
dev DEVICE="phone":
    {{ TAO }} dev . --app Hearth --device {{ DEVICE }}

# Live-develop against the device store, with no account or network involved.
dev-on-device:
    {{ TAO }} dev . --app HearthOnDevice

# Open the in-memory preview, signed in as the demo account.
preview:
    {{ TAO }} dev . --app HearthPreview

# Render every scenario for review.
scenarios:
    {{ TAO }} design scenarios . --app Hearth

# Hold the app to the design's rules across every scenario.
design-check:
    {{ TAO }} design check . --app Hearth

# Report what crosses the public boundary, from the projections in Access.tao-revolution.
public-surface:
    {{ TAO }} access report . --app Hearth --public

# Report every literal and phrase each language has not translated.
words-check:
    {{ TAO }} words check .

# Build and submit to the stores, automating as much as possible. Docs/Roadmap/Tao ship/
ship:
    {{ TAO }} ship . --app Hearth

# Deliver a compiled build to the project's invited members through the Tao Studio companion app.
ship-beta:
    {{ TAO }} ship . --app Hearth --beta
