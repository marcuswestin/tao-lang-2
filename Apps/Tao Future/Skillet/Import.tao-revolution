// Importing a recipe from a web page — the one thing here Tao does not own.
//
// Tao declares the contract and emits `FetchRecipeAction` from it; TypeScript implements it in the
// sidecar, and the compiler checks the join both ways. Rejecting is a returned value, not an exception,
// so the caller sees it as an ordinary outcome case. The sidecar holds no authority: it returns a value,
// and one transaction commits it.

use primary from @tao/keys

type RecipeDraft is {
   Title text
   Servings number
   Ingredients list of text
   Steps list of text
   Source text
}

// `<expression> from <path>` is the whole boundary: no `implement`, no `inject`, no kind word, and no
// inline fence. A foreign action declares its failure cases on its head, so a test stubbing one picks a
// declared case and renaming that case breaks the test at compile time.
action FetchRecipe(Link text) returns RecipeDraft
   fails NotARecipe "No recipe was found on that page."
   fails Unreachable "That page could not be read."
   from ./FetchRecipe.ts

// App-wide, mounted on the navigator.
action OpenImportSheet() {
   // Visibility follows permission to create a Recipe in MyKitchen.Recipes, resolved by the store.
   present ImportSheet() as sheet
}
command ImportRecipe() {
   Title "Import from a link"
   Icon "link"
   Key primary + "i"
   do OpenImportSheet()
}

file view ImportSheet() {
   state Link = ""

   state Refusal = ""

   // `runs single`: a second press while the first fetch is in flight is ignored, not queued. Dismissing
   // the sheet cancels a fetch in flight. A declared failure aborts the whole joined call and discards
   // its private writes, and the outcome belongs to this site — nothing shows unless it is named here.
   action Import() runs single {
      check Link is not empty
      when do FetchRecipe(Link) {
         saved -> RecipeDraft {
            // One transaction: the recipe, its ingredients, and its steps land together or not at all.
            let Recipe = SaveImportedRecipe(MyKitchen, RecipeDraft)
            dismiss
            open RecipeLink(Recipe)
         }
         error -> Message { set Refusal = Message } // the declared case's sentence, beside the field
   }  }

   render Col [card, width max 560, gap md] {
      Text("Paste a link to a recipe on the web.") [body, muted]
      #importLink
      TextInput(Value: bind Link, Label: "Link", Placeholder: "https://…", Keyboard: url, Focus: initial) { on submit -> { do Import() } }
      if Import running { Status("Reading the page…", Announce: yes) }
      if Refusal is not empty { Status(Refusal, Tone: Warning, Announce: yes) }
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> { dismiss } }
         #import
         Button("Import", Disabled: Link is empty, Busy: Import running) [primary] { on press -> { do Import() } }
}  }  }
