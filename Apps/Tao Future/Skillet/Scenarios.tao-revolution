// The states this app is reviewed, screenshotted, and audited in.
//
// `scenarios [Subject] "group" { … }` has an optional subject and a required group name; every nested
// `scenario "entry" { … }` has a required entry name. Group clauses are inherited defaults and an entry
// clause of the same kind replaces the group's wholesale, so after inheritance every entry has exactly
// one device and one subject. `prepare` is the scenario-local data delta: ordered updates to fixture
// handles, applied after the fixture and before the subject mounts — it is not a second fixture.
//
// Every rule in SkilletDesign's `rules { }` runs over these, so a screenshot and the design's acceptance
// criteria cannot drift apart. There is no `design check` declaration: `tao review` renders the gallery
// and flags what it can measure there.

scenarios "Library" {
   fixture HomeKitchen
   run Skillet at RecipeLink(Shakshuka)

   scenario "empty" {
      fixture NewCook
      run Skillet
      device phone
      appearance light
   }
   scenario "full" {
      device laptop 1440 x 900
   }
}

scenarios "Recipe" {
   fixture HomeKitchen
   run Skillet at RecipeLink(Shakshuka)
   device phone

   scenario "longTitleLargeText" {
      prepare { update Shakshuka { Title: "Shakshuka with roasted red pepper and a soft egg" } }
      textScale 200%
   }
   scenario "spanish" {
      locale "es"
   }
   // Pseudolanguages are review modes, never shipped languages: Double-Length and mirrored layout are
   // reviewed in one pass, and neither is an entry in `app { languages }`.
   scenario "pseudolocale" {
      locale pseudolocale
      direction rightToLeft
   }
}

scenarios "Shop" {
   fixture WeekShopped
   run Skillet
   device phone

   scenario "foldedOffline" {
      network offline
      press "Shop"
   }
   scenario "withStores" {
      device tablet landscape
      press "Shop"
   }
}

scenarios "Cook" {
   fixture TimerRunning
   run Skillet at CookLink(Shakshuka)
   device tablet landscape
   appearance dark

   scenario "running" { }
   scenario "reducedMotionHighContrast" {
      contrast high
      motion reduced
   }
}

scenarios "Kitchen" {
   fixture HomeKitchen
   run Skillet
   device phone

   scenario "guest" {
      prepare { update SamMember { Role: Guest } }
      press "Kitchen"
   }
}

// A focused view render rather than an app run: one parameterized view mounted with fixture handles.
scenarios RecipeCard "row" {
   fixture HomeKitchen
   device phone

   scenario "favorite" {
      prepare { update Shakshuka { Favorite } }
      render RecipeCard(Recipe: Shakshuka)
   }
   scenario "shared" {
      prepare { update Shakshuka { Shared } }
      render RecipeCard(Recipe: Shakshuka)
   }
}
