// The shopping list. Lines arrive from the plan and from typing; the same ingredient across a week is
// one line you tick once.

scene ShoppingList() {
   Title "Shop"
   Toolbar { ClearTheBought }
   state NewItem = ""

   // `group by` folds rows that agree on the named fields into one line, and a named aggregate totals a
   // field. A folded line stands for the rows it folds: reading Name or Unit reads what they share,
   // reading Amount reads the total, and ticking it ticks every row inside. A grouped row keeps its
   // contributing rows under their collection name, so `Line.Groceries` is there when a screen wants
   // the rows themselves.
   query Lines from MyKitchen.Groceries {
      where is Needed
      group by Name, Unit, Aisle, Store
      Amount = sum(Amount)
      order by Aisle, Name
   }
   // The aisles that have something in them, so the walk through the shop is in order. A second
   // grouped query is how a screen groups a presentation: `loop` iterates and never groups.
   query Aisles from MyKitchen.Groceries {
      where is Needed
      group by Aisle
      order by Aisle
   }
   query Bought from MyKitchen.Groceries {
      where is Bought
      group by Name, Unit, Aisle, Store
      Amount = sum(Amount)
      order by Name
   }
   action AddItem() runs single {
      check NewItem is not empty
      create Grocery { Household: MyKitchen, Name: NewItem }
      set NewItem = ""
   }

   action DeleteBoughtItems() runs single {
      // Visibility is store-derived from whether any Bought Grocery may be deleted; Enabled below
      // separately keeps the visible command inert when there are no bought rows.
      delete each Grocery where Household is MyKitchen and is Bought
   }
   command ClearTheBought() {
      Title "Clear bought"
      Icon "trash"
      Enabled Bought is not empty
      do DeleteBoughtItems()
   }

   render ScrollView [screen] {
      Col [page, width max 900] {
         OfflineNotice()
         #newItem
         TextInput(Value: bind NewItem, Label: "Add an item", Placeholder: "Olive oil") { on submit -> { do AddItem() } }

         guard Lines
         if Lines is empty {
            EmptyState(Icon: "basket", Title: "Nothing to buy", Body: "Plan a meal and add it to the list, or type an item above.")
         }

         // The list and the map side by side on a wide screen, one column on a phone. A map must name a
         // non-map alternative over the same rows, so location graphics are never the only way to shop.
         Panes [gap lg] {
            #lines
            Col [claim 2, gap lg] {
               loop Aisles / AisleLines {
                  Section(AisleLines.Aisle) {
                     @actions Col [size 14, radius pill, background aisle(AisleLines.Aisle), decorative]
                     loop Lines / Line where Line.Aisle is AisleLines.Aisle { GroceryRow(Line) }
               }  }

               if Bought is not empty {
                  Section("Bought") {
                     loop Bought / Line { GroceryRow(Line) }
            }  }  }

            if Lines[Store is not none] is not empty {
               Map(Lines, Place: Line.Store, Label: "Where to buy these") [height min 320, radius lg] {
                  pin label Line.Store.Name
                  me
               } alternative {
                  loop Lines / Line { GroceryRow(Line) }
}  }  }  }  }  }

// One line of the list — a folded row, which stands for its sources: it exposes the fields the fold
// agrees on (the grouped fields, `where`-fixed fields, sums), and a write through it reaches every
// source row. `Bought` is bound to the row, so ticking writes through.
file view GroceryRow(Grocery) {
   action HaveIt() runs single {
      when do KeepInPantry(Grocery) {
         saved -> present Notice("{ Grocery.Name } is in the pantry") as toast (Key: "pantry")
   }  }
   render Row [line] {
      #tick
      Checkbox(Value: bind Grocery.Bought, Label: Grocery.Name) [lead]
      Col [main, gap xxs] {
         Text(Grocery.Name) [body, strike when Grocery is Bought]
         // Bound to the row, so on a folded line this sets the shop for every row it stands for.
         if NearbyStores is not empty {
            Choice(Value: bind Grocery.Store, Options: NearbyStores, Placeholder: "Any shop", Label: "Where to buy { Grocery.Name }") [caption]
      }  }
      Measure(Grocery.Amount, Grocery.Unit) [trail]
      Button(Icon: "cabinet", Label: "Already have { Grocery.Name }") [quiet, trail] { on press -> { do HaveIt() } }
}  }
