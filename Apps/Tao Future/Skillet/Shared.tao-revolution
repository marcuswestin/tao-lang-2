// The vocabulary every screen uses: the kitchen, the safety net, the frames, the one question, and the
// commands that work from every tab.

// -- Live handles ------------------------------------------------------------------------------------------
//
// One membership per person, so `MyKitchen` is a value and the app root can be a `when` over it. A
// handle carries availability like a query: the root sees `loading`, `none`, or the kitchen.
let MyMembership = exactly one Me.Memberships
let MyKitchen = MyMembership.Household

// -- The safety net -----------------------------------------------------------------------------------------
//
// Every case a guard does not name lands here. Declaring it is not optional — an app without a
// `guard default` is a validator error — which is how `unauthorized` becomes unskippable without making
// every read site spell five branches. A guard is availability only. Emptiness is content, not failure,
// so it is `if X is empty` at the site that cares.
//
// `failed` is the safety net for effects: an outcome no `when` handled — a transaction, a sidecar, or a
// sign-in that was rejected or errored inside an action — lands here with its sentence. (An unhandled
// rejection of `save X` invalidates X instead, so it shows beside the draft's fields.) This is why most
// `when` blocks below name only the outcome they do something with.
guard default {
   loading -> Spinner(Label: "Opening Skillet…")
   missing -> EmptyState(Icon: "questionmark.folder", Title: "This is gone", Body: "Someone in your kitchen may have removed it.")
   unauthorized -> EmptyState(Icon: "lock", Title: "You don't have access to this", Body: "Ask someone in the kitchen to invite you back.")
   rejected -> Problem { Text(Problem) [caption, danger] }
   error -> Message { Text(Message) [body] }
   failed -> Problem { present Notice(Problem) as toast (Key: "failed") }
}

// -- Frames and layouts ---------------------------------------------------------------------------------------

// A layout places caller content and nothing else.
view Centered() {
   render Col [screen, content center center] { @@content }
}

// Named slots beside `@@content`, so a caller can fill more than one region.
view Section(Title text) {
   @actions = empty

   render Col [gap sm] {
      Row [content spread center, gap sm] {
         Text(Title) [sectionTitle]
         Row [content right center, gap xs] { @actions }
      }
      Col [gap xs] { @@content }
}  }

// The design's `EmptyState` pattern names the slots; this view fills them.
view EmptyState(Icon icon, Title text, Body text) {
   render Col [pattern EmptyState] {
      Icon(Icon) [@icon]
      Text(Title) [@title]
      Text(Body) [@body]
      Col [@action] { @@content }
}  }

// -- Views ---------------------------------------------------------------------------------------------------

type Tone is one of Neutral, Good, Warning

// A status carries a symbol as well as a colour, because the design's rules say so. `Announce` is
// opt-in, so a badge does not become a live region by accident.
view Status(Message text, Tone Tone (default Neutral), Announce yes / no (default no)) {
   let Symbol = when Tone { Neutral -> "circle"; Good -> "checkmark.circle"; Warning -> "exclamationmark.triangle" }
   render Row [content left center, gap sm, announce when Announce] {
      Icon(Symbol) [muted, ink good when Tone is Good, ink danger when Tone is Warning]
      Text(Message) [caption]
}  }

view OfflineNotice() {
   render if Connection is Offline { Status("Offline — your changes are safe on this device", Tone: Warning, Announce: yes) }
}

// An amount in the reader's measurement system: `Mass` and `Volume` carry metric and imperial forms,
// chosen by `Me.Units`, so the same line reads "400 g" or "14 oz" without a branch here.
phrase Mass(Amount number) = metric "{ Amount } g" / imperial "{ Amount in ounces } oz"
phrase Volume(Amount number) = metric "{ Amount } ml" / imperial "{ Amount in cups } cups"

view Measure(Amount number (optional), Unit Unit (optional)) {
   render Text(when Unit {
      none -> Amount
      "g" -> Mass(Amount)
      "kg" -> Mass(Amount * 1000)
      "ml" -> Volume(Amount)
      "l" -> Volume(Amount * 1000)
      otherwise -> "{ Amount } { Unit }"
   }) [caption]
}

view IngredientLine(Ingredient, Scale number (default 1)) {
   render Row [pattern Line] {
      Col [aisleMark(Ingredient.Aisle), @leading, decorative]
      Measure(Ingredient.Amount * Scale, Ingredient.Unit) [@leading]
      Text(Ingredient.Name) [body, @content]
}  }

// -- The one question ---------------------------------------------------------------------------------------

// Back, tapping outside, or Cancel answers no. `stop unless ask Confirm(…)` is the idiom.
view Confirm(Question text, Body text, Verb text) responds yes / no {
   render Col(Label: Question) [card, width max 480, gap md] {
      Text(Question) [sectionTitle]
      Text(Body) [body]
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> respond no }
         #confirm
         Button(Verb) [destructive] { on press -> respond yes }
}  }  }

view Notice(Message text) {
   render Text(Message) [toast]
}

// -- Find anything ------------------------------------------------------------------------------------------
//
// Mounted on the navigator (see Skillet.tao-revolution), so the shortcut works from every tab.

action FindAnythingIntent() {
   Title "Find anything"
   present FindSheet() as palette
}
command FindAnything = FindAnythingIntent() with {
   Label "Find anything"
   Icon "magnifyingglass"
   Key "cmd+k"
}

view FindSheet() {
   Title "Find anything"
   Search Query
   // One query over two fields and two entities, ranked by relevance.
   query Hits from MyKitchen.Recipes {
      search Query in Title, Notes, Ingredients.Name
      order by relevance
      limit 20
   }
   render Col [surface, width max 680] {
      if Query is empty { Text("Search every recipe in this kitchen.") [muted, pad md] }
      guard Hits
      if Hits is empty and Query is not empty { Text("No matches.") [muted, pad md] }
      List(Hits) {
         Row [pattern Line] {
            Icon("book") [@leading]
            Col [@content, gap xxs] {
               Text(Recipe.Title) [body]
               Text(Recipe.Course) [caption]
         }  }
         on select -> { dismiss; open RecipeLink(Recipe) }
}  }  }
