// Skillet's design. One declaration, organized as typed value blocks plus styles, screens, and rules.
// The block name types its members, so the checker needs no annotations and there is no generic tokens
// block. Screens speak in names ([card], [title], [primary]); raw visual values are confined to here.
//
// There is no meaning layer and no dark block: a semantic role is a derived entry whose value is
// conditional on the environment, so the old tokens → meaning → dark stack is one block with derivation.

design SkilletDesign {
   colors {
      cream #FBF7EF
      paper #FFFFFF
      linen #EDE6DA
      charcoal #2B2622
      smoke #6F6861
      ember #D9622B { 20 #F4D7C8, 60 #B34E1F } // a family: ember, ember.20, ember.60
      sage #5E8C61
      brick #B4432F
      night #17140F
      soot #24201B
      ash #3B352E

      // Derived, conditional entries: each resolves at render, constant per frame.
      canvas    when Scheme is Dark night / not cream
      surface   when Scheme is Dark soot / not paper
      sunken    when Scheme is Dark ash / not linen
      inverse   when Scheme is Dark cream / not charcoal
      ink       when Scheme is Dark cream / not charcoal
      muted     when Scheme is Dark linen / not smoke
      subtle    when Scheme is Dark ash / not linen
      accent    ember
      good      sage
      danger    brick
      onAccent  paper // stays light in both schemes: it sits on ember either way

      // A parameterized entry is the case-keyed palette, by the same mechanism as `phrase`. Used as
      // `[background aisle(Ingredient.Aisle)]`, so the mapping is stated once, not re-branched in
      // product code.
      aisle(Aisle) when Aisle {
         Produce -> sage
         Bakery -> ember
         Dairy -> cream
         Pantry -> linen
         Frozen -> smoke
         Homeware -> charcoal
      }
   }

   sizes {
      xxs 2.px, xs 4.px, sm 8.px, md 12.px, lg 16.px, xl 24.px, xxl 40.px
      screen 20.px, touch 48.px
      pill 999.px
      readable 1.rem // grows with the person's text setting
   }

   shadows {
      sm [offset 1.px, blur 3.px, opacity 10%]
      md [offset 6.px, blur 20.px, opacity 14%]
   }

   // The text entries are the clause names a site uses: `Text(Recipe.Title) [title]`.
   text {
      pageTitle [size 34.px, weight bold, line 40.px]
      title [size 24.px, weight semibold, line 30.px]
      sectionTitle [size 17.px, weight semibold, line 22.px]
      body [size 16.px, line 1.4]
      label [size 15.px, weight medium, line 20.px]
      caption [size 13.px, line 18.px, ink muted]
   }

   // The size classes every `when wide` clause uses. No pixel count or device name appears in a screen.
   screens { narrow below 600.px, medium below 900.px, wide }

   styles {
      // Element defaults are Capitalized: every Text in the app starts from `Text`, and `App` is the
      // root's. Interaction states are ordinary postfix conditions, not a sub-grammar.
      App [background canvas]
      Text [ink ink]
      Col [gap sm]
      Row [gap sm]
      Button [label, tap min touch, content center center, gap sm, radius pill,
              pad horizontal md vertical sm, background surface, ink ink, border subtle,
              overlay own ink 8% when hovered, brightness -5% when pressed, scale 0.985 when pressed]
      TextInput [background surface, border subtle, radius sm, pad md, body, tap min touch,
                 border accent when focused, ring accent when focused]
      Checkbox [size 24.px, radius sm, border subtle, tap min touch, ring accent when focused]
      // Generated interaction affordances are ordinary element defaults; an app may restyle them without
      // declaring or owning the runtime layers they render on.
      Hint [background inverse, ink inverse, radius sm, pad horizontal sm vertical xxs, caption]
      Overview [background surface, border subtle, radius md, pad md, gap xs, shadow md]

      // Lowercase bundles a site opts into.
      muted [ink muted]
      danger [ink danger]
      strike [decoration strike]
      center [align center]

      primary [background accent, ink onAccent]
      secondary [background surface, ink ink, border subtle]
      quiet [background none, ink ink]
      destructive [background danger, ink onAccent]

      screen [fill, background canvas, content top center]
      page [fill, width max 1120.px, pad screen, gap lg, pad xxl when wide]
      surface [background surface, border subtle, radius md]
      card [surface, pad md, gap sm, shadow sm, pad lg when wide, pad md when TextScale > 1.6]
      selected [background sunken, border accent]
      chip [background sunken, radius pill, pad horizontal sm vertical xxs, caption,
            pad horizontal md vertical xs when TextScale > 1.6]
      toast [background inverse, ink inverse, radius pill, pad horizontal lg vertical md, label, shadow md]

      // A row: a leading mark, the content, a trailing edge. The retired `patterns { }` block's `Line`
      // is ordinary bundles over ordinary containers.
      line [content left center, gap sm, pad vertical sm, tap min touch]
      lead [hug]
      main [claim 1, compress]
      trail [hug, ink muted]
   }

   // Each rule runs where it is actually decidable: contrast, naming, heading order, and declared tap
   // minimums are build diagnostics, layout-dependent rules are measured over the scenario gallery, and
   // perceptual rules are review criteria the gallery surfaces. There is no `design check` declaration.
   rules {
      rule contrast at least wcag.aa
      rule tap targets at least 44.px
      rule every interactive element is named
      rule heading order is sequential
      rule raw visual values stay inside the design
      rule text survives 200% scale without clipping
      rule no horizontal overflow except maps
      rule meaning survives without color or motion
      rule status is carried by an icon as well as a color
   }
}
