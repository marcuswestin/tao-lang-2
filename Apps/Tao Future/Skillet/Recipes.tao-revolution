// The library, one recipe, its editor, and sharing.

use primary from @tao/keys

// App-wide: mounted on the navigator, so primary+N works from every tab. It closes over app-wide handles only.
action OpenNewRecipe() runs single {
   // Visibility follows permission to create a Recipe in MyKitchen.Recipes, resolved by the store.
   // No row yet, so a draft. It commits once, so an abandoned "New recipe" never syncs to the whole
   // kitchen.
   let Recipe = ask NewRecipeSheet(MyKitchen)
   check Recipe is not none
   open RecipeLink(Recipe)
}
command NewRecipe() {
   Title "New recipe"
   Icon "plus"
   Key primary + "n"
   do OpenNewRecipe()
}

scene RecipeLibrary() {
   Title "Recipes"
   Toolbar { NewRecipe ImportRecipe }
   state Query = ""
   state OnlyFavorites = no
   query Recipes from MyKitchen.Recipes {
      search Query
      where is Favorite or OnlyFavorites is no
      order by Favorite descending, Title
   }

   render ScrollView [screen] {
      Col [page] {
         OfflineNotice()
         Toggle(Value: bind OnlyFavorites, Label: "Favorites only") [caption]
         // Emptiness is content, not failure, so it is handled here rather than in the safety net.
         when Recipes {
            loading -> Spinner(Label: "Opening your library…")
            empty -> {
               when Query is empty {
                  yes -> {
                     EmptyState(Icon: "book", Title: "No recipes yet", Body: "Write one down, or import one from a link.") {
                        Button(NewRecipe) [primary]
                     }
                  }
                  no -> { Text("Nothing matches “{ Query }”.") [body, muted] }
               }
            }
            otherwise -> {
               Grid [cell min 220, gap md] {
                  loop Recipes / Recipe {
                     RecipeCard(Recipe)
                     on select -> { open RecipeLink(Recipe) }
}  }  }  }  }  }  }

file view RecipeCard(Recipe) {
   render Col [card, pad none, gap none, clip] {
      Image(Recipe.Photo, Description: Recipe.Title) [height 140, fit cover]
      Col [pad md, gap xxs] {
         Text(Recipe.Title, Lines: 2) [sectionTitle]
         Row [content left center, gap xs] {
            Text(Recipe.Course) [chip]
            if Recipe is Favorite { Icon("heart.fill", Label: "Favorite") [ink accent] }
            if Recipe is Shared { Icon("link", Label: "Shared") [muted] }
}  }  }  }

view NoRecipeSelected() {
   render EmptyState(Icon: "book", Title: "Pick a recipe", Body: "Your library stays here while a recipe opens beside it, or on the next screen.")
}

scene RecipeScreen(Recipe) {
   Title Recipe.Title
   Toolbar { Cook Plan Share Delete }
   // Who else has this open. Two cooks in one kitchen is the ordinary case, not an edge case.
   presence Viewers on Recipe

   action StartCooking() {
      open CookLink(Recipe)
   }
   command Cook() {
      Title "Cook"
      Icon "flame"
      Key primary + "r"
      Enabled Recipe.Steps is not empty
      do StartCooking()
   }
   action OpenMealPlan() {
      present PlanMeal(Recipe: Recipe) as sheet
   }
   command Plan() {
      Title "Plan"
      Icon "calendar.badge.plus"
      do OpenMealPlan()
   }
   action ToggleFavorite() {
      // Visibility follows permission to change Recipe, resolved by the store.
      toggle Recipe.Favorite
   }
   command Favorite() {
      Title "Favorite"
      Label when Recipe is Favorite "Remove from favorites" / not "Favorite"
      Icon when Recipe is Favorite "heart.fill" / not "heart"
      do ToggleFavorite()
   }
   action OpenRecipeEditor() {
      // Visibility follows permission to change Recipe, resolved by the store.
      present RecipeEditor(Recipe) as sheet
   }
   command Edit() {
      Title "Edit"
      Icon "pencil"
      Key primary + "e"
      do OpenRecipeEditor()
   }
   action OpenRecipeSharing() {
      // Visibility follows permission to change Recipe, resolved by the store.
      present ShareRecipe(Recipe) as sheet
   }
   command Share() {
      Title "Share"
      Label when Recipe is Shared "Manage link" / not "Share recipe"
      Icon "square.and.arrow.up"
      do OpenRecipeSharing()
   }
   action ConfirmDeleteRecipe() runs single {
      // Store-derived delete permission controls visibility. The delete effect and explicit
      // confirmation carry destructive behavior; the command adds no separate role marker.
      let Sure = ask Confirm("Delete { Recipe.Title }?", Body: "This removes it for everyone who cooks here.", Verb: "Delete")
      check Sure
      delete Recipe
      dismiss
   }
   command Delete() {
      Title "Delete recipe"
      Icon "trash"
      do ConfirmDeleteRecipe()
   }

   render ScrollView [screen] {
      guard Recipe // loading, missing, unauthorized, and error all fall to the app read net
      Col [page, width max 900] {
         Image(Recipe.Photo, Description: Recipe.Title) [height 260, radius lg, fit cover]
         Row [content right center, gap xs, wrap] {
            Button(Cook)
            Button(Plan)
            Button(Share)
            Button(Delete)
         }

         Row [content left center, gap xs] {
            Text("{ Recipe.Servings } servings") [chip]
            if Recipe.Duration is not none { Text(Recipe.Duration) [chip] }
            Text(Recipe.Course) [chip]
            Button(Favorite) [quiet]
         }
         loop first 3 of Viewers.Others / Other {
            Status("{ Other.Name } is looking at this too")
         }

         Panes [gap xl] {
            Section("Ingredients") {
               loop Recipe.Ingredients / Ingredient { IngredientLine(Ingredient) }
            }
            Section("Steps") [claim 2] {
               loop Recipe.Steps / Step {
                  Row [gap md, content left top] {
                     Text(Step.Position) [label, muted, width 24]
                     Col [gap xxs, claim 1] {
                        Text(Step.Text) [body]
                        if Step.Timer is not none { Text("Timer: { Step.Timer }") [caption] }
         }  }  }  }  }

         if Recipe.Notes is not empty { Section("Notes") { Text(Recipe.Notes) [body] } }
         Button(Edit) // hidden on its own when `can change Recipe` is no
         if Recipe.Source is not none {
            Button("View the original", Icon: "globe") [quiet] { on press -> { open Recipe.Source } }
}  }  }  }

// Creating: a draft, because the row does not exist yet.
file view NewRecipeSheet(Household) responds Recipe {
   draft New = Recipe for new { Household, Course: Dinner, Servings: 4 }
   action Add() runs single {
      when save New {
         saved -> Recipe { respond Recipe } // a rejection invalidates New on its own
   }  }
   render Col [card, width max 560, gap md] {
      Text("New recipe") [sectionTitle]
      #newTitle
      TextInput(Value: bind New.Title, Label: "What are you making?", Focus: initial) { on submit -> { do Add() } }
      Row [gap md] {
         NumberInput(Value: bind New.Servings, Label: "Serves", Min: 1) [claim 1]
         Choice(Value: bind New.Course, Label: "Course") [claim 1]
      }
      Problems(New)
      Row [content right center, gap sm] {
         Button("Cancel") [secondary] { on press -> { respond } }
         #addRecipe
         Button("Add", Disabled: New.Incomplete) [primary, busy when Add.Running] { on press -> { do Add() } }
}  }  }

// Editing: the row exists and its fields stand on their own, so every input writes through. There is no
// save button, no dirty state, and nothing to discard.
file view RecipeEditor(Recipe) {
   action DismissEditor() {
      dismiss
   }
   command Done() {
      Title "Done"
      Icon "checkmark"
      do DismissEditor()
   }

   render ScrollView [pad lg] {
      Col [width max 720, gap lg] {
         Row [gap md, content left top] {
            ImageInput(Value: bind Recipe.Photo, Label: "Photo", Sources: camera, library) [width 96, height 96, radius md]
            Col [gap sm, claim 1] {
               #title
               TextInput(Value: bind Recipe.Title, Label: "What are you making?")
               Choice(Value: bind Recipe.Course, Label: "Course")
         }  }
         Row [gap md] {
            NumberInput(Value: bind Recipe.Servings, Label: "Serves", Min: 1)
            DurationInput(Value: bind Recipe.Duration, Label: "Total time")
         }
         Problems(Recipe)

         Section("Ingredients") {
            @actions Button("Add", Icon: "plus") [quiet] { on press -> { create Ingredient { Recipe, Name: "" } } }
            // A container wraps and `loop` iterates. Dragging is possible because the collection is
            // `(ordered)`; the store keeps the positions.
            Col(Reorderable: yes) [gap xs] {
               loop Recipe.Ingredients / Ingredient {
                  Row [gap sm, content left center, wrap] {
                     // `together Amount, Unit` on the entity means these two land as one write.
                     NumberInput(Value: bind Ingredient.Amount, Label: "Amount") [width 90]
                     Choice(Value: bind Ingredient.Unit, Label: "Unit") [width 100]
                     TextInput(Value: bind Ingredient.Name, Label: "Ingredient") [claim 1]
                     Choice(Value: bind Ingredient.Aisle, Label: "Aisle") [width 130]
                     Button(Icon: "minus.circle", Label: "Remove { Ingredient.Name }") [quiet] { on press -> { delete Ingredient } }
         }  }  }  }

         Section("Steps") {
            @actions Button("Add", Icon: "plus") [quiet] { on press -> { create Step { Recipe, Text: "" } } }
            Col(Reorderable: yes) [gap xs] {
               loop Recipe.Steps / Step {
                  Row [gap sm, content left top, wrap] {
                     Text("{ Step.Position }.") [label, muted, width 24]
                     TextInput(Value: bind Step.Text, Label: "Step", Lines: 3) [claim 1]
                     DurationInput(Value: bind Step.Timer, Label: "Timer") [width 120]
                     Button(Icon: "minus.circle", Label: "Remove step { Step.Position }") [quiet] { on press -> { delete Step } }
         }  }  }  }

         Section("Notes") { TextInput(Value: bind Recipe.Notes, Label: "Notes", Lines: 4) }
         Row [content right center] { Button(Done) [primary] }
}  }  }

// -- Sharing --------------------------------------------------------------------------------------------------

file view ShareRecipe(Recipe) {
   action Start() runs single {
      when do StartSharing(Recipe) { saved -> SharedRecipe { share SharedRecipeLink(SharedRecipe); dismiss } }
   }
   action Revoke() runs single {
      do StopSharing(Recipe)
      dismiss
   }
   render Col [gap lg, pad lg, width max 620] {
      when Recipe.Shared {
         Private -> {
            Text("Anyone with the link can see the ingredients and steps. Your notes and the page you imported it from stay private.") [body]
            // Generated from the projection in Access.tao-revolution, so it cannot drift from what
            // actually crosses the boundary.
            PublicationPreview(Recipe, As: SharedRecipe)
            Row [content right center, gap sm] {
               Button("Cancel") [quiet] { on press -> { dismiss } }
               #createLink
               Button("Create link") [primary, busy when Start.Running] { on press -> { do Start() } }
         }  }
         Shared -> {
            Status("Anyone with the link can see this recipe", Tone: Good)
            PublicationPreview(Recipe, As: SharedRecipe)
            Text("Stopping means the link you already sent stops working.") [body]
            Row [content right center, gap sm] {
               Button("Close") [quiet] { on press -> { dismiss } }
               #revokeLink
               Button("Stop sharing") [destructive, busy when Revoke.Running] { on press -> { do Revoke() } }
               Button("Share link") [primary] { on press -> { share SharedRecipeLink(publish Recipe as SharedRecipe) } }
}  }  }  }  }

// The public face of a recipe. `SharedRecipe` is a different, read-only type: the private fields are
// not absent by convention, they are not in the type.
public scene SharedRecipeScreen(SharedRecipe) {
   Title SharedRecipe.Title
   render ScrollView [screen] {
      guard SharedRecipe
      Col [page, width max 720] {
         Image(SharedRecipe.Photo, Description: SharedRecipe.Title) [height 240, radius lg, fit cover]
         Row [content left center, gap xs] {
            Text("{ SharedRecipe.Servings } servings") [chip]
            if SharedRecipe.Duration is not none { Text(SharedRecipe.Duration) [chip] }
         }
         // A projected ingredient has only Name, Amount, and Unit — it is not an `Ingredient`, so the
         // kitchen's `IngredientLine` (which reads Aisle) does not apply here.
         Section("Ingredients") {
            loop SharedRecipe.Ingredients / Ingredient {
               Row [line] {
                  Measure(Ingredient.Amount, Ingredient.Unit) [lead]
                  Text(Ingredient.Name) [body, main]
         }  }  }
         Section("Steps") {
            loop SharedRecipe.Steps / Step {
               Row [gap md, content left top] {
                  Text(Step.Position) [label, muted, width 24]
                  Text(Step.Text) [body, claim 1]
         }  }  }
         Text("Shared from Skillet") [caption, center]
}  }  }
