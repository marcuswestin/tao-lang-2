use all from ./library/Library
use Title as TitleType from ./library/Library
use GroupedRows from ./library/GroupedRows
use BookStore, InvalidInput, Occurrence, LoadedItems,
    LoadAfter, Refresh from ./library/BookIO
use Col, Row, Button, TextField, Spinner, Spacer, LazyList from @tao/ui
use Length, ConversionFailure from @tao/core
use minutes, seconds from @tao/time

// 1. Future project; activate only with a dependency-complete entry slice.
project {
   id "syntax2"
   name "Syntax2 Library"
   version "0.1.0"
   app LibraryApp
   remote none
}

app LibraryApp {
   Datasource BookStore
   view Library
   guard {
      loading Context -> Spinner
      ConversionFailure Problem -> "{Problem.Message}"
      error Problem -> "{Problem.Message}"
   }
}

// 2. Repeated types, renderer defaults, repeated placement and forwarding.
// Banner's two text roles graduated to Main.tao.
view Heading(Title) { render Title [caption] }
view NumberedBook(Book, Occurrence) {
   render Row { "{Occurrence.Ordinal}." Book }
}
view Shelf(Items list of Book) {
   @header(Title): Heading
   @item(Book, Occurrence): NumberedBook
   @footer: "Loaded snapshot" [caption]
   render Col {
      @header(Title "Library")
      LazyList(Items) [claim 2] { @item: @item }
      @header(Title "End")
      @footer
   }
}
view GroupedShelf(Items list of Book) {
   render LazyList(GroupedRows(Items)) [claim 2] {
      @item Entry, Occurrence -> Entry
   }
}

// 3. Signature projections and canonical named state construction.
// ProfileName graduated to Main.tao.
view Library {
   state Draft = NewBook { Title TitleType "" }
   state Feedback = TitleType ""
   state GroupMode no
   let GroupMode2 = GroupMode yes
   let Title = TitleType.Default()
   // Person construction and bare text placement graduated to Main.tao.
   // Readers construction graduated to Main.tao.
   let Label = EarlierLabel(.Right TitleType "Shelf", .Left Title)
   let Score = Score 2 + Score 3

   // 3.1 Canonical seconds; arithmetic retains the leftmost quantity's view.
   let Span = 2 minutes + 30 seconds
   let Scaled = 2 * Span
   let Factor = Span / 30 seconds
   let Offset = -2 seconds

   // 4. Provisional app-level bounded query contract; see README.
   query Feed = Books with { order by Id asc, paginate 40 }
   render Col {
      #heading accessible label "Library"
      Banner(.Subtitle "{Scaled.seconds()} / {Factor}", .Title Label)
      Person
      "{Subtract(Right 2, Left 5)} / {Score as TitleType} / {Offset}"
      Spacer [claim 2]
      Spacer

      // 5. Typed input, special recovery; other failures reach the app guard.
      Row {
         TextField(.Value Draft.Title)
         Button("Add") {
            on press -> do Add(Draft) then {
               InvalidInput Problem -> {
                  set Feedback = TitleType "{Problem.Message}"
               }
               done -> { set Draft = NewBook { Title TitleType "" } }
            }
         }
      }
      Feedback // Empty text emits no node; explicit Text("") would keep one.
      Button("Group") {
         on press -> when GroupMode {
            yes -> { set GroupMode = GroupMode no }
            no -> { set GroupMode = GroupMode yes }
         }
      }

      // 6. Available empty results pass the guard; multiple matches render.
      guard Feed
      when Feed {
         refreshing -> Spinner
         empty -> "No books."
         stale -> "Showing cached books."
      }
      when GroupMode {
         no -> Shelf(LoadedItems(Feed)) {
            @header Title -> Banner(.Title Title, .Subtitle "{Length(Readers)} readers")
            @item Book, Occurrence -> NumberedBook(Occurrence, Book)
            @footer: empty
         }
         yes -> GroupedShelf(LoadedItems(Feed))
      }
      Button("More") { on press -> do LoadAfter(Feed) }
      Button("Refresh") { on press -> do Refresh(Feed) }
      Button("Return loaded") { on press -> do LoadedItems(Feed).Return() }
   }
}

// 7. Rejections and their working spellings.
// Subtract(2, 5) is ambiguous: use Subtract(Right 2, Left 5).
// PersonName(Name "Ada", .FamilyName "Lovelace") cannot narrow Name:
// use PersonName(.GivenName "Ada", .FamilyName "Lovelace").
// Subtract(1 minutes, 30 seconds) cannot discard semantics:
// use 1 minutes - 30 seconds.
