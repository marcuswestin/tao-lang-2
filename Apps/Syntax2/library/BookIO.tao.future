// App-owned adapter contracts, not new universal state/pagination APIs.
// Bodies and generated bindings belong to the adapter implementation slice.
use Book, Books, People from ./Library
use Duration from @tao/time
use Memory from @tao/data/providers/memory

public datasource BookStore = Memory { Data [Books, People] }
public type InvalidInput is { Message text }
public type TemporaryFile is text
public type RevisionID is text
public type Revision is { Book, RevisionID, Unseen yes/no }
public type Occurrence is { Ordinal number }
public type BookWindow is list of Book

// 1. Pure cached reads; they never fetch, write, suspend or acknowledge a revision.
public func ObservedRevision(Book) -> Revision { return from ./BookIO.ts }
public func LoadedItems(BookWindow) -> Books { return from ./BookIO.ts }

// 2. Actions own I/O and modeled failures. Foreign effects cannot be assumed empty.
public action CreateTemporaryPDF(Book) -> TemporaryFile from ./BookIO.ts
public action DeleteTemporaryFile(TemporaryFile) from ./BookIO.ts
public action UploadFile(TemporaryFile) from ./BookIO.ts
public action MarkSeen(Revision) from ./BookIO.ts
public action NotifyExport(Book, Duration) from ./BookIO.ts
public action LoadAfter(BookWindow) from ./BookIO.ts
public action Refresh(BookWindow) from ./BookIO.ts
