// 1. Private semantic roles remain accessible through the exported signature.
public
type Name is text

type GivenName is Name

type FamilyName is Name

// 1.1 Contextual literal elements acquire the list's named element type.
public
type ComparedNames is list of Name

public
func PersonName(GivenName, FamilyName) {
   return "{ GivenName } { FamilyName }"
}

// 2. Inline roles share backing; their names determine argument binding.
public
func Subtract(Left number, Right number) {
   return Left - Right
}

// 3. Live data identity and one stored Boolean with its inverse member.
public
type Title is text

public
type NewBook is {
   Title
}

public
data People / Person {
   Name
}

public
data Books / Book {
   Title (required "Enter a title"),
   Note text (default ""),
   Author Person?,
   LoanedOut yes / Returned no
}
