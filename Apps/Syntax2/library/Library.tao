use Comparison, Ordered, UpperCase from @tao/core
use RenderKey from @tao/ui
use BookRow from ./BookViews

// 1. Private semantic roles remain accessible through the exported signature.
public
type Name is text

type GivenName is Name

type FamilyName is Name

// 1.1 Contextual literal elements acquire the list's named element type.
public
type ComparedNames is list of Name

public
func PersonName(GivenName, FamilyName) {
   return "{ GivenName } { FamilyName }"
}

// 2. Inline roles share backing; their names determine argument binding.
public
func Subtract(Left number, Right number) {
   return Left - Right
}

// 3. Live data identity and one stored Boolean with its inverse member.
public
can Display {
   ToText() fails never -> text
}

public
type GroupMode is yes/no

public
type ValidTitle is text

public
type Title is text with {
   func ToText() fails never {
      return UpperCase(Title)
   }

   func Compare(Other Title) fails never -> Comparison {
      return CompareTitles(Title, Other) from ./Library.ts
   }

   Title as ValidTitle fails InvalidFormat {
      return ValidateTitle(Title) from ./Library.ts
   }

   view Render() {
      render Title.ToText()
   }

   static func Default() {
      return Title "Library"
   }
}

// 3.1 Both roles retain one concrete ordered/displayable type.
public
func EarlierLabel where type T is Ordered and Display (Left T, Right T) {
   return pick Left.Compare(Right) {
      greater -> Right.ToText()
      otherwise -> Left.ToText()
}  }

public
type Score is number with {
   func +(Other Score) fails never -> Score {
      return AddScores(Score, Other) from ./Library.ts
   }

   Score as Title fails never {
      return Title "{ Score }"
}  }

public
type NewBook is Book { Title }

public
data People / Person {
   Name
}

public
data Books / Book {
   Title (required "Enter a title"),
   Note text (default ""),
   Author Person?,
   LoanedOut yes / Returned no,

   func Book.Key() fails never -> RenderKey {
      return RenderKey "book:{ Book.Id }"
   },

   action Book.Return() {
      update Book {
         Returned: yes
      }
   },
   action Books.Return() {
      loop Books / Book {
         do Book.Return()
      }
   },
   view Book.Render() {
      render BookRow(Book)
}  }
