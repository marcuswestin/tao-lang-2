use Col, Row, Button, RenderKey from @tao/ui
use Ordered, UpperCase from @tao/core
use Time, Wait, seconds from @tao/time
use CreateTemporaryPDF, DeleteTemporaryFile, UploadFile,
    ObservedRevision, MarkSeen, NotifyExport from ./BookIO

// 1. Private signature types projected through an exported callable.
public type Name is text
type GivenName is Name
type FamilyName is Name
public func PersonName(GivenName, FamilyName) {
   return "{GivenName} {FamilyName}"
}
public type ComparedNames is list of Name
public type GroupMode is yes/no

// 2. Structural capabilities; omitted owner prefix is canonical in with.
public can Display { ToText() fails never -> text }
public can ui { Render() -> rendered }
public type Title is text with {
   func ToText() fails never { return UpperCase(Title) }
   view Render() { render Title.ToText() }
   static func Default() { return Title "Library" }
}
public func EarlierLabel
   where type T is Ordered and Display
   (Left T, Right T) {
   return pick {
      Left <= Right -> Left.ToText()
      otherwise -> Right.ToText()
   }
}
public func Subtract(Left number, Right number) { return Left - Right }

// 2.1 Pure native operator; raw JavaScript output must be checked and wrapped.
public type Score is number with {
   func +(Other Score) {
      return `types.Score.fromJSValue(Score.getJSValue() + Other.getJSValue())`
   }
   Score as Title fails never { return Title "{Score}" }
}

// 3. Live item handles, inverse field, item and collection receivers.
public type NewBook is { Title }
public data People / Person { Name }
public data Books / Book {
   Title (required "Enter a title")
   Note text (default "")
   Author Person?
   LoanedOut yes / Returned no
   // Standard-library LazyList's structural contract, not an entity magic method.
   func Book.Key() fails never { return RenderKey "book:{Book.Id}" }
   action Book.Return() { update Book { Returned yes } }
   action Books.Return() { loop Books / Book { do Book.Return() } }
   view Book.Render() {
      let Revision = ObservedRevision(Book)
      render Col {
         Book.Title
         AuthorName(Book.Author)
         if Book.Returned { "Available" }
         Book.Note
         Row {
            if Revision.Unseen { "●" }
            Button("Seen") { on press -> do MarkSeen(Revision) }
            Button("Return") { on press -> do Book.Return() }
            Button("Export") {
               on press -> do Export(Book) then {
                  done Duration -> async {
                     do Wait(2 seconds)
                     do NotifyExport(Book, Duration)
                  }
               }
            }
         }
      }
   }
}

// 3.1 A matched guard stops this helper, not the enclosing Book row.
view AuthorName(Person?) {
   render Col {
      guard Person { none -> "Unknown author" }
      "{Person.Name}"
   }
}

// 4. Sequential actions; completion joins cleanup; notification is detached.
public action Export(Book) {
   let Timer = Time.StartTimer()
   let File = do CreateTemporaryPDF(Book)
   defer DeleteTemporaryFile(File)
   do UploadFile(File)
   return Timer.Duration() // Fixed sample before joined cleanup.
}
public action Add(NewBook) { create Book with NewBook }
