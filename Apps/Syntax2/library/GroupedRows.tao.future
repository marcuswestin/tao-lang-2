use Book, ui from ./Library
use RenderKey from @tao/ui

// 1. A row is a keyed recipe. Content stores live values, not rendered nodes.
public type RowKey is RenderKey
public type HeaderLabel is text
public type GroupHeader is { HeaderLabel } with {
   view Render() { render "{GroupHeader.HeaderLabel}" [caption] }
}
public type GroupedRow is { RowKey, Content ui } with {
   func Key() fails never -> RenderKey { return GroupedRow.RowKey }
   view Render() { render GroupedRow.Content }
}

// 2. Pure grouping/flattening. Native binding must construct checked Tao rows.
// GroupedRows.ts.future specifies the algorithm, with typed builders supplied
// by the generated binding. It must return wrapped rows, never raw JS records.
public func GroupedRows(Items list of Book) -> list of GroupedRow {
   return from ./GroupedRows.ts
}

// 3. RowKey is an ordinary field, not compiler magic. Standard-library LazyList
// consumes Key() through its ordinary Keyed capability. Other list implementations
// choose their own contracts. Runtime/compiler integration still needs implementation.
// Key extraction uses stable row identity, not index or JS object identity.
// Moving an unchanged key preserves its occurrence; deleting it unmounts it.
// Book members remain live. Reading them here registers normal dependencies;
// changes that affect grouping recompute this pure projection.
