// Pure algorithm sketch. This is not an accepted generated bridge signature.
// The eventual typed binding supplies cached field reads and checked Tao builders.
// BookHandle is the live handle, never a copy of its row data.
export function groupedRows<BookHandle, Row>(
  items: readonly BookHandle[],
  read: (book: BookHandle) => { bookId: string; authorId: string | null; authorName: string },
  header: (key: string, label: string) => Row,
  bookRow: (key: string, book: BookHandle) => Row,
): readonly Row[] {
  const groups = new Map<string, { label: string; books: { id: string; book: BookHandle }[] }>()
  for (const book of items) {
    const { bookId, authorId, authorName } = read(book)
    // Tagged tuples avoid collisions between the absent-author group and real IDs.
    const groupKey = JSON.stringify(['author', authorId])
    let group = groups.get(groupKey)
    if (!group) {
      group = { label: authorId === null ? 'Unknown author' : authorName, books: [] }
      groups.set(groupKey, group)
    }
    group.books.push({ id: bookId, book })
  }
  const rows: Row[] = []
  for (const [key, group] of groups) {
    rows.push(header(JSON.stringify(['header', key]), group.label))
    for (const { id, book } of group.books) {
      rows.push(bookRow(JSON.stringify(['book', id]), book))
    }
  }
  return rows
}
// Author changes move a book without changing its book key; renaming an author
// updates the header label without remounting its key. First appearance orders groups.
// The acquired Items must contain unique books; duplicate occurrences need extra keys.
