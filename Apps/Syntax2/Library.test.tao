use LibraryApp from ./Main

test "Syntax2 Library" {
   test "renders a quoted header and switches the grouping display" {
      run LibraryApp

      expect text "Library"
      expect text "Reversed text roles"
      expect text "Ada Lovelace"
      expect text "ADA"
      expect text "LIBRARY"
      expect text "Earlier: LIBRARY"
      expect text "5"
      expect text "2 readers"
      expect text "3"
      expect text "Quantity arithmetic ready."
      expect text "Signed offset ready."
      expect text "All books."
      expect missing text "Ready"
      press "Add"
      expect text "Enter a title"
      press "Clear feedback"
      expect missing text "Enter a title"
      press "Show feedback"
      expect text "Ready"
      press "Clear feedback"
      expect missing text "Ready"
      expect missing text "Grouped books."
      expect text "BOOK 1"
      expect text "BOOK 40"
      expect missing text "BOOK 41"
      press "More"
      expect text "BOOK 80"
      expect missing text "BOOK 81"
      press "More"
      expect text "BOOK 83"
      press "Refresh"
      expect text "BOOK 40"
      expect text "BOOK 83"
      press "Group"
      expect text "Grouped books."
      expect missing text "All books."
      press "Group"
      expect text "All books."
      expect missing text "Grouped books."
      enter "A new book" into #draft
      expect #draft input value "A new book"
      press "Add"
      expect #draft input value ""
   }
}
