use LibraryApp from ./Main

test "Syntax2 Library" {
   test "renders a quoted header and switches the grouping display" {
      run LibraryApp

      expect text "Library"
      expect text "Reversed text roles"
      expect text "Ada Lovelace"
      expect text "ADA"
      expect text "LIBRARY"
      expect text "Earlier: LIBRARY"
      expect text "5"
      expect text "2 readers"
      expect text "3"
      expect text "Quantity arithmetic ready."
      expect text "Signed offset ready."
      expect text "All books."
      expect missing text "Ready"
      press "Add"
      expect text "Enter a title"
      press "Clear feedback"
      expect missing text "Enter a title"
      press "Show feedback"
      expect text "Ready"
      press "Clear feedback"
      expect missing text "Ready"
      expect missing text "Grouped books."
      expect text "BOOK 1"
      expect text "1."
      expect missing text "Loaded snapshot"
      expect text "40 loaded"
      press "More"
      expect text "80 loaded"
      press "More"
      expect text "83 loaded"
      press "Refresh"
      expect text "83 loaded"
      press "Group"
      expect text "Grouped books."
      expect missing text "All books."
      expect text "BOOK 1"
      press "Group"
      expect text "All books."
      expect missing text "Grouped books."
      enter "A new book" into #draft
      expect #draft input value "A new book"
      press "Add"
      expect #draft input value ""
   }
   test "routes a stale continuation failure to the app guard" {
      run LibraryApp
      enter "A new book" into #draft
      press "Add"
      expect #draft input value ""
      press "More"
      expect text "Couldn't finish 'action.'"
   }
   test "acknowledges only the displayed revision and returns the live book" {
      run LibraryApp
      press "Group"
      select #book[1] {
         expect text "BOOK 1"
         expect text "Unknown author"
         expect missing text "Available"
         expect text "●"
         press label "Seen book-001"
         expect missing text "●"
         press label "Return book-001"
         expect text "Available"
         expect text "●"
      }
   }
   test "returns the loaded collection through its function-result receiver" {
      run LibraryApp
      select #book[1] {
         expect missing text "Available"
      }
      press "Return loaded"
      select #book[1] {
         expect text "Available"
      }
}  }
