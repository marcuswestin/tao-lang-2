// Target definitions to implement in @tao/ui; this app imports that package.
// These names are ordinary standard-library declarations, not compiler intrinsics.
public type RenderKey is text
public can Keyed {
   Key() fails never -> RenderKey
}

// Standard-library LazyList requires stable unique keys for reorderable input.
// Its generic admission/type contract uses normal structural capability checking.
// Its library implementation calls Key() and rejects duplicate identities.
// It does not discover an arbitrary field named RowKey, repair keys with indices,
// or impose this contract on loops or independently authored list components.
// Ordinary entity identity is available separately; a library adapter or an
// associated method such as Book.Key() can expose it through this protocol.
