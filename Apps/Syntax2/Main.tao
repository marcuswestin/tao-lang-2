use all from @tao/ui
use PersonName, Subtract from ./library/Library

app LibraryApp {
   id "com.tao.syntax2"
   name "Syntax2 Library"
   version "0.1.0"
   view Library
}

// 1. The projection preserves GivenName identity; this named descendant admits upward.
type ProfileName is PersonName.GivenName

view Banner(Heading text) {
   render Col {
      "{ Heading }" [weight bold]
}  }

view Library {
   state GroupMode is boolean = false
   let Person = PersonName(ProfileName "Ada", .FamilyName "Lovelace")
   render Col {
      #heading accessible label "Library"
      Banner("Library")
      "{ Person }"
      "{ Subtract(Right 2, Left 5) }"
      Spacer
      Button("Group") {
         on press -> { toggle GroupMode }
      }
      when GroupMode {
         true -> "Grouped books."
         otherwise -> "All books."
}  }  }
