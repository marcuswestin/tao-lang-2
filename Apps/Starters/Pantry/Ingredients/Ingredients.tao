use Checkbox, Col, ScrollView, Spinner, Text, TextInput, TextMultiline from @tao/ui
use FormButton from @tao/ui/basic
use Ingredient, Ingredients from ..

// The ingredients feature: the list a person lands on, one row of it, and the detail of one
// ingredient.
package
scene IngredientList() {
   Title "Ingredients"
   state NewName = ""
   query Ingredients { }
   action AddIngredient() {
      check NewName is not empty
      create Ingredient {
         Name: NewName
      }
      set NewName = ""
   }
   command NewIngredient() {
      Title "Add ingredient"
      Icon "plus"
      Enabled NewName is not empty
      do AddIngredient()
   }
   Toolbar { NewIngredient }
   render ScrollView() [screen] {
      Col() [column] {
         Col() [panel] {
            Text("NEW INGREDIENT") [eyebrow]

            #ingredientName
            TextInput(Value: NewName, Label: "Name", Placeholder: "New ingredient name") {
               on submit AddIngredient
            }

            #addIngredient
            FormButton("Add ingredient", Disabled: NewName is empty) {
               on press AddIngredient
         }  }
         guard Ingredients {
            loading -> { Spinner() }
            error -> Message {
               Text("Ingredients could not be loaded") [sectionTitle]
               TextMultiline(Message) [body]
         }  }
         guard Ingredients empty -> { Col() [panel] {
            Text("No ingredients yet") [sectionTitle]
            TextMultiline("Add the first one above.") [body]
         } }

         #ingredients
         loop Ingredients / Ingredient {
            IngredientRow(Ingredient)
            on select -> { present IngredientDetail(Ingredient) }
}  }  }  }

// One ingredient in the list.
package
view IngredientRow(Ingredient) {
   render Col() [card] {
      if Ingredient.InStock is InStock {
         Text("IN STOCK") [eyebrow]
      }
      Text(Ingredient.Name) [sectionTitle]
      Text("Quantity: { Ingredient.Quantity }") [caption]

      #openIngredient
      FormButton("Open") [buttonSecondary] {
         on press -> { present IngredientDetail(Ingredient) }
}  }  }

// One ingredient: edit its fields or delete it.
package
scene IngredientDetail(Ingredient) {
   Title Ingredient.Name
   state NameDraft = Ingredient.Name
   action SaveIngredient() {
      check NameDraft is not empty
      update Ingredient {
         Name: NameDraft
   }  }
   action SetInStock(Value boolean) {
      update Ingredient {
         InStock: Value
   }  }
   action DeleteIngredient() {
      delete Ingredient
      dismiss
   }
   command SaveIngredientCommand() {
      Title "Save ingredient"
      Icon "checkmark"
      Enabled NameDraft is not empty
      do SaveIngredient()
   }
   Toolbar { SaveIngredientCommand }
   render ScrollView() [screen] {
      Col() [column, panel] {
         Text("INGREDIENT") [eyebrow]
         guard Ingredient {
            loading -> { Spinner() }
            missing -> { TextMultiline("This ingredient no longer exists.") [body] }
            error -> Message { TextMultiline("The ingredient could not be loaded: { Message }") [body] }
         }

         #ingredientNameDraft
         TextInput(Value: NameDraft, Label: "Name", Placeholder: "Name") {
            on submit SaveIngredient
         }
         Text("Quantity: { Ingredient.Quantity }") [body]

         #ingredientInStock
         Checkbox(Value: Ingredient.InStock is InStock, Label: "In stock") {
            on change SetInStock
         }

         #saveIngredient
         FormButton("Save ingredient", Disabled: NameDraft is empty) {
            on press SaveIngredient
         }

         #deleteIngredient
         FormButton("Delete ingredient") [buttonDanger] {
            on press DeleteIngredient
}  }  }  }
