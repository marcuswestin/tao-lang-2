// decision: type declarations, enums, and casing
// depends on: 001-project-package-and-visibility
// status: open

// option 1: keep explicit Tao type declarations with enum values as strings
// Context infers enum defaults and assignments from the field or parameter type.
type FocusTone is enum {
   "calm",
   "clear",
   "urgent",
}

type TaskTitle is text

view ToneBadge Tone FocusTone {
   render Badge Tone [badge]
}

// option 2: allow enum case identifiers instead of string values
// This is friendlier to code-like workflows, but creates casing and display-label questions.
type FocusTone is enum {
   calm
   clear
   urgent
}

alias DefaultTone = FocusTone calm

// option 3: infer scalar aliases directly from typed examples
// This is concise, but hides whether the type is a domain alias or just a constructor.
type TaskTitle text
type FocusTone enum "calm", "clear", "urgent"

state DraftTitle = TaskTitle "Capture something"
state DraftTone = FocusTone "calm"
