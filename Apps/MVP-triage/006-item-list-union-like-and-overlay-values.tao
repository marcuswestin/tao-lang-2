// decision: item, list, union, structural, and overlay value syntax
// depends on: 004-type-declarations-and-enums, 005-typed-constructors-and-literal-inference
// status: open

// option 1: keep explicit type declarations and `with` overlays
// This mirrors MVP-3 and keeps value composition close to app/test override syntax.
type CaptureFlags is item {
   Pinned is boolean optional
   Offline is boolean optional
}

type PriorityList is [Priority]
type Searchable is like {
   Title is text
   UpdatedAt is number
}

type CaptureTarget is StillData.Note | StillData.Task

alias OverlayedTask = StillData.Task {
   Title StillData.Task.Title "Overlay base"
   Workspace DefaultWorkspace
} with {
   Intent StillData.Task.Intent "later"
}

// option 2: use collection-oriented operators for overlays and list changes
// This makes merges explicit, but risks becoming a mini data-patch language.
alias OverlayedTask = StillData.Task {
   Title StillData.Task.Title "Overlay base"
   Workspace DefaultWorkspace
} merge {
   Intent StillData.Task.Intent "later"
}

alias Tags = ["local", "typed"] append "offline" remove "typed"

// option 3: wait for literal and constructor decisions before finalizing overlays
// waiting for 005-typed-constructors-and-literal-inference
