// decision: debugging, source maps, and devtools surface
// depends on: 020-custom-events-lifecycle-and-automation, 027-testing-syntax-selectors-and-runtime-flags
// status: open

// option 1: project debug/devtools declarations plus direct tests
// This keeps source-map policy visible and testable.
project debug StillDebugging {
   source maps authored, generated
   source map mode precise
   repo relative paths true
   stepping line
   breakpoints tao, tsx
   hermes symbolication true
}

project devtools StillDevtools {
   panel state
   panel actions
   panel events
   replay actions, events
}

test "debug map preserves authored and generated sources" {
   check "source map" {
      compile StillTriageApp with debug StillDebugging
      expect sourcemap source "Apps/MVP-triage"
      expect sourcemap source "_gen_tao-app"
   }
}

// option 2: debugging is entirely compiler CLI configuration
// This keeps app source clean, but debug expectations are not part of Tao.
// tao debug sourcemaps StillTriageApp --mode precise --hermes

// option 3: wait for testing syntax
// waiting for 027-testing-syntax-selectors-and-runtime-flags
