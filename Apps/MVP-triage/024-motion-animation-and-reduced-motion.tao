// decision: motion, animation, and reduced-motion behavior
// depends on: 014-design-token-recipe-and-rule-model, 020-custom-events-lifecycle-and-automation
// status: open

// option 1: first-class `project motion` plus motion-aware design recipes
// This keeps timing/easing typed and lets scenarios/tests disable nondeterminism.
type MotionIntent is enum {
   "quiet",
   "normal",
   "expressive",
}

project motion StillMotion {
   duration fast 120.ms
   duration normal 220.ms
   easing standard cubic 0.2, 0, 0, 1
   spring gentle stiffness 180 damping 24

   transition card.enter {
      opacity 0 -> 1 duration normal easing standard
      y 8 -> 0 spring gentle
   }

   reduce motion {
      card.enter none
      decorative none
   }

   test deterministic
}

project design StillMotionDesign extends StillDesign {
   motionCard [card, enter card.enter, press scale 99%]
}

// option 2: keep motion as style specs only
// This is simpler but makes test/runtime policy harder to centralize.
project design StillMotionDesign extends StillDesign {
   motionCard [card, transition opacity 220.ms, press scale 99%, reduce motion none]
}

// option 3: runtime facade only, no Tao motion declarations yet
// This defers syntax, but motion cannot participate in design diagnostics.
action AnimateCard {
   do RuntimeMotion.transition "card.enter"
}
