// decision: custom events, lifecycle hooks, and automation declarations
// depends on: 019-state-actions-functions-and-inline-events
// status: open

// option 1: event declarations plus `does`, `emit`, and scoped lifecycle handlers
// This follows MVP-3 and makes event contracts explicit on views/actions.
type UploadError is item {
   Message text
   Recoverable boolean default true
}

event uploaded Asset asset
event failed Error UploadError

project action UploadAttachment File asset {
   emits uploaded asset
   emits failed UploadError

   do BridgeUploads.send File {
      on started -> { emit progress 0 }
      on done -> Uploaded asset { emit uploaded Uploaded }
      on failed -> Error UploadError { emit failed Error }
   }
}

project view UploadButton File asset {
   does uploaded asset
   does failed UploadError

   Button "Upload", .Label "Upload attachment", [primaryAction]
      on press -> { do UploadAttachment File }
}

// option 2: event names are inferred from handler declarations
// This reduces declarations, but contracts become harder to inspect.
project view UploadButton File asset {
   Button "Upload", .Label "Upload attachment", [primaryAction]
      on press -> {
         do BridgeUploads.send File
            on done -> Uploaded asset { emit uploaded Uploaded }
            on failed -> Error UploadError { emit failed Error }
      }
}

// option 3: automation blocks own app/network/time events only
// This keeps lifecycle distinct from view events.
project automation StillRuntimeEvents {
   on every 30.seconds while app active -> { do RefreshVisibleQueries }
   on app.foreground -> { do RefreshVisibleQueries }
   on network.offline -> { emit failed UploadError { Message "Offline" } }
}
