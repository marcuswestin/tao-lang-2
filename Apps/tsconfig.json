{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@tao/*": [
        "../packages/cli/tao-cli/modules/@tao/*"
      ],
      "@tao/runtime": [
        "../packages/apps/runtime/TaoRuntime-src/TR.ts"
      ],
      "expo-clipboard": [
        "../packages/apps/expo-host/node_modules/expo-clipboard"
      ],
      "expo-haptics": [
        "../packages/apps/expo-host/node_modules/expo-haptics"
      ],
      "react-native": [
        "../packages/apps/expo-host/node_modules/react-native"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": [
    "Tao Future",
    "Tao Studio",
    "WordFlower"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
