use StillFullMVP
use Icon from @tao/ui
use StillData from @data
use FullSurfaceShowcase from @complete/FullSurface
use MotionShowcase, StillMotion from @complete/Motion
use EventModelScreen from @complete/EventModel
use RendererSlotShowcase from @complete/RendererSlots
use ErrorHandlingShowcase, SyncBoundary from @complete/ErrorHandling
use DelayLabel, StandardDelay from @complete/SemanticTypes
use InstantProviderCapabilities from @complete/DataProviderAdvanced
use StillBridgeManifest from @complete/Bridges
use StillAccessibilityPolicy, StillFullStrings from @complete/A11yI18nPolicy
use RuntimeShowcase from @ui/showcase
use FeatureFrame, SlotFillExample from @ui/showcase/SlotViews
use PriorityLabel, HasOffline, CaptureDefaults from @complete/Values

using app StillFullMVP

test "Still MVP 3 full future surface" {
   check "renders a focused slot component" {
      render RuntimeShowcase
      expect visible text "Runtime primitives"
      expect count text "Runtime primitives" 1
      expect role "button" name "Open runtime preview"
   }

   check "renders with state overrides and child content" {
      render FeatureFrame "Override title", "Test" with {
         @icon {
            Icon "test" [badge]
         }
         Text "Child content supplied from render test." [body]
      }

      expect text "Override title"
      expect text "Child content supplied from render test."
   }

   check "renders named slots" {
      render SlotFillExample
      expect text "relative import"
      expect visible text "Named slots have defaults"
   }

   check "uses richer selectors and artifacts" {
      run StillFullMVP with {
         datasource.appId "still-mvp-complete-selectors"
      }

      press role "tab" name strings.home.capture
      write into row text "Profile label" placeholder "Profile label" "Operator"
      expect visible text "Operator"
      expect count text "Runtime Surface" 1
      expect role "tab" name strings.home.capture selected
      screenshot "settings-runtime"
      record video "settings-runtime-flow"
   }

   check "navigates every route" {
      run StillFullMVP
      route "/"
      expect text "Make the day readable"
      route "/today"
      expect text "Workspaces"
      route "/capture/task"
      expect text "Capture"
   }

   check "tests value-level functions" {
      expect call PriorityLabel "high" equals "High"
      expect call HasOffline CaptureDefaults equals true
   }

   check "renders full surface showcase" {
      render FullSurfaceShowcase [
         StillData.Task {
            Title StillData.Task.Title "Test renderer slot row"
            Workspace StillData.Workspace {
               Title StillData.Workspace.Title "Test workspace"
               Summary StillData.Workspace.Summary "Workspace for full-surface render tests."
               Slug StillData.Workspace.Slug "test-workspace"
               Ordering StillData.Workspace.Ordering 99
            }
            Intent StillData.Task.Intent "next"
            CreatedAt now()
            UpdatedAt now()
         }
      ]

      expect visible text "Still full future surface"
      expect visible text "Motion language"
      expect visible text "Events and subscriptions"
      expect visible text "Renderer slots"
      expect visible text "Error boundaries"
   }

   check "exercises event model syntax" {
      render EventModelScreen
      press placeholder "Search"
      write "draft"
      submit
      expect visible text "Submitted draft"
      emit app.foreground
      expect event RefreshVisibleQueries called
   }

   check "renders motion and boundaries" {
      render MotionShowcase
      press label "Toggle motion preview"
      expect motion StillMotion.cardLift applied

      render ErrorHandlingShowcase
      press label "Read latest export"
      expect boundary SyncBoundary handled loading or error
   }

   check "renders renderer slots with key and children" {
      render RendererSlotShowcase [
         StillData.Task {
            Title StillData.Task.Title "Slot task"
            Workspace StillData.Workspace {
               Title StillData.Workspace.Title "Slot workspace"
               Summary StillData.Workspace.Summary "Workspace for renderer slots."
               Slug StillData.Workspace.Slug "slot-workspace"
               Ordering StillData.Workspace.Ordering 100
            }
            Intent StillData.Task.Intent "follow-up"
            CreatedAt now()
            UpdatedAt now()
         }
      ]

      expect text "Slot task"
      expect text "Variadic child content lands in @@children."
   }

   check "validates policies providers and bridges" {
      expect policy StillAccessibilityPolicy requires label for IconButton
      expect strings StillFullStrings missing translation error release
      expect provider InstantProviderCapabilities supports pagination cursor
      expect provider InstantProviderCapabilities supports transaction
      expect bridge StillBridgeManifest locks versions
      expect call DelayLabel StandardDelay equals "Measured"
   }
}
