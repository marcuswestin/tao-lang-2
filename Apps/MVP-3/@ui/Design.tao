project design StillDesign {
   ink #121826
   muted #667085
   whisper #98a2b3
   canvas #f6f7f3
   surface #ffffff
   surfaceLift #fbfcf8
   line #dde3d8
   primary #2f6b4f
   primaryPress #25583f
   primarySoft #e4f0e8
   honey #f3b95f
   honeySoft #fff3d9
   danger #ba3b46
   dangerSoft #ffe7ea
   focus #8ac4a3

   xs 4px
   sm 8px
   md 12px
   lg 18px
   xl 24px
   xxl 32px
   readable 720px
   pill 999px

   display [size 34, weight 800, text ink, line 40]
   title [size 23, weight 750, text ink, line 29]
   section [size 15, weight 750, text ink, line 20, caps true, tracking 4]
   body [size 16, weight 450, text ink, line 23]
   quiet [size 14, weight 450, text muted, line 20]
   label [size 14, weight 700, text ink, line 18]
   metric [size 28, weight 800, text ink, line 32]

   screen [fill, bg canvas, text ink]
   shell [fill, width fill, maxWidth readable, center, pad horizontal xl vertical lg, gap lg]
   shellHeader [row, content spaceBetween center, width fill, gap md]
   hero [stack, gap md, width fill, pad xl, bg surface, border line, radius 28, shadow soft]
   heroGlow [bg radial primarySoft topRight 38%, overlay noise 2%]
   sectionStack [stack, width fill, gap md]
   sectionHeader [row, content spaceBetween center, width fill, gap md]
   card [stack, gap sm, width fill, pad lg, bg surface, border line, radius 22]
   cardInteractive [card, press scale 99%, focus ring focus]
   workspaceCard [cardInteractive, gap md]
   noteCard [cardInteractive]
   taskCard [row, content spaceBetween center, gap md, width fill, pad lg, bg surface, border line, radius 22]
   taskDone [taskCard, bg surfaceLift, text muted, opacity 72%]
   metricRow [wrap, gap sm, width fill]
   metricTile [stack, gap xs, pad md, minWidth 132, flex 1, bg surfaceLift, border line, radius 18]
   captureForm [stack, gap md, width fill, pad lg, bg surface, border line, radius 24]
   actionRow [row, gap sm, width fill, wrap]
   rowSpread [row, content spaceBetween center, width fill, gap md]
   textField [bg surface, text ink, border line, radius 16, pad md, minTap 48, focus border focus]
   textArea [textField, minHeight 132, align top]
   primaryAction [rowCenter, bg primary, text white, radius 16, pad horizontal lg vertical md, minTap 48, press bg primaryPress]
   secondaryAction [rowCenter, bg surface, text ink, border line, radius 16, pad horizontal lg vertical md, minTap 48]
   quietAction [rowCenter, bg primarySoft, text primary, radius 16, pad horizontal md vertical sm, minTap 44]
   dangerAction [rowCenter, bg dangerSoft, text danger, radius 16, pad horizontal md vertical sm, minTap 44]
   modeRail [row, gap xs, width fill, pad xs, bg surfaceLift, border line, radius 18]
   mode [rowCenter, width fill, radius 14, pad md, text muted]
   modeSelected [mode, bg surface, text ink, shadow soft]
   badge [rowCenter, radius pill, pad horizontal sm vertical xs, bg primarySoft, text primary]
   badgeMuted [badge, bg surfaceLift, text muted]
   badgeDanger [badge, bg dangerSoft, text danger]
   empty [stack, gap sm, width fill, pad lg, bg surfaceLift, border dashed line, radius 22]
   loading [row, gap sm, width fill, pad lg, bg primarySoft, radius 22]
   error [stack, gap md, width fill, pad lg, bg dangerSoft, border danger, radius 22]
   settingsRow [row, content spaceBetween center, width fill, gap md, pad vertical sm]
   showcaseScroll [scroll vertical, scroll indicators auto, overscroll contain, height 620, width fill, overflow auto]
   showcaseFrame [stack, gap md, width fill, margin top md bottom lg, pad lg, bg surface, border line, radius 24, frame raised, overflow clip]
   titleFrame [frame text, margin bottom xs]
   heroImage [width fill, height 180, frame media, overflow clip, radius 18]
   imageInputFrame [height 120, frame dashed, centered, overflow clip, bg surfaceLift, border line, radius 18]
   pressableFrame [height 48, frame raised, pad md, centered, bg primarySoft, radius 16]
   progressRow [row, gap sm, width fill, aligned baseline]
   showcaseList [frame inset, margin top sm bottom sm, width fill]
   listRow [row, gap sm, aligned baseline, pad vertical xs]
   featureFrame [frame raised, stack, gap sm, width fill, pad md, bg surfaceLift, border line, radius 20, press scale 99%]
   featureRow [row, content spaceBetween baseline, gap md, width fill, aligned baseline]
   slotIcon [frame circle 40, centered, bg primarySoft, text primary]
   slotMeta [hug, rigid, aligned right]
   relativePill [row, gap xs, hug, compress, aligned baseline]
   tinyIcon [width 8, height 8]
   alignmentShowcase [row, gap sm, width fill, aligned stretch]
   alignLeft [frame outline, width fill, aligned left, centered vertical, pad sm]
   alignBottom [frame outline, width fill, aligned bottom, pad sm]
   alignRight [frame outline, width fill, aligned right, centered vertical, pad sm]
   wrapLine [wrap, wrap lines 2, wrap balance, overflow fade right, gap xs, width fill]
   modalFrame [frame modal, overflow clip, width fill, maxWidth readable]
   modalBody [stack, gap md, pad lg, centered]
   actionMath [row, gap sm, width fill, aligned baseline]
}
