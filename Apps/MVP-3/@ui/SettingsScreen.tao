use Button, Number, Row, Stack, Text, TextInput from @tao/ui
use StillData from @data
use DeltaLabel from @logic
use AppShell, HeroPanel, PlatformName, Section
use RuntimeShowcase from @ui/showcase

alias DefaultAccentIndex = inject number ```ts
   return 7
```

project screen SettingsScreen {
   state ProfileLabel = StillData.Workspace.Title "Local profile"
   state PreviewBefore = 8
   state PreviewScale = 12

   action AdjustPreview Delta number {
      PreviewBefore = PreviewScale
      PreviewScale += Delta
      PreviewScale -= 1
      PreviewScale *= 2
      PreviewScale /= 2
   }

   render AppShell "Settings", "Local profile" {
      HeroPanel {
         Text "Still runs close to the user" [section]
         Text "The MVP uses local data, platform-aware runtime defaults, Tao-authored behavior tests, and a source-level design system." [body]
      }

      Section "Runtime" {
         Row [settingsRow] {
            Text "Provider" [label]
            Text "Memory" [quiet]
         }
         Row [settingsRow] {
            Text "Runtime" [label]
            Text PlatformName [quiet]
         }
         Row [settingsRow] {
            Text "Accent seed" [label]
            Text "${ DefaultAccentIndex }" [quiet]
         }
         Row [settingsRow] {
            Text "Design syntax" [label]
            Text "flat [] specs" [quiet]
         }
      }

      Section "Preview controls" {
         Stack [captureForm] {
            TextInput ProfileLabel, .Label "Profile label", .Placeholder "Profile label", [textField, width fill]
               on focus -> { do AdjustPreview 1 }
               on submit -> Value text { ProfileLabel = StillData.Workspace.Title Value }

            Row [actionMath] {
               Number PreviewScale [metric]
               Text call DeltaLabel PreviewBefore, PreviewScale [quiet]
               Button "Boost", .Label "Boost preview scale", [secondaryAction, width hug]
                  on press -> { do AdjustPreview 4 }
            }
         }
      }

      Section "Runtime Surface" {
         RuntimeShowcase
      }

      Button "Back to Today", .Label "Today tab", [primaryAction, width fill]
         on press -> { navigation tab Today }
   }
}
