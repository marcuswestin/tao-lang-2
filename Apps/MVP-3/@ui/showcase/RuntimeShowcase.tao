use Badge, Box, Icon, IconButton, Image, ImageInput, Link, List, Modal, Pressable, Progress, Row, ScrollView, Spinner, Stack, Text, TextFrame, TextMultiline from @tao/ui
use StillAssets from @assets
use StillPermissions from @permissions
use UploadProgress from @logic
use FeatureFrame, SlotFillExample from ./SlotViews
use RelativeAccent from ../relative/RelativeAtoms

project view RuntimeShowcase {
   state PreviewOpen = false
   state SelectedImage = StillAssets.EmptyPreview
   state UploadRatio = call UploadProgress 3, 5

   render ScrollView [showcaseScroll] {
      Box [showcaseFrame, frame raised, overflow clip] {
         TextFrame "Runtime primitives" [title]
         TextMultiline "This panel intentionally exercises the larger Tao runtime surface: framed text, multiline copy, media, input, scroll, modal, link, list, progress, and pressable surfaces." [body]

         Image StillAssets.HeroImage, .Label "Still preview image", [heroImage, frame media]

         ImageInput SelectedImage, .Label "Attach reference image", .Permission StillPermissions.photos, [imageInputFrame]
            on submit -> Uploaded asset { SelectedImage = Uploaded }

         Row [progressRow, aligned baseline] {
            Spinner [rigid]
            Progress UploadRatio, .Label "Upload progress", [width fill]
            Text "${ UploadRatio * 100 }%" [quiet]
         }

         Pressable .Label "Open runtime preview", [pressableFrame, centered] {
            on press -> { PreviewOpen = true }

            Text "Open preview" [label]
         }

         List ["Local", "Typed", "Offline"] [showcaseList, height 132, overflow auto] {
            item Capability text {
               Row [listRow, aligned baseline] {
                  Icon "check" [badge]
                  Text Capability [body]
               }
            }
         }

         Row [alignmentShowcase, aligned stretch] {
            Box [alignLeft, height 44] {
               Text "left" [quiet]
            }
            Box [alignBottom, height 64] {
               Text "bottom" [quiet]
            }
            Box [alignRight, height 44] {
               Text "right" [quiet]
            }
         }

         FeatureFrame "Slot defaults" {
            Text "This tile uses the default @icon and @meta slots." [body]
         }

         FeatureFrame "Slot fill syntax", "Assets" {
            @icon [slotIcon, nudge x -1] {
               Icon "image" [badge]
            }

            @meta [slotMeta, aligned baseline] {
               RelativeAccent "Filled"
            }

            Text "This tile fills @icon and @meta while preserving the layout supplied by FeatureFrame." [body]
         }

         SlotFillExample

         Row [wrapLine, compress] {
            Badge "wrap" [badgeMuted]
            Badge "line controls" [badgeMuted]
            Badge "overflow fade" [badgeMuted]
            Badge "scroll aware" [badgeMuted]
         }

         Link "Open Tao package registry", destination "https://tao.local/packages/still", [quietAction, hug]

         Modal PreviewOpen, .Label "Runtime preview", [modalFrame, centered] {
            Stack [modalBody] {
               IconButton "Close", .Icon "x", .Label "Close runtime preview", [quietAction, hug]
                  on press -> { PreviewOpen = false }
               TextFrame "Preview ready" [title]
               TextMultiline "Modal content uses the same frame, overflow, and centered layout tokens as the rest of the surface." [body]
            }
         }
      }
   }
}
