requires @tao/ui >= 1.0
requires @tao/bridge >= 0.1
requires @tao/motion >= 0.1
requires @still/analytics >= 0.4

use StillRootNavigation from @nav
use StillAssets from @assets
use StillPermissions from @permissions
use StillTheme from @theme
use StillSecrets from @complete/Capabilities
use StillAccessibilityPolicy, StillFullStrings, StillFullLocale, StillReleasePolicy from @complete/A11yI18nPolicy
use StillBridgeManifest from @complete/Bridges
use StillFullInstantDatasource, FullProductionTarget from @complete/DataProviderAdvanced
use StillDebugging, StillDevtools from @complete/Debugging
use StillErrorPolicy from @complete/ErrorHandling
use StillRuntimeEvents from @complete/EventModel
use StillClock from @complete/Events
use StillFullDesign, StillFullSurface, FullAppStoreBuild from @complete/FullSurface
use StillMotion from @complete/Motion
use StillDeepLinks, PreviewRoutes from @complete/NavigationRuntime
use StillScenarioCheck from @complete/Scenarios
use StillCompleteDev, CompleteKitchenSink from @complete/Tooling

project {
   name "Still MVP 3"
   tagline "The full future Tao surface, imagined as one calm local command center."
   remote none
   license MIT
}

project app StillFullMVP {
   design StillFullDesign
   theme StillTheme
   assets StillAssets
   permissions StillPermissions
   accessibility StillAccessibilityPolicy
   strings StillFullStrings
   locale StillFullLocale
   policy StillReleasePolicy
   datasource StillFullInstantDatasource
   runtime FullProductionTarget
   build FullAppStoreBuild
   secrets StillSecrets
   navigator StillRootNavigation
   deepLinks StillDeepLinks
   routes PreviewRoutes
   automation StillClock
   events StillRuntimeEvents
   motion StillMotion
   bridges StillBridgeManifest
   errors StillErrorPolicy
   debug StillDebugging
   devtools StillDevtools
   scenarios StillScenarioCheck
   dev StillCompleteDev
   showcase CompleteKitchenSink
   surface StillFullSurface

   on push notification -> Notification { navigation tab Capture }

   on network failure -> Failure { navigation tab Settings }
}
