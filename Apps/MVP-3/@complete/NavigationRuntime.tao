use StillData from @data
use StillRootNavigation from @nav
use CaptureScreen, DashboardScreen from @ui

project navigator StillDeepLinks {
   stack {
      screen Today DashboardScreen {
         path "/today"
         title strings.home.empty
         generated ReactNavigation {
            nativeStack true
            webHistory browser
         }
      }

      screen CaptureByKind CaptureScreen {
         path "/capture/:DraftKind"
         param DraftKind StillData.CaptureKind
         parity ios android web
      }
   }
}

project route PreviewRoutes {
   route "/" -> StillRootNavigation.MainTabs
   route "/today" -> StillDeepLinks.Today
   route "/capture/task" -> StillDeepLinks.CaptureByKind {
      DraftKind "task"
   }
}
