use Box, Button, Icon, Row, Stack, Text from @tao/ui
use AppShell from @ui

project layer CaptureOverlay {
   position above AppShell
   dim background 24%
}

project view PopoverExample {
   state MenuOpen = false

   render Box [frame raised] {
      Button "Open menu", .Label "Open popover", [quietAction]
         on press -> { MenuOpen = true }

      popover MenuOpen, anchor previous, placement bottom right {
         Stack [card] {
            Text "Popover actions" [label]
            Button "Close", .Label "Close popover", [quietAction]
               on press -> { MenuOpen = false }
         }
      }
   }
}

project view PortalToastExample Message text {
   render portal CaptureOverlay {
      toast Message [frame raised, aligned bottom, margin bottom xl]
   }
}

project view RenderElisionExample Hidden boolean {
   render when Hidden -> <none> otherwise -> Box [card] {
      Text "Rendered only when visible" [body]
   }
}

project view AngleRenderBlockExample {
   render <Row [rowSpread]>
      <Icon "wand" [badge] />
      <Text "Angle render blocks stay visually compact." [body] />
   </Row>
}
