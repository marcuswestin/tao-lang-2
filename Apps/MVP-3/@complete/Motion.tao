use Box, Button, Pressable, Progress, Row, Stack, Text from @tao/ui
use StillCompleteDesign from ./DesignSystem

type MotionIntent is enum {
   "decorative",
   "state",
   "navigation",
   "attention",
}

project motion StillMotion {
   duration instant 0.ms
   duration fast 120.ms
   duration normal 220.ms
   duration slow 420.ms

   easing standard cubic 0.2, 0, 0, 1
   easing emphasized cubic 0.2, 0, 0, 1.2
   easing linear cubic 0, 0, 1, 1
   spring gentle stiffness 180, damping 22, mass 1

   transform lifted [translate y -2, scale 1.01]
   transform pressed [scale 0.98]
   transform toastEnter [translate y 12, opacity 0]
   transform toastExit [translate y -8, opacity 0]

   transition cardLift transform lifted over fast with standard
   transition press transform pressed over fast with emphasized
   transition routeSharedAxis opacity, translate over normal with standard
   transition progress value over fast with linear

   animation pulse [scale 1, opacity 1] -> [scale 1.04, opacity 0.82] over slow repeat while busy
   animation shimmer background over slow repeat while loading

   lifecycle enter toastEnter -> identity over normal with emphasized
   lifecycle exit identity -> toastExit over fast with standard

   reduced {
      transition none except state, navigation
      animation none except progress
      duration fast instant
      duration normal fast
      duration slow fast
   }

   tests {
      animations completeImmediately
      expose flushMotion
      snapshots freeze at end
   }

   runtime facade TaoMotion
   platform web fallback CSS
   platform ios native Animated
   platform android native Animated
   platform headless deterministic
}

project design StillMotionDesign extends StillCompleteDesign {
   tokens motion {
      duration.fast StillMotion.fast
      duration.normal StillMotion.normal
      easing.standard StillMotion.standard
      transform.lifted StillMotion.lifted
   }

   recipe PressableMotion for Pressable {
      state pressed [motion StillMotion.press]
      state focused [focus ring focus]
      state busy [animation StillMotion.pulse]
   }
}

project view MotionShowcase {
   state Expanded = false
   state UploadProgress = 0.42

   render Stack [card, gap md] {
      Row [rowSpread, aligned baseline] {
         Text "Motion language" [title]
         Button "Toggle motion", .Label "Toggle motion preview", [quietAction]
            on press -> { toggle Expanded }
      }

      Box [featureFrame, motion Expanded ? StillMotion.cardLift : none] {
         Text "State transitions use named motion, not raw animated props." [body]
      }

      Progress UploadProgress, .Label "Animated upload progress", [width fill, motion StillMotion.progress]
   }
}
