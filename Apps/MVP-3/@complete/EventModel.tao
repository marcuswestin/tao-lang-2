use Button, Pressable, ScrollView, Stack, Text, TextInput from @tao/ui
use StillData from @data
use StillMotion from ./Motion

type UploadError is item {
   Message text
   Recoverable boolean default true
}

event uploaded Asset asset
event failed Error UploadError
event submitted Value text
event refreshed At date

project action UploadAttachment File asset {
   emits uploaded asset
   emits failed UploadError

   do BridgeUploads.send File {
      on started -> { emit progress 0 }
      on done -> Uploaded asset { emit uploaded Uploaded }
      on failed -> Error UploadError { emit failed Error }
      on cancelled -> { emit failed UploadError { Message "Cancelled" } }
   }
}

project view UploadButton File asset {
   does uploaded asset
   does failed UploadError

   Button "Upload", .Label "Upload attachment", [primaryAction]
      on press -> {
         do UploadAttachment File {
            on uploaded -> Uploaded asset { emit uploaded Uploaded }
            on failed -> Error UploadError { emit failed Error }
         }
      }
}

project view SearchBox {
   state Query = StillData.Task.Title ""

   does changed text
   does submitted text

   TextInput Query, .Label "Search tasks", .Placeholder "Search", [textField]
      on focus -> { emit focused }
      on change -> Value text {
         Query = StillData.Task.Title Value
         emit changed Value
      }
      on submit -> Value text { emit submitted Value }
      on blur -> { emit blurred }
}

project automation StillRuntimeEvents {
   on every 30.seconds while app active -> { emit refreshed now() }
   on after 500.ms while screen visible -> { emit motion.ready StillMotion.normal }
   on app.foreground -> { do RefreshVisibleQueries }
   on app.background -> { do QueueLocalWrites }
   on app.inactive -> { do PauseDecorativeMotion }
   on network.online -> { do FlushSyncQueue }
   on network.offline -> { emit failed UploadError { Message "Offline" } }
   on orientation.change -> Orientation { do ReflowFor Orientation }
   on keyboard.show -> Keyboard { do AdjustForKeyboard Keyboard }
   on keyboard.hide -> { do RestoreKeyboardInset }
   on safeArea.change -> Insets { do ApplySafeArea Insets }
}

project screen EventModelScreen {
   state LastEvent = "Ready"
   state SearchValue = ""

   on refreshed -> At date { LastEvent = "Refreshed at ${ At }" }
   on StillData.Tasks.updated -> { LastEvent = "Tasks updated" }
   on StillData.Tasks.refreshing -> { LastEvent = "Refreshing tasks" }
   on StillData.Tasks.stale -> { LastEvent = "Tasks need refresh" }
   on StillData.Tasks.failed -> Error UploadError { LastEvent = Error.Message }

   render ScrollView [screenScroll] {
      Stack [section] {
         Text "Events and subscriptions" [title]
         SearchBox {
            on changed -> Value text { SearchValue = Value }
            on submitted -> Value text { LastEvent = "Submitted ${ Value }" }
         }
         Text LastEvent [body]
      }
   }
}

project view GestureSurface {
   state GestureStatus = "No gesture yet"

   render Pressable .Label "Gesture event surface", [pressableFrame] {
      on long_press -> { GestureStatus = "Long pressed" }
      on hover_in -> { GestureStatus = "Hovering" }
      on hover_out -> { GestureStatus = "Hover ended" }
      on scroll -> Offset number { GestureStatus = "Scrolled ${ Offset }" }
      on swipe -> Direction text { GestureStatus = "Swiped ${ Direction }" }
      on drag -> Delta item { GestureStatus = "Dragged" }
      on pinch -> Scale number { GestureStatus = "Pinched ${ Scale }" }

      Text GestureStatus [body]
   }
}

