use StillData from @data
use StillSecrets, ProductionTarget, StagingTarget from ./Capabilities

type SyncStrategy is enum {
   "lastWriteWins",
   "serverWins",
   "manualMerge",
}

type PageCursor is text

data StillAuditData extends StillData {
   Sessions/Session {
      User is StillData.Workspace
      StartedAt date indexed
      LastSeenAt date indexed
      Locale text indexed
      DeviceId text unique indexed
   }

   SyncEvents/SyncEvent {
      Workspace
      CreatedAt date indexed
      Kind text indexed
      Payload is json
      ConflictStrategy SyncStrategy default "lastWriteWins"
   }
}

session StillSession {
   CurrentUser is StillData.Workspace from provider.auth.user
   CurrentLocale is locale
   CurrentDeviceId is device.id
   Tenant is provider.auth.tenant optional
}

provider capability InstantProviderCapabilities {
   provider InstantDB
   supports where scalar, nested, exists, missing, in, like
   supports order directScalar, nestedDirectScalar
   supports pagination cursor, limit
   supports count, aggregation, queryOnce, liveQuery
   supports writes create, update, upsert, merge, delete, link, unlink, transaction
   supports auth userToken, adminToken, ruleParams
   supports realtime subscriptions
   supports offline queue, optimistic updates
   rejects relationshipDepth > 2
   rejects unindexed order
}

datasource StillFullInstantDatasource {
   data StillAuditData
   provider InstantDB
   capabilities InstantProviderCapabilities
   appId env.INSTANT_APP_ID
   auth CurrentUser
   ruleParams {
      tenant StillSession.Tenant
      locale StillSession.CurrentLocale
   }
   secrets StillSecrets
   schema push on compile, dev
   schema diff warn destructive, apply safe
   migrations folder "./migrations"
   sync offlineFirst
   conflict default "lastWriteWins"
   optimistic true
   realtime true
}

query StillAuditData.Tasks as SearchResults SearchText text, PageAfter PageCursor optional {
   Title, Intent, Done, UpdatedAt
   where Title like SearchText
   where Intent in [StillData.Task.Intent "next", StillData.Task.Intent "follow-up"]
   where UpdatedAt exists
   where Archived missing
   order by UpdatedAt desc
   limit 25
   page after PageAfter
}

query once StillAuditData.Session as CurrentSession {
   DeviceId = StillSession.CurrentDeviceId,
   StartedAt,
   LastSeenAt,
}

query StillAuditData.Tasks as TaskStats {
   count as TotalTasks
   count where Done = true as DoneTasks
   max UpdatedAt as LastTaskUpdate
}

query StillAuditData.Workspaces, StillAuditData.Tasks as HomeBundle {
   Workspaces {
      Title, Slug
      order by Ordering asc
   }

   Tasks {
      Title, Intent
      where Workspace = Workspaces.First
      limit 10
   }
}

action SaveCaptureTransaction Workspace StillData.Workspace, Title StillData.Task.Title {
   transaction "capture-and-audit" {
      upsert StillAuditData.Task as Task by Slug {
         Workspace
         Title
         Intent StillData.Task.Intent "next"
         CreatedAt now()
         UpdatedAt now()
      }

      create StillAuditData.SyncEvent {
         Workspace
         CreatedAt now()
         Kind "task.created"
         Payload json { Title }
      }

      link Workspace.Tasks to Task
   } on conflict "lastWriteWins"
}

action ArchiveWorkspace Workspace StillData.Workspace {
   transaction "archive-workspace" {
      update Workspace {
         Pinned false
      }

      unlink Workspace.Tasks where Done = true
      delete StillAuditData.SyncEvent where Workspace = Workspace and Kind = "draft"
   }
}

project runtime target FullProductionTarget extends ProductionTarget {
   datasource StillFullInstantDatasource
   provider AdminBackend {
      schema push
      transaction server
      secrets serverOnly
   }
}

project runtime target FullStagingTarget extends StagingTarget {
   datasource StillFullInstantDatasource with {
      appId "still-full-staging"
      reset beforeEach
      seed scenarios
   }
}
