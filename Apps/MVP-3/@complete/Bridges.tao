project bridge ExpoHaptics from npm "expo-haptics" {
   version "^15"
   platform ios, android
   headless fallback noop
   permission none

   expose action impact Style HapticImpact {
      maps to Haptics.impactAsync
      async true
   }

   type HapticImpact is enum {
      "light",
      "medium",
      "heavy",
   }
}

project bridge ExpoClipboard from npm "expo-clipboard" {
   version "^8"
   platform ios, android, web
   headless fallback memory
   permission clipboard

   expose action writeText Value text {
      maps to Clipboard.setStringAsync
      async true
   }

   expose function readText returns text {
      maps to Clipboard.getStringAsync
      async loading error ClipboardError
   }
}

project bridge NativeShare from reactNative "Share" {
   platform ios, android, web
   headless fallback record
   permission shareSheet

   expose action share Message text, Url text optional {
      maps to Share.share
      async true
   }
}

project bridge GestureKit from npm "react-native-gesture-handler" {
   version "^3"
   platform ios, android, web
   headless fallback synthetic

   expose view Swipeable {
      props {
         onSwipe event direction SwipeDirection
         threshold number default 48
      }
      children one
   }

   type SwipeDirection is enum {
      "left",
      "right",
      "up",
      "down",
   }
}

module @tao/expo-haptics generated from ExpoHaptics {
   action impact Style HapticImpact
}

project bridges StillBridgeManifest {
   include ExpoHaptics
   include ExpoClipboard
   include NativeShare
   include GestureKit
   lock "./StillBridges.lock"
   unsafe any requires manual annotation
   overloaded functions require specialization
   hooks expose only inside views
   subscriptions require owner lifecycle
}

action SaveWithHaptic {
   do ExpoHaptics.impact "medium"
   do NativeShare.share "Saved in Still"
}
