use Stack, Text from @tao/ui
use StillAssets from @assets
use StillData from @data
use StillAccessibilityPolicy, StillFullStrings, StillFullLocale, StillReleasePolicy from ./A11yI18nPolicy
use StillBridgeManifest from ./Bridges
use AppStoreBuild from ./Capabilities
use FullProductionTarget, FullStagingTarget, StillFullInstantDatasource from ./DataProviderAdvanced
use StillDebugging, StillDevtools from ./Debugging
use StillErrorPolicy, ErrorHandlingShowcase from ./ErrorHandling
use StillRuntimeEvents, EventModelScreen, GestureSurface from ./EventModel
use StillMotion, StillMotionDesign, MotionShowcase from ./Motion
use RendererSlotShowcase from ./RendererSlots
use StillScenarioCheck from ./Scenarios
use Duration, Money, SecretCode from ./SemanticTypes
use StillCompleteDev from ./Tooling

project design StillFullDesign extends StillMotionDesign {
   accessibility StillAccessibilityPolicy
   strings StillFullStrings
   locale StillFullLocale
   motion StillMotion
   policy StillReleasePolicy
   debug StillDebugging
   devtools StillDevtools

   adaptive direction rtl {
      rowStart end
      icon mirror chevron
   }

   adaptive highContrast {
      contrast minimum AAA
      surface border strong
   }

   adaptive locale script complex {
      type fallback system
      lineHeight generous
   }
}

project capability StillFullSurface {
   design StillFullDesign
   assets StillAssets
   datasource StillFullInstantDatasource
   runtime production FullProductionTarget
   runtime staging FullStagingTarget
   events StillRuntimeEvents
   bridges StillBridgeManifest
   errors StillErrorPolicy
   scenarios StillScenarioCheck
   dev StillCompleteDev
   semantic Duration, Money, SecretCode
}

project build profile FullAppStoreBuild extends AppStoreBuild {
   runtime FullProductionTarget
   policy StillReleasePolicy
   debug StillDebugging
   sourcemaps dual
   distribution appStore
}

project view FullSurfaceShowcase Tasks [StillData.Task] {
   render Stack [showcaseFrame, gap lg] {
      Text "Still full future surface" [display]
      MotionShowcase
      EventModelScreen
      GestureSurface
      RendererSlotShowcase Tasks
      ErrorHandlingShowcase
   }
}
