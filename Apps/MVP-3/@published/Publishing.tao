requires @tao/ui >= 1.0
requires @tao/bridge >= 0.1
requires @tao/motion >= 0.1
requires @still/analytics >= 0.4

use RuntimeShowcase from @ui/showcase
use StillFullDesign, StillFullSurface from @complete/FullSurface
use StillBridgeManifest from @complete/Bridges
use StillDebugging from @complete/Debugging
use RemoteTrendCard from @still/analytics

publish package StillFullMVPKit {
   exports StillFullDesign
   exports StillFullSurface
   exports StillBridgeManifest
   exports StillDebugging
   exports RuntimeShowcase
   exports RemoteTrendCard
}

publish app StillFullMVPRelease {
   installName "@ro/still-full-mvp"
   package StillFullMVPKit
   channel public
}

project app InstalledStillFullMVP = install @ro/still-full-mvp "1.0.0" {
   datasource appId "still-full-mvp-installed"
}
