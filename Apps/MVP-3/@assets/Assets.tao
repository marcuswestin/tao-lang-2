project assets StillAssets {
   image HeroImage from "./images/still-hero.png" {
      alt "Still workspace preview"
      frame "16:9"
   }

   image HeroImageRtl from "./images/still-hero-rtl.png" {
      alt "Still workspace preview for right-to-left layouts"
      frame "16:9"
   }

   image HeroImageEs from "./images/still-hero-es.png" {
      alt "Vista previa del espacio de trabajo Still"
      frame "16:9"
   }

   image EmptyPreview from "./images/empty-preview.png" {
      alt "Empty local workspace"
      frame "1:1"
   }
}
