use WordFlower, WordFlowerDeclarationHead, WordFlowerDeclarationHeadWith, WordFlowerDeclarationLet, WordFlowerDeclarationLetWith, WordFlowerDrawer, WordFlowerFoundationTest from ./

// Directional journeys for the full target. Steps that reach panes, overlays, toasts, windows,
// and dialogues reuse the implemented #tag / select vocabulary; anything beyond that vocabulary
// is expected to be decided in a future Next slice before implementation.
test "WordFlower full target" {
   test "activates the workspace tab and fills the split" {
      run WordFlower
      expect text "Starter prompt: Morning pages"
      expect text "Try writing for 10 minutes"
      expect text "Tagged: daily, warmup"
      enter "Novel" into #workspaceName
      submit #workspaceName
      expect text "Novel"
      press text "Workspace" // selection items are activated by their labels
      expect text "Choose a workspace"
      expect text "Novel" // target-only activation reveals preserved selection content; it does not present
      select #chooseWorkspace[1] {
         press text "Novel"
      }
      expect text "Files" // the split mounts with its pane titles
      expect text "Novel"
   }

   test "asks before closing a document" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #openDocument
      }
      expect text "Document: Chapter one"
      press #closeDocument
      expect text "Close Chapter one?"
      press #cancelClose
      expect text "Document: Chapter one" // cancelling answers none and the editor stays
      press #closeDocument
      press #confirmClose
      expect missing text "Document: Chapter one"
   }

   test "saving presents a keyed toast" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #openDocument
      }
      expect text "Saves this session: 0"
      expect checkbox #markFinal unchecked
      press #markFinal
      expect checkbox #markFinal checked
      enter "" into #documentTitle
      press #save
      expect text "Document: Chapter one"
      expect text "Saves this session: 0"
      enter "Opening" into #documentTitle
      enter "The first line." into #documentBody
      expect text "Words: 3"
      press #save
      expect text "Saved"
      expect text "Document: Opening"
      expect text "Saves this session: 1"
      enter "It began at sea." into #newParagraph
      submit #newParagraph
      expect #newParagraph input value ""
      expect text "It began at sea."
   }

   test "preserves workspace and document CRUD through lifecycle states" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Renamed novel" into #workspaceTitle
      press #saveWorkspace
      expect text "Workspace: Renamed novel"
      press #addDocument
      expect text "Document title is required"
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #finish
      }
      expect text "No drafts"
      select #finishedDocuments[1] {
         press #reopen
      }
      select #documents[1] {
         press #delete
      }
      expect text "No drafts"
      back
      select #workspaces[1] {
         press #deleteWorkspace
      }
      expect text "No workspaces yet"
   }

   test "a with-variant reconfigures the same app" {
      run WordFlowerDrawer
      press #activateWorkspaceTab
      expect text "Choose a workspace"
      press text "Settings"
      expect {
         text "Settings"
         text "Writing session"
         text "10 words"
         text "Build development"
      }
      press #resetSignedOut
      expect text "Signed out"
   }
}

test "WordFlower navigation foundation" {
   test "native back uses the semantic reducer" {
      run WordFlowerFoundationTest
      expect text "Foundation home marker"
      press text "Open deterministic detail"
      expect text "Foundation detail marker"
      back
      expect text "Foundation home marker"
      expect missing text "Foundation detail marker"
   }

   test "slot dismissal restores its initial stack" {
      run WordFlowerFoundationTest
      press text "Open deterministic slot"
      expect text "Foundation slot marker"
      press text "Restore initial stack"
      expect text "Foundation home marker"
      expect missing text "Foundation slot marker"
   }
}

test "WordFlower declaration refinement forms" {
   test "a primitive head with canonical construction works" {
      run WordFlowerDeclarationHead
      expect text "Foundation home marker"
   }

   test "a primitive head with explicit refinement works" {
      run WordFlowerDeclarationHeadWith
      expect text "Foundation home marker"
   }

   test "an inferred let with canonical construction works" {
      run WordFlowerDeclarationLet
      expect text "Foundation home marker"
   }

   test "an inferred let with explicit refinement works" {
      run WordFlowerDeclarationLetWith
      expect text "Foundation home marker"
   }
}

// Testing vocabulary intended beyond the MVP tier: focused renders with state overrides, app-level
// overrides, role and accessibility-state selectors, and localized string keys.
test "WordFlower revolution" {
   let LongTitle = "A Complete History of the Semicolon, Volume Two"

   test "renders one view in isolation with overridden state" {
      render ReadingView(Document) with Focused { }

      expect role heading name LongTitle
      expect checkbox label "Final" unchecked
   }

   test "runs the app against a named datasource and theme" {
      run WordFlower with {
         datasource.appId "wordflower-empty"
         theme WordFlowerDesign
      }

      expect #emptyState {
         text string .workspaces.EmptyTitle // localized string keys, not literal copy
      }
      expect missing #loadingSpinner
   }

   test "exports a document and reports failure through a presentation result" {
      run WordFlower with {
         datasource.appId "wordflower-seeded"
      }

      press label "Workspace"
      press role button name "Open document"
      press #export
      expect text "Exporting"
      expect button "Export" disabled
   }
}
