// A nav definition declares public properties and produces one root nav descriptor.
nav WorkspaceSplit Workspace {
   render SplitNav {
      Axis "horizontal"

      // Direct keys bind to Panes. The nested SelectionNav starts its own key namespace.
      @files {
         // A ui with bound arguments is a presentable value; it renders only when the nav mounts it.
         Content SlotNav { Initial FileTree(Workspace) }
         Title "Files"
         IdealSize 280
         CollapsePriority 2
      }
      @documents {
         Content SelectionNav {
            Items { }
            Display "tabs"
            Dynamic true
         }
         Title "Documents"
         Grow 1
         CollapsePriority 3
      }
      @inspector {
         Content SlotNav { }
         Title "Inspector"
         IdealSize 340
         CollapsePriority 1
      }
   }
}

workspace ui FileTree Workspace {
   query Documents from Workspace.Documents { }
   render Col() [gap 6, pad 10] {
      Text(Workspace.Name)
      guard Documents {
         loading -> { Spinner() }
         error -> Message { Text("Could not load files: { Message }") }
      }
      #files
      loop Documents / Document {
         Row() [gap 6] {
            #open
            FormButton(Document.Title) {
               // Relative @documents resolves to the nearest unique pane and reveals it.
               on press -> { present DocumentScreen(Document) in @documents }
            }
            #openRooted
            FormButton("Rooted") {
               on press -> { present DocumentScreen(Document) in WordFlower@workspace@documents }
            }
            #openViaBinding
            FormButton("Via mounted binding") {
               // WorkspaceNav is mounted once; resolution follows its active WorkspaceSplit content.
               on press -> { present DocumentScreen(Document) in WorkspaceNav@documents }
            }
            #openComparison
            FormButton("Comparison tab") {
               // Dynamic selection normally focuses semantic identity; a key makes another occurrence.
               on press -> {
                  present Occurrence {
                     Content: DocumentScreen(Document)
                     Key: "comparison"
                  } in @documents
               }
            }
         }
      }
   }
}

// The pane-level entry guards entity availability; the editor below assumes an available document.
workspace ui DocumentScreen Document {
   render Col() [fill] {
      guard Document {
         loading -> { Spinner() }
         missing -> { Text("Document { Document.Id } no longer exists.") } // a handle keeps its Id after the row is gone
         unauthorized -> { Text("You no longer have access to this document.") }
         error -> Message { Text("The document could not be loaded: { Message }") }
      }
      DocumentEditor(Document)
   }
}

// `view` stays embeddable content; DocumentEditor only appears inside another render tree.
workspace view DocumentEditor Document {
   state TitleDraft = Document.Title
   state BodyDraft = Document.Body
   state SaveCount = 0
   query Paragraphs from Document.Paragraphs { }
   action SaveDocument {
      guard TitleDraft empty
      update Document {
         Title: TitleDraft
         Body: BodyDraft
      }
      set SaveCount += 1
      present Toast {
         Content: SavedToast
         Key: "document-saved"
         Duration: 3.seconds // duration literals are directional
      } in WordFlower@toasts
   }
   action CloseDocument {
      // `ask` suspends the action until the dialogue responds; a bare `respond` answers none.
      let Result = ask ConfirmCloseDialogue(Document)
      when Result {
         Confirmed -> { dismiss }
         otherwise -> { } // cancelled
      }
   }
   render Col() [gap 10, pad 16] {
      Text(DocumentLabel(Document.Title)) [title, width fill]
      #documentTitle
      TextInput(Value: TitleDraft, Label: "Document title", Placeholder: "Document title") {
         on submit SaveDocument
      }
      #documentBody
      TextInput(Value: BodyDraft, Label: "Document body", Placeholder: "Write the document body") [claim 2] {
         on submit SaveDocument
      }
      WordCount(BodyDraft)
      Text("Saves this session: { SaveCount }")
      guard Paragraphs {
         loading -> { Spinner() }
         error -> Message { Text("Could not load paragraphs: { Message }") }
      }
      #paragraphs
      loop Paragraphs / Paragraph {
         #inspect
         FormButton(Paragraph.Text) {
            on press -> { present ParagraphInspector(Paragraph) in @inspector }
         }
      }
      Row() [gap 6] {
         #documentInfo
         FormButton("Document info") {
            on press -> { present DocumentInfo(Document) in WordFlower@overlays }
         }
         #save
         FormButton("Save") {
            on press SaveDocument
         }
         #comparisonWindow
         FormButton("Comparison window") {
            on press -> {
               present Window {
                  Content: DocumentScreen(Document)
                  Key: "comparison-left"
                  Title: DocumentLabel(Document.Title)
               } in WordFlower@windows
            }
         }
         #snapshotDocument
         FormButton("Snapshot") {
            on press -> {
               // A snapshot is an immutable copy; the live handle keeps updating elsewhere.
               let Snapshot = snapshot Document
               present DocumentSnapshot(Snapshot) in WordFlower@overlays
            }
         }
         #closeDocument
         FormButton("Close document") {
            on press CloseDocument
         }
      }
   }
}

ui ParagraphInspector Paragraph {
