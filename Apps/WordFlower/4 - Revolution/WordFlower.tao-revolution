// A declaration that fills host-facing chrome is a `scene`, and a scene is presented rather than
// composed inline. `Title`, `Toolbar`, and `Header` live on `scene` alone, so a view that is only
// ever composed cannot declare chrome nothing reads.
scene WorkspaceList() {
   Title "WordFlower"
   state WorkspaceName = ""
   query Workspaces {
      order by Pinned descending // what the Pin command is for; the entity's CreatedAt breaks ties
   }
   // An `action` is private: it carries no `Title`, `Description`, or `Summary` and is never
   // surfaced. `check` is the action's early exit — `guard` is the view-side construct and tests a
   // data object's availability, never a boolean.
   action AddWorkspace() {
      if WorkspaceName is empty {
         present WorkspaceNameNotice() as overlay
      }
      check WorkspaceName is not empty
      create Workspace {
         Name: WorkspaceName
      }
      set WorkspaceName = ""
   }
   render ScrollView() [screen] {
      Col() [width max column, centered, gap sm] {
         Text("WordFlower") [title]
         Text(Tagline) [body]
         #workspaceName
         TextInput(Value: WorkspaceName, Label: "Workspace name", Placeholder: "Novel") {
            on submit AddWorkspace
         }
         #addWorkspace
         FormButton("Add workspace", Icon: "plus", Disabled: WorkspaceName is empty) {
            on press AddWorkspace
         }
         #activateWorkspaceTab
         FormButton("Activate workspace") {
            // Target-only activation names a complete app value and reveals without new content.
            on press -> { present WordFlower@workspace }
         }
         // Emptiness is content, not failure, so it is handled here rather than in the net above.
         when Workspaces {
            empty -> {
               #emptyState
               EmptyState(Icon: "doc.text", Title: "No workspaces yet") {
                  Image("./images/empty-workspaces.png", Decorative: yes) [width 160, centered]
                  Text("Starter prompt: { StarterPrompt.PromptTitle }") [body]
                  Text("Try writing for { StarterPrompt.PromptMinutes } minutes") [body]
                  TagSummary(StarterPrompt.PromptTags)
               }
            }
            otherwise -> {
               #workspaces
               loop Workspaces / Workspace {
                  WorkspaceRow(Workspace)
               }
            }
         }
      }
   }
}

view WorkspaceRow(Workspace) {
