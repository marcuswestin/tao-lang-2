// A `frame` wraps caller content. `@@content` places the unnamed children the caller passed, and a
// named slot declares its own default so callers may omit it.
public frame DocumentCard Title text {
   @actions = empty

   render Col() [gap sm, pad md, bg bg.canvas, border subtle, radius md] {
      Row() [content baseline left, gap sm] {
         Text(Title) [type title]
         @actions [aligned right] { }
      }
      Col() [gap xs] {
         @@content
      }
   }
}

// Declaration properties may be written as a longhand block, with `optional` and `default`
// properties that call sites omit.
package view ParagraphLine {
   Paragraph Paragraph
   Label text
   optional Subtitle text
   Density number default 1

   render Col() [gap xs] {
      Text("{ Label }: { Paragraph.Text }") [type body]
   }
}

// A reading surface: scrolling content, multiline text, list selection, and progress.
workspace ui ReadingView Document {
   state Focused/Unfocused // case-valued state shorthand needs no initializer
   query Paragraphs from Document.Paragraphs { Text } // queries may select the fields they read

   render ScrollView() [screen] {
      Image("./images/cover.png", Decorative: false) [width fill]
      Row() [content baseline left, gap sm] {
         Icon("feather")
         Text(Document.Title) [title]
      }
      ProseEditor(Document.Body) // a view imported from an external project under a local name
      TextMultiline(Document.Body, Lines: 3)
      Progress(Document.Paragraphs.Count / 20)
      List(Paragraphs) {
         Text(Paragraph.Text)
         on select -> Paragraph {
            present ParagraphInspector(Paragraph) in @inspector
         }
      }
      Checkbox(Document.Final, Label: "Final")
   }
}

// A publishing flow: string-valued enum arguments, and a presentation that answers with a result.
workspace ui ExportPanel Document {
   state Format = ExportFormat."markdown"
   state Countdown 30.seconds // typed state initialized without `=`

   action Export {
      let Status = present ExportProgress(Document, Format: Format)
      when Status {
         Presented -> { log "export started" }
         Failed -> Error { present ExportFailure(Error) in WordFlower@overlays }
         FellBack -> Fallback { log Fallback }
      }
   }

   render Col() [screen, gap md] {
      Text("Export { Document.Title }") [title]
      Text(MeasureLabel(Document.Paragraphs.Count))
      #export
      FormButton("Export") {
         on press Export
      }
   }
}

ui ExportProgress Document, Format is ExportFormat {
   render Text("Exporting { Document.Title } as { Format }…")
}

ui ExportFailure Message text {
   render Text("Export failed: { Message }")
}

// Automation: time, and app lifecycle. Autosave runs on a schedule rather than on every keystroke.
workspace ui AutosaveController Document {
   state SecondsSinceSave = 0

   on every 1.second -> {
      set SecondsSinceSave += 1
   }

   on every 30.seconds -> {
      update Document { Body: Document.Body }
      set SecondsSinceSave = 0
   }

   render Text("Saved { SecondsSinceSave } seconds ago") [type body, fg fg.muted]
}

// Presentation state survives relaunch, and migrates when declarations are renamed.
state SavedPresentation = serialize presentation WordFlower

on app restore -> {
   let Restored = deserialize presentation SavedPresentation
   // Invoking a ui always needs parentheses; presenting an already-constructed presentable value
   // does not, exactly as with `present Occurrence { ... }` and target-only `present App@key`.
   present Restored
}

migrate presentation 2 -> 3 {
   rename destination DocumentEditorUi to DocumentScreen
}

// `unsafe ts` declares a typed native boundary as a declaration, rather than inlining TS in a render.
unsafe ts FormatNativeTitle DocumentId is Document.Id -> text

// `inject` also produces typed values outside render position.
