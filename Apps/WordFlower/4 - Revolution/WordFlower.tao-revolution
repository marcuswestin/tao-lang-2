use InstantDB from @tao/data/providers/instantdb
use DynamicSelectionNav, Occurrence, SelectionNav, SlotNav, SplitNav, StackNav from @tao/nav
use CountWords, Join from @tao/text
use Checkbox, Col, FormButton, Icon, Image, Panes, Progress, Row, ScrollView, Spinner, Text, TextInput, TextMultiline from @tao/ui
use Editor as ProseEditor from @prose // imports may be renamed locally
use every, Interval from @tao/time

// @tao/nav and @tao/data are self-hosted: public types carry their own identity rather than relying
// on name tables. Generic property validation reads their config shape, and package-scope
// A `nav`/`provider` sidecar binds them to the published TR.NavKind and TR.DataProvider protocols. Ordinary
// configured navs and datasources use primitive value heads that preserve their precise types.
// Configured `with` patches may add direct keyed entries when the declaration owns a keyed contract.
// A strict `App@key` target may name a complete root or in-file variant. Variants retain their root
// declaration identity, and the key must exist on every launch configuration of that root.

// WordFlower/Revolution is the tier beyond the v1 release: functionality Tao eventually intends to
// cover that the MVP deliberately does not ship. It contains everything in `../3 - MVP` plus the
// additions below, and it stays in sync with every decision settled in `../2 - Next`.
//
// Beyond MVP, this file expresses: project identity and external dependencies; locally renamed
// imports; the full design system (raw tokens, semantic tokens, recipes, rules, platform blocks —
// `patterns` retired for content-accepting views, Decisions §13); closed unions with `match`; string-valued enums; longhand declaration-property blocks
// and `default` properties; case-valued and unit-typed state; optional self-referential relations;
// query field selection; time and lifecycle automation; presentation results and presentation
// serialization with migration; platform-conditional declarations; the `unsafe ts` native
// boundary; asset literals; richer stdlib primitives; and grouped `scenarios` declarations.
//
// TODO — intended functionality with no settled syntax yet. Add usage here as each is decided.
//
// Packaging and modules
//   - Direct package references without imports (LANG-002)
//   - Namespaces, and exporting types and values from one default export (Roadmap.md, Ro's STACK)
// Type system
//   - Overloaded declarations via `match` cases (Docs/Spec/Tao Type System.md, future design)
//   - Structural `like` types, heterogeneous list element unions (Docs/Spec/Tao Type System.md)
//   - `stateful T` contagion and collapse-on-read semantics (Docs/Spec/Tao Type System.md)
//   - Contextual bare scalar literals (LANG-005)
//   - Generics, macros, async functions, higher-order collection APIs (Autonomous MVP deferrals)
//   - `${…}` template-literal sugar alongside `"{ X }"` interpolation (Autonomous MVP decision log)
// Data
//   - Nested collection-owned relationships with inferred cardinality (LANG-007)
//   - Transactions, `link`/`unlink`, conflict policies, provider-gated writes (LANG-009)
//   - Query-attached state branches and general case matching in guards (LANG-008)
//   - Query and list render elision; optional `render` keyword (LANG-008, LANG-012)
//   - Local editable copies of entity fields (LANG-019)
//   - Capability manifests and runtime-target-owned provider selection (LANG-010)
//   - Authentication, accounts, permissions, collaboration, and sync (Autonomous MVP deferrals)
//   - Schema migrations (Docs/Spec/Tao Data.md)
// Events and control flow
//   - Declared events with `does`/`did`/`on` and inferred event names (LANG-020)
//   - Navigation lifecycle: appear/disappear/focus/blur and unsaved-change guards (DEF-NAV-006)
//   - Concurrent event policy: queue, single-flight, cancel-previous, exclusive (DEF-NAV-011)
//   - Result values with try/catch/finally and exhaustive case matching (LANG-021)
//   - `blur self`, field-bound inputs, and AI/package actions (LANG-016, LANG-019, LANG-020)
// Presentation
//   - Authenticated and anonymous link authority (Decisions.md §10)
//   - Addressing a specific window/toast/dynamic-selection occurrence by runtime key (DEF-NAV-016)
//   - Conditional chrome tied to the active selection item (DEF-NAV-012)
//   - Multiple OS scenes (side-by-side app windows), spatial presentation, widgets, complications
//     (DEF-NAV-003). Distinct from Tao's `scene`, which is the settled declaration kind that owns
//     host-facing chrome
//   - Window geometry, detached panels, persisted geometry, native chrome (DEF-NAV-004)
//   - Durable suspended workflows and continuations (DEF-NAV-005)
//   - Overlay families: action, input, form, menu, mode (LANG-018)
//   - Interactive toasts and refreshed child-occurrence policy (DEF-NAV-017)
//   - Non-semantic cosmetic property metadata (DEF-NAV-015)
// Layout, style, and motion
//   - `nudge`, `overlay`, scroll helpers, safe-area and keyboard insets (LANG-017, Docs/Spec/Tao Layout and UI.md)
//   - Logical `start`/`end` directions, aspect ratio, wrapped-line controls (Docs/Spec/Tao Layout and UI.md)
//   - Visual layers, portals, popovers, one Modal abstraction (LANG-018)
//   - Which future spec modifiers, if any, must remain inline-only (LANG-013)
//   - Motion policy and recipes, with reduced motion expressible (LANG-024)
//   - Container-query adaptive variants; the condition syntax is unsettled (Docs/Spec/Tao Design - WIP.md)
// Accessibility, localization, assets
//   - Accessibility and localization policy and UI metadata (LANG-023)
//   - Ambient `app.theme` / `app.data` / `app.strings` / `app.assets` capabilities (LANG-003)
//   - Permission declarations and native bridge generation (LANG-025)
// Testing
//   - Bounded retrying, event-driven settling, count and uniqueness assertions (Docs/Spec/Tao Testing.md)
//   - Row seeding, remote adapters, credentials, and cleanup policy (Docs/Spec/Tao Testing.md)
//   - Package testing (Docs/Spec/Tao Testing.md)

project {
   id "wordflower" // an opaque, immutable, developer-chosen identity that survives moves and forks
   name "WordFlower"
   remote none
   license MIT

   // External dependencies are declared in source and resolved into a lockfile by `tao install`.
   requires github:acme/prose @editor --version 1.0.1
}

// The full design system grows around the settled flat tokens and named clause bundles. Bundles and
// inline clauses resolve left to right, with the last same-clause value winning; incompatible
// surviving clause categories remain invalid. Semantic tokens, recipes, patterns, rules, and
// platform adaptations below remain Revolution-only additions.
design WordFlowerDesign {
   personality = calm
   density = normal
   platform = universal

   // The settled flat-token layer remains valid as the later semantic system grows around it.
   paper #f6f7f3
   ink #121826
   inkMuted #5b6472
   accent #2f6b4f
   line #d9dcd4

   tokens {
      color {
         paper = oklch(97% 0.01 110)
         ink = oklch(20% 0.02 265)
         accent = oklch(55% 0.12 155)
         red.600 = oklch(55% 0.20 25)
      }
      space { xs = 4  sm = 8  md = 12  lg = 16  xl = 24  screen = 20 }
      radius { sm = 6  md = 10  lg = 16  pill = 999 }
   }

   semantic {
      bg.canvas = color.paper
      fg.text = color.ink
      fg.muted = color.ink / 60%
      border.subtle = color.ink / 15%
      intent.primary.bg = color.accent
      intent.destructive.bg = color.red.600
   }

   // Named clause bundles that render sites apply exactly like layout clauses.
   screen [fill, content top stretch, pad 16, bg paper]
   title [size 28, weight 700, fg ink]
   body [size 16, line 22, fg inkMuted]
   panel [pad 12, radius 8, bg paper, border line]

   recipes {
      recipe Button {
         base [centered, pad horizontal md vertical sm, radius md, type label, minTap 44]

         variant size {
            sm [pad horizontal sm vertical xs, type label.sm]
            md [pad horizontal md vertical sm, type label]
            lg [pad horizontal lg vertical md, type label.lg]
         }

         variant intent {
            primary [bg intent.primary.bg, fg white, border transparent]
            secondary [bg bg.canvas, fg fg.text, border border.subtle]
            destructive [bg intent.destructive.bg, fg white]
         }

         state pressed [brightness -4%, scale .98]
         state disabled [opacity disabled]

         default {
            size = md
            intent = primary
         }
      }
   }

   patterns {
      pattern EmptyState {
         layout [centered, gap lg, pad screen]

         slots {
            icon [size xl, fg fg.muted]
            title [type title, align center]
            body [type body, fg fg.muted, align center]
            action [primary, size lg]
         }
      }
   }

   rules {
      contrast minimum = wcag.aa
      tapTarget minimum = 44
      rawColor allowed = themeOnly
      maxTypeStylesPerScreen = 5
      requireSemanticRole interactive
      preferTokensForSpacing = true
   }

   platform ios { material = glass  radius.bias = +2 }
   platform android { elevation = tonal  dynamicColor = true }
   platform web { focusRing = visible  hover = true }
}

// Declarations may be selected by target platform; referencing one that a platform does not
// declare is an unavailable-declaration error rather than a runtime failure.
<platform is Desktop>
   nav WorkspaceNav = SlotNav { Initial WorkspaceChooser }
</platform>

<platform is iOS | Android>
   nav WorkspaceNav = StackNav { Initial WorkspaceChooser }
</platform>

// A configured nav binding is an immutable descriptor, not a mounted instance or exposed state.
nav HomeStack = StackNav { Initial WorkspaceList }
nav SettingsStack = StackNav { Initial Settings }
nav SignedOutNav = StackNav { Initial SignedOut }

nav WordFlowerNavigator = SelectionNav {
   Initial @home
   Display "automatic"

   // Direct keys bind to SelectionNav's declared `@key` collection and share this configured nav's
   // target-key namespace.
   // Icon is part of the settled keyed-item contract. Badge remains a Revolution-only extension;
   // shipped SelectionNav items declare Label, Icon, and Content.
   @home {
      Label "Home"
      Icon "house"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Icon "folder"
      Badge "3"
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Icon "gear"
      Content SettingsStack
   }
}

// The shell: the navigator and the focus bar, laid out as ordinary content. A nav renders like any
// other view — `nav is scene is view` — so persistent chrome around navigated content is a `Col`,
// not a navigation kind. The navigator arrives as a parameter, which is how one shell serves every
// preview variant. The bar is conditional on the data, so it appears with the session and the
// content grows back when the session ends; the navigator never is, because its history lives on
// its mount and a branch that unmounted it would drop where the person was.
scene WordFlowerShell(Navigator nav) {
   query FocusSessions as CurrentSession {
      limit 1
   }
   render Col() [fill] {
      Navigator() [fill]
      when CurrentSession {
         empty -> { }
         otherwise -> { FocusBar() }
      }
   }
}

// The preview variant hands the shell a differently configured navigator, so a preview still gets
// the focus bar.
nav WordFlowerDrawerNavigator = WordFlowerNavigator with {
   Display "drawer"
}

datasource WordFlowerStore = InstantDB {
   AppId "wordflower-mvp"
}

datasource WordFlowerStageStore = WordFlowerStore with {
   AppId "wordflower-stage"
}

// The app is rooted in a view: the shell, which lays the navigator and the focus bar out as ordinary
// content. Tao mounts a navigator around a view root, so nothing here names one. Every nav owns an
// absolute overlay lane above its content, so no app declares an overlay host; overlays stack while
// covered entries stay mounted but hidden, and Back/dismiss use the app reducer. Toasts are
// app-level, transient, replace the same key rather than stacking, and neither consume Back nor expose
// plain dismissal. Window presentation is universal and keeps its semantic key on the call site.
// A datasource value uses a primitive head, such as `datasource WordFlowerStore = InstantDB { ... }`;
// Memory is keyless, while remote providers own their provider-specific configuration below.
app WordFlower {
   Name "WordFlower"
   Design WordFlowerDesign
   view WordFlowerShell(WordFlowerNavigator)

   // Overlay, toast, and window hosting need no declaration; a presentation names the mode instead.
   // Layout and Dismissible below are Revolution-only future overlay-presentation modifiers:
   //   present X() as overlay (Layout: "sheet", Dismissible: true)
   // Layout is one of "sheet" | "popover" | "full-screen" | "palette" | "inspector" | "floating".
   Datasource WordFlowerStore
}

// `with` copies public properties into a configured variant; WordFlower and WordFlowerShell are
// unchanged. The variant rebinds the root with the same shell and a different navigator in it, so it
// keeps the focus bar.
app WordFlowerDrawer = WordFlower with {
   Name "WordFlower - Drawer Preview"
   view WordFlowerShell(WordFlowerDrawerNavigator) // the same shell, a different navigator in it
}

app WordFlowerStage = WordFlower with {
   Name "WordFlower - Stage"
   Datasource WordFlowerStageStore
}

let Tagline = "A quiet place for words that matter."

let ParagraphGoal = 10

let SessionGoal is number = 10

// The focused writing session's length, in minutes.
let SessionMinutes is number = 25

type PromptTitle is text

type PromptMinutes is number

type PromptTags is list of text

type WritingPrompt is {
   PromptTitle,
   PromptMinutes,
   PromptTags,
   PromptSubtitle text?
}

let StarterTags = PromptTags ["daily", "warmup"]

let StarterPrompt = WritingPrompt {
   PromptTitle: "Morning pages"
   PromptMinutes: 10
   StarterTags
}

// One-case enums are nominal types; a dismissed responder answers `none`.
type ConfirmResult is one of Confirmed

// A case set may carry text-literal cases, spelled as the literal a person types.
type ExportFormat is one of "markdown", "html", "pdf"

// A closed union is matched exhaustively; `match` also overloads declarations by argument shape.
type Measure is text | number

function MeasureLabel(Value Measure) returns text {
   return match Value
      when text -> Value
      when number -> "{ Value } words"
}

// An item type extends another, and a property type stays owner-qualified.
type DailyPrompt is WritingPrompt with { PromptStreak number }

data Workspaces / Workspace {
   Name text
   CreatedAt time (default now) // the runtime applies the deferred `now` value for each create
   Pinned yes / no // demonstrative; not yet used by the app
   Documents (relation Documents, owned)

   index CreatedAt
   order by CreatedAt
}

data Documents / Document {
   Title text
   Body text (default "")
   Final yes / Draft no
   Public yes / Private no (default Public) // demonstrative; not yet used by the app
   CreatedAt time (default now)
   Workspace (relation Workspace)
   Paragraphs (owned)

   index CreatedAt
   order by CreatedAt
}

data Paragraphs / Paragraph {
   Text text
   Ordering number
   Document
   Parent Paragraph (optional) // relations may be optional and self-referential

   index Ordering
   order by Ordering
}

// A focused writing session. `local only` is an entity-level storage fact, a third trailing group
// entry beside `index` and `order by`: this entity lives in the device store whatever datasource the
// app configures, so the remote and staged variants never sync it. It is the narrow form of
// per-entity datasource scoping, and a stored relation may not cross the boundary it draws. Holding
// the session as data rather than as view state is what lets it survive navigation and relaunch, and
// lets each consumer query it locally.
data FocusSessions / FocusSession {
   EndsAt time // absolute, so a running session survives relaunch correctly
   PausedAt time (default now) // read only while paused; resuming re-anchors EndsAt from it
   Paused yes / Running no

   local only
}

function DocumentLabel(Title text) returns text {
   return "Document: { Title }"
}

function GoalFraction(Count number) {
   if Count == 0 {
      return 0
   }
   return Count / ParagraphGoal
}

view Card(Title text) {
   @actions = empty

   render Col() [gap 8, pad 12, panel] {
      Row() [content spread center] {
         Text(Title) [title]
         @actions
      }
      Col() [gap 6] {
         @@content
      }
   }
}

view Scroller() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({
        children: <RN.ScrollView contentContainerStyle={{ flexGrow: 1 }}>{Content}</RN.ScrollView>,
