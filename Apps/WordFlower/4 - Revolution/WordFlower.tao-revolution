// ---------------------------------------------------------------------------------------------
// §16. Fixtures and scenarios
// ---------------------------------------------------------------------------------------------

// A fixture builds a named, reusable data graph. Its rows are handles that tests and scenarios point
// at, so a journey and a review state start from the same world.
fixture StarterWorkspace {
   Novel = create Workspace { Name: "Novel" }
   Opening = create Document { Workspace: Novel, Title: "Opening", Body: "The first line." }
}

// A scenario pins a named, buildable app state for screenshots and review. Group clauses are
// inherited defaults; an entry clause of the same kind replaces the group clause wholesale, and
// `prepare` is the scenario-local data delta applied after the fixture and before the subject
// mounts.
scenarios ReadingView "content" {
   fixture StarterWorkspace
   render (Document: Opening)
   device phone

   scenario "empty" {
      prepare { update Opening { Body: "" } }
   }

   scenario "longTitle" {
      prepare { update Opening { Title: "A Complete History of the Semicolon, Volume Two" } }
   }

   scenario "dark" {
      appearance dark
   }

   // Pseudolocale is a review mode, exactly as the platform does it — never an entry in
   // `project { languages }` — and it is paired with right-to-left so mirrored layout is reviewed in
   // the same pass.
   scenario "pseudolocale" {
      locale pseudolocale
      direction rightToLeft
   }
}

// Fixtureless focused scenarios begin from an empty store. Required actions may be omitted only
// here; Studio supplies an isolated logging stand-in and replays these steps in order.
scenarios SavedToast "interaction" {
   device phone

   scenario "held" {
      render ()
      press down #revertSave
      advance 600.ms
      press up #revertSave
      hover #revertSave
      focus #revertSave
   }
}
