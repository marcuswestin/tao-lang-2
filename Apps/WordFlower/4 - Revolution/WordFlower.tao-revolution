// Every declaration's parameter list is parenthesized, and a parameter is a name, its type, and its
// trailing traits — the same shape a field has. The only trait a parameter needs is a default, which
// has a bare spelling that needs no parenthesis.
public
view ParagraphLine(Paragraph, Label text, Subtitle text?, Density number default 1) {
   render Col() [gap xs] {
      Text("{ Label }: { Paragraph.Text }") [body]
   }
}

// A reading surface: scrolling content, multiline text, collection selection, and progress.
// TODO: windowing or virtualization for very large loop-owned collections remains Revolution work;
// its syntax is deliberately unnamed until it can extend the settled language-owned `loop` surface.
view ReadingView(Document) {
   state Reading = Unfocused
   query Paragraphs from Document.Paragraphs { Text } // queries may select the fields they read
   action SetReadingFinished(Value yes / no) {
      update Document { Final: Value }
   }

   render ScrollView() [screen] {
      // Distraction-free reading is a case, not a pair of booleans, so the two states cannot both be
      // on and the render tree covers them exhaustively.
      #toggleReading
      FormButton(when Reading { Focused -> "Show everything", Unfocused -> "Focus the text" }) {
         on press -> { set Reading = when Reading { Focused -> Unfocused, Unfocused -> Focused } }
      }
      when Reading {
         Unfocused -> {
            // A semantic label on non-text media, not decoration.
            Image("./images/cover.png", Description: Document.Title) [width fill]
            Row() [content baseline left, gap sm] {
               Icon("feather")
               Text(Document.Title) [title]
            }
         }
         Focused -> { }
      }
      ProseEditor(Document.Body) // a view imported from an external project under a local name
      TextMultiline(Document.Body, Lines: 3)
      Progress(Document.Paragraphs.Count / 20)
      loop Paragraphs / Paragraph {
         Text(Paragraph.Text)
         on select -> {
            reveal ParagraphInspector(Paragraph) in @inspector
         }
      }
      Checkbox(Value: Document.Final is Final, Label: "Final") {
         on change SetReadingFinished
      }
   }
}

// A publishing flow: text-literal cases, a duration-typed state, a foreign action that declares its
// own failure cases, and §5's outcome vocabulary at the calling site. There is no second, write-only
// net, so a site that fires an effect names the outcomes it treats.
view ExportPanel(Document) {
   state Format = ExportFormat."markdown"
   state Countdown = 30.s

   action RunExport() runs single {
      when do ExportDocument(Document, Format: Format) {
         saved -> { present Notice("Exported") as toast (Key: "export", Duration: 3.s) }
         queued -> { present Notice("Saved — it will export when you are back online") as toast (Key: "export", Duration: 3.s) }
         rejected -> Problem { present Notice(Problem) as toast (Key: "export", Duration: 5.s) }
      }
   }

   render Col() [screen, gap md] {
      Text("Export { Document.Title }") [title]
      Text(MeasureLabel(Document.Paragraphs.Count))
      Text("This panel closes in { Countdown }") [body]
      Row() [gap sm] {
         #export
         FormButton("Export") [busy when RunExport.Running] {
            on press RunExport
         }
         #closeExport
         FormButton("Close") {
            // A sheet reads neither `Title` nor `Toolbar`, so its only exit is in its own content.
            on press -> { dismiss }
         }
      }
   }
}

