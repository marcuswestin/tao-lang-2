// A content-accepting view wraps caller content. `@@content` places the unnamed children the
// caller passed, and a named slot declares its own default so callers may omit it.
public
view DocumentCard(Title text) {
   @actions = empty

   render Col() [gap sm, pad md, background canvas, border edge, radius md] {
