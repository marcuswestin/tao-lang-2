// A content-accepting view wraps caller content. `@@content` places the unnamed children the
// caller passed, and a named slot declares its own default so callers may omit it.
public
view DocumentCard(Title text) {
   @actions = empty

   render Col() [gap sm, pad md, bg bg.canvas, border subtle, radius md] {
      Row() [content baseline left, gap sm] {
         Text(Title) [type title]
         @actions [aligned right] { }
      }
      Col() [gap xs] {
         @@content
      }
   }
}

// Declaration properties may be written as a longhand block, with `optional` and `default`
// properties that call sites omit.
package
view ParagraphLine() {
   Paragraph Paragraph
   Label text
   Subtitle text?
   Density number default 1

   render Col() [gap xs] {
      Text("{ Label }: { Paragraph.Text }") [type body]
   }
}

// A reading surface: scrolling content, multiline text, collection selection, and progress.
// TODO: windowing or virtualization for very large loop-owned collections remains Revolution work;
// its syntax is deliberately unnamed until it can extend the settled language-owned `loop` surface.
workspace
view ReadingView(Document) {
   state Focused/Unfocused // case-valued state shorthand needs no initializer
   query Paragraphs from Document.Paragraphs { Text } // queries may select the fields they read
   action SetReadingFinished(Value boolean) {
      if Value {
         update Document {
            Final
      }  }
      if not Value {
         update Document {
            Draft
   }  }  }

   render ScrollView() [screen] {
      Image("./images/cover.png", Decorative: false, Label: "Document cover") [width fill]
      Row() [content baseline left, gap sm] {
         Icon("feather")
         Text(Document.Title) [title]
      }
      ProseEditor(Document.Body) // a view imported from an external project under a local name
      TextMultiline(Document.Body, Lines: 3)
      Progress(Document.Paragraphs.Count / 20)
      loop Paragraphs / Paragraph {
         Text(Paragraph.Text)
         on select -> {
            present ParagraphInspector(Paragraph) in @inspector
         }
      }
      Checkbox(Value: Document.Final is Final, Label: "Final") {
         on change SetReadingFinished
      }
   }
}

// Unit literals below are Revolution-only and remain deferred beyond the current tranche; toast
// Duration above intentionally takes a plain number of seconds.
// A publishing flow: string-valued enum arguments, and a presentation that answers with a result.
workspace
view ExportPanel(Document) {
   state Format = ExportFormat."markdown"
   state Countdown 30.seconds // typed state initialized without `=`

   action Export() {
      let Status = present ExportProgress(Document, Format: Format)
      when Status {
         Presented -> { log "export started" }
         Failed -> Error { present ExportFailure(Error) as overlay }
         FellBack -> Fallback { log Fallback }
         otherwise -> { log "export status unavailable" }
      }
   }

   render Col() [screen, gap md] {
      Text("Export { Document.Title }") [title]
      Text(MeasureLabel(Document.Paragraphs.Count))
      #export
      FormButton("Export") {
         on press Export
      }
   }
}

view ExportProgress(Document, Format ExportFormat) {
   render Text("Exporting { Document.Title } as { Format }…")
}

view ExportFailure(Message text) {
   render Text("Export failed: { Message }")
}

// Automation: time, and app lifecycle. Autosave runs on a schedule rather than on every keystroke.
workspace
view AutosaveController(Document) {
   state SecondsSinceSave = 0

   on every 1.second -> {
      set SecondsSinceSave += 1
   }

   on every 30.seconds -> {
      update Document { Body: Document.Body }
      set SecondsSinceSave = 0
   }

   render Text("Saved { SecondsSinceSave } seconds ago") [type body, fg fg.muted]
}

