// ---------------------------------------------------------------------------------------------
// The focused writing session
// ---------------------------------------------------------------------------------------------

// Pick a length, write until the clock runs out, pause and resume, or stop early. The session is a
// row in the device-local store rather than state in one view, which is what lets the editor start
// it and the shell count it down.
//
// Starting is an editor affordance — you choose a length where you are about to write — so this view
// creates the row and nothing else.
file view FocusStarter() {
   query FocusSessions as CurrentSession {
      limit 1
   }
   action Start(Length duration) {
      create FocusSession {
         EndsAt: now + Length
   }  }
   render Col() [gap xs] {
      when CurrentSession {
         empty -> {
            #startFocus
            FormButton("Focus for { SessionLength }") {
               on press -> { do Start(SessionLength) }
         }  }
         otherwise -> { Text("A session is running") [body] }
}  }  }

// The focus bar: the running session, wherever you are. The shell lays it out beside the navigator,
// and it reads the session from the store rather than from a parent view, which is what lets it stay
// visible while the writing happens several navigation levels deeper.
//
// A ticking clock is a library value, not a language construct: there is no `clock` declaration, no
// `live` binding, and no `every` clause. `Interval` is an ordinary imported value whose reading
// changes, and `Left` is an ordinary derivation over it. `EndsAt` is absolute, so a running session
// survives relaunch; pausing freezes the reading by recording when it stopped, and resuming
// re-anchors the deadline to the remainder, so paused time is not lost.
file view FocusBar() {
   query FocusSessions as CurrentSession {
      limit 1
   }
   state Tick = Interval(1.s)
   render Row() [gap xs, panel, border accent when FocusBar is active] {
      Text("Focus session") [label]
      loop CurrentSession / FocusSession {
         let Left = when FocusSession.Paused {
            yes -> FocusSession.EndsAt - FocusSession.PausedAt
            no -> FocusSession.EndsAt - Tick.Value
         }
         Text(when Left > 0 Left.Clock / not "Time's up") [title]
         FocusSessionControls(FocusSession)
}  }  }

// The child command closes over one mounted session. Its modifier shortcut therefore remains
// available while attention is in the editor, without promoting the session to global state.
view FocusSessionControls(FocusSession) {
   command PauseFocus() {
      Title "Pause focus session"
      Key primary + "p"
      Enabled FocusSession.Paused is Running
      do -> { update FocusSession {
         PausedAt: now
         Paused
      } }
   }
   Commands { PauseFocus }
   render Row() [gap xs] {
      // The block form of a yes/no match names the poles. `Text(when Left > 0 Left.Clock / not
      // "Time's up")` above is its compact sibling, for exactly the two-outcome value case.
      when FocusSession.Paused {
         yes -> {
            #resumeFocus
            FormButton("Resume") {
               on press -> { update FocusSession {
                  EndsAt: now + (FocusSession.EndsAt - FocusSession.PausedAt)
                  Running
               } }
         }  }
         no -> {
            #pauseFocus
            FormButton("Pause") {
               on press -> { do PauseFocus() }
      }  }  }

      #stopFocus
      FormButton("Stop") {
         on press -> { delete FocusSession }
}  }  }

