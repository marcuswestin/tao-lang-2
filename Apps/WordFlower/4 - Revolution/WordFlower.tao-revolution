use InstantDB from @tao/data/providers/instantdb
use DynamicSelectionNav, Occurrence, SelectionNav, SlotNav, SplitNav, StackNav from @tao/nav
use primary from @tao/keys
use CountWords, Join from @tao/text
use Interval from @tao/time
use Checkbox, Col, FormButton, Icon, Image, Panes, Placeholder, Progress, Row, ScrollView, Spacer, Spinner, Text, TextInput, TextMultiline from @tao/ui
use Editor as ProseEditor from @prose // imports may be renamed locally

// WordFlower/Revolution is the tier beyond the v1 release: functionality Tao eventually intends to
// cover that the MVP deliberately does not ship. It contains everything in `../3 - MVP` plus the
// additions below.
//
// This file is written in the decided dialect. `Docs/Roadmap/Tao Revolution/Decisions.md` is the
// authority for every spelling here, and each section below cites the decision it rests on. Where
// this tier and `1 - Current` still disagree, the disagreement is a migration the tranche loop owes
// Current, not a bug in this file — `Process.md` principle 1 is subset by omission, never by
// respelling, so `3 - MVP` is derived from these spellings rather than from today's implementation.
//
// `Open questions.md` beside this file records everything the rewrite needed that Decisions.md does
// not answer. Nothing in this file invents a spelling to fill one of those gaps.
//
// What this tier expresses, by decision section:
//
//   §1  visibility — `file` narrows, no marker is folder-visible, `public` widens
//   §2  typed slots, unit literals and duration arithmetic, entities, yes/no poles, relation traits,
//       `validate` / `required` / `together`, `local only`, case types with text-literal cases
//   §5  direct write verbs, the one `guard default` read net, `when do` effect outcomes
//   §6  live `query … from <path>`, field selection, relation traversal
//   §7  reactive parameters, explicit copies, projected input items, and document write recovery
//   §8  commands with parameter-list slots, private actions, `check` early exit, `when` / `if`,
//       `Key primary + "…"`, `runs single`
//   §9  one renderable kind with `scene is view`, clause lists, conditional styling, `Interval`
//   §10 the nav kinds, `Compact { Progression … }`, `Width` / `CollapseOrder`, `reveal` vs
//       `present`, presentation modes, `link`, `Restore`
//   §11 `project`, `app`, keywordized variants and provider bindings
//   §13 the design system: `colors` / `sizes` / `text` / `screens` / `styles` / `rules`
//   §14 `phrase`, inline source copy, the `words` file
//   §15 `<expr> from <path>`, foreign views, foreign actions with declared failures
//   §16 `fixture`, journeys, `scenarios` groups with `prepare`
//
// Keyboard attention follows the settled T4 contract: the runtime derives regions and targets
// from the read-only interaction outline, narrowing is locale-aware word-prefix matching, and
// commands remain the one discoverable verb model for pointer, keyboard, palette, assistants, and
// future host surfaces. The shell's focus-bar siblings form one compiler-described region without
// a wrapper, so the later tier does not invent another focus owner.
//
// Generated interaction surfaces follow the settled T5 contract. Hints, the region overview, the
// target's verb layer, and the always-present command palette are pure runtime renderings of the
// outline, attention, bindings, and catalog. One app-host layer sits above content after toasts,
// never enters navigation history or consumes Back, and is absent from accessibility traversal
// while hidden. Cached app-relative bounds anchor affordances without measuring when a surface
// opens. Runtime allocation derives locale-aware keys deterministically by identity, preserves them
// across reorders, and excludes reducer keys plus explicit shortcuts; affordances appear after the
// first hardware-key dispatch. `Hint` and `Overview` are ordinary element defaults in `styles { }`
// (§13, KEY-D13), so an app restyles those runtime layers without owning them.
//
// TODO — intended functionality with no settled syntax yet. Add usage here as each is decided.
//
// Packaging and modules
//   - Direct package references without imports (LANG-002)
//   - Namespaces, and exporting types and values from one default export (Roadmap.md, the Developer's STACK)
// Type system
//   - Overloaded declarations via `match` cases (Docs/Spec/Tao Type System.md, future design)
//   - Structural `like` types, heterogeneous list element unions (Docs/Spec/Tao Type System.md)
//   - `stateful T` contagion and collapse-on-read semantics (Docs/Spec/Tao Type System.md)
//   - Contextual bare scalar literals (LANG-005)
//   - Generics, macros, async functions, higher-order collection APIs (Autonomous MVP deferrals)
//   - `${…}` template-literal sugar alongside `"{ X }"` interpolation (Autonomous MVP decision log)
// Data
//   - Nested collection-owned relationships with inferred cardinality (LANG-007)
//   - Transactions, `link`/`unlink`, conflict policies, provider-gated writes (LANG-009)
//   - Query-attached state branches and general case matching in guards (LANG-008)
//   - Query and list render elision; optional `render` keyword (LANG-008, LANG-012)
//   - Capability manifests and runtime-target-owned provider selection (LANG-010)
//   - Authentication, accounts, permissions, collaboration, and sync (Autonomous MVP deferrals).
//     The authority cluster — `access`, `audience`, `transaction`, `publish`, `presence` — is
//     decided (§3, §4) but deliberately unused here: whether WordFlower is the app that forces it
//     is an open product question (`Open questions.md` Q1), and inventing collaborative workspaces
//     would answer it without the Developer.
//   - Schema migrations (Docs/Spec/Tao Data.md)
// Events and control flow
//   - Declared events with `does`/`did`/`on` and inferred event names (LANG-020)
//   - Navigation lifecycle: appear/disappear/focus/blur and unsaved-change guards (DEF-NAV-006)
//   - Concurrent event policy: queue, cancel-previous, exclusive (DEF-NAV-011). `runs single` and
//     `runs latest` are settled (§8) and used below
//   - Result values with try/catch/finally and exhaustive case matching (LANG-021)
//   - `blur self`, field-bound inputs, and AI/package actions (LANG-016, LANG-019, LANG-020)
//   - A periodic in-view effect. §9 retired the `every` clause and §12's `automation` is
//     provider-owned scheduled work, so autosave-on-a-timer has no decided spelling
//     (`Open questions.md` Q5)
// Presentation
//   - Authenticated and anonymous link authority (Decisions.md §10)
//   - Addressing a specific window/toast/dynamic-selection occurrence by runtime key (DEF-NAV-016)
//   - Conditional chrome tied to the active selection item (DEF-NAV-012)
//   - Multiple OS scenes (side-by-side app windows), spatial presentation, widgets, complications
//     (DEF-NAV-003). Distinct from Tao's `scene`, which is the settled declaration kind that owns
//     host-facing chrome
//   - Window geometry, detached panels, persisted geometry, native chrome (DEF-NAV-004)
//   - Durable suspended workflows and continuations (DEF-NAV-005)
//   - Authored overlay families: action, input, form, menu, mode (LANG-018); generated floating
//     interaction layers are settled runtime policy, not authored presentation
//   - Interactive toasts and refreshed child-occurrence policy (DEF-NAV-017)
//   - Non-semantic cosmetic property metadata (DEF-NAV-015)
// Layout, style, and motion
//   - `nudge`, `overlay`, scroll helpers, safe-area and keyboard insets (LANG-017, Docs/Spec/Tao Layout and UI.md)
//   - Logical `start`/`end` directions, aspect ratio, wrapped-line controls (Docs/Spec/Tao Layout and UI.md)
//   - Authored portals, popovers, and one Modal abstraction (LANG-018)
//   - Which future spec modifiers, if any, must remain inline-only (LANG-013)
//   - Motion policy and recipes, with reduced motion expressible (LANG-024)
//   - Container-query adaptive variants; `[container]` and descendant-only `when Container …` are
//     decided in outline (§13) but the condition syntax is unsettled
//   - A declaration-level platform conditional. §13 decides the `Platform` environment value, which
//     the navigation below uses; gating a whole declaration has no decided form
//     (`Open questions.md` Q4)
// Accessibility, localization, assets
//   - Accessibility and localization policy and UI metadata beyond §13's `rules { }` (LANG-023)
//   - Ambient `app.theme` / `app.data` / `app.strings` / `app.assets` capabilities (LANG-003)
//   - Permission declarations and native bridge generation (LANG-025)
// Testing
//   - Bounded retrying, event-driven settling, count and uniqueness assertions (Docs/Spec/Tao Testing.md)
//   - Row seeding beyond `fixture`, remote adapters, credentials, and cleanup policy
//   - Package testing (Docs/Spec/Tao Testing.md)

// §11. The product envelope. `targets` and `languages` are what make `Platform` and `Locale`
// meaningful values, so a tier that reads either declares both.
project {
   id "wordflower" // an opaque, immutable, developer-chosen identity that survives moves and forks
   name "WordFlower"
   version "1.0.0"
   DefaultApp WordFlower
   targets phone, tablet, laptop
   languages "en-US", "es"
   remote none
   license MIT

   // External dependencies are declared in source and resolved into a lockfile by `tao install`.
   requires github:acme/prose @editor --version 1.0.1
}

// ---------------------------------------------------------------------------------------------
// §13. The design system
// ---------------------------------------------------------------------------------------------
//
// One `design` declaration, organized as typed value blocks plus styles, screens, and rules. The
// block name types its members, so nothing is annotated. There is no token/meaning/dark stack and no
// `platform { }` block: a semantic role is a derived entry whose value is conditional on the
// environment, and both tiers — folded and reactive — are ordinary expressions.
design WordFlowerDesign {
   colors {
      // A family nests as a head value plus a block, addressed as a path.
      paper #f6f7f3
      night #101612
      slate #121826 { 60 #5b6472 }
      mist #edf3ee
      accent #2f6b4f { 20 #e1ede4, 60 #28563d }
      line #d9dcd4
      lineDark #34453a
      slateSoft #8a93a0
      danger #a43d3d
      onAccent #ffffff

      // Derived, environment-conditional entries. These are the semantic roles; every product
      // screen speaks in these names and never in a hex literal, which is what makes the contrast
      // rule below decidable at build time.
      canvas when Scheme is Dark night / not paper
      ink when Scheme is Dark mist / not slate
      muted when Scheme is Dark slateSoft / not slate.60
      edge when Scheme is Dark lineDark / not line
   }

   sizes {
      xs 4.px, sm 8.px, md 12.px, lg md + 4.px, xl 24.px // `lg` folds at build
      gutter 20.px
      touch 48.px
      readable 1.rem // grows with the person's text setting
      column 720.px
      wideColumn 960.px
   }

   text {
      title [size 28.px, weight 700, line 34.px]
      body [size readable, line 1.4, ink muted] // a bare number is a ratio
      label [size readable, weight 600]
   }

   screens { narrow below 500.px, medium below 1000.px, wide }

   styles {
      // A lowercase entry is a bundle a site opts into.
      screen [fill, content top stretch, pad gutter, background canvas]
      panel [pad md, radius md, background canvas, border edge, gap sm]
      destructive [ink danger]

      // A Capitalized entry is an element default: every occurrence of that element starts here.
      App [background canvas]
      Text [ink ink]
      TextInput [background canvas, border edge, ink ink, radius md, size readable]
      FormButton [tap min touch, background accent, background accent.20 when pressed,
                  border accent when focused, ink onAccent, ink accent.60 when hovered,
                  radius md, weight 700]
      Checkbox [ink ink]
      Progress [background edge, ink accent, radius 999]
      statusDot [width sm, height sm, radius xs]

      // The active tab takes its look from the same default, through the host-supplied `selected`.
      NavigationTab [pad sm, radius sm, ink muted, background accent.20 when selected,
                     ink accent.60 when selected]

      // The generated interaction layers are runtime renderings; an app restyles them here without
      // declaring or owning them (KEY-D13).
      Hint [background accent.60, ink onAccent, radius sm, pad sm, weight 700]
      Overview [background canvas, ink ink, border edge, radius md, pad md, gap sm]
   }

   rules {
      rule contrast at least wcag.aa
      rule tap targets at least 44.px
      rule meaning survives without color or motion
   }
}

// ---------------------------------------------------------------------------------------------
// §5. The one read net
// ---------------------------------------------------------------------------------------------
//
// Declared once, anonymously, and covering the states of whatever subject a site reads. A site names
// only the cases it treats specially, so `unauthorized` can never be accidentally skipped and no
// screen below repeats a spinner. Emptiness is content, not failure, so it stays at the site.
guard default {
   loading -> Spinner(Label: "Opening WordFlower…")
   missing -> EmptyState(Icon: "questionmark.folder", Title: "This is gone")
   unauthorized -> EmptyState(Icon: "lock", Title: "You don't have access to this")
   rejected -> Problem { Text(Problem) [body, destructive] }
   error -> Message { Text(Message) [body] }
}

// ---------------------------------------------------------------------------------------------
// §10. Navigation
// ---------------------------------------------------------------------------------------------

// A configured nav binding is an immutable descriptor, not a mounted instance or exposed state.
//
// `Platform` is the §13 environment value — read-only, reactive, and Capitalized like every handle —
// and `when` is §8's value-producing form, so the platform split needs no declaration-level
// conditional. The cases are the project's own `targets`, never a device or OS name.
nav WorkspaceNav = when Platform {
   laptop -> SlotNav { Initial WorkspaceChooser }
   otherwise -> StackNav { Initial WorkspaceChooser }
}

nav HomeStack = StackNav { Initial WorkspaceList }
nav SettingsStack = StackNav { Initial Settings }
nav SignedOutNav = StackNav { Initial SignedOut }

nav WordFlowerNavigator = SelectionNav {
   Initial @home
   Display "automatic"

   // Direct keys bind to SelectionNav's declared `@key` collection and share this configured nav's
   // target-key namespace. `Label`, `Icon`, and `Content` are the shipped keyed-item contract;
   // `Badge` remains a Revolution-only extension.
   @home {
      Label "Home"
      Icon "house"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Icon "folder"
      Badge "3" // §9 defers `Badge` behind a forcing feature (`Open questions.md` Q10)
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Icon "gear"
      Content SettingsStack
   }
}

// The preview variant hands the shell a differently configured navigator, so a preview still gets
// the focus bar.
nav WordFlowerDrawerNavigator = WordFlowerNavigator with {
   Display "drawer"
}

// Product code composes a nav value with an ordinary function. `Compact` declares the compact-width
// progression as an ordered listing — the order of the names is the progression, so no arrow appears
// — and `CollapseOrder N` names the Nth pane to fold away as width shrinks, so the inspector goes
// first and the documents pane is the last thing left.
function WorkspaceSplit(Workspace) returns nav {
   return SplitNav {
      Compact { Progression @files, @documents, @inspector; Back reverse }

      // Direct keys bind to the panes. The nested DynamicSelectionNav starts its own key namespace.
      @files {
         // A view with bound arguments is a presentable value; it renders only when the nav mounts it.
         Content SlotNav { Initial FileTree(Workspace) }
         Title "Files" // a pane `Title` is in no decision (`Open questions.md` Q10)
         Width 280
         CollapseOrder 2
      }
      @documents {
         // DynamicSelectionNav may begin empty and receive tabs at runtime, so it has no Initial or
         // static keyed items. It is not one of §10's four decided kinds (`Open questions.md` Q3).
         Content DynamicSelectionNav {
            Display "tabs"
         }
         Title "Documents"
         Width min 420
         CollapseOrder 3
      }
      @inspector {
         Content SlotNav { Initial EmptyInspector }
         Title "Inspector"
         Width 340
         CollapseOrder 1
      }
   }
}

// ---------------------------------------------------------------------------------------------
// §11. Providers and apps
// ---------------------------------------------------------------------------------------------

datasource WordFlowerStore = InstantDB {
   AppId "wordflower-mvp"
}

datasource WordFlowerStageStore = WordFlowerStore with {
   AppId "wordflower-stage"
}

// The app is rooted in a view: the shell, which lays the navigator and the focus bar out as ordinary
// content. Tao mounts a navigator around a view root, so nothing here names one. Every nav owns an
// absolute overlay lane above its content, so no app declares an overlay host; overlays stack while
// covered entries stay mounted but hidden, and Back/dismiss use the app reducer. Toasts are
// app-level, transient, replace the same key rather than stacking, and neither consume Back nor
// expose plain dismissal. Window presentation is universal and keeps its semantic key on the call
// site.
app WordFlower {
   Name "WordFlower"
   Design WordFlowerDesign
   Datasource WordFlowerStore
   view WordFlowerShell(WordFlowerNavigator)

   // Restoration is default-on and host managed; `Restore` is written only to deviate. Toasts and
   // asked occurrences never restore by language rule, so the subtraction here is the declared part.
   Restore automatic { Exclude sheets, menus, toasts }
}

// `with` copies public properties into a configured variant; WordFlower and WordFlowerShell are
// unchanged. The variant rebinds the root with the same shell and a different navigator in it, so it
// keeps the focus bar.
app WordFlowerDrawer = WordFlower with {
   Name "WordFlower - Drawer Preview"
   view WordFlowerShell(WordFlowerDrawerNavigator) // the same shell, a different navigator in it
}

app WordFlowerStage = WordFlower with {
   Name "WordFlower - Stage"
   Datasource WordFlowerStageStore
}

// Preview and journey variants swap providers rather than forking a product declaration, which is
// what lets a test name the world it runs in instead of reconfiguring one inline.
app WordFlowerPreview = WordFlower with {
   Name "WordFlower Preview"
   Datasource Memory
   Restore fresh
}

// ---------------------------------------------------------------------------------------------
// §10. Links — one declaration carries address, URL, and mounting policy
// ---------------------------------------------------------------------------------------------
//
// Entity parameters name their entity type; the path is the author's explicit stability promise.
// `reveal` focuses an equal mount rather than stacking a second copy, so opening the same document
// from a link, the file tree, and a draft row all land in one place.
link WorkspaceLink(Workspace) "/workspaces/{Workspace}" -> {
   // Revealing into a pane also selects the selection item holding it, so nothing here activates
   // the tab a second time.
   reveal WorkspaceSplit(Workspace) in WordFlower@workspace
}

link DocumentLink(Document) "/documents/{Document}" -> {
   reveal WorkspaceSplit(Document.Workspace) in WordFlower@workspace
   // A link body has no enclosing render, so its targets are rooted rather than relative.
   reveal DocumentScreen(Document) in WordFlower@workspace@documents
   focus WordFlower@workspace@documents
}

// ---------------------------------------------------------------------------------------------
// §2. Values, types, and copy
// ---------------------------------------------------------------------------------------------

let Tagline = "A quiet place for words that matter."

let ParagraphGoal = 10

number SessionGoal = 10

// The focused writing session's length. A duration is a typed unit value, not a bare number, so the
// arithmetic below is dimensional and `25.min` never silently means milliseconds.
duration SessionLength = 25.min

// §14. `phrase` names copy that needs more than a literal — typed holes or plural forms. A sentence
// several rules share is a phrase too, which is why the missing-document copy lives here.
phrase ParagraphCount(Count number) = one "{ Count } paragraph" / other "{ Count } paragraphs"
phrase DocumentGone = "That document is gone."

type PromptTitle is text

type PromptMinutes is number

type PromptTags is list of text

type WritingPrompt is {
   PromptTitle,
   PromptMinutes,
   PromptTags,
   PromptSubtitle text?
}

// Conversion is a call on the type name; a bad literal is a compile error because the compiler
// evaluates it.
let StarterTags = PromptTags(["daily", "warmup"])

let StarterPrompt = WritingPrompt {
   PromptTitle: "Morning pages"
   PromptMinutes: 10
   StarterTags
}

// One-case case types are nominal; a dismissed responder answers `none`.
type ConfirmResult is one of Confirmed

// Cases may be text literals, spelled as the literal a person types.
type ExportFormat is one of "markdown", "html", "pdf"

// A union is matched with `when`, the one word for covering every case.
type Measure is text | number

function MeasureLabel(Value Measure) returns text {
   return when Value {
      text -> Value
      number -> "{ Value } words"
   }
}

// An item type extends another, and a property type stays owner-qualified.
type DailyPrompt is WritingPrompt with { PromptStreak number }

// Reading state is a case type rather than a pair of booleans, so the two states cannot both be on.
type Reading is one of Focused, Unfocused

// ---------------------------------------------------------------------------------------------
// §2. Entities
// ---------------------------------------------------------------------------------------------
//
// Relations are inferred from names: a plural field is a to-many, a singular one the reverse to-one,
// and the `relation` trait carries the target only when the field is named otherwise. `required`
// states completeness and never blocks a write; `validate` is the store invariant enforced on every
// write path; `index`, `order by`, and `local only` trail the field list as a group.
data Workspaces / Workspace {
   Name text (required "Name this workspace", search, title)
   CreatedAt time (default now) // the runtime applies the deferred `now` value for each create
   ChangedAt time (default now, touch on change)
   Pinned yes / no
   Documents (owned)

   validate Name is not empty "A workspace needs a name"

   index CreatedAt
   order by CreatedAt
}

data Documents / Document {
   Title text (required "Name this document", search, title)
   // `required` states completeness and never blocks a write; the invariant that rejects one is a
   // `validate`, and it is what invalidates a draft that tries to save without a title.
   Body text (default "", search)
   Final yes / Draft no
   Public yes / Private no (default Public)
   CreatedAt time (default now)
   ChangedAt time (default now, touch on change)
   Workspace
   Paragraphs (owned, ordered)

   validate Title is not empty "A document needs a title"

   index CreatedAt
   order by CreatedAt
   commands Finish, Duplicate
   commands hide Delete
}

data Paragraphs / Paragraph {
   Text text
   Document
   Parent? (relation Paragraphs) // relations may be optional and self-referential

   // `Documents.Paragraphs (ordered)` keeps positions in the store, so nothing here maintains an
   // ordering field by hand and the position reads back on the row.
   validate Text is not empty "A paragraph needs words"
}

// A focused writing session. `local only` is an entity-level storage fact, a third trailing group
// entry beside `index` and `order by`: this entity lives in the device store whatever datasource the
// app configures, so the remote and staged variants never sync it. A stored relation may not cross
// the boundary it draws. Holding the session as data rather than as view state is what lets it
// survive navigation and relaunch, and lets each consumer query it locally.
data FocusSessions / FocusSession {
   EndsAt time // absolute, so a running session survives relaunch correctly
   PausedAt time (default now) // read only while paused; resuming re-anchors EndsAt from it
   Paused yes / Running no

   // `together` makes two fields one fact, so a paused session never syncs without the moment it
   // stopped.
   together Paused, PausedAt

   local only
}

// ---------------------------------------------------------------------------------------------
// §8. Commands — the discoverable verbs
// ---------------------------------------------------------------------------------------------
//
// A command is a standalone configured value: its slots are its parameters, its body holds member
// fills and exactly one `do`, and the action behind it is a private procedure with no title metadata.
// Juxtaposition in a command block always binds, because the slots live in the parameter list.
//
// These carry no visibility marker: §1 has two modifiers, `file` and `public`, and an unmarked
// declaration is visible to the whole folder — which is what the test file beside this one imports
// through. `public` below is reserved for the two declarations that genuinely cross the package
// boundary.
command Finish(Document) {
   Title "Finish document"
   Description "Moves a document out of drafts and into the archive."
   Summary "Finish { Document.Title }"
   Icon "checkmark.circle"
   Key "f"
   Enabled Document.Final is Draft
   do -> { update Document {
      Final
   } }
}

command Duplicate(Document) {
   Title "Duplicate document"
   Description "Makes a new draft beside this document."
   Summary "Duplicate { Document.Title }"
   Icon "doc.on.doc"
   Key "d"
   do -> { create Document {
      Title: "{ Document.Title } copy"
      Body: Document.Body
      Document.Workspace
   } }
}

command Export(Document) {
   Title "Export document"
   Description "Writes this document out in a chosen format."
   Summary "Export { Document.Title }"
   Icon "square.and.arrow.up"
   Key primary + "e"
   do -> { present ExportPanel(Document) as sheet }
}

command Delete(Document) {
   Title "Delete document"
   Description "Permanently removes this document."
   Summary "Delete { Document.Title }"
   Icon "trash"
   Key "x"
   do -> { delete Document }
}

// ---------------------------------------------------------------------------------------------
// §15. The TypeScript boundary
// ---------------------------------------------------------------------------------------------
//
// `<expression> from <path>` is an ordinary expression operator: the free names in the expression
// resolve to named exports of that path, so no keyword announces the boundary and no declaration
// form of its own exists. `implement inject` and the inline fence are retired.
text BuildStamp = BuildStamp() from ./Shell.ts

// A foreign action has no Tao body and declares its failure cases on the declaration head. A stub in
// a journey picks a declared case, so renaming one breaks the test at compile time.
action ExportDocument(Document, Format ExportFormat) returns text
   fails Offline "Exporting needs a connection."
   fails Rejected "The export service rejected this document."
   from ./Export.ts

// A foreign view declares its TypeScript implementation in its head. Tao owns the parameter,
// response, caller-content, and named-slot contract; the component owns its native root and honors
// Layout and Tag.
view Scroller() accepts content from ./Shell.ts

// `render inject` remains the occurrence-level native implementation form, beside the declaration
// form above rather than replaced by it.
view WordBadge(Total number) {
   render inject Total, Suffix " words", Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [`${Total}${Suffix}`], layout: Layout, tag: Tag })
   ```
}

// ---------------------------------------------------------------------------------------------
// Functions
// ---------------------------------------------------------------------------------------------

function DocumentLabel(Title text) returns text {
   return "Document: { Title }"
}

// A function stops by returning, and `if` is the one-sided test that gets it there — it never takes
// an `else`.
function GoalFraction(Count number) returns number {
   if Count == 0 {
      return 0
   }
   return Count / ParagraphGoal
}

// ---------------------------------------------------------------------------------------------
// Shared views
// ---------------------------------------------------------------------------------------------

// The shell: the navigator and the focus bar, laid out as ordinary content. A nav renders like any
// other view — `nav is scene is view` — so persistent chrome around navigated content is a `Col`,
// not a navigation kind. The navigator arrives as a parameter, which is how one shell serves every
// preview variant. The bar is conditional on the data, so it appears with the session and the
// content grows back when the session ends; the navigator never is, because its history lives on
// its mount and a branch that unmounted it would drop where the person was.
scene WordFlowerShell(Navigator nav) {
   query FocusSessions as CurrentSession {
      limit 1
   }
   render Col() [fill] {
      Navigator() [fill]
      when CurrentSession {
         empty -> { }
         otherwise -> { FocusBar() }
      }
   }
}

// A named arrangement with slots is an ordinary view placing `@@content`; §13 does not carry a
// `patterns { }` block forward, and this is what replaces it.
view EmptyState(Icon icon, Title text) {
   @body = empty

   render Col() [content center center, gap lg, pad gutter] {
      Icon(Icon) [size xl, ink muted]
      Text(Title) [title, centered]
      @body
      Col() [gap sm] { @@content }
   }
