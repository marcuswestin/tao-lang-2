use ExportDocument, StarterWorkspace, WordFlower, WordFlowerDeclarationHead, WordFlowerDeclarationHeadWith, WordFlowerDeclarationLet, WordFlowerDeclarationLetWith, WordFlowerDrawer, WordFlowerFoundationTest, WordFlowerStage from ./
use CloudKit from @tao/data/providers/cloudkit

// Exercise per-row recovery through the same WordFlower UI; its hosted InstantDB variant saves
// snapshots, while this test-only provider has queued and retryable writes.
app WordFlowerSyncTest = WordFlower with {
   Name "WordFlower Sync Test"
   Datasource CloudKit { }
}

// Directional journeys for the full target. Steps that reach panes, overlays, toasts, windows,
// and dialogues reuse the implemented #tag / select vocabulary; anything beyond that vocabulary
// is expected to be decided in a future Next slice before implementation.
test "WordFlower full target" on phone {
   test "activates the workspace tab and fills the split" {
      run WordFlower
      expect text "Starter prompt: Morning pages"
      expect text "Try writing for 10 minutes"
      expect text "Tagged: daily, warmup"
      enter "Novel" into #workspaceName
      submit #workspaceName
      expect text "Novel"
      press text "Workspace" // selection items are activated by their labels
      expect text "Choose a workspace"
      expect text "Novel" // target-only activation reveals preserved selection content; it does not present
      select #chooseWorkspace[1] {
         press text "Novel"
      }
      expect text "Files" // the split mounts with its pane titles
      expect text "Novel"
   }

   test "asks before closing a document" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #openDocument
      }
      expect text "Document: Chapter one"
      press #closeDocument
      expect text "Close Chapter one?"
      press #cancelClose
      expect text "Document: Chapter one" // cancelling answers none and the editor stays
      press #closeDocument
      press #confirmClose
      expect missing text "Document: Chapter one"
   }

   test "shares a saved document as Markdown" with StarterWorkspace {
      run WordFlower
      select #workspaces[1] { press #openWorkspace }
      select #documents[1] { press #openDocument }
      expect text "Document: Opening"
      press toolbar command "Export document"
      press #export
      expect text "Ready to share"
   }

   test "reports a named export failure" with StarterWorkspace {
      action ExportDocument fails Offline
      run WordFlower
      select #workspaces[1] { press #openWorkspace }
      select #documents[1] { press #openDocument }
      expect text "Document: Opening"
      press toolbar command "Export document"
      press #export
      expect text "Exporting needs a connection."
   }

   test "reports an otherwise declared export failure" with StarterWorkspace {
      action ExportDocument fails TooLarge
      run WordFlower
      select #workspaces[1] { press #openWorkspace }
      select #documents[1] { press #openDocument }
      expect text "Document: Opening"
      press toolbar command "Export document"
      press #export
      expect text "This document is too long to export."
   }

   test "leaves a cancelled export quiet" with StarterWorkspace {
      action ExportDocument fails Cancelled
      run WordFlower
      select #workspaces[1] { press #openWorkspace }
      select #documents[1] { press #openDocument }
      expect text "Document: Opening"
      press toolbar command "Export document"
      press #export
      expect missing text "Ready to share"
   }

   test "saving presents a keyed toast" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #openDocument
      }
      expect text "Saves this session: 0"
      expect checkbox #markFinal unchecked
      press #markFinal
      expect checkbox #markFinal checked
      enter "" into #documentTitle
      press #save
      expect text "Document: Chapter one"
      expect text "Saves this session: 0"
      enter "Opening" into #documentTitle
      enter "The first line." into #documentBody
      expect text "Words: 3"
      press #save
      expect text "Saved"
      expect text "Document: Opening"
      expect text "Saves this session: 1"
      enter "It began at sea." into #newParagraph
      submit #newParagraph
      expect #newParagraph input value ""
      expect text "It began at sea."
   }

   test "runs a focused writing session down under a controlled clock" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #openDocument
      }
      press #startFocus
      // The bar lives in the shell, not in the editor that started the session, so the countdown
      // belongs to the app. Asserting on the bar's own static label rather than on the session it
      // shows is what separates an unmounted bar from one that is present but rendering nothing.
      expect text "25:00"
      expect text "Focus session"
      advance 1.s
      expect text "24:59"
      press #pauseFocus
      advance 5.min
      expect text "24:59" // paused: the reading is anchored to the moment it stopped
      press #resumeFocus
      advance 1.min
      expect text "23:59" // resumed: the paused minutes were not lost
      // Stopping deletes the row, so the shell's condition is empty again and the bar goes with it.
      press #stopFocus
      expect missing text "23:59"
      expect missing text "Focus session"
   }

   test "preserves workspace and document CRUD through lifecycle states" {
      run WordFlower
      expect navigation title "WordFlower"
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      expect navigation title "Novel"
      enter "Renamed novel" into #workspaceTitle
      expect toolbar command "Save workspace" enabled
      press toolbar command "Save workspace"
      expect navigation title "Renamed novel"
      expect text "Workspace: Renamed novel"
      press #addDocument
      expect text "Document title is required"
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #finish
      }
      expect text "No drafts"
      select #finishedDocuments[1] {
         press #reopen
      }
      select #documents[1] {
         press #delete
      }
      expect text "No drafts"
      back
      select #workspaces[1] {
         press #deleteWorkspace
      }
      expect text "No workspaces yet"
   }

   test "a with-variant reconfigures the same app" {
      run WordFlowerDrawer
      press #activateWorkspaceTab
      expect text "Choose a workspace"
      press text "Settings"
      expect {
         text "Settings"
         text "Writing session"
         text "10 words"
         text "Build development"
      }
      press #resetSignedOut
      expect text "Signed out"
   }
}

// T4's test vocabulary drives the semantic attention reducer directly. These journeys remain in
// the full MVP sketch so later product breadth cannot silently regress the settled keyboard model.
test "WordFlower keyboard attention" {
   test "narrows and activates a workspace without Back disturbing attention" {
      run WordFlower
      enter "Home" into #workspaceName
      submit #workspaceName
      enter "Projects" into #workspaceName
      submit #workspaceName

      narrow "pro"
      expect focus region "WordFlower"
      expect target "Projects"
      back
      expect focus region "WordFlower"
      expect target "Projects"
      press key "Enter"
      expect navigation title "Projects"
   }

   test "shows stable generated hints only on demand" {
      run WordFlower
      enter "Home" into #workspaceName
      submit #workspaceName
      enter "Projects" into #workspaceName
      submit #workspaceName
      expect missing text "H — Home"
      press key "?"
      expect {
         text "Interaction hints"
         text "H — Home"
         text "P — Projects"
      }
      press key "?"
      expect missing text "Interaction hints"
   }

   test "engages the editor and invokes the focus bar chord" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] { press #openWorkspace }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] { press #openDocument }

      narrow "document title"
      expect target "Document title"
      press key "Enter"
      enter "Opening" into #documentTitle
      press key "Escape"
      expect target "Document title"

      press #startFocus
      press key "primary+p"
      expect text "Resume"
   }

   test "surfaces only the promoted document verb and runs its accelerator" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] { press #openWorkspace }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle

      narrow "chapter one"
      expect target "Chapter one"
      press key "."
      expect verbs "Finish document", "Open document", "Delete document"
      expect {
         text "Actions for Chapter one"
         text "F — Finish document"
      }
      press key "f"
      expect text "No drafts"
   }

   test "opens and narrows the generated command palette" {
      run WordFlower
      expect missing text "Command palette"
      press key "primary+k"
      expect {
         text "Command palette"
         text "Duplicate document"
      }
      narrow "dup doc"
      expect target "Duplicate document"
   }

   test "opens an overview of the navigator and persistent focus region" {
      run WordFlower
      enter "Home" into #workspaceName
      submit #workspaceName
      select #workspaces[1] { press #openWorkspace }
      enter "Morning pages" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] { press #openDocument }
      press #startFocus
      back
      back
      expect missing text "Interaction overview"
      press key "Escape"
      expect {
         text "Interaction overview"
         text "W — WordFlower"
         // `f` is the explicit Finish-document accelerator, so allocation advances through the
         // label instead of shadowing it.
         text "O — Focus session"
      }
   }
}

// World controls operate on isolated, provider-faithful test stores; journeys never contact a
// shared remote service.
test "WordFlower remote data" {
   test "keeps an offline document edit queued until reconnect" on phone with StarterWorkspace {
      run WordFlowerSyncTest
      select #workspaces[1] { press #openWorkspace }
      select #documents[1] { press #openDocument }
      network offline
      enter "An offline revision." into #documentBody
      press #save
      expect text "Waiting to sync"
      network online
      wait for sync
      expect missing text "Waiting to sync"
   }

   test "retries a rejected document write" on phone with StarterWorkspace {
      run WordFlowerSyncTest
      select #workspaces[1] { press #openWorkspace }
      select #documents[1] { press #openDocument }
      datasource fails after update Document "Server rejected the document."
      enter "A revised opening." into #documentBody
      press #save
      expect text "Server rejected the document."
      press #retryDocument
      wait for sync
      expect missing text "Server rejected the document."
   }

   test "surfaces and recovers from an unauthorized document" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #documents[1] {
         press #openDocument
      }
      expect text "Document: Chapter one"
      expect text "You no longer have access to this document."
      expect text "Document: Chapter one"
   }

   test "a derived datasource configures a deployment variant" {
      run WordFlowerStage
      expect text "No workspaces yet"
      enter "Novel" into #workspaceName
      submit #workspaceName
      expect text "Novel"
   }

   test "recovers from a remote provider failure" {
      run WordFlower
      expect missing text "No workspaces yet"
      expect {
         text "Could not load WordFlower"
         text "The workspace could not be reached"
      }
      expect text "No workspaces yet"
   }

   test "continues an async action while its remote write is delayed" {
      run WordFlower
      enter "Novel" into #workspaceName
      submit #workspaceName
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Delayed draft" into #newDocumentTitle
      submit #newDocumentTitle
      expect #newDocumentTitle input value ""
      expect text "Delayed draft"
   }
}

test "WordFlower navigation foundation" {
   test "native back uses the semantic reducer" {
      run WordFlowerFoundationTest
      expect navigation title "Navigation foundation"
      expect text "Foundation home marker"
      press text "Open deterministic detail"
      expect navigation title "Foundation detail"
      expect text "Foundation detail marker"
      back
      expect navigation title "Navigation foundation"
      expect text "Foundation home marker"
      expect missing text "Foundation detail marker"
   }

   test "slot dismissal restores its initial stack" {
      run WordFlowerFoundationTest
      press text "Open deterministic slot"
      expect text "Foundation slot marker"
      press text "Restore initial stack"
      expect text "Foundation home marker"
      expect missing text "Foundation slot marker"
   }
}

test "WordFlower declaration refinement forms" {
   test "a primitive head with canonical construction works" {
      run WordFlowerDeclarationHead
      expect text "Foundation home marker"
   }

   test "a primitive head with explicit refinement works" {
      run WordFlowerDeclarationHeadWith
      expect text "Foundation home marker"
   }

   test "an inferred let with canonical construction works" {
      run WordFlowerDeclarationLet
      expect text "Foundation home marker"
   }

   test "an inferred let with explicit refinement works" {
      run WordFlowerDeclarationLetWith
      expect text "Foundation home marker"
   }
}
