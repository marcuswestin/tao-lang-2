use InstantDB from @tao/data/providers/instantdb
use DynamicSelectionNav, Occurrence, SelectionNav, SlotNav, SplitNav, StackNav from @tao/nav
use CountWords, Join from @tao/text
use Interval from @tao/time
use Checkbox, Col, FormButton, Image, Panes, Placeholder, Problems, Progress, Row, ScrollView, Spacer, Spinner, Text, TextInput from @tao/ui

// WordFlower/MVP is the malleable full target for the v1 release: everything Tao must cover to call
// itself shipped, written with the syntax decisions settled so far (see `../2 - Next`). It is
// reconciled — not frozen — whenever Current absorbs a Next slice and the implementation teaches us
// something. Intended functionality beyond the release lives in `../4 - Revolution`.
//
// This file predates the Tao Revolution decisions (`Docs/Roadmap/Tao Revolution/Decisions.md`) and is
// re-derived from the rewritten Revolution tier at Process step 4 — same spellings, fewer
// capabilities. Requirements settled for that derivation, beyond what this sketch shows:
// - No automations, notifications, or interruption levels in MVP; those wait for the app
//   expansion (`Apps/Tao Future/`, Skillet first).
// - Open at derivation time: whether the authority cluster (access rules, transactions, invites,
//   publish, presence) enters MVP via collaborative workspaces or waits for the app expansion.
//
// The focused writing session landed in Current with the interaction system tranche: a device-local
// row that the shell reads, rather than state inside one view. The session below is that same
// feature sized for the full MVP surface — its length comes from a stored preference rather than a
// fixed pair of buttons.
//
// Keyboard attention follows the settled T4 contract in `../2 - Next`: the runtime derives regions
// and targets from the interaction outline, narrowing is locale-aware word-prefix matching, and
// commands remain the one discoverable verb model for pointer, keyboard, palette, and future host
// surfaces. The shell's focus-bar siblings form one compiler-described region without a wrapper.
//
// Generated interaction surfaces follow the settled T5 contract. Hints, the region overview, the
// target's verb layer, and the always-present command palette are pure runtime renderings of the
// outline, attention, bindings, and catalog. One app-host layer sits above content after toasts,
// never enters navigation history or consumes Back, and is absent from accessibility traversal
// while hidden. Cached app-relative bounds anchor affordances without measuring when a surface
// opens. Runtime allocation derives locale-aware keys deterministically by identity, preserves them
// across reorders, and excludes reducer keys plus explicit shortcuts; affordances appear after the
// first hardware-key dispatch.
//
// MVP retains the requirements intentionally moved out of the current Next tranche:
// - The InstantDB provider protocol handles inbound subscription deltas, write acknowledgement,
//   externally originated store revisions, and reconciliation between provider row identity and
//   generated Tao ids.
// - Remote providers can report `unauthorized` for an entity handle. `data <status>` is retired
//   (Decisions §16); the states it drove are reached through the world controls — network, sync,
//   and datasource fault injection — which have not landed yet.
// - The universal app shell applies safe-area and keyboard insets without a source-level opt-in on
//   every surface. The app root, every navigator, a `SplitNav` pane or an inline scene holding a
//   window-owning navigator, `ask` (which dims the whole window from the app host's window layer),
//   `as sheet`, `as toast`, and auxiliaries do today; what remains is Android keyboard avoidance,
//   which is unproven, and whether a plain `as overlay` presented under a navigator that does not
//   own its window should reach the window edges the way `ask` now does.
// - Property-function syntax must settle type-level addition and override plus the identity,
//   equality, capture, and anonymous-expression consequences of per-value behavior.
// - Design grows beyond flat tokens and clause bundles into recipes, variants, states, rules, and
//   platform blocks only when corresponding MVP code exercises each form; `patterns` is retired in
//   favour of content-accepting views (Decisions §13).
// - Concurrency-policy vocabulary, asset literals, and route/restoration policy remain MVP design
//   work and must enter a future Next contract as executable code before implementation.
//
// Navs and datasources are ordinary values. Primitive value heads constrain their family while
// preserving the precise configured type; reusable contracts use `type T is nav|datasource with`.
// A package-level `nav`/`provider` sidecar binds those rarer types to the published TR.NavKind and
// TR.DataProvider protocols rather than to compiler-maintained name tables. Configured `with`
// patches may add direct keyed entries when the declaration owns a keyed contract.
// A strict `App@key` target may name a complete root or in-file variant. Variants retain their root
// declaration identity, and the key must exist on every launch configuration of that root.

project {
   id "wordflower"
   name "WordFlower"
   version "1.0.0"
   DefaultApp WordFlower
   remote none
   license MIT
}

// Design starts with flat tokens plus named clause bundles that render sites apply like direct
// layout clauses. Bundles and inline clauses resolve left to right, with the last same-clause value
// winning; incompatible surviving clause categories remain invalid.
design WordFlowerDesign {
   paper #f6f7f3
   ink #121826
   inkMuted #5b6472
   accent #2f6b4f
   line #d9dcd4

   screen [fill, content top stretch, pad 16, bg paper]
   title [size 28, weight 700, fg ink]
   body [size 16, line 22, fg inkMuted]
   panel [pad 12, radius 8, bg paper, border line]
   FormButton [bg accent, bg paper when pressed, border accent when focused, fg ink, fg accent when hovered]
   Hint [bg accent, fg paper, radius 8, pad 8, weight 700]
   Overview [bg paper, fg ink, border line, radius 12, pad 12, gap 8]
}

// A configured nav binding is an immutable descriptor, not a mounted instance or exposed state.
nav HomeStack = StackNav { Initial WorkspaceList }
nav SettingsStack = StackNav { Initial Settings }
nav WorkspaceNav = SlotNav { Initial WorkspaceChooser }
nav SignedOutNav = StackNav { Initial SignedOut }

nav WordFlowerNavigator = SelectionNav {
   Initial @home
   Display "automatic"

   // Direct keys bind to SelectionNav's declared `@key` collection and share this configured nav's
   // target-key namespace.
   @home {
      Label "Home"
      Icon "house"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Icon "folder"
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Icon "gear"
      Content SettingsStack
   }
}

// The shell: the navigator and the focus bar, laid out as ordinary content. A nav renders like any
// other view — `nav is scene is view` — so persistent chrome around navigated content is a `Col`,
// not a navigation kind. The navigator arrives as a parameter, which is how one shell serves every
// preview variant. The bar is conditional on the data, so it appears with the session and the
// content grows back when the session ends; the navigator never is, because its history lives on
// its mount and a branch that unmounted it would drop where the person was.
scene WordFlowerShell(Navigator nav) {
   query FocusSessions as CurrentSession {
      limit 1
   }
   render Col() [fill] {
      Navigator() [fill]
      when CurrentSession {
         empty -> { }
         otherwise -> { FocusBar() }
      }
   }
}

// The preview variant hands the shell a differently configured navigator, so a preview still gets
// the focus bar.
nav WordFlowerDrawerNavigator = WordFlowerNavigator with {
   Display "drawer"
}

datasource WordFlowerStore = InstantDB {
   AppId "wordflower-mvp"
}

datasource WordFlowerStageStore = WordFlowerStore with {
   AppId "wordflower-stage"
}

// The app is rooted in a view: the shell, which lays the navigator and the focus bar out as ordinary
// content. Tao mounts a navigator around a view root, so nothing here names one.
// Every nav owns an absolute overlay lane above its content, so no app declares an overlay host;
// overlays stack while covered entries stay mounted but hidden, and Back/dismiss use the app reducer.
// Toasts are app-level, transient, replace the same key rather than stacking, and neither consume
// Back nor expose plain dismissal. Window presentation is universal and keeps its semantic key on
// the `present … as window` call site.
// A datasource value uses a primitive head, such as `datasource WordFlowerStore = InstantDB { ... }`;
// `with` patches an existing configured value. Memory is keyless, while remote providers own their
// provider-specific configuration below.
// The read net: a guard site that does not name an exceptional read case sends it here.
guard default {
   loading -> Spinner()
   error -> Message { Text("Could not load this: { Message }") }
}

app WordFlower {
   Name "WordFlower"
   Design WordFlowerDesign
   view WordFlowerShell(WordFlowerNavigator)

   Datasource WordFlowerStore
}

// `with` copies public properties into a configured variant; WordFlower and WordFlowerShell are
// unchanged. The variant rebinds the root with the same shell and a different navigator in it, so it
// keeps the focus bar.
app WordFlowerDrawer = WordFlower with {
   Name "WordFlower - Drawer Preview"
   view WordFlowerShell(WordFlowerDrawerNavigator) // the same shell, a different navigator in it
}

app WordFlowerStage = WordFlower with {
   Name "WordFlower - Stage"
   Datasource WordFlowerStageStore
}

let Tagline = "A quiet place for words that matter."

let ParagraphGoal = 10

let SessionGoal is number = 10

// The focused writing session's length, in minutes.
let SessionMinutes is number = 25

type PromptTitle is text

type PromptMinutes is number

type PromptTags is list of text

type WritingPrompt is {
   PromptTitle,
   PromptMinutes,
   PromptTags,
   PromptSubtitle text?
}

let StarterTags = PromptTags ["daily", "warmup"]

let StarterPrompt = WritingPrompt {
   PromptTitle: "Morning pages"
   PromptMinutes: 10
   StarterTags
}

// One-case enums are nominal types; a dismissed responder answers `none`.
type ConfirmResult is one of Confirmed

data Workspaces / Workspace {
   Name text (required "Name this workspace", title)
   CreatedAt time (default now)
   Pinned yes / no // demonstrative declaration; the product does not use it yet
   Documents (relation Documents, owned)

   index CreatedAt
   order by CreatedAt
}

data Documents / Document {
   Title text (required "Name this document", search, title)
   Body text (default "", search)
   Final yes / Draft no
   Public yes / Private no (default Public) // demonstrative declaration; the product does not use it yet
   CreatedAt time (default now)
   Workspace (relation Workspace)
   Paragraphs (owned)

   index CreatedAt
   order by CreatedAt
   commands Finish, Duplicate
   commands hide Delete
}

data Paragraphs / Paragraph {
   Text text
   Ordering number
   Document

   index Ordering
   order by Ordering
}

// A focused writing session. `local only` is an entity-level storage fact, a third trailing group
// entry beside `index` and `order by`: this entity lives in the device store whatever datasource the
// app configures, so the remote and staged variants never sync it. Holding the session as data
// rather than as view state is what lets it survive navigation and relaunch, and lets each consumer
// query it locally.
data FocusSessions / FocusSession {
   EndsAt time // absolute, so a running session survives relaunch correctly
   PausedAt time (default now) // read only while paused; resuming re-anchors EndsAt from it
   Paused yes / Running no

   local only
}

// Entity command policy is independent of the view that happens to render a document. Finish and
// Duplicate are the ordered defaults; destructive deletion is available only where a view
// explicitly promotes it.
workspace
command Finish(Document) {
   Title "Finish document"
   Description "Moves a document out of drafts and into the archive."
   Summary "Finish { Document.Title }"
   Icon "checkmark.circle"
   Key "f"
   Enabled Document.Final is Draft
   do -> { update Document {
      Final
   } }
}

workspace
command Duplicate(Document) {
   Title "Duplicate document"
   Description "Makes a new draft beside this document."
   Summary "Duplicate { Document.Title }"
   Icon "doc.on.doc"
   Key "d"
   do -> { create Document {
      Title: "{ Document.Title } copy"
      Body: Document.Body
      Document.Workspace
   } }
}

workspace
command Delete(Document) {
   Title "Delete document"
   Description "Permanently removes this document."
   Summary "Delete { Document.Title }"
   Icon "trash"
   Key "x"
   do -> { delete Document }
}

function DocumentLabel(Title text) returns text {
   return "Document: { Title }"
}

function GoalFraction(Count number) {
   if Count == 0 {
      return 0
   }
   return Count / ParagraphGoal
}

let BuildStamp is text = BuildStamp() from ./Shell.ts

view Card(Title text) {
   @actions = empty

   render Col() [gap 8, pad 12, panel] {
      Row() [content spread center] {
         Text(Title) [title]
         @actions
      }
      Col() [gap 6] {
         @@content
      }
   }
}

view Scroller() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({
        children: <RN.ScrollView contentContainerStyle={{ flexGrow: 1 }}>{Content}</RN.ScrollView>,
        layout: Layout,
        tag: Tag,
      })
   ```
}

view WordBadge(Total number) {
   render inject Total, Suffix " words", Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [`${Total}${Suffix}`], layout: Layout, tag: Tag })
   ```
}

view WordCount(Value text) {
   render Text("Words: { CountWords(Value) }") [body]
}

view TagSummary(Tags PromptTags) {
   render Text("Tagged: { Join(Tags, Separator: ", ") }") [body]
}

// A declaration that fills host-facing chrome is a `scene`, and a scene is presented rather than
// composed inline. `Title`, `Toolbar`, and `Header` live on `scene` alone, so a view that is only
// ever composed cannot declare chrome nothing reads.
type WorkspaceInput is Workspace { Name }

scene WorkspaceList() {
   Title "WordFlower"
   state Input = WorkspaceInput { Name: "" }
   query Workspaces { }
   action AddWorkspace() {
      if Input.Incomplete {
         present WorkspaceNameNotice() as overlay
      }
      check not Input.Incomplete
      create Workspace with Input
      set Input = WorkspaceInput { Name: "" }
   }
   render ScrollView() [screen] {
      Col() [width max 720, centered, gap 10] {
         Text("WordFlower") [title]
         Text(Tagline) [body]
         guard Workspaces {
            error -> Message {
               Text("Could not load WordFlower")
               Text(Message)
            }
         }
         #workspaceName
         TextInput(Value: Input.Name, Label: "Workspace name", Placeholder: "Novel") {
            on submit AddWorkspace
         }
         Problems(Input.Problems) [validation]
         #addWorkspace
         FormButton("Add workspace", Icon: "plus", Disabled: Input.Incomplete) {
            on press AddWorkspace
         }
         #activateWorkspaceTab
         FormButton("Activate workspace") {
            // Target-only activation names a complete app value and reveals without new content.
            on press -> { present WordFlower@workspace }
         }
         guard Workspaces empty -> {
            Image("./images/empty-workspaces.png", Decorative: true) [width 160, centered]
            Text("No workspaces yet") [title]
            Text("Starter prompt: { StarterPrompt.PromptTitle }") [body]
            Text("Try writing for { StarterPrompt.PromptMinutes } minutes") [body]
            TagSummary(StarterPrompt.PromptTags)
         }
         #workspaces
         loop Workspaces / Workspace {
            Col() [gap 6, pad 10] {
               Text(Workspace.Name)
               #openWorkspace
               FormButton("Open workspace") {
                  // Omitted target delegates to the nearest enclosing nav (HomeStack), pushing a new occurrence.
                  on press -> { present WorkspaceDetails(Workspace) }
               }
               #deleteWorkspace
               FormButton("Delete workspace", Icon: "trash") {
                  on press -> { delete Workspace }
               }
               #openInSplit
               FormButton("Open in workspace tab") {
                  on press -> {
                     // A configured nav value locates its one equal active mount. The next statement sees the update synchronously.
                     present WorkspaceSplit(Workspace) in WorkspaceNav
                     present WordFlower@workspace
                  }
               }
            }
         }
      }
   }
}

// Presented above the nearest enclosing nav. An explicit `in <target>` would override that contextual
// scope. Every nav's overlay entries stack above covered content while preserving its mounted state.
view WorkspaceNameNotice() {
   render Col() [gap 6, pad 10] {
      Text("A workspace needs a name")
      #dismissNotice
      FormButton("Dismiss") {
         on press -> { dismiss } // dismissal runs through the app reducer that owns the nearest nav
      }
   }
}

workspace
scene WorkspaceDetails(Workspace) { // a bare parameter name binds the same-named entity type
   Title Workspace.Name
   state WorkspaceNameDraft = Workspace.Name
   state DocumentTitle = ""
   state Find = ""
   let SectionLabel = "Drafts"
   query Drafts from Workspace.Documents {
      where is Draft
      search Find
   }
   query FinishedDocuments from Workspace.Documents {
      where is Final
      search Find
   }
   // An `action` is private: it carries no `Title`, `Description`, or `Summary` and is never
   // surfaced. The command is the discoverable verb, so the words a person reads live there.
   action SaveWorkspace() {
      check WorkspaceNameDraft is not empty
      update Workspace {
         Name: WorkspaceNameDraft
      }
   }
   // A command is a configured value: its slots are parameters, and its block holds metadata members
   // and exactly one `do`. This one is declared in the scene because it reads that scene's own state,
   // exactly as an `action` may.
   command Save() {
      Title "Save workspace"
      Icon "checkmark"
      Enabled WorkspaceNameDraft is not empty
      do SaveWorkspace()
   }
   Toolbar { Save }
   action AddDocument() {
      check DocumentTitle is not empty
      async {
         create Document { // don't wait for creation completion to update the text input
            Title: DocumentTitle
            Workspace // unlabeled arguments bind by type; the entity value matches the relation field
         }
      }
      set DocumentTitle = ""
   }
   render ScrollView() [screen] {
      Col() [width max 960, centered, gap 10] {
         Text("Workspace: { Workspace.Name }") [title]
         #workspaceTitle
         TextInput(Value: WorkspaceNameDraft, Label: "Workspace title", Placeholder: "Workspace title") {
            on submit SaveWorkspace
         }
         #saveWorkspace
         FormButton("Save workspace", Disabled: WorkspaceNameDraft is empty) {
            on press SaveWorkspace
         }
         Text("{ SectionLabel }: { Drafts.Count }")
         #pushTwice
         FormButton("Push this workspace twice") {
            on press -> {
               // Presenting the same semantic value twice still creates two distinct occurrences.
               present WorkspaceDetails(Workspace)
               present WorkspaceDetails(Workspace)
            }
         }
         guard Drafts
         guard FinishedDocuments
         #newDocumentTitle
         TextInput(Value: DocumentTitle, Label: "New document title", Placeholder: "Draft the next chapter") {
            on submit AddDocument
         }
         when DocumentTitle {
            empty -> { Text("Document title is required") }
            otherwise -> { Text(DocumentTitle) }
         }
         #addDocument
         FormButton("Add document", Disabled: DocumentTitle is empty) {
            on press AddDocument
         }
         #findDocuments
         TextInput(Value: Find, Label: "Find in this workspace", Placeholder: "Title or words") {
            on submit -> { } // the lists narrow as the term changes; there is nothing to submit
         }
         // Panes uses a horizontal row only when, after gaps, every child can receive at least 320
         // logical pixels; otherwise it preserves source order in a vertical stack.
         Panes() [gap 16] {
            Col() [gap 6] {
               when Drafts {
                  empty -> { Text("No drafts") }
                  otherwise -> {
                     #documents
                     loop Drafts / Document {
                        DraftDocumentRow(Document)
                     }
                  }
               }
            }
            Col() [gap 6] {
               let SectionLabel = "Finished"
               Text(SectionLabel)
               guard FinishedDocuments empty -> {
                  Text("No finished documents")
               }
               #finishedDocuments
               loop FinishedDocuments / Document {
                  FinishedDocumentRow(Document)
               }
            }
         }
      }
   }
}

// These row views preserve the full MVP screen while applying the settled verb tiers at the
// occurrence that owns each document target. A draft promotes Finish and excludes Duplicate;
// a finished row does the inverse. Delete remains hidden by the entity unless a later surface
// explicitly lists it.
view DraftDocumentRow(Document) {
   Commands { Finish }
   hide Duplicate
   render Col() [gap 6] {
      Text(Document.Title)
      #openDocument
      FormButton("Open document") {
         on press -> {
            present WorkspaceSplit(Document.Workspace) in WordFlower@workspace
            present DocumentScreen(Document) in WordFlower@workspace@documents
         }
      }
      #finish
      FormButton("Finish document") {
         on press -> { do Finish(Document) }
      }
      #delete
      FormButton("Delete document", Icon: "trash") {
         on press -> { delete Document }
      }
   }
}

view FinishedDocumentRow(Document) {
   Commands { Duplicate }
   hide Finish
   render Col() [gap 6] {
      Text(Document.Title)
      #reopen
      FormButton("Reopen document") {
         on press -> { update Document { Draft } }
      }
      #deleteFinished
      FormButton("Delete finished document", Icon: "trash") {
         on press -> { delete Document }
      }
   }
}

scene WorkspaceChooser() {
   Title "Choose a workspace"
   query Workspaces { }
   render Col() [screen, gap 10] {
      Text("Choose a workspace")
      #chooseWorkspace
      loop Workspaces / Workspace {
         Text(Workspace.Name) [body]
         on select -> {
            present WorkspaceSplit(Workspace) in WordFlower@workspace
         }
      }
   }
}

// A product function constructs a configured SplitNav descriptor. Primitive `nav` heads declare
// configured values; reusable package contracts use `type T is nav with` and `nav <Export> from ./<File>.ts`.
function WorkspaceSplit(Workspace) returns nav {
   return SplitNav {
      Axis "horizontal"

      // Direct keys bind to Panes. The nested dynamic selection starts its own key namespace.
      @files {
         // A view with bound arguments is a presentable value; it renders only when the nav mounts it.
         Content SlotNav { Initial FileTree(Workspace) }
         Title "Files"
         IdealSize 280
         CollapsePriority 2
      }
      @documents {
         // This MVP-target future declaration is distinct from shipped SelectionNav: it starts empty
         // and accepts runtime-added items, so it has no required static Initial and no undeclared
         // Items/Dynamic flags.
         Content DynamicSelectionNav {
            Display "tabs"
         }
         Title "Documents"
         Grow 1
         CollapsePriority 3
      }
      @inspector {
         Content SlotNav { Initial EmptyInspector }
         Title "Inspector"
         IdealSize 340
         CollapsePriority 1
      }
   }
}

view EmptyInspector() {
   render Text("No inspector selected")
}

workspace
view FileTree(Workspace) {
   query Documents from Workspace.Documents { }
   render Col() [gap 6, pad 10] {
      Text(Workspace.Name)
      guard Documents {
         loading -> { Spinner() }
         error -> Message { Text("Could not load files: { Message }") }
      }
      #files
      loop Documents / Document {
         Row() [gap 6] {
            #open
            FormButton(Document.Title) {
               // Relative @documents resolves to the nearest unique pane and reveals it.
               on press -> { present DocumentScreen(Document) in @documents }
            }
            #openRooted
            FormButton("Rooted") {
               on press -> { present DocumentScreen(Document) in WordFlower@workspace@documents }
            }
            #openViaBinding
            FormButton("Via mounted binding") {
               // WorkspaceNav is mounted once; resolution follows its active WorkspaceSplit content.
               on press -> { present DocumentScreen(Document) in WorkspaceNav@documents }
            }
            #openComparison
            FormButton("Comparison tab") {
               // Dynamic selection normally focuses semantic identity; a key makes another occurrence.
               on press -> {
                  present Occurrence {
                     Content: DocumentScreen(Document)
                     Key: "comparison"
                  } in @documents
               }
            }
         }
      }
   }
}

// The pane-level entry guards entity availability; the editor below assumes an available document.
workspace
scene DocumentScreen(Document) {
   Title Document.Title
   // The unfilled entity slot is supplied from this presented scene's Document parameter.
   Toolbar { Finish }
   render Col() [fill] {
      guard Document {
         missing -> { Text("Document { Document.Id } no longer exists.") } // the unavailable handle retains its stable Id
      }
      DocumentEditor(Document)
   }
}

type DocumentInput is Document { Title, Body }

// `view` stays embeddable content; DocumentEditor only appears inside another render tree.
workspace
view DocumentEditor(Document) {
   state Input = copy Document as DocumentInput
   state ParagraphText = ""
   state DetachedParagraphText = ""
   state SaveCount = 0
   state PreviousTitle = Document.Title
   state PreviousBody = Document.Body
   query Paragraphs from Document.Paragraphs { }
   action SetFinished(Value boolean) {
      update Document { Final: Value }
   }
   action SaveDocument() {
      check not Input.Incomplete
      set PreviousTitle = Document.Title
      set PreviousBody = Document.Body
      update Document with Input
      set SaveCount += 1
      // A keyed toast replaces the same key instead of stacking. Duration is a number of seconds;
      // unit literals remain deferred.
      present SavedToast(Revert: -> {
         update Document {
            Title: PreviousTitle
            Body: PreviousBody
         }
         set Input.Title = PreviousTitle
         set Input.Body = PreviousBody
      }) as toast (Key: "document-saved", Duration: 3.s)
   }
   action AddParagraph() {
      check ParagraphText is not empty
      // `async` starts as a later root, so capture the submitted value before clearing the input.
      // A failed detached write enters the datasource error state.
      set DetachedParagraphText = ParagraphText
      async {
         create Paragraph {
            Text: DetachedParagraphText
            Ordering: Paragraphs.Count + 1
            Document
         }
      }
      set ParagraphText = ""
   }
   action CloseDocument() {
      // `ask` suspends the action until the presented view responds; a bare `respond` answers none.
      let Result = ask ConfirmCloseDialogue(Document)
      // `when` is always exhaustive, so a one-sided test uses `if`, which never takes `else`.
      if Result is Confirmed { dismiss }
   }
   render Col() [gap 10, pad 16] {
      Text(DocumentLabel(Document.Title)) [title, width fill]
      #documentTitle
      TextInput(Value: Input.Title, Label: "Document title", Placeholder: "Document title") {
         on submit SaveDocument
      }
      Problems(Input.Problems) [validation]
      #documentBody
      TextInput(Value: Input.Body, Label: "Document body", Placeholder: "Write the document body") [claim 2] {
         on submit SaveDocument
      }
      WordCount(Input.Body)
      #focusSession
      FocusStarter()
      #markFinal
      Checkbox(Value: Document.Final is Final, Label: "Final") {
         on change SetFinished
      }
      Text("Saves this session: { SaveCount }")
      if Document.WritesFailed > 0 {
         Text(Document.WriteError)
         if Document.CanRetryWrites {
            FormButton("Retry submitted write") { on press -> { retry Document } }
         }
      }
      if Document.WritesQueued > 0 { Text("Waiting to sync") }
      Progress(Value: GoalFraction(Paragraphs.Count))
      Text("Goal: { ParagraphGoal } paragraphs") [body]
      guard Paragraphs
      #newParagraph
      TextInput(Value: ParagraphText, Label: "New paragraph", Placeholder: "Add a paragraph") {
         on submit AddParagraph
      }
      #paragraphs
      loop Paragraphs / Paragraph {
         #inspect
         FormButton(Paragraph.Text) {
            on press -> { present ParagraphInspector(Paragraph) in @inspector }
         }
      }
      Row() [gap 6] {
         #documentInfo
         FormButton("Document info") {
            on press -> { present DocumentInfo(Document) as overlay }
         }
         #save
         FormButton("Save") {
            on press SaveDocument
         }
         #comparisonWindow
         FormButton("Comparison window") {
            on press -> {
               present DocumentScreen(Document) as window (Key: "comparison-left")
            }
         }
         #snapshotDocument
         FormButton("Snapshot") {
            on press -> {
               // A snapshot is an immutable copy; the live handle keeps updating elsewhere.
               let Snapshot = snapshot Document
               present DocumentSnapshot(Snapshot) as overlay
            }
         }
         #closeDocument
         FormButton("Close document") {
            on press CloseDocument
         }
      }
   }
}

view ParagraphInspector(Paragraph) {
   render Text("{ Paragraph.Document.Title } - { Paragraph.Text }")
}

view DocumentInfo(Document) {
   render Col() [gap 6, pad 10] {
      Text(Document.Title)
      Text("{ Document.Paragraphs.Count } paragraphs")
      #dismissInfo
      FormButton("Dismiss") {
         on press -> { dismiss }
      }
   }
}

view DocumentSnapshot(Snapshot Document.Snapshot) {
   render Col() [gap 6, pad 10] {
      Text("Captured version")
      Text(Snapshot.Title)
      #dismissSnapshot
      FormButton("Dismiss") {
         on press -> { dismiss }
      }
   }
}

// A focused writing session: pick a length, write until the clock runs out, pause and resume, or
// stop early. The session is a row in the device-local store rather than state in one view, which is
// what lets the editor start it and the shell count it down.
//
// Starting is an editor affordance — you choose a length where you are about to write — so this view
// creates the row and nothing else. The length comes from the person's preference rather than a
// fixed pair of buttons.
file view FocusStarter() {
   query FocusSessions as CurrentSession {
      limit 1
   }
   action Start(Length duration) {
      create FocusSession {
         EndsAt: now + Length
   }  }
   render Col() [gap 6] {
      when CurrentSession {
         empty -> {
            #startFocus
            FormButton("Focus for { SessionMinutes } min") {
               on press -> { do Start(SessionMinutes.min) }
         }  }
         otherwise -> { Text("A session is running") [body] }
}  }  }

// The focus bar: the running session, wherever you are. The shell lays it out beside the navigator,
// and it reads the session from the store rather than from a parent view, which is what lets it stay
// visible while the writing happens several navigation levels deeper. The clock is a library value
// and `Left` is an ordinary derivation that recomputes as it ticks. `EndsAt` is absolute, so a
// running session survives relaunch; pausing freezes the reading by recording when it stopped, and
// resuming re-anchors the deadline to the remainder, so paused time is not lost.
file view FocusBar() {
   query FocusSessions as CurrentSession {
      limit 1
   }
   state Tick = Interval(1.s)
   render Row() [gap 6, panel, border accent when FocusBar is active] {
      Text("Focus session") [body]
      loop CurrentSession / FocusSession {
         let Left = when FocusSession.Paused {
            true -> FocusSession.EndsAt - FocusSession.PausedAt
            otherwise -> FocusSession.EndsAt - Tick.Value
         }
         Text(when Left > 0 Left.Clock / not "Time's up") [title]
         FocusSessionControls(FocusSession)
}  }  }  }

// The child command closes over one mounted session. Its modifier shortcut therefore remains
// available while attention is in the editor, without promoting the session to global state.
view FocusSessionControls(FocusSession) {
   command PauseFocus() {
      Title "Pause focus session"
      Key primary + "p"
      Enabled FocusSession.Paused is Running
      do -> { update FocusSession {
         PausedAt: now
         Paused
      } }
   }
   Commands { PauseFocus }
   render Row() [gap 6] {
      when FocusSession.Paused {
         true -> {
            #resumeFocus
            FormButton("Resume") {
               on press -> { update FocusSession {
                  EndsAt: now + (FocusSession.EndsAt - FocusSession.PausedAt)
                  Running
               } }
         }  }
         otherwise -> {
            #pauseFocus
            FormButton("Pause") {
               on press -> { do PauseFocus() }
      }  }  }

      #stopFocus
      FormButton("Stop") {
         on press -> { delete FocusSession }
}  }  }

view SavedToast(Revert action()) {
   render Row() [gap 10] {
      Placeholder("Saved status icon") [width 20, height 20]
      Text("Saved")
      Spacer()
      #revertSave
      FormButton("Revert") { on press Revert }
   }
}

// Fixtureless focused scenarios begin from an empty store. Required actions may be omitted only
// here; Studio supplies an isolated logging stand-in and replays these steps in order.
scenarios SavedToast "interaction" {
   device phone
   scenario "held" {
      render ()
      press down #revertSave
      advance 600.ms
      press up #revertSave
      hover #revertSave
      focus #revertSave
}  }

// A view with `responds T` is presented for a typed answer; `ask` resumes with the response or none.
view ConfirmCloseDialogue(Document) responds ConfirmResult {
   render Col() [gap 6, pad 10] {
      Text("Close { Document.Title }?")
      #confirmClose
      FormButton("Close") {
         on press -> { respond Confirmed }
      }
      #cancelClose
      FormButton("Cancel") {
         on press -> { respond } // bare respond answers none
      }
   }
}

scene Settings() {
   Title "Settings"
   render Scroller() [screen] {
      Col() [width max 720, centered, gap 10] {
         Text("Settings") [title]
         Card(Title: "Writing session") {
            WordBadge(SessionGoal)
            Text("Build { BuildStamp }") [body]
            @actions FormButton("Reset to signed out") {
               #resetSignedOut
               // From a view declaration, `replace` is the only root operation an app host accepts.
               on press -> { replace SignedOutNav in WordFlower }
            }
         }
      }
   }
}

scene SignedOut() {
   Title "Signed out"
   render Text("Signed out")
}

// Deterministic navigation-foundation harness: only StackNav and SlotNav, with no Design or
// Datasource capability, so navigation foundations stay executable independently of them.
workspace
type FoundationHomeStack is StackNav with {
   Initial is FoundationHome
}

workspace
nav FoundationStack = FoundationHomeStack {}
workspace
nav FoundationStackWith = FoundationHomeStack with {}
workspace
let FoundationStackLet = FoundationHomeStack {}
workspace
let FoundationStackLetWith = FoundationHomeStack with {}
workspace
nav FoundationNavigator = SlotNav { Initial FoundationStack }

app WordFlowerFoundationTest {
   Name "WordFlower Navigation Foundation Test"
   Navigator FoundationNavigator
}

app WordFlowerDeclarationHead {
   Name "WordFlower Declaration Head"
   Navigator FoundationStack
}

app WordFlowerDeclarationHeadWith = app with {
   Name "WordFlower Declaration Head With"
   Navigator FoundationStackWith
}

workspace
let WordFlowerDeclarationLet = app {
   Name "WordFlower Declaration Let"
   Navigator FoundationStackLet
}

workspace
let WordFlowerDeclarationLetWith = app with {
   Name "WordFlower Declaration Let With"
   Navigator FoundationStackLetWith
}

scene FoundationHome() {
   Title "Navigation foundation"
   render Col() {
      Text("Foundation home marker")
      FormButton("Open deterministic detail") {
         on press -> { present FoundationDetail() }
      }
      FormButton("Open deterministic slot") {
         on press -> { present FoundationSlot() in FoundationNavigator }
      }
   }
}

scene FoundationDetail() {
   Title "Foundation detail"
   render Col() {
      Text("Foundation detail marker")
      FormButton("Reset foundation app") {
         on press -> { replace FoundationNavigator in WordFlowerFoundationTest }
      }
   }
}

view FoundationSlot() {
   render Col() {
      Text("Foundation slot marker")
      FormButton("Restore initial stack") {
         on press -> { dismiss }
      }
   }
}
