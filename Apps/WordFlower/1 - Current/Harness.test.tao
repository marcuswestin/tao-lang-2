use SlotNav, StackNav from @tao/nav/basic
use Col, FormButton, Text from @tao/ui

project {
   id "wordflower-foundation-harness"
   name "WordFlower Foundation Harness"
}

app WordFlowerNavHarness {
   Name "WordFlower Navigation Harness"
   Navigator HarnessNavigator
   // An app without data omits `Datasource` entirely
}

// These four apps cross the two independent declaration sugars. Each is a complete app value with
// the same mounted behavior: primitive head versus inferred `let`, and canonical construction versus
// explicit `with`. The checks below run all four, so every spelling must compile and work.
app WordFlowerStackByNav {
   Name "WordFlower Declaration Head"
   Navigator StackByNav
}

app WordFlowerStackByNavWith = app with {
   Name "WordFlower Declaration Head With"
   Navigator StackByNavWith
}

// A deterministic navigation harness. It keeps stack, slot, and root-replacement acceptance
// independent of the product app, its data, and its design. Keeping the complete harness in this
// test sidecar prevents its implementation-only app variants from crowding the interactive picker.
// One complete type and four equivalent value spellings make the declaration/refinement contract
// executable. `HarnessStack` is the rare type declaration; each value below has that same
// precise inferred type and the same configured behavior. The primitive `nav` head adds a family
// constraint, while `let` infers it. A constructor block may expose or omit the core `with` without
// changing the result.
type HarnessStack is StackNav with {
   Initial is HarnessHome
}

workspace
nav StackByNav = HarnessStack { }

workspace
nav StackByNavWith = HarnessStack with { }

workspace
let StackByLet = HarnessStack { }

workspace
let StackByLetWith = HarnessStack with { }

workspace
nav HarnessNavigator = SlotNav {
   Initial StackByNav
}

folder
let WordFlowerStackByLet = app {
   Name "WordFlower Declaration Let"
   Navigator StackByLet
}

folder
let WordFlowerStackByLetWith = app with {
   Name "WordFlower Declaration Let With"
   Navigator StackByLetWith
}

scene HarnessHome() {
   Title "Navigation harness"
   render Col() {
      Text("Harness home marker")

      #openHarnessDetail
      FormButton("Open deterministic detail") {
         on press -> { present HarnessDetail() }
      }
      FormButton("Open deterministic slot") {
         on press -> { present HarnessSlot() in HarnessNavigator }
}  }  }

scene HarnessDetail() {
   Title "Harness detail"
   render Col() {
      Text("Harness detail marker")
      FormButton("Reset foundation app") {
         // `replace <nav> in <App>` swaps the app's root content; it is the only root operation an
         // app accepts, it names the app declaration, and it is valid only inside a view
         // declaration.
         on press -> { replace HarnessNavigator in WordFlowerNavHarness }
}  }  }

view HarnessSlot() {
   render Col() {
      Text("Harness slot marker")
      FormButton("Restore initial stack") {
         on press -> { dismiss } // dismissing a SlotNav's presented content restores its Initial
}  }  }

test "WordFlower navigation foundation" {
   test "native back uses the semantic reducer" {
      run WordFlowerNavHarness
      expect navigation title "Navigation harness"
      expect text "Harness home marker"
      // Phase, pointer, and focus steps deliver their own events without collapsing into a full
      // activation. The adapter-level mutation proof checks their exact event names and order.
      press down #openHarnessDetail
      advance 600.ms
      press up #openHarnessDetail
      hover #openHarnessDetail
      focus #openHarnessDetail
      expect missing text "Harness detail marker"
      press #openHarnessDetail
      expect navigation title "Harness detail"
      expect text "Harness detail marker"
      back
      expect navigation title "Navigation harness"
      expect text "Harness home marker"
      expect missing text "Harness detail marker"
   }
   test "slot dismissal restores its initial stack" {
      run WordFlowerNavHarness
      press "Open deterministic slot"
      expect text "Harness slot marker"
      press "Restore initial stack"
      expect text "Harness home marker"
      expect missing text "Harness slot marker"
   }
}

// All four checks must mount the same complete app/nav behavior. Together they prove that primitive
// value heads and inferred `let` bindings are equivalent, and that an explicit constructor `with`
// is equivalent to its canonical omission.
test "WordFlower declaration refinement forms" {
   test "a primitive head with canonical construction works" {
      run WordFlowerStackByNav

      expect text "Harness home marker"
   }
   test "a primitive head with explicit refinement works" {
      run WordFlowerStackByNavWith

      expect text "Harness home marker"
   }
   test "an inferred let with canonical construction works" {
      run WordFlowerStackByLet

      expect text "Harness home marker"
   }
   test "an inferred let with explicit refinement works" {
      run WordFlowerStackByLetWith

      expect text "Harness home marker"
   }
}
