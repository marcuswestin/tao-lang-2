use WordFlower from ./

test "WordFlower documents" {
   test "edits a document on its own live destination" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Draft the intro" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      expect {
         text "Document: Draft the intro"
         text "Workspace: Home"
         text "Words: 0"
         text "Saves this session: 0"
         text "Paragraphs: 0"
         text "Goal: 10 paragraphs"
      }
      expect #editDocumentTitle input value "Draft the intro"
      // The scene's `Toolbar { Finish }` mentions the command without filling its slot; the surface
      // fills it from the presented scene's parameters by type when it is invoked.
      expect toolbar command "Finish document" enabled
      expect checkbox #markFinal unchecked
      enter "" into #editDocumentTitle
      submit #editDocumentTitle
      expect text "Saved title: Draft the intro"
      enter "Polish the intro" into #editDocumentTitle
      enter "Set the scene with intent" into #editDocumentBody
      expect text "Words: 5" // the explicit change action keeps the live word count reactive
      press #saveDocument
      expect {
         text "Saved title: Polish the intro"
         text "Saved body: Set the scene with intent"
         text "Saves this session: 1"
         text "Saved" // the keyed toast
      }
      advance 3.s
      expect missing text "Saved" // its duration has elapsed
   }
   test "reverts the last save from the toast's action parameter" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Draft the intro" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      enter "Polish the intro" into #editDocumentTitle
      enter "First line" into #editDocumentBody
      press #saveDocument
      expect text "Saved title: Polish the intro"
      enter "Ship the intro" into #editDocumentTitle
      enter "Second line" into #editDocumentBody
      press #saveDocument
      expect {
         text "Saved title: Ship the intro"
         text "Saved body: Second line"
      }
      // The toast carries the revert action for the save it announces — an ephemeral presentation
      // taking a non-serializable parameter.
      press #revertSave
      expect {
         text "Saved title: Polish the intro"
         text "Saved body: First line"
      }
      expect #editDocumentTitle input value "Polish the intro"
   }
   test "marks a document final through the checkbox" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      expect checkbox #markFinal unchecked
      press #markFinal
      expect checkbox #markFinal checked
      press #markFinal
      expect checkbox #markFinal unchecked
      press #markFinal
      expect checkbox #markFinal checked
      back
      expect {
         text "Drafts: 0"
         text "No drafts"
      }
      select #finishedDocuments[1] {
         expect text "Chapter one"
      }
   }
   test "adds paragraphs and clears the input from the asynchronous action" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      enter "It began at sea." into #newParagraph
      submit #newParagraph
      // The statement after `async` clears the input without awaiting the write.
      expect #newParagraph input value ""
      expect {
         text "Paragraphs: 1"
         text "It began at sea."
   }  }
   test "asks before closing" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      expect text "Document: Chapter one"
      press #closeDocument
      expect text "Close Chapter one?"
      press #cancelClose
      expect text "Document: Chapter one" // cancelling answers none and the editor stays
      press #closeDocument
      press #confirmClose
      expect missing text "Document: Chapter one"
   }
   test "reports a missing document behind the availability guard" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      // Keep the document mounted in the Workspace tab while deleting it from the independently
      // preserved Home tab. Returning to Workspace exercises the live handle's missing state.
      press "Workspace"
      select #chooseWorkspace[1] {
         press "Home"
      }
      select #workspaceDocuments[1] {
         press "Chapter one"
      }
      expect text "Document: Chapter one"
      press "Home"
      select #drafts[1] {
         press #delete
      }
      expect text "No drafts"
      press "Workspace"
      expect {
         text "Document Document-2 no longer exists."
         missing text "Document: Chapter one"
   }  }
   test "runs the document verb from the scene toolbar" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Chapter one" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      expect toolbar command "Finish document" enabled
      press toolbar command "Finish document"
      // `Enabled Document.Final is Draft`, so the one declared verb reports itself unavailable once
      // the document has left drafts -- the toolbar and the row's button share that judgement
      // because they share the command.
      expect toolbar command "Finish document" disabled
      expect checkbox #markFinal checked
   }
}
