use Placeholder from @tao/ui

project {
   id "wordflower-placeholder-harness"
   name "WordFlower Placeholder Harness"
}

app PlaceholderHarness {
   view PlaceholderHarnessView
}

view PlaceholderHarnessView() {
   render Placeholder("Draft cover") [width 52, height 52]
}

test "Placeholder development rendering" {
   run PlaceholderHarness

   expect text "Draft cover"
}
