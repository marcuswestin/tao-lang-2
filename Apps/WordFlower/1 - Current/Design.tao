// ============================================================================================
// THIS FILE WAS IMPLEMENTED LAST IN TRANCHE 4.
//
// Design and styling followed the green stdlib surfaces, adaptive layout, declaration model,
// `async`, typed injection, functions, declaration parameter lists, and optional item fields.
//
// The reason is ordering, not preference: design styles primitives, so the primitives must exist
// first or the app gets restyled twice. The bundles below are applied at render sites throughout
// the other files ([screen], [title], [body]); landing their resolver last avoided restyling the
// primitives twice.
//
// This tranche implements exactly the flat tokens and named clause bundles exercised below. Do not
// generalize the implementation beyond those two represented forms.
// ============================================================================================
// A design declaration is ordinary Tao source, subject to the same visibility, imports, and
// validation as everything else. An app selects one with its `Design` property. `#...` lexes as
// `TagOrHexColor`; in these value positions the validator accepts exactly 3-, 4-, 6-, or 8-digit
// CSS hexadecimal colors. The values deliberately include both letter-leading forms that also fit
// tag lexemes and digit-leading forms, proving that lexical choice never decides their AST meaning.
folder
design WordFlowerDesign {
   // A warm paper palette keeps the writing surface quiet while the green accent gives actions and
   // selection a recognizable WordFlower voice.
   canvas #f4f2ec
   surface #fffdf8
   surfaceRaised #ffffff
   ink #172019
   inkMuted #647067
   accent #3f7657
   accentStrong #28563d
   accentSoft #e1ede4
   line #d9e0da
   danger #a43d3d
   dangerSoft #f8e6e3
   onAccent #ffffff

   // Capitalized bundles are defaults for linked stdlib elements. The navigation bundles are
   // consumed by Tao's portable/web host so product chrome and content use one mounted design.
   Text [fg ink]
   TextInput [bg surfaceRaised, border line, fg ink, radius 12, size 16]
   FormButton [bg accentStrong, fg onAccent, radius 12, weight 700]
   Checkbox [fg ink]
   Progress [bg line, fg accent, radius 999]
   AppSurface [bg canvas]
   NavigationHost [bg canvas]
   NavigationContent [bg canvas]
   NavigationHeader [bg surfaceRaised, border line]
   NavigationTitle [size 18, weight 700, fg ink]
   NavigationTabs [gap 6, pad 6, bg surfaceRaised, border line]
   NavigationTab [pad 10, radius 10, fg inkMuted, weight 600]
   NavigationTabActive [NavigationTab, bg accentSoft, fg accentStrong]
   NavigationChromeButton [pad 8, radius 8, fg accentStrong, weight 600]
   ModalSurface [bg surfaceRaised, border line]
   ToastSurface [bg surfaceRaised, border line, fg ink]

   // Product bundles describe hierarchy rather than individual screens. Later entries at a render
   // site remain free to tune layout without respelling the palette or type scale.
   screen [fill, content top stretch, pad 24, bg canvas]
   hero [gap 8, pad 24, radius 20, bg accentSoft, border line]
   display [size 40, line 46, weight 700, fg ink]
   eyebrow [size 13, line 18, weight 700, fg accentStrong]
   title [size 28, line 34, weight 700, fg ink]
   sectionTitle [size 20, line 26, weight 700, fg ink]
   body [size 16, line 24, fg inkMuted]
   caption [size 14, line 20, fg inkMuted]
   validation [size 14, line 20, weight 600, fg danger]
   panel [gap 14, pad 20, radius 18, bg surfaceRaised, border line]
   card [gap 10, pad 16, radius 14, bg surface, border line]
   subtlePanel [gap 10, pad 16, radius 14, bg accentSoft]
   buttonSecondary [bg surfaceRaised, border line, fg accentStrong]
   buttonDanger [bg dangerSoft, border danger, fg danger]
}

// The dark design is a complete mounted catalog, not a collection of call-site overrides. Keeping
// the same semantic bundle names means every WordFlower screen and portable host can switch as one.
folder
design WordFlowerDarkDesign {
   canvas #101612
   surface #18201a
   surfaceRaised #202a22
   ink #edf3ee
   inkMuted #a7b4aa
   accent #8fbea0
   accentStrong #b2d6bd
   accentSoft #26382c
   line #34453a
   danger #ef9189
   dangerSoft #412724
   onAccent #102016
   Text [fg ink]
   TextInput [bg surfaceRaised, border line, fg ink, radius 12, size 16]
   FormButton [bg accentStrong, fg onAccent, radius 12, weight 700]
   Checkbox [fg ink]
   Progress [bg line, fg accent, radius 999]
   AppSurface [bg canvas]
   NavigationHost [bg canvas]
   NavigationContent [bg canvas]
   NavigationHeader [bg surface, border line]
   NavigationTitle [size 18, weight 700, fg ink]
   NavigationTabs [gap 6, pad 6, bg surface, border line]
   NavigationTab [pad 10, radius 10, fg inkMuted, weight 600]
   NavigationTabActive [NavigationTab, bg accentSoft, fg accentStrong]
   NavigationChromeButton [pad 8, radius 8, fg accentStrong, weight 600]
   ModalSurface [bg surfaceRaised, border line]
   ToastSurface [bg surfaceRaised, border line, fg ink]
   screen [fill, content top stretch, pad 24, bg canvas]
   hero [gap 8, pad 24, radius 20, bg accentSoft, border line]
   display [size 40, line 46, weight 700, fg ink]
   eyebrow [size 13, line 18, weight 700, fg accentStrong]
   title [size 28, line 34, weight 700, fg ink]
   sectionTitle [size 20, line 26, weight 700, fg ink]
   body [size 16, line 24, fg inkMuted]
   caption [size 14, line 20, fg inkMuted]
   validation [size 14, line 20, weight 600, fg danger]
   panel [gap 14, pad 20, radius 18, bg surfaceRaised, border line]
   card [gap 10, pad 16, radius 14, bg surface, border line]
   subtlePanel [gap 10, pad 16, radius 14, bg accentSoft]
   buttonSecondary [bg surface, border line, fg accentStrong]
   buttonDanger [bg dangerSoft, border danger, fg danger]
}
