use Local, Memory from @tao/data
use SelectionNav, SlotNav, StackNav from @tao/nav
use Col, FormButton, Text, TextInput from @tao/ui

// Tranche status: absorbed
// This tranche decides (the process contract is ../README.md):
// - `SelectionNav` with keyed items (`@key { Label, Content }`), `Initial @key`, `Display`, and
//   target-only activation: `present App@key` names the root app declaration and reveals an item
//   without new content. A strict key must be available from the root navigator and every variant
//   of that app in the file
// - Configured `with` variants: `Nav with { Display "drawer" }` and app variants that override
//   Name, Navigator, or Datasource without changing the original
// - A third data level (Paragraphs) and entity availability guards:
//   `guard Entity { loading / missing / unauthorized / error -> Message }` with available fall-through;
//   a handle keeps its Id after its row is gone
// - `dialogue Name <Params> responds <Enum>`; `ask` suspends the action until the dialogue answers;
//   `respond Case` answers, bare `respond` answers none
// - `is <Case>` generalizes `is empty` into a case test usable wherever a boolean is
// - `when` stays exhaustive everywhere — `otherwise` is always required. `if <boolean> { ... }` is
//   the one-sided test and never takes `else`; two or more outcomes are `when`'s job
// - Presentation modes replace named hosts. Every nav can host overlays, so
//   `present X() as overlay` layers above the NEAREST nav (the same contextual rule plain
//   `present` uses) and `in <target>` still overrides scope. `present X() as toast (Key: "...",
//   Duration: 3)` is always app-level and transient. The same key replaces; different keys coexist.
//   Toasts expire automatically and neither consume Back nor expose plain dismissal. Keyed app
//   auxiliaries stay in the language for genuinely app-specific hosts such as windows, but no app
//   declares overlay or toast hosts. Duration is a number of seconds; unit literals remain deferred
// - Pure functions in product code (`function Name Params returns type = expression`)
// - Data fields as `Name type (modifiers)`: parenthesized comma-separated modifiers, booleans as
//   `Name yes / no [NoAlias] [(default Case)]`, owner-side `auto-delete`, values (like `now`)
//   that the runtime applies later
// - Types instantiate with a bare block (`Datasource Local { ... }`); `with` patches values, and a
//   property-position `with` (`Navigator with { ... }`) merge-copies the original's property
// - Self-hosted navs and datasources: a package declares config properties in Tao and binds
//   semantics with `implement inject` against the published TR protocols in the stdlib sources
//
// Splits, windows, design, and the remote provider stay in `../3 - MVP` for later tranches.
// All tranche-1 forms below are implemented and unchanged. Per ../README.md, `3 - MVP` and
// `4 - Revolution` are reconciled with this tranche's decisions ONCE, as the final step after
// Current absorbs Next — mid-tranche amendments to Next accumulate here first.
project {
   name "WordFlower"
   remote none
   license MIT
}

// An app mounts navs, it does not render content directly. `Navigator` is the primary nav. Overlay
// and toast hosting are universal capabilities, so no app declares them; keyed auxiliary entries
// remain available for app-specific hosts such as windows.
app WordFlower {
   Name "WordFlower"
   Navigator WordFlowerNavigator
   Datasource Local { // Local is a type, which gets instantiated, so no `with`
      StorageKey "WordFlowerData"
}  }

app WordFlowerFoundationTest {
   Name "WordFlower Navigation Foundation Test"
   Navigator FoundationNavigator
   // An app without data omits `Datasource` entirely
}

// A configured nav binding is an immutable descriptor, not a mounted instance or exposed state.
let HomeStack = StackNav {
   Initial WorkspaceList
}
let WorkspaceNav = SlotNav {
   Initial WorkspaceChooser
}
let SettingsStack = StackNav {
   Initial Settings
}
let SignedOutNav = StackNav {
   Initial SignedOut
}

// Direct keys bind to SelectionNav's declared `@key` collection and share this configured nav's
// target-key namespace.
let WordFlowerNavigator = SelectionNav {
   Initial @home
   Display "automatic"
   @home {
      Label "Home"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Content SettingsStack
}  }

// `with` copies public properties of a *value* into a new value; WordFlower itself is unchanged.
workspace let WordFlowerDrawer = WordFlower with {
   Name "WordFlower - Drawer Preview"
   Navigator with { // this short-hands `Navigator WordFlower.Navigator with { ... }`. If you drop `with`, it would be an overwrite instead of a merge-copy
      Display "drawer"
}  }

// Overwriting a property in a variant (no `with`): the demo app swaps the whole datasource.
let WordFlowerDemo = WordFlower with {
   Name "WordFlower Demo"
   Datasource Memory // Memory is keyless; a bare name instantiates an all-defaulted type
}

enum ConfirmResult {
   Confirmed
}

data Workspaces / Workspace { // top-level data: the plural collection, then the singular entity it stores — the same `Plural / Singular` order as `loop`
   Name text
   // Modifiers take values: `now` is a deferred runtime default sampled separately for each create,
   // while `Initial WorkspaceList` likewise passes a ui that mounts later.
   CreatedAt time (default now) // modifications inside parentheses, comma separated
   Pinned yes / no // yes / no defaults to no; declared for demonstration, not yet used by the app
   Documents (relation Documents, auto-delete) // deleting this owner also deletes its related Documents

   // Blank line between properties and modifiers
   index CreatedAt // index is declared separately
   order by CreatedAt // default order, defaults to asc
}

data Documents / Document {
   Title text
   Body text (default "")
   Final yes / no Draft // yes/no accepts an optional no-case alias name
   Public yes / no Private (default Public) // yes/no also accepts default; demonstrative, not yet used
   CreatedAt time (default now)
   Workspace (relation Workspace) // `on delete ..` etc are modifications
   Paragraphs (auto-delete) // `relation ...` is optional if the name matches a data declaration.
   index CreatedAt
   order by CreatedAt
}

data Paragraphs / Paragraph {
   Text text
   Ordering number
   Document // `relation ...` is optional if the name matches a data declaration
   index Ordering
   order by Ordering
}

let Tagline = "A quiet place for words that matter."

type PromptTitle is text

type PromptMinutes is number

type PromptTags is list

type WritingPrompt is {
   PromptTitle
   PromptMinutes
   PromptTags
}

// Typed constructors keep their value-literal form; item fields follow the same argument decisions
// as invocations: `Field: value` labels a field, and an unlabeled typed value binds by type.
let StarterTags = PromptTags ["daily", "warmup"] // list items are comma separated
let StarterPrompt = WritingPrompt {
   PromptTitle: "Morning pages"
   PromptMinutes: 10
   StarterTags // unlabeled: binds the PromptTags field by type
}

function DocumentLabel Title is text returns text = "Document: { Title }"

// `ui` is content that can enter the app's presentation tree; `view` stays embeddable content.
// There is no separate destination list: presenting a `ui` is the whole navigation contract.
ui WorkspaceList {
   state WorkspaceName = ""
   query Workspaces { // `<Name from>` is omitted: a query binds its source's name. `query Workspaces as ArchivedWorkspaces { ... }` would also work
   // order by CreatedAt asc // can be omitted bc it's the entity's declared default order
   }
   action AddWorkspace {
      guard WorkspaceName empty -> { // a match runs its handler and skips the remainder of this action block
         // `present` is an invocation, so parentheses are always required, including with no arguments.
         // `as overlay` layers above the nearest enclosing nav rather than pushing into it.
         present WorkspaceNameNotice() as overlay
      }
      create Workspace {
         Name: WorkspaceName
      }
      set WorkspaceName = ""
   }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text("WordFlower")
      Text(Tagline)
      // In a render, a matched guard shows its handler and skips the remainder of its ENCLOSING BLOCK
      guard Workspaces {
         loading -> {
            Text("Loading workspaces…")
         }
         error -> Message {
            Text("Could not load WordFlower")
            Text(Message)
      }  }
      #workspaceName // Tags apply to the next view render
      // Arguments are comma-separated; `Name:` labels a parameter, and unlabeled values bind by type
      TextInput(Value: WorkspaceName, Label: "Workspace name", Placeholder: "Home") {
         // An explicit `on change` replaces the input's default update of its bound state
         on change -> NewWorkspaceName {
            set WorkspaceName = NewWorkspaceName
         }
         on submit AddWorkspace
      }
      Text(when WorkspaceName {
         empty -> "Workspace name is required"
         otherwise -> WorkspaceName
      })
      #addWorkspace
      FormButton("Add workspace", Disabled: WorkspaceName is empty) {
         on press AddWorkspace
      }
      #activateWorkspaceTab
      FormButton("Go to workspaces") {
         // Target-only activation: presenting a bare key reveals that item without new content
         on press -> {
            present WordFlower@workspace
      }  }
      guard Workspaces empty -> { // Guarding a single condition can be done without brackets `{ empty -> ... }`
         Text("No workspaces yet")
         Text("Create one to start capturing documents.")
         Text("Starter prompt: { StarterPrompt.PromptTitle }") // interpolation reaches custom item members
         Text("Try writing for { StarterPrompt.PromptMinutes } minutes")
         TagLine(StarterPrompt.PromptTags)
      }
      #workspaces
      loop Workspaces / Workspace { // `loop` binds each row by the provided singular name. In this case it's just `Workspace`, but it could be e.g `NewWorkspace`, etc
         Col() [gap 6, pad 10] {
            Text(Workspace.Name)
            #openWorkspace
            FormButton("Open workspace") {
               on press -> {
                  present WorkspaceDetail(Workspace)
               } // delivered to the nearest enclosing nav
            }
            #deleteWorkspace
            FormButton("Delete workspace") {
               on press -> {
                  delete Workspace
}  }  }  }  }  }

// Presented above the nearest nav; overlays stack above content and are dismissible
ui WorkspaceNameNotice {
   render Col() [gap 6, pad 10] {
      Text("A workspace needs a name")
      #dismissNotice
      FormButton("Dismiss") {
         on press -> {
            dismiss
         } // the nearest enclosing nav is the overlay host that presented this
}  }  }

// Visibility is `file` (the default, written by omission), `package`, `workspace`, or `public`.
// These replace the transitional `project` and `publish` words.
workspace ui WorkspaceDetail Workspace { // a bare parameter name binds the same-named entity type
   state WorkspaceNameDraft = Workspace.Name
   state DocumentTitle = ""
   let SectionLabel = "Drafts" // definition-level `let` bindings stay visible through the render tree
   action SaveWorkspace {
      guard WorkspaceNameDraft empty
      update Workspace {
         Name: WorkspaceNameDraft
   }  }
   action AddDocument {
      guard DocumentTitle empty
      create Document {
         Title: DocumentTitle
         Workspace // unlabeled arguments bind by type; the entity value matches the relation field
      }
      set DocumentTitle = ""
   }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text("Workspace: { Workspace.Name }")
      #workspaceTitle
      TextInput(Value: WorkspaceNameDraft, Label: "Workspace title", Placeholder: "Workspace title") {
         on submit SaveWorkspace
      }
      #saveWorkspace
      FormButton("Save workspace", Disabled: WorkspaceNameDraft is empty) {
         on press SaveWorkspace
      }

      // Queries can be inlined, but hook-like statements (state, query) must come before any
      // conditional in the definition body
      query Drafts from Workspace.Documents {
         where is Draft // filters by boolean case name, mirroring `update Document { Final }`. `is <yes/no>` evaluates to true or false.
      }
      query FinishedDocuments from Workspace.Documents {
         where is Final
      }
      Text("{ SectionLabel }: { Drafts.Count }")
      guard Drafts { // a guard takes exactly one subject; guard each query separately
         loading -> {
            Text("Loading documents…")
         }
         error -> Message {
            Text("Could not load documents: { Message }")
      }  }
      guard FinishedDocuments {
         loading -> {
            Text("Loading documents…")
         }
         error -> Message {
            Text("Could not load documents: { Message }")
      }  }
      #newDocumentTitle
      TextInput(Value: DocumentTitle, Label: "New document title", Placeholder: "Draft the next chapter") {
         // No `on change`: TextInput updates its bound state automatically; the default binding requires `Value:` to reference a writable state
         on submit AddDocument
      }
      when DocumentTitle {
         empty -> {
            Text("Document title is required")
         }
         otherwise -> {
            Text(DocumentTitle)
      }  }
      #addDocument
      FormButton("Add document", Disabled: DocumentTitle is empty) {
         on press AddDocument
      }
      when Drafts {
         empty -> {
            Text("No drafts")
         }
         otherwise -> {
            // A tagged loop can be selected by 1-based row index and then queried within:
            // #drafts[INDEX] { press #edit }
            #drafts
            loop Drafts / Document {
               Col() [gap 6, pad 10] {
                  Text(Document.Title)
                  #edit
                  FormButton("Open document") {
                     on press -> {
                        present DocumentScreen(Document)
                  }  }
                  #finish
                  FormButton("Finish document") {
                     on press -> {
                        update Document {
                           Final
                        }
                     } // boolean cases are written by name
                  }
                  #delete
                  FormButton("Delete document") {
                     on press -> {
                        delete Document
      }  }  }  }  }  }
      guard FinishedDocuments empty -> {
         Text("No finished documents")
      }
      Col() [gap 6] {
         let SectionLabel = "Finished" // a render-block `let` shadows the definition-level binding inside its block
         Text(SectionLabel)
         #finishedDocuments
         loop FinishedDocuments / Document {
            Col() [gap 6, pad 10] {
               Text(Document.Title)
               #reopen
               FormButton("Reopen document") {
                  on press -> {
                     update Document {
                        Draft
               }  }  }
               #deleteFinished
               FormButton("Delete finished document") {
                  on press -> {
                     delete Document
}  }  }  }  }  }  }

// The presented entry guards entity availability; the editor below assumes an available document.
workspace ui DocumentScreen Document {
   render Col() [fill] {
      guard Document {
         loading -> {
            Text("Loading document…")
         }
         missing -> {
            Text("Document { Document.Id } no longer exists.") // a handle keeps its Id after the row is gone
         }
         unauthorized -> {
            Text("You no longer have access to this document.")
         }
         error -> Message {
            Text("The document could not be loaded: { Message }")
      }  }
      DocumentEditor(Document)
}  }

workspace view DocumentEditor Document {
   state TitleDraft = Document.Title
   state BodyDraft = Document.Body
   state ParagraphText = ""
   state SaveCount = 0
   query Paragraphs from Document.Paragraphs { }
   action SetBodyDraft Value is text { // an action reference bound to an event receives the payload through its parameters
      set BodyDraft = Value
   }
   action SaveDocument {
      guard TitleDraft empty
      update Document {
         Title: TitleDraft
         Body: BodyDraft
      }
      set SaveCount += 1 // compound `set` composes with number state
      // A keyed toast replaces the previous occurrence with the same key instead of stacking.
      // Presentation modifiers go in parentheses, like data field modifiers.
      present SavedToast() as toast (Key: "document-saved", Duration: 3)
   }
   action AddParagraph {
      guard ParagraphText empty
      create Paragraph {
         Text: ParagraphText
         Ordering: Paragraphs.Count + 1
         Document
      }
      set ParagraphText = ""
   }
   action CloseDocument {
      // `ask` suspends this action until the dialogue responds; a bare `respond` answers none.
      // A one-sided test is `if`; it never takes `else`, so multi-outcome branching stays `when`.
      let Result = ask ConfirmCloseDialogue(Document)
      if Result is Confirmed {
         dismiss
   }  }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text(DocumentLabel(Document.Title)) [width fill]
      Text("Workspace: { Document.Workspace.Name }")
      #editDocumentTitle
      TextInput(Value: TitleDraft, Label: "Document title", Placeholder: "Document title") {
         on submit SaveDocument
      }
      #editDocumentBody
      // The body editor claims the column's leftover space
      TextInput(Value: BodyDraft, Label: "Document body", Placeholder: "Write the document body") [claim 2] {
         on change SetBodyDraft // an explicit action reference also replaces the input's default binding
         on submit SaveDocument
      }
      WordCount(BodyDraft)
      #saveDocument
      FormButton("Save document", Disabled: TitleDraft is empty) {
         on press SaveDocument
      }
      Text("Saved title: { Document.Title }")
      Text("Saved body: { Document.Body }")
      Text("Saves this session: { SaveCount }")
      Text("Paragraphs: { Paragraphs.Count }")
      #newParagraph
      TextInput(Value: ParagraphText, Label: "New paragraph", Placeholder: "Add a paragraph") {
         on submit AddParagraph
      }
      #paragraphs
      loop Paragraphs / Paragraph {
         Col() [gap 6, pad 10] {
            Text(Paragraph.Text)
      }  }
      #closeDocument
      FormButton("Close document") {
         on press CloseDocument
}  }  }

ui SavedToast {
   render Text("Saved")
}

// A dialogue is a ui presented for a typed answer; `ask` resumes with the response or none. Each
// ask is an independent stacked occurrence. Back or plain dismissal answers none before removal.
dialogue ConfirmCloseDialogue Document responds ConfirmResult {
   render Col() [gap 6, pad 10] {
      Text("Close { Document.Title }?")
      #confirmClose
      FormButton("Close") {
         on press -> {
            respond Confirmed
      }  }
      #cancelClose
      FormButton("Cancel") {
         on press -> {
            respond // bare respond answers none
}  }  }  }

ui WorkspaceChooser {
   query Workspaces { }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text("Choose a workspace")
      guard Workspaces empty -> {
         Text("No workspaces yet")
      }
      #chooseWorkspace
      loop Workspaces / Workspace {
         #choose
         FormButton(Workspace.Name) {
            on press -> {
               // A configured nav value locates its one equal active mount
               present WorkspaceDocuments(Workspace) in WorkspaceNav
}  }  }  }  }

workspace ui WorkspaceDocuments Workspace {
   query Documents from Workspace.Documents { }
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text("Documents in { Workspace.Name }")
      guard Documents empty -> {
         Text("No documents yet")
      }
      #workspaceDocuments
      loop Documents / Document {
         #openDocument
         FormButton(Document.Title) {
            on press -> {
               present DocumentScreen(Document)
}  }  }  }  }

ui Settings {
   render Col() [fill, content top stretch, gap 10, pad 16] {
      Text("Settings")
      #resetSignedOut
      FormButton("Reset to signed out") {
         on press -> {
            replace SignedOutNav in WordFlower
}  }  }  }

ui SignedOut {
   render Text("Signed out")
}

// Typed TS injection stays the permanent escape hatch for behavior Tao does not own.
view WordCount Value is text {
   render inject Value ```ts
      return <RN.Text>Words: {Value.trim() === '' ? 0 : Value.trim().split(/\s+/).length}</RN.Text>
   ```
}

view TagLine Tags is list {
   render inject Tags ```ts
      return <RN.Text>Tagged: {Tags.join(', ')}</RN.Text>
   ```
}

// Deterministic in-between harness for the first navigation foundation slice. Product syntax is
// still decided in this file; the harness keeps foundation acceptance independent of full WordFlower.
let FoundationStack = StackNav {
   Initial FoundationHome
}
let FoundationNavigator = SlotNav {
   Initial FoundationStack
}

ui FoundationHome {
   render Col() {
      Text("Foundation home marker")
      FormButton("Open deterministic detail") {
         on press -> {
            present FoundationDetail()
      }  }
      FormButton("Open deterministic slot") {
         on press -> {
            present FoundationSlot() in FoundationNavigator
}  }  }  }

ui FoundationDetail {
   render Col() {
      Text("Foundation detail marker")
      FormButton("Reset foundation app") {
         // `replace <nav> in <App>` swaps the app's root content; it is the only root operation an app accepts
         // Replacement is contextual and is valid only from inside a visual declaration.
         on press -> {
            replace FoundationNavigator in WordFlowerFoundationTest
}  }  }  }

ui FoundationSlot {
   render Col() {
      Text("Foundation slot marker")
      FormButton("Restore initial stack") {
         on press -> {
            dismiss
         } // dismissing a SlotNav's presented content restores its Initial
}  }  }
