use Interval from @tao/time
use Col, FormButton, Text from @tao/ui

// A focused writing session: pick a length, write until the clock runs out, pause and resume, or
// stop early. The clock is a library value — `Interval` ticks every second from mount to unmount —
// and `Left` is an ordinary derivation that recomputes on every tick.
folder
view FocusSession() {
   state Tick = Interval(1.s)
   state EndsAt = now
   state Focusing = false
   let Left = EndsAt - Tick.Value
   action Start(Length duration) {
      set EndsAt = now + Length
      set Focusing = true
      do Tick.Start()
   }
   // Pausing stops the tick, which freezes `Left`; resuming re-anchors the deadline to the frozen
   // remainder, so paused time is not lost.
   action Pause() {
      do Tick.Stop()
   }
   action Resume() {
      set EndsAt = now + Left
      do Tick.Start()
   }
   action Finish() {
      set Focusing = false
   }
   render Col() [gap 6] {
      when Focusing {
         true -> {
            Text(when Left > 0 Left.Clock / not "Time's up") [title]
            when Tick.Running {
               true -> {
                  #pauseFocus
                  FormButton("Pause") {
                     on press Pause
               }  }
               otherwise -> {
                  #resumeFocus
                  FormButton("Resume") {
                     on press Resume
            }  }  }

            #stopFocus
            FormButton("Stop") {
               on press Finish
         }  }
         otherwise -> {
            Text("Focused writing") [title]

            #focusFive
            FormButton("Focus for 5 min") {
               on press -> { do Start(5.min) }
            }

            #focusTwentyFive
            FormButton("Focus for 25 min") {
               on press -> { do Start(25.min) }
}  }  }  }  }
