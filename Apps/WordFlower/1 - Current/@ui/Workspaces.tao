use Documents, Duplicate, Finish, Workspaces from @data
use SlotNav from @tao/nav
use Join from @tao/text
use Box, Col, Image, Panes, Problems, Row, ScrollView, Text, TextInput, TextMultiline from @tao/ui
use FormButton from @tao/ui/basic
use DocumentScreen from ./

type PromptTitle is text

type PromptMinutes is number

type PromptTags is list of text

workspace
nav WorkspaceNav = SlotNav {
   Initial WorkspaceChooser
}

// Primitive-rooted types remain scalar values and may not add supplied per-value fields that change
// the primitive representation.
type WritingPrompt is {
   PromptTitle,
   PromptMinutes,
   PromptTags,
   PromptSubtitle text? // an item field may be absent; reading it yields `none`
}

// A projection selects the fields a form edits and carries their `required` sentences, so the form
// knows it is unfinished before any row exists.
type WorkspaceInput is Workspace { Name }

// The workspace area. Every renderable declaration is a `view`; whether one composes inline in a
// render tree or enters the presentation tree is decided at each use site, never on the head.
workspace
scene WorkspaceList() {
   Title "WordFlower"
   state Input = WorkspaceInput {
      Name: ""
   }
   query Workspaces = Workspaces with { }
   action AddWorkspace() {
      if Input.Incomplete {
         present WorkspaceNameNotice() as overlay
      }
      check not Input.Incomplete // a false check skips the rest of this action
      create Workspace with Input
      set Input = WorkspaceInput {
         Name: ""
   }  }
   // `ScrollView` scrolls its content; `width max` keeps a readable column on a wide screen, and
   // `centered` places that column in the middle of the available space.
   render ScrollView() [screen] {
      Col() [workspaceWidth, centeredLayout, gapSection] {
         Col() [hero] {
            Text("YOUR WRITING HOME") [eyebrow]
            Text("WordFlower") [display]
            TextMultiline(WordFlowerTagline) [body]
         }
         // The home screen titles its own load failure; loading goes to the app's read net.
         guard Workspaces {
            error -> Message {
               Text("Could not load WordFlower") [title]
               TextMultiline(Message) [body]
         }  }
         Panes() [gapWide] {
            Col() [panel] {
               Text("CREATE A SPACE") [eyebrow]
               Text("Begin somewhere quiet") [sectionTitle]
               TextMultiline("Give this collection a name. You can change it whenever the writing takes a new shape.") [body]

               #workspaceName
               TextInput(Value: Input.Name, Label: "Workspace name", Placeholder: "Home") {
                  on change -> NewWorkspaceName { // an explicit handler replaces the default binding
                     set Input.Name = NewWorkspaceName
                  }
                  on submit AddWorkspace
               }
               // The unfinished fields' `required` sentences, and nothing once the input is complete.
               Problems(Input.Problems) [validation]

               #addWorkspace
               FormButton("Add workspace", Disabled: Input.Incomplete) {
                  on press AddWorkspace
               }

               #activateWorkspaceTab
               FormButton("Browse all workspaces") [buttonSecondary] {
                  on press -> { // target-only activation reveals an item without new content
                     present @workspace
            }  }  }
            Col() [panel] {
               Text("YOUR LIBRARY") [eyebrow]
               Text("Recent workspaces") [sectionTitle]
               TextMultiline("Open a writing space or clear one you no longer need.") [body]
               guard Workspaces empty -> { NoWorkspacesYet() }

               #workspaces
               loop Workspaces / Workspace {
                  WorkspaceRow(Workspace)
                  on select -> { present WorkspaceDetail(Workspace) }
}  }  }  }  }  }

// Presented above the nearest nav; overlays stack above content and are dismissible.
view WorkspaceNameNotice() {
   render Col() [panel, formWidth] {
      Text("A workspace needs a name") [sectionTitle]
      TextMultiline("Add a short name before creating this writing space.") [body]

      #dismissNotice
      FormButton("Dismiss") {
         on press -> { dismiss }
}  }  }

scene WorkspaceDetail(Workspace) { // a bare parameter name binds the same-named entity type
   Title Workspace.Name
   state WorkspaceNameDraft = Workspace.Name
   state DocumentTitle = ""
   state Find = ""
   // `search` keeps the rows whose `(search)` fields match the term the way keyboard narrowing
   // does, word prefixes in order; a blank term keeps every row.
   query Drafts = Workspace.Documents with {
      where is Draft // filters by boolean case name, mirroring `update Document { Final }`
      search Find
   }
   query FinishedDocuments = Workspace.Documents with {
      where is Final
      search Find
   }
   action SaveWorkspace() {
      check WorkspaceNameDraft is not empty
      update Workspace {
         Name: WorkspaceNameDraft
   }  }
   // A command is the discoverable verb and the action is the private procedure behind it, so the
   // name a person reads lives on the command. This one is declared in the scene because it reads
   // and resets that scene's own state, exactly as an `action` may.
   command Save() {
      Title "Save workspace"
      Icon "checkmark"
      Enabled WorkspaceNameDraft is not empty
      do SaveWorkspace()
   }
   Toolbar { Save }
   action AddDocument() {
      check DocumentTitle is not empty
      create Document {
         Title: DocumentTitle
         Workspace // unlabeled arguments bind by type; the entity matches the relation field
      }
      set DocumentTitle = ""
   }
   render ScrollView() [screen] {
      Col() [workspaceWidth, centeredLayout, gapSection] {
         Col() [hero] {
            Text("WORKSPACE") [eyebrow]
            Text(Workspace.Name) [display]
            TextMultiline("Workspace: { Workspace.Name }") [caption]
            TextMultiline("Shape the space, then keep the words moving.") [body]
         }
         // A guard takes exactly one subject; a bare guard sends every exceptional case to the net.
         guard Drafts
         guard FinishedDocuments
         Panes() [gapWide] {
            Col() [panel] {
               Text("WORKSPACE DETAILS") [eyebrow]
               Text("Name this space") [sectionTitle]

               #workspaceTitle
               TextInput(Value: WorkspaceNameDraft, Label: "Workspace title", Placeholder: "Workspace title") {
                  on submit SaveWorkspace
               }

               #saveWorkspace
               FormButton("Save workspace", Disabled: WorkspaceNameDraft is empty) {
                  on press SaveWorkspace
            }  }
            Col() [panel] {
               Text("NEW DOCUMENT") [eyebrow]
               Text("Start the next page") [sectionTitle]

               #newDocumentTitle
               TextInput(Value: DocumentTitle, Label: "Document title", Placeholder: "Draft the next chapter") {
                  on submit AddDocument
               }
               when DocumentTitle {
                  empty -> { Text("Document title is required") [validation] }
                  otherwise -> { TextMultiline("Ready to write { DocumentTitle }") [caption] }
               }

               #addDocument
               FormButton("Add document", Disabled: DocumentTitle is empty) {
                  on press AddDocument
         }  }  }

         #findDocuments
         TextInput(Value: Find, Label: "Find in this workspace", Placeholder: "Title or words") {
            on submit -> { } // the lists narrow as the term changes; there is nothing to submit
         }
         // `Panes` lays its children side by side when the container is wide enough and stacks them
         // otherwise. Children size themselves with the ordinary layout clauses.
         Panes() [gapWide] {
            Col() [panel] {
               Text("DRAFTS") [eyebrow]
               Text("Drafts: { Drafts.Count }") [sectionTitle]
               guard Drafts empty -> { TextMultiline("No drafts") [body] }
               // A tagged list can be selected by 1-based row index: #drafts[INDEX] { press #edit }
               #drafts
               loop Drafts / Document {
                  DraftRow(Document)
            }  }
            Col() [panel] {
               Text("ARCHIVE") [eyebrow]
               Text("Finished") [sectionTitle]
               guard FinishedDocuments empty -> { TextMultiline("No finished documents") [body] }

               #finishedDocuments
               loop FinishedDocuments / Document {
                  FinishedRow(Document)
}  }  }  }  }  }

workspace
view WorkspaceChooser() {
   query Workspaces = Workspaces with { }
   render Col() [screen, readableWidth, centeredLayout, gapWide] {
      Col() [hero] {
         Text("YOUR LIBRARY") [eyebrow]
         Text("Choose a workspace") [display]
         TextMultiline("Pick up where you left off.") [body]
      }
      guard Workspaces empty -> { TextMultiline("No workspaces yet") [body] }
      // A loop with `on select` makes each row selectable. Its singular name scopes both the template and
      // `on select`, so a selectable collection needs no stdlib List or per-row button.
      #chooseWorkspace
      loop Workspaces / Workspace {
         Text(Workspace.Name) [card, sectionTitle]
         on select -> { present WorkspaceDocuments(Workspace) in WorkspaceNav }
}  }  }

view WorkspaceDocuments(Workspace) {
   query Documents = Workspace.Documents with { }
   render Col() [screen, readableWidth, centeredLayout, gapWide] {
      Col() [hero] {
         Text("{ Workspace.Name }") [eyebrow]
         Text("Documents in { Workspace.Name }") [display]
      }
      guard Documents empty -> { TextMultiline("No documents yet") [body] }

      #workspaceDocuments
      loop Documents / Document {
         Col() [card] {
            Text(Document.Title) [sectionTitle]
            // The list mixes drafts and finished work, so each row says which it is.
            if Document.Final is Final {
               StatusBadge("Final", Tint: accent)
            }
            if Document.Final is Draft {
               StatusBadge("Draft")
         }  }
         on select -> { present DocumentScreen(Document) }
}  }  }

// A status label led by a dot in the caller's color. The dot sits inside the badge, where a caller's
// clauses cannot reach, so its color travels as a `color` value; the default keeps the common case
// short. `background Tint` reads the value because a Capitalized word in a clause list is a value.
view StatusBadge(Label text, Tint color default inkMuted) {
   render Row() [gapSmall] {
      Box() [statusDot, background Tint]
      Text(Label) [caption]
}  }

let WordFlowerTagline = "A quiet place for words that matter."

// Typed constructors keep their value-literal form; item fields follow the same argument decisions
// as invocations: `Field: value` labels a field, and an unlabeled typed value binds by type.
let StarterTags = PromptTags ["daily", "warmup"]
let StarterPrompt = WritingPrompt {
   PromptTitle: "Morning pages"
   PromptMinutes: 10
   StarterTags // unlabeled: binds the PromptTags field by type
   // PromptSubtitle is optional and omitted here
}

view TagSummary(Tags PromptTags) {
   render TextMultiline("Tagged: { Join(Tags, Separator: ", ") }") [body]
}

// Shown while the library is empty: what WordFlower is for, and something to start from.
view NoWorkspacesYet() {
   render Col() [subtlePanel] {
      // A decorative image needs no accessibility label. This tranche represents assets as text
      // paths.
      Image("./images/empty-workspaces.png", Decorative: true) [illustrationWidth, centeredLayout]
      Text("No workspaces yet") [sectionTitle]
      TextMultiline("Create one to start capturing documents.") [body]
      TextMultiline("Starter prompt: { StarterPrompt.PromptTitle }") [body]
      TextMultiline("Try writing for { StarterPrompt.PromptMinutes } minutes") [body]
      TagSummary(StarterPrompt.PromptTags)
}  }

// One row of the workspace library. Presenting is legal in any view body, so the row opens its own
// workspace instead of receiving an `Open action()` from the screen that lists it. The card look is
// the row's public default, declared in the header so a list may override it.
workspace
view WorkspaceRow(Workspace) [card] {
   render Col() {
      Text(Workspace.Name) [sectionTitle]
      TextMultiline("A quiet place to collect drafts and finished work.") [caption]

      #deleteWorkspace
      FormButton("Delete workspace") [buttonDanger] {
         on press -> { delete Workspace }
      }

      #openWorkspace
      FormButton("Open workspace") {
         on press -> { present WorkspaceDetail(Workspace) }
}  }  }

// One unfinished document: open it, finish it, or discard it.
view DraftRow(Document) [card] {
   Commands { Finish }
   hide Duplicate
   render Col() {
      Text(Document.Title) [sectionTitle]

      #edit
      FormButton("Open document") {
         on press -> { present DocumentScreen(Document) }
      }

      #finish
      FormButton("Finish document") [buttonSecondary] {
         // Invoking a command reads like invoking an action, so the row and any other surface that
         // offers Finish run one declared verb rather than two copies of
         // the write.
         on press -> { do Finish(Document) }
      }

      #delete
      FormButton("Delete document") [buttonDanger] {
         on press -> { delete Document }
}  }  }

// One finished document: reopen it or discard it.
view FinishedRow(Document) {
   Commands { Duplicate }
   hide Finish
   render Col() [card] {
      Text(Document.Title) [sectionTitle]

      #reopen
      FormButton("Reopen document") [buttonSecondary] {
         on press -> { update Document {
            Draft
         } }
      }

      #deleteFinished
      FormButton("Delete finished document") [buttonDanger] {
         on press -> { delete Document }
}  }  }
