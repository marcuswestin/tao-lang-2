use Document, Finish, Paragraph from @data
use CountWords from @tao/text
use Checkbox, Col, Panes, Problems, Progress, Row, ScrollView, Spacer, Text, TextInput, TextMultiline from @tao/ui
use FormButton from @tao/ui/basic

// Shared values, types, and the typed-injection escape hatch.
// This one-case enum is deliberate: `ConfirmResult` is a nominal type, `Confirmed` is its one
// value, and a dismissed responder answers `none` rather than requiring a second enum case.
type ConfirmResult is one of Confirmed

type ExportFailure is one of Offline, TooLarge, Cancelled

// A phrase is named copy: its plural forms choose by the count, so the outline never reads
// "1 paragraphs".
phrase ParagraphCount(Count number) = one "{ Count } paragraph" / other "{ Count } paragraphs"

// The document area: an availability-guarded entry, the editor itself, and the close conversation.
// The presented entry guards entity availability; the editor below assumes an available document.
project
scene DocumentScreen(Document) {
   command Export() {
      Title "Export document"
      Description "Shares the saved document as Markdown."
      Icon "square.and.arrow.up"
      do -> { present ExportPanel(Document) as sheet }
   }
   Title Document.Title
   Toolbar { Finish, Export }
   render Col() [grow] {
      // The screen names the one case it words itself; loading, unauthorized, and error go to the net.
      guard Document {
         none -> {
            TextMultiline("Document { Document.Id } no longer exists.") [body] // a handle keeps its Id
      }  }
      DocumentEditor(Document)
}  }

// Typed TS injection also stays the permanent escape hatch for rendering Tao does not own.
view WordCountLabel(Value text) {
   render TextMultiline("Words: { CountWords(Value) }") [body]
}

type DocumentInput is Document { Title, Body }

// The TypeScript sidecar hands a Markdown copy to the platform share sheet. The app records the
// failure cases here so an export site can distinguish a missing connection from other rejections.
project
action ExportDocument(Document) fails Offline "Exporting needs a connection." fails TooLarge "This document is too long to export." fails Cancelled "" from ./Export.ts

view ExportPanel(Document) {
   action RunExport() {
      when do ExportDocument(Document) {
         saved -> { present ExportNotice("Ready to share") as toast (Key: "document-export", Duration: 3.s) }
         Offline -> { present ExportNotice("Exporting needs a connection.") as toast (Key: "document-export", Duration: 5.s) }
         Cancelled -> { }
         rejected -> Problem { present ExportNotice(Problem) as toast (Key: "document-export", Duration: 5.s) }
         error -> Message { present ExportNotice(Message) as toast (Key: "document-export", Duration: 5.s) }
   }  }
   render Col() [panel, formWidth] {
      Text("Export { Document.Title }") [sectionTitle]
      TextMultiline("Share a Markdown copy of the saved document.") [body]

      #export
      FormButton("Share Markdown") {
         on press RunExport
      }

      #closeExport
      FormButton("Close") [buttonSecondary] {
         on press -> { dismiss }
}  }  }

view ExportNotice(Message text) {
   render TextMultiline(Message) [body]
}

view DocumentEditor(Document) {
   state Input = copy Document as DocumentInput
   state ParagraphText = ""
   state DetachedParagraphText = ""
   state SaveCount = 0
   state PreviousTitle = ""
   state PreviousBody = ""
   query Paragraphs = Document.Paragraphs with { }
   action SetFinished(Value boolean) {
      // A yes/no field takes the boolean directly; naming the field writes the pole it selects.
      update Document {
         Final: Value
   }  }
   action SaveDocument() {
      check not Input.Incomplete // the projection carries Title's `required` sentence
      set PreviousTitle = Document.Title
      set PreviousBody = Document.Body
      update Document with Input
      set SaveCount += 1
      // A keyed toast replaces the previous occurrence with the same key instead of stacking. An
      // ephemeral presentation may take a non-serializable parameter: the toast receives the revert
      // action for the very save it announces, reading the values captured above.
      present SavedToast(Revert: -> {
         update Document {
            Title: PreviousTitle,
            Body: PreviousBody
         }
         set Input.Title = PreviousTitle
         set Input.Body = PreviousBody
      }) as toast (Key: "document-saved", Duration: 3.s)
   }
   action AddParagraph() {
      check ParagraphText is not empty
      // `async` starts as a later root, so capture the submitted value before clearing the input.
      // A failed detached write enters the datasource error state.
      set DetachedParagraphText = ParagraphText
      async {
         create Paragraph {
            Text: DetachedParagraphText,
            Ordering: Paragraphs.Count + 1,
            Document
      }  }
      set ParagraphText = ""
   }
   action CloseDocument() {
      // `ask` suspends this action until the presented view responds; a bare `respond` answers none.
      let Result = ask ConfirmCloseDialogue(Document)
      if Result is Confirmed {
         dismiss
   }  }
   // Editing and the paragraph outline sit side by side on a wide screen and stack on a narrow one.
   render Panes() [screen, gapWide] {
      ScrollView() [claimDouble] {
         Col() [readableWidth, panel] {
            Text("DOCUMENT") [eyebrow]
            Text(DocumentLabel(Document.Title)) [display]
            TextMultiline("Workspace: { Document.Workspace.Name }") [body]

            #editDocumentTitle
            TextInput(Value: Input.Title, Label: "Document title", Placeholder: "Document title") {
               on submit SaveDocument
            }
            Problems(Input.Problems) [validation]

            #editDocumentBody
            TextInput(Value: Input.Body, Label: "Document body", Placeholder: "Write the document body") [claimDouble] {
               on submit SaveDocument
            }
            WordCountLabel(Input.Body)

            #focusSession
            FocusStarter()

            #markFinal
            Checkbox(Value: Document.Final is Final, Label: "Final") {
               on change SetFinished
            }

            #saveDocument
            FormButton("Save document", Disabled: Input.Incomplete) {
               on press SaveDocument
            }
            TextMultiline("Saved title: { Document.Title }") [body]
            TextMultiline("Saved body: { Document.Body }") [body]
            TextMultiline("Saves this session: { SaveCount }") [body]
            if Document.WritesFailed > 0 {
               TextMultiline(Document.WriteError) [body]
               if Document.CanRetryWrites {
                  #retryDocument
                  FormButton("Retry submitted write") {
                     on press -> { retry Document }
            }  }  }
            if Document.WritesQueued > 0 {
               TextMultiline("Waiting to sync") [body]
            }

            #closeDocument
            FormButton("Close document") [buttonSecondary] {
               on press CloseDocument
      }  }  }
      Col() [panel] {
         Text("OUTLINE") [eyebrow]
         Text(ParagraphCount(Paragraphs.Count)) [sectionTitle]
         guard Paragraphs

         // `Progress` takes a fraction between 0 and 1.
         Progress(Value: GoalFraction(Paragraphs.Count))
         TextMultiline("Goal: { ParagraphGoal } paragraphs") [body]

         #newParagraph
         TextInput(Value: ParagraphText, Label: "New paragraph", Placeholder: "Add a paragraph") {
            on submit AddParagraph
         }

         #paragraphs
         loop Paragraphs / Paragraph {
            Col() [card] {
               TextMultiline(Paragraph.Text) [body]
}  }  }  }  }

project
view SavedToast(Revert action()) {
   render Row() [gapMedium] {
      Text("✓") [width 20, height 20]
      TextMultiline("Saved") [body]
      Spacer()

      #revertSave
      FormButton("Revert") [buttonSecondary] {
         on press Revert
}  }  }

// A view with `responds T` is presented for a typed answer; `ask` resumes with the response or
// none. Each ask is an independent stacked occurrence. Back or plain dismissal answers none before
// removal.
view ConfirmCloseDialogue(Document) responds ConfirmResult {
   render Col() [panel, formWidth] {
      Text("Close { Document.Title }?") [sectionTitle]
      TextMultiline("Your latest unsaved changes will stay in this session until you return.") [body]

      #confirmClose
      FormButton("Close") [buttonDanger] {
         on press -> { respond Confirmed }
      }

      #cancelClose
      FormButton("Cancel") [buttonSecondary] {
         on press -> {
            respond // bare respond answers none
}  }  }  }

// A writing session's goal, used by the editor's progress indicator.
let ParagraphGoal = 10

// A function body is a block and hands its result back with `return`, so an early return can
// take a guard's place. `-> <type>` is optional and inferred when omitted.
func DocumentLabel(Title text) -> text {
   return "Document: { Title }"
}

// A fraction between 0 and 1 for `Progress`.
func GoalFraction(Count number) {
   if Count == 0 {
      return 0
   }
   return Count / ParagraphGoal
}
