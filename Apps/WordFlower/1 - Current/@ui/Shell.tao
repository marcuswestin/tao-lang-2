use FocusSessions from @data
use StackNav from @tao/nav
use Col, Row, Text, TextMultiline from @tao/ui
use FormButton from @tao/ui/basic

// The shell: the navigator and the focus bar, laid out as ordinary content. A nav renders like any
// other view -- `nav is scene is view` -- so persistent chrome around navigated content is a `Col`,
// not a navigation kind. The navigator arrives as a parameter, which is how one shell serves every
// preview variant. The bar is conditional on the data; the navigator never is, because its history
// lives on its mount and a branch that unmounted it would drop where the person was.
workspace
scene WordFlowerShell(Navigator nav) {
   query FocusSessions as CurrentSession {
      limit 1
   }
   render Col() [fill] {
      Navigator() [fill]
      when CurrentSession {
         empty -> { }
         otherwise -> { FocusBar() }
}  }  }

// The screens the app shell mounts directly.
workspace
scene Settings() {
   Title "Settings"
   render Scroller() [screen] {
      Col() [readableWidth, centeredLayout, gapWide] {
         Col() [hero] {
            Text("WORDFLOWER") [eyebrow]
            Text("Settings") [display]
            TextMultiline("A few quiet controls for the way you write.") [body]
         }
         Card(Title: "Writing session") {
            WordBadge(SessionGoal)
            Collapsible() {
               TextMultiline("Build { BuildStamp }") [body] // a typed injected value, not a render
            }
            @actions FormButton("Reset to signed out") [buttonDanger] {
               #resetSignedOut
               on press -> { replace SignedOutNav in app }
}  }  }  }  }

workspace
scene SignedOut() {
   Title "Signed out"
   render Col() [screen, centeredLayout] {
      Text("Signed out") [title]
}  }

nav SignedOutNav = StackNav {
   Initial SignedOut
}

// `is` narrows, `=` binds. An ascribed binding keeps the `let` column while naming the type it must
// satisfy; `ParagraphGoal` above demonstrates the equivalent inferred form without the constraint.
let SessionGoal is number = 10

// `<expression> from <path>` reaches TypeScript from any expression position. The names in the
// expression are the sidecar's named exports, and the ascribed type is the contract they must meet.
let BuildStamp is text = BuildStamp() from ./Shell.ts

// Content acceptance is inferred from the body, never declared: a view accepts caller content iff
// it places `@@content`. The simplest case places caller content directly.
view Toolbar() {
   render Row() [gapSmall, alignRight] {
      @@content
}  }

// A view surrounds caller content with its own fixed siblings. Putting `@@content` inside an
// explicit inner host means caller layout applies to the caller's children rather than to the
// wrapper's own structure. `@actions` is a named slot with a default, so callers may omit it.
//
// The header clause is the card's public surface: its padding and panel look are defaults a caller
// may replace or clear (`Card("…") [pad none, border none]`), while the root's own `gapSmall` is
// private to the card's structure.
view Card(Title text) [padMedium, panel] {
   @actions = empty
   render Col() [gapSmall] {
      // The title claims the row and compresses: a card action sits beside a heading that is as
      // long as the writer's own words, and on a phone the two do not both fit at their natural
      // widths. Without this the heading keeps its width and both run off the card.
      Row() [spreadCenter] {
         Text(Title) [title, claim 1, compress]
         @actions
      }
      Col() [gapTight] {
         @@content
}  }  }

// A stateful content-accepting wrapper, which the retired frame/layout statelessness ladder could
// not express. `@@content` placement may be conditional: at most one placement renders, and while
// its branch is off the caller's content does not mount.
view Collapsible() {
   state Expanded = true
   render Col() [gapTight] {
      when Expanded {
         true -> {
            #collapseDetails
            FormButton("Hide details") [buttonSecondary] {
               on press -> { set Expanded = false }
            }
            @@content
         }
         otherwise -> {
            #expandDetails
            FormButton("Show details") [buttonSecondary] {
               on press -> { set Expanded = true }
}  }  }  }  }

// `TR`, `RN`, and `process` are always in scope inside injected TypeScript. The inject list names
// every additional binding received from Tao: no `_ViewProps`, no `_tao`, and no compiler-prefixed
// name of any kind. Each entry is `<Name> <value>`, and a bare name is shorthand for binding a
// property under its own name. Literal values and ambient channels are ordinary expressions in
// that position. This retires the implicit props bag across Tao, stdlib included.
//
// Three ambient channels are exposed, which is what a non-stdlib implementation needs to cover its
// cases: `@@content` is caller content, `@@layout` is the layout resolved for this occurrence
// including the parent direction it lays out against, and `@@tag` is the call site's test tag.
// Everything else Tao propagates today — navigation, response, app, caller inheritance — stays
// private and travels on its own, so a hand-written implementation never touches it.
view WordBadge(Total number) {
   render inject Total, Suffix " words", Layout @@layout, Tag @@tag ```ts
      return TR.Views.Text({ children: [`${Total}${Suffix}`], layout: Layout, tag: Tag })
   ```
}

// A TypeScript-backed container accepts caller content the same way: naming `@@content` in its
// inject list is the placement that makes it content-accepting. The value of `render inject` is the
// view's root element: Tao wraps nothing around it. Applying `Layout` and `Tag` is therefore the
// implementation's job, as is rendering `Content` exactly once, and Tao checks none of it.
//
// `Content` is opaque: it may be placed anywhere, but it is not a collection to inspect, map over,
// or take apart. The compiled shape of caller content is not a public interface.
view Scroller() {
   render inject Content @@content, Layout @@layout, Tag @@tag ```ts
      return TR.Views.View({
        children: <RN.ScrollView contentContainerStyle={{ flexGrow: 1 }}>{Content}</RN.ScrollView>,
        layout: Layout,
        tag: Tag,
      })
   ```
}
