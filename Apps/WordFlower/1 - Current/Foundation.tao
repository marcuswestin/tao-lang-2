use SlotNav, StackNav from @tao/nav
use Col, FormButton, Text from @tao/ui
use WordFlowerFoundationTest from ./

// A deterministic navigation harness. It keeps stack, slot, and root-replacement acceptance
// independent of the product app, its data, and its design.
// One complete type and four equivalent value spellings make the declaration/refinement contract
// executable. `FoundationHomeStack` is the rare type declaration; each value below has that same
// precise inferred type and the same configured behavior. The primitive `nav` head adds a family
// constraint, while `let` infers it. A constructor block may expose or omit the core `with` without
// changing the result.
workspace type FoundationHomeStack is StackNav with {
   Initial is FoundationHome
}

workspace nav FoundationStack = FoundationHomeStack { }

workspace nav FoundationStackWith = FoundationHomeStack with { }

workspace let FoundationStackLet = FoundationHomeStack { }
workspace let FoundationStackLetWith = FoundationHomeStack with { }

workspace nav FoundationNavigator = SlotNav {
   Initial FoundationStack
}

ui FoundationHome() {
   render Col() {
      Text("Foundation home marker")
      FormButton("Open deterministic detail") {
         on press -> {
            present FoundationDetail()
      }  }
      FormButton("Open deterministic slot") {
         on press -> {
            present FoundationSlot() in FoundationNavigator
}  }  }  }

ui FoundationDetail() {
   render Col() {
      Text("Foundation detail marker")
      FormButton("Reset foundation app") {
         // `replace <nav> in <App>` swaps the app's root content; it is the only root operation an
         // app accepts, it names the app declaration, and it is valid only inside a visual
         // declaration.
         on press -> {
            replace FoundationNavigator in WordFlowerFoundationTest
}  }  }  }

ui FoundationSlot() {
   render Col() {
      Text("Foundation slot marker")
      FormButton("Restore initial stack") {
         on press -> {
            dismiss
         } // dismissing a SlotNav's presented content restores its Initial
}  }  }
