// Scratch contract for `@tao/time`; it graduates to `packages/stdlib/@tao/time/Time.tao` with its
// sidecar `Time.ts` at absorption.

// A ticker is a reactive library value: `Value` is the time as of the latest tick, `Running`
// whether it ticks, and `Start()` and `Stop()` control it. It starts when the view that holds it
// mounts and stops when that view unmounts; `Start()` on a running ticker and `Stop()` on a stopped
// one do nothing.
public
type Ticker is {
   Value time
   Running boolean
   Start action()
   Stop action()
}

// `Interval(Every)` constructs a ticker that ticks every `Every`. The lowering is the obvious one —
// an interval timer plus a state update per tick — reached through the expression-position `from`
// (§15), which is the whole bridge: no clock grammar enters the language.
public
function Interval(Every duration) returns Ticker {
   return Interval(Every) from ./Time.ts
}
