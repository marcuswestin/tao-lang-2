// The data catalog used by the app's Local datasource.

workspace data Workspaces / Workspace { // the plural collection, then the singular entity it stores
   Name text
   // Modifiers take values: `now` is a runtime default sampled separately for each create.
   CreatedAt time (default now)
   Pinned yes / no // without an explicit default, a yes/no field defaults to no
   Documents (relation Documents, auto-delete) // deleting this owner also deletes its Documents

   index CreatedAt
   order by CreatedAt
}

workspace data Documents / Document {
   Title text
   Body text (default "")
   Final yes / no Draft // an optional no-case alias name
   Public yes / no Private (default Public) // an explicit default may select either case
   CreatedAt time (default now)
   Workspace (relation Workspace)
   Paragraphs (auto-delete)

   index CreatedAt
   order by CreatedAt
}

workspace data Paragraphs / Paragraph {
   Text text
   Ordering number
   Document

   index Ordering
   order by Ordering
}
