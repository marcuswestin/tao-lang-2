use WordFlower from ./

test "WordFlower workspaces" {
   test "narrows, targets, and activates a workspace without Back disturbing attention" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      enter "Projects" into #workspaceName
      press #addWorkspace

      narrow "pro"
      expect focus region "WordFlower"
      expect target "Projects"
      // Targeting is free: narrowing to one row does not open it.
      expect navigation title "WordFlower"
      back
      expect focus region "WordFlower"
      expect target "Projects"
      press key "Enter"
      expect navigation title "Projects"
   }
   test "starts empty and keeps invalid creates inert" {
      run WordFlower
      expect navigation title "WordFlower"
      expect { // `expect { ... }` groups several assertions into one step
         text "WordFlower"
         text "No workspaces yet"
         text "Starter prompt: Morning pages"
         text "Try writing for 10 minutes"
         text "Tagged: daily, warmup"
         text "Workspace name is required"
      }
      expect #workspaceName {
         placeholder "Home"
         input value ""
      }
      press #addWorkspace // disabled while the draft is empty, so nothing happens
      expect missing text "A workspace needs a name"
      submit #workspaceName
      expect text "A workspace needs a name" // the empty-name guard presents an overlay notice
      press #dismissNotice
      expect missing text "A workspace needs a name"
      expect text "No workspaces yet"
   }
   test "uses live workspaces and preserves covered screen state" {
      run WordFlower
      enter "Home" into #workspaceName
      submit #workspaceName
      enter "Unsent workspace" into #workspaceName
      select #workspaces[1] { // `select` scopes steps to the tagged loop's 1-based row
         expect text "Home"
         expect label "Home" // the row is named by `Text(Workspace.Name)`, its `(title)` field
         press #openWorkspace
      }
      expect navigation title "Home"
      expect text "Workspace: Home"
      expect #workspaceTitle input value "Home"
      enter "" into #workspaceTitle
      expect toolbar command "Save workspace" disabled
      submit #workspaceTitle
      expect text "Workspace: Home"
      enter "Renamed workspace" into #workspaceTitle
      expect toolbar command "Save workspace" enabled
      press toolbar command "Save workspace"
      expect navigation title "Renamed workspace"
      expect {
         text "Workspace: Renamed workspace"
         text "No drafts"
      }
      back
      expect navigation title "WordFlower"
      expect {
         text "WordFlower"
         text "Renamed workspace"
      }
      expect #workspaceName input value "Unsent workspace"
      expect missing text "Workspace: Renamed workspace"
   }
   test "shows drafts and finished documents in both panes" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      submit #newDocumentTitle
      expect text "No drafts"
      enter "Draft the intro" into #newDocumentTitle
      submit #newDocumentTitle
      // `Panes` stacks or sits side by side depending on width; both panes render either way.
      expect {
         text "Drafts: 1"
         text "Draft the intro"
         text "Finished"
         text "No finished documents"
      }
      // The row's label is derived from `Text(Document.Title)`, the `(title)` field it renders.
      // Its view promotes Finish, hides Duplicate, and the entity keeps Delete hidden by default,
      // so the exact verb list also proves both exclusions.
      narrow "draft the intro"
      expect target "Draft the intro"
      press key "."
      expect verbs "Finish document"
      press key "f"
      expect {
         text "Drafts: 0"
         text "No drafts"
      }
      select #finishedDocuments[1] {
         expect text "Draft the intro"
         press #reopen
      }
      expect {
         text "Drafts: 1"
         text "Draft the intro"
         text "No finished documents"
      }
      select #drafts[1] {
         press #finish
      }
      expect {
         text "Drafts: 0"
         text "No drafts"
      }
      select #finishedDocuments[1] {
         press #deleteFinished
      }
      expect text "No finished documents"
   }
   test "deletes related documents transitively with their workspace" {
      run WordFlower
      enter "Temporary" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Related draft" into #newDocumentTitle
      press #addDocument
      expect text "Related draft"
      back
      select #workspaces[1] {
         press #deleteWorkspace
      }
      expect text "No workspaces yet"
      enter "Replacement" into #workspaceName
      press "Add workspace" // visible-text presses remain alongside #tag selectors
      select #workspaces[1] {
         expect text "Replacement"
         press #openWorkspace
      }
      expect {
         missing text "Related draft"
         text "No drafts"
}  }  }
