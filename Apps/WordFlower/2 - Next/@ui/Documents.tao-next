use Documents, Paragraphs from @data
use CountWords from @tao/text
use Checkbox, Col, FormButton, Panes, Progress, Row, ScrollView, Spinner, Text, TextInput from @tao/ui

// Shared values, types, and the typed-injection escape hatch.
// This one-case enum is deliberate: `ConfirmResult` is a nominal type, `Confirmed` is its one
// value, and a dismissed responder answers `none` rather than requiring a second enum case.
type ConfirmResult is one of Confirmed

// The document area: an availability-guarded entry, the editor itself, and the close conversation.
// The presented entry guards entity availability; the editor below assumes an available document.
workspace
view DocumentScreen(Document) {
   render Col() [fill] {
      guard Document {
         loading -> { Spinner() }
         missing -> {
            Text("Document { Document.Id } no longer exists.") [body] // a handle keeps its Id
         }
         error -> Message { Text("The document could not be loaded: { Message }") [body] }
      }
      DocumentEditor(Document)
}  }

// Typed TS injection also stays the permanent escape hatch for rendering Tao does not own.
view WordCountLabel(Value text) {
   render Text("Words: { CountWords(Value) }") [body]
}

view DocumentEditor(Document) {
   state TitleDraft = Document.Title
   state BodyDraft = Document.Body
   state ParagraphText = ""
   state SaveCount = 0
   query Paragraphs from Document.Paragraphs { }
   action SetBodyDraft(Value text) {
      set BodyDraft = Value
   }
   action SetFinished(Value boolean) {
      // A yes/no field takes the boolean directly; naming the field writes the pole it selects.
      update Document {
         Final: Value
   }  }
   action SaveDocument() {
      guard TitleDraft empty
      let PreviousTitle = Document.Title
      let PreviousBody = Document.Body
      update Document {
         Title: TitleDraft
         Body: BodyDraft
      }
      set SaveCount += 1
      // A keyed toast replaces the previous occurrence with the same key instead of stacking. An
      // ephemeral presentation may take a non-serializable parameter: the toast receives the revert
      // action for the very save it announces, closing over the values captured above.
      present SavedToast(Revert: -> {
         update Document {
            Title: PreviousTitle
            Body: PreviousBody
         }
         set TitleDraft = PreviousTitle
         set BodyDraft = PreviousBody
      }) as toast (Key: "document-saved", Duration: 3.s)
   }
   action AddParagraph() {
      guard ParagraphText empty
      // `async` starts the write and immediately continues to clear the input. A failed write enters
      // the datasource error state.
      async {
         create Paragraph {
            Text: ParagraphText
            Ordering: Paragraphs.Count + 1
            Document
      }  }
      set ParagraphText = ""
   }
   action CloseDocument() {
      // `ask` suspends this action until the presented view responds; a bare `respond` answers none.
      let Result = ask ConfirmCloseDialogue(Document)
      if Result is Confirmed {
         dismiss
   }  }
   // Editing and the paragraph outline sit side by side on a wide screen and stack on a narrow one.
   render Panes() [screen, gap 16] {
      ScrollView() [claim 2] {
         Col() [width max 720, gap 10] {
            Text(DocumentLabel(Document.Title)) [title]
            Text("Workspace: { Document.Workspace.Name }") [body]

            #editDocumentTitle
            TextInput(Value: TitleDraft, Label: "Document title", Placeholder: "Document title") {
               on submit SaveDocument
            }

            #editDocumentBody
            TextInput(Value: BodyDraft, Label: "Document body", Placeholder: "Write the document body") [claim 2] {
               on change SetBodyDraft
               on submit SaveDocument
            }
            WordCountLabel(BodyDraft)

            #focusSession
            FocusSession()

            #markFinal
            Checkbox(Value: Document.Final is Final, Label: "Final") {
               on change SetFinished
            }

            #saveDocument
            FormButton("Save document", Disabled: TitleDraft is empty) {
               on press SaveDocument
            }
            Text("Saved title: { Document.Title }") [body]
            Text("Saved body: { Document.Body }") [body]
            Text("Saves this session: { SaveCount }") [body]

            #closeDocument
            FormButton("Close document") {
               on press CloseDocument
      }  }  }
      Col() [gap 10] {
         Text("Paragraphs: { Paragraphs.Count }") [title]
         guard Paragraphs {
            loading -> { Spinner() }
            error -> Message { Text("Could not load paragraphs: { Message }") [body] }
         }

         // `Progress` takes a fraction between 0 and 1.
         Progress(Value: GoalFraction(Paragraphs.Count))
         Text("Goal: { ParagraphGoal } paragraphs") [body]

         #newParagraph
         TextInput(Value: ParagraphText, Label: "New paragraph", Placeholder: "Add a paragraph") {
            on submit AddParagraph
         }

         #paragraphs
         loop Paragraphs / Paragraph {
            Col() [gap 6, pad 10] {
               Text(Paragraph.Text) [body]
}  }  }  }  }

view SavedToast(Revert action()) {
   render Row() [gap 6] {
      Text("Saved") [body]

      #revertSave
      FormButton("Revert") {
         on press Revert
}  }  }

// A view with `responds T` is presented for a typed answer; `ask` resumes with the response or
// none. Each ask is an independent stacked occurrence. Back or plain dismissal answers none before
// removal.
view ConfirmCloseDialogue(Document) responds ConfirmResult {
   render Col() [gap 6, pad 10] {
      Text("Close { Document.Title }?") [title]

      #confirmClose
      FormButton("Close") {
         on press -> { respond Confirmed }
      }

      #cancelClose
      FormButton("Cancel") {
         on press -> {
            respond // bare respond answers none
}  }  }  }

// A writing session's goal, used by the editor's progress indicator.
let ParagraphGoal = 10

// A function body is a block and hands its result back with `return`, so an early return can
// take a guard's place. `returns <type>` is optional and inferred when omitted.
function DocumentLabel(Title text) returns text {
   return "Document: { Title }"
}

// A fraction between 0 and 1 for `Progress`.
function GoalFraction(Count number) {
   if Count == 0 {
      return 0
   }
   return Count / ParagraphGoal
}
