use CurrentSession, FocusSessions from @data
use Interval from @tao/time
use Col, Row, Text from @tao/ui
use FormButton from @tao/ui/basic

// A focused writing session: pick a length, write until the clock runs out, pause and resume, or
// stop early. The session is a row in the device-local store rather than state in one view, which
// is what lets the editor start it and the shell frame count it down.
//
// Starting is an editor affordance -- you choose a length where you are about to write -- so this
// view creates the row and nothing else.
folder
view FocusStarter() {
   action Start(Length duration) {
      create FocusSession {
         EndsAt: now + Length
   }  }
   render Col() [subtlePanel] {
      when CurrentSession {
         empty -> {
            Text("Focused writing") [sectionTitle]

            #focusFive
            FormButton("Focus for 5 min") [buttonSecondary] {
               on press -> { do Start(5.min) }
            }

            #focusTwentyFive
            FormButton("Focus for 25 min") {
               on press -> { do Start(25.min) }
            }
         }
         otherwise -> {
            Text("A session is running") [caption]
}  }  }  }

// The focus bar: the running session, wherever you are. It sits in the shell frame's bottom slot
// and reads the session from the store rather than from a parent view, which is what lets it stay
// visible while the writing happens three navigation levels deeper. `EndsAt` is absolute, so a
// running session survives relaunch; pausing freezes the reading by recording when it stopped, and
// resuming re-anchors the deadline to the remainder, so paused time is not lost.
workspace
view FocusBar() {
   state Tick = Interval(1.s)
   render Row() [subtlePanel, gap 12] {
      loop CurrentSession / FocusSession {
         let Left = when FocusSession.Paused is Paused {
            true -> FocusSession.EndsAt - FocusSession.PausedAt
            otherwise -> FocusSession.EndsAt - Tick.Value
         }
         Text(when Left > 0 Left.Clock / not "Time's up") [title]
         when FocusSession.Paused is Paused {
            true -> {
               #resumeFocus
               FormButton("Resume") {
                  on press -> {
                     update FocusSession {
                        EndsAt: now + (FocusSession.EndsAt - FocusSession.PausedAt)
                        Running
               }  }  }
            }
            otherwise -> {
               #pauseFocus
               FormButton("Pause") {
                  on press -> {
                     update FocusSession {
                        PausedAt: now
                        Paused
         }  }  }  }  }

         #stopFocus
         FormButton("Stop") [buttonDanger] {
            on press -> { delete FocusSession }
}  }  }  }
