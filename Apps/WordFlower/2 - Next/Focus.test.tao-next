use WordFlower from ./

test "WordFlower focused writing" {
   test "keeps the session visible while you move around the app" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Morning pages" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      // Before a session exists the frame's bottom slot holds `none`, so it reserves no space and
      // nothing it would contain is on screen.
      expect text "Focused writing"
      expect missing text "Stop"
      press #focusFive
      expect text "5:00"
      // The bar lives in the shell frame, not in the screen that started the session, so leaving
      // the editor does not take the timer with it.
      back
      back
      expect text "5:00"
      advance 1.s
      expect text "4:59"
   }
   test "runs a session down under a controlled clock" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Morning pages" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      press #focusFive
      expect text "5:00"
      advance 1.min
      expect text "4:00"
      press #pauseFocus
      advance 1.min
      expect text "4:00" // paused: the reading is anchored to the moment it stopped
      press #resumeFocus
      advance 1.min
      expect text "3:00" // resumed: the paused minute was not lost
      advance 3.min
      expect text "Time's up"
      press #stopFocus
      // Stopping deletes the row, so the slot's content is `none` again and the bar's controls go
      // with it.
      expect {
         text "Focused writing"
         missing text "Time's up"
   }  }
   test "keeps a running session across a relaunch" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Morning pages" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      press #focusTwentyFive
      expect text "25:00"
      advance 90.s
      expect text "23:30"
      // The session is data on the device and `EndsAt` is absolute, so a relaunch resumes the same
      // countdown rather than restarting it.
      relaunch
      expect text "23:30"
      advance 30.s
      expect text "23:00"
}  }
