use WordFlower from ./

test "WordFlower focused writing" {
   test "keeps the session visible while you move around the app" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Morning pages" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      // Before a session exists the shell renders no bar at all. Asserting on the bar's own static
      // eyebrow rather than on the session it shows is what separates an unmounted bar from one
      // that is present but rendering nothing.
      expect text "Focused writing"
      expect missing text "Focus session"
      press #focusFive
      expect text "5:00"
      expect text "Focus session"
      // The focus bar's mounted command belongs to the shell occurrence, so its modifier chord is
      // available even while attention is in the editor rather than on the bar's button.
      press key "primary+p"
      expect text "Resume"
      press #resumeFocus
      // The bar lives in the shell, not in the screen that started the session, so leaving the
      // editor does not take the timer with it.
      back
      back
      expect text "5:00"
      advance 1.s
      expect text "4:59"
   }
   test "runs a session down under a controlled clock" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Morning pages" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      press #focusFive
      expect text "5:00"
      advance 1.min
      expect text "4:00"
      press #pauseFocus
      advance 1.min
      expect text "4:00" // paused: the reading is anchored to the moment it stopped
      press #resumeFocus
      advance 1.min
      expect text "3:00" // resumed: the paused minute was not lost
      advance 3.min
      expect text "Time's up"
      press #stopFocus
      // Stopping deletes the row, so the shell's condition is empty again and the bar's controls go
      // with it.
      expect {
         text "Focused writing"
         missing text "Time's up"
   }  }
   test "keeps a running session across a relaunch" {
      run WordFlower
      enter "Home" into #workspaceName
      press #addWorkspace
      select #workspaces[1] {
         press #openWorkspace
      }
      enter "Morning pages" into #newDocumentTitle
      submit #newDocumentTitle
      select #drafts[1] {
         press #edit
      }
      press #focusTwentyFive
      expect text "25:00"
      advance 90.s
      expect text "23:30"
      // The session is data on the device and `EndsAt` is absolute, so a relaunch resumes the same
      // countdown rather than restarting it.
      relaunch
      expect text "23:30"
      advance 30.s
      expect text "23:00"
   }
}
