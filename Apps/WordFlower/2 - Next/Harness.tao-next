use SlotNav, StackNav from @tao/nav/basic
use Col, FormButton, Text from @tao/ui
use WordFlowerNavHarness from ./

// A deterministic navigation harness. It keeps stack, slot, and root-replacement acceptance
// independent of the product app, its data, and its design.
// One complete type and four equivalent value spellings make the declaration/refinement contract
// executable. `HarnessStack` is the rare type declaration; each value below has that same
// precise inferred type and the same configured behavior. The primitive `nav` head adds a family
// constraint, while `let` infers it. A constructor block may expose or omit the core `with` without
// changing the result.
type HarnessStack is StackNav with {
   Initial is HarnessHome
}

workspace
nav StackByNav = HarnessStack { }

workspace
nav StackByNavWith = HarnessStack with { }

workspace
let StackByLet = HarnessStack { }

workspace
let StackByLetWith = HarnessStack with { }

workspace
nav HarnessNavigator = SlotNav {
   Initial StackByNav
}

view HarnessHome() {
   Title "Navigation harness"
   render Col() {
      Text("Harness home marker")
      #openHarnessDetail
      FormButton("Open deterministic detail") {
         on press -> { present HarnessDetail() }
      }
      FormButton("Open deterministic slot") {
         on press -> { present HarnessSlot() in HarnessNavigator }
}  }  }

view HarnessDetail() {
   Title "Harness detail"
   render Col() {
      Text("Harness detail marker")
      FormButton("Reset foundation app") {
         // `replace <nav> in <App>` swaps the app's root content; it is the only root operation an
         // app accepts, it names the app declaration, and it is valid only inside a view
         // declaration.
         on press -> { replace HarnessNavigator in WordFlowerNavHarness }
}  }  }

view HarnessSlot() {
   render Col() {
      Text("Harness slot marker")
      FormButton("Restore initial stack") {
         on press -> { dismiss } // dismissing a SlotNav's presented content restores its Initial
}  }  }
