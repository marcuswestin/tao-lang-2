use InstantDB from @instantdb
use Local from @tao/data
use SelectionNav, SlotNav, StackNav from @tao/nav
use Col, FormButton, Text from @tao/ui
use BuildStamp, FoundationNavigator, WordFlowerDesign, WorkspaceChooser, WorkspaceList from ./

// Tranche status: open
//
// SURFACES AND REMOTE DATA. This tranche gives WordFlower the UI primitives and adaptive layout a
// real app needs, puts it on a remote provider, and closes several small language gaps. It ends
// with a deliberately minimal first styling pass.
//
// The contract is now a DIRECTORY. Every file here is part of it:
//
//   WordFlower.tao-next   this file — project, apps, navigation, providers, variants, app shell
//   Data.tao-next         the data catalog
//   Shared.tao-next       shared types, functions, and injected views
//   Workspaces.tao-next   the workspace area
//   Documents.tao-next    the document area
//   Foundation.tao-next   the deterministic navigation harness
//   Design.tao-next       the minimal design system — IMPLEMENT LAST, see that file
//
// Because a tier is a directory now, the absorption gates must compare `1 - Current` and
// `2 - Next` as whole directories: same file set, and every file byte-identical to its counterpart
// when the tranche is closed. Teaching the gates about directories is part of this tranche. Until
// it lands they still pair two named files, so the marker below is repeated in this file's sidecar;
// once directory gating exists, one marker in this file governs the tier.
//
// This tranche decides:
// - Stdlib surfaces: `ScrollView`, `Image`, `Icon`, `Checkbox`, `List` with `on select`, `Spinner`,
//   and `Progress`
// - Adaptive layout: `Panes()` lays its children side by side when the container is wide enough and
//   stacks them otherwise, and `width max <n>` bounds a readable column. Responsiveness is a
//   container behavior, not a language-level breakpoint
// - The app shell honors safe-area and keyboard insets. This is runtime behavior with no source
//   surface; apps do not opt in
// - Remote data: `Datasource InstantDB { AppId "..." }` on the published provider protocol,
//   extended for inbound subscription deltas, write acknowledgement, externally originated store
//   revisions, and reconciliation between provider row identity and generated ids
// - `unauthorized` becomes a provider-produced availability state. `data unauthorized` and
//   `data delayed <milliseconds>` drive it and latency deterministically in checks
// - `async { }` runs its block without delaying the statements after it; failures surface as
//   provider error state. The concurrency policy vocabulary stays deferred under DEF-NAV-011
// - Declaration kinds name configured values, replacing `let` for them: `Kind Name { ... }`
//   declares a new one and `Kind Name = <value>` names or derives one, so `app X = Y with { ... }`
//   `datasource S = Local { ... }` / `datasource T = S with { ... }`, and `nav N = StackNav { ... }`
//   read like every other declaration. The `AppValueDeclaration` union collapses to `AppDeclaration`, and app variants
//   inherit the entry-file rule — every app and variant is declared in the entry file, which is
//   what keeps cross-module variant derivation unreachable
// - `inject <type>` produces a typed value outside render position
// - `optional <Name> <type>` declares an item field that may be absent
// - `expect checkbox <selector> checked|unchecked` joins the test vocabulary, since a two-state
//   control cannot be asserted through visible text
// - Minimal design: flat tokens plus named clause bundles applied at render sites, and an app
//   `Design` property
//
// Deliberately NOT here: splits and windows, snapshots, restoration and routes, the concurrency
// policy vocabulary, and bare asset literals — assets are ordinary text paths in this tranche and
// LANG-025 still owns the `./images/hero.png` literal form.

project {
   name "WordFlower"
   remote none
   license MIT
}

// A configured nav binding is an immutable descriptor, not a mounted instance or exposed state.
nav HomeStack = StackNav {
   Initial WorkspaceList
}
nav WorkspaceNav = SlotNav {
   Initial WorkspaceChooser
}
nav SettingsStack = StackNav {
   Initial Settings
}
nav SignedOutNav = StackNav {
   Initial SignedOut
}

// Direct keys bind to SelectionNav's declared `@key` collection and share this configured nav's
// target-key namespace. `Icon` names a stdlib system icon.
nav WordFlowerNavigator = SelectionNav {
   Initial @home
   Display "automatic"
   @home {
      Label "Home"
      Icon "house"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Icon "folder"
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Icon "gear"
      Content SettingsStack
}  }

// A configured datasource is a named value like any other: constructed from a provider with a bare
// block, or derived from another with `with`.
datasource DeviceStore = Local {
   StorageKey "WordFlowerData"
}
datasource CloudStore = InstantDB {
   AppId "wordflower-dev"
}
datasource StagingStore = CloudStore with {
   AppId "wordflower-staging"
}

// An app mounts navs, it does not render content directly. Overlay and toast hosting are universal
// capabilities, so no app declares them.
app WordFlower {
   Name "WordFlower"
   Design WordFlowerDesign
   Navigator WordFlowerNavigator
   Datasource DeviceStore // offline-first: the device owns the writing; sync is a variant
}

// The same app against the remote provider. A variant patches public properties; the original and
// its declaration identity are unchanged, so strict targets still name `WordFlower`. An app variant
// is an app, so it needs no visibility marking to be imported by a test sidecar beside it.
app WordFlowerCloud = WordFlower with {
   Name "WordFlower Cloud"
   Datasource CloudStore
}

app WordFlowerStaging = WordFlowerCloud with {
   Name "WordFlower Staging"
   Datasource StagingStore
}

app WordFlowerDrawer = WordFlower with {
   Name "WordFlower - Drawer Preview"
   Navigator with { // patches the app's own navigator instead of replacing it
      Display "drawer"
}  }

app WordFlowerFoundationTest {
   Name "WordFlower Navigation Foundation Test"
   Navigator FoundationNavigator
   // An app without data omits `Datasource` entirely
}

workspace ui Settings {
   render Col() [screen, width max 720, centered, gap 10] {
      Text("Settings") [title]
      Text("Build { BuildStamp }") [body] // a typed injected value, not a render
      #resetSignedOut
      FormButton("Reset to signed out") {
         on press -> {
            replace SignedOutNav in WordFlower
}  }  }  }

workspace ui SignedOut {
   render Col() [screen, centered] {
      Text("Signed out") [title]
}  }
