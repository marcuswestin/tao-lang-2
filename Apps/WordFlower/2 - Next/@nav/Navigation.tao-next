use SelectionNav, StackNav from @tao/nav
use Settings, WorkspaceList, WorkspaceNav from @ui

// The product's shared top-level navigators. Private navigators live beside the scenes that own
// them, which keeps generated module dependencies one-way.
// A configured nav declaration is a nav value: an immutable descriptor, not a mounted occurrence
// or exposed runtime state. `StackNav` is its inferred concrete type; the `nav` head checks the
// primitive family without erasing that more precise type.
nav HomeStack = StackNav {
   Initial WorkspaceList
}

nav SettingsStack = StackNav {
   Initial Settings
}

// Direct keys bind to SelectionNav's declared `@key` collection and share this configured nav's
// target-key namespace. The `Icon` property contains a system-icon name; it is not an Icon view.
project
nav WordFlowerNavigator = SelectionNav {
   Initial @home
   Display "automatic"
   @home {
      Label "Home"
      Icon "house"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Icon "folder"
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Icon "gear"
      Content SettingsStack
}  }

// The preview variants hand the shell a differently configured navigator, so a preview still gets
// the focus bar.
project
nav WordFlowerDrawerNavigator = WordFlowerNavigator with {
   Display "drawer"
}

project
nav WordFlowerTabsNavigator = WordFlowerNavigator with {
   Display "tabs"
}
