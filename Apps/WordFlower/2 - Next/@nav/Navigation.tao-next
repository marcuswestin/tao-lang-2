use FrameNav, SelectionNav, SlotNav, StackNav from @tao/nav
use CurrentSession from @data
use FocusBar, Settings, SignedOut, WorkspaceChooser, WorkspaceList from @ui

// Every navigator the product mounts. The harness beside this file covers the declaration
// spellings; these are the real ones.
// A configured nav declaration is a nav value: an immutable descriptor, not a mounted occurrence
// or exposed runtime state. `StackNav` is its inferred concrete type; the `nav` head checks the
// primitive family without erasing that more precise type.
nav HomeStack = StackNav {
   Initial WorkspaceList
}

workspace
nav WorkspaceNav = SlotNav {
   Initial WorkspaceChooser
}

nav SettingsStack = StackNav {
   Initial Settings
}

workspace
nav SignedOutNav = StackNav {
   Initial SignedOut
}

// Direct keys bind to SelectionNav's declared `@key` collection and share this configured nav's
// target-key namespace. The `Icon` property contains a system-icon name; it is not an Icon view.
workspace
nav WordFlowerNavigator = SelectionNav {
   Initial @home
   Display "automatic"
   @home {
      Label "Home"
      Icon "house"
      Content HomeStack
   }
   @workspace {
      Label "Workspace"
      Icon "folder"
      Content WorkspaceNav
   }
   @settings {
      Label "Settings"
      Icon "gear"
      Content SettingsStack
}  }

// The shell: fixed chrome around the navigated content. Edge slots hold views or navs and never
// take Back -- the frame routes it to `@center`. A slot whose `Content` is `none` reserves no
// space, so the focus bar appears with the session and the content grows back when the session
// ends; that presence is a property of the data, never of layout measurement.
workspace
nav WordFlowerShell = FrameNav {
   @center {
      Content WordFlowerNavigator
   }
   @bottom {
      Label "Focus session"
      Content when CurrentSession {
         empty -> none
         otherwise -> FocusBar
}  }  }
