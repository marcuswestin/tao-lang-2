#!/bin/sh
set -eu

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --setup-only ]; }; then
  printf 'Usage: ./enter-tao-dev-env [--setup-only]\n' >&2
  exit 2
fi

repository=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
cd "$repository"

if ! command -v devenv >/dev/null 2>&1; then
  printf 'Tao development needs devenv and Nix installed before this shell can start.\n' >&2
  exit 1
fi

# One setup runs in the pinned environment before the interactive shell begins. The second
# devenv invocation reuses its evaluated profile and keeps the shell active until the user exits.
export DEVENV_TUI=false
devenv shell --no-tui ./agent setup
if [ "${1:-}" = --setup-only ]; then
  exit 0
fi
if [ "${SHELL##*/}" = zsh ]; then
  # System zshrc runs compinit before our zshrc can restore the user's ZDOTDIR.
  # Keep its dump beside a startup link in the checkout's disposable cache, not in source.
  shell_cache="$repository/.artifacts/cache/dev-shell/zsh"
  shell_startup="$repository/packages/cli/dev-cli/dev-cli-src/shell/.zshrc"
  mkdir -p "$shell_cache"
  if [ "$(readlink "$shell_cache/.zshrc" 2>/dev/null || true)" != "$shell_startup" ]; then
    # Publish atomically so simultaneous shell launches never see a missing startup file.
    shell_link="$shell_cache/.zshrc.$$"
    trap 'rm -f "$shell_link"' 0
    ln -s "$shell_startup" "$shell_link"
    mv -f "$shell_link" "$shell_cache/.zshrc"
    trap - 0
  fi
  export TAO_ORIGINAL_ZDOTDIR="${ZDOTDIR:-$HOME}"
  export ZDOTDIR="$shell_cache"
  exec devenv shell --no-tui -- zsh -i
fi
exec devenv shell --no-tui
