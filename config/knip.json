{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "enumMembers",
    "exports",
    "nsExports",
    "nsTypes",
    "types"
  ],
  "ignore": [
    "**/_gen_*/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "Apps/**/*.{ts,tsx}"
      ],
      "project": [
        "Apps/**/*.{ts,tsx}"
      ],
      "includeEntryExports": true
    },
    "packages/*": {
      "entry": [
        "cli-src/subprocess-test-api.ts",
        "*-tests/**/*.{test,jest,live}.{ts,tsx}",
        "*-tests/**/*-fixture.{ts,tsx}"
      ],
      "project": [
        "*-src/**/*.{ts,tsx}",
        "*-tests/**/*.{ts,tsx}"
      ]
    },
    "packages/*/*": {
      "entry": [
        "cli-src/subprocess-test-api.ts",
        "*-tests/**/*.{test,jest,live}.{ts,tsx}",
        "*-tests/**/*-fixture.{ts,tsx}"
      ],
      "project": [
        "*-src/**/*.{ts,tsx}",
        "*-tests/**/*.{ts,tsx}"
      ]
    },
    "packages/dev": {
      "entry": [
        "dev-src/dev.ts",
        "dev-src/agent-dev.ts",
        "dev-src/cli/agent-help.ts",
        "dev-src/agent-hooks/ShellHabitsEntry.ts",
        "dev-src/agent-hooks/SubagentBriefEntry.ts",
        "dev-src/agent-hooks/GitHooksEntry.ts",
        "dev-src/performance/language-performance.ts",
        "dev-src/repository-tests/*.ts",
        "dev-src/studio/StudioClientSnapshotProcess.ts",
        "dev-src/studio/StudioPackagedService.ts",
        "dev-src/studio/StudioPackagedTestCommand.ts",
        "dev-tests/**/*.test.{ts,tsx}",
        "performance-checks/**/*.test.{ts,tsx}",
        "studio-smoke/**/*.test.{ts,tsx}"
      ],
      "project": [
        "dev-src/**/*.{ts,tsx}",
        "dev-tests/**/*.{ts,tsx}",
        "performance-checks/**/*.{ts,tsx}",
        "studio-smoke/**/*.{ts,tsx}"
      ]
    },
    "packages/testing/e2e-testing": {
      "entry": [
        "playwright.config.ts",
        "**/*.host.spec.ts",
        "fixtures/**/*.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "packages/ai/generation": {
      "entry": [
        "generation-tests/**/*.test.{ts,tsx}",
        "generation-live/**/*.live.{ts,tsx}"
      ],
      "project": [
        "generation-src/**/*.{ts,tsx}",
        "generation-tests/**/*.{ts,tsx}",
        "generation-live/**/*.{ts,tsx}"
      ]
    },
    "packages/testing/host-control": {
      "entry": [
        "host-control-src/host-control.ts",
        "host-control-tests/**/*.test.ts"
      ],
      "project": [
        "host-control-src/**/*.ts",
        "host-control-tests/**/*.ts"
      ]
    },
    "packages/testing/playwright-driver": {
      "entry": [
        "playwright-driver-src/host-control-playwright.ts"
      ],
      "project": [
        "playwright-driver-src/**/*.ts"
      ]
    },
    "packages/testing/appium-driver": {
      "entry": [
        "appium-driver-src/appium.ts",
        "appium-driver-tests/**/*.test.ts"
      ],
      "project": [
        "appium-driver-src/**/*.ts",
        "appium-driver-tests/**/*.ts"
      ]
    },
    "packages/ides/ide-extension": {
      "entry": [
        "esbuild.config.ts",
        "ide-extension-src/extension/main.ts",
        "ide-extension-src/language/main.ts",
        "ide-extension-tests/**/*.test.{ts,tsx}"
      ],
      "project": [
        "esbuild.config.ts",
        "ide-extension-src/**/*.{ts,tsx}",
        "ide-extension-tests/**/*.{ts,tsx}"
      ]
    },
    "packages/apps/runtime": {
      "entry": [
        "TaoRuntime-src/host-testing/RuntimeHostTestControl.ts",
        "TaoRuntime-src/host-testing/NativeHostTestControl.ts",
        "TR-tests/**/*.test.{ts,tsx}"
      ],
      "project": [
        "TaoRuntime-src/**/*.{ts,tsx}",
        "TR-tests/**/*.{ts,tsx}"
      ]
    },
    "packages/apps/expo-host": {
      "entry": [
        "expo-host-src/testing/compile-app.tsx",
        "expo-host-src/testing/render-app.tsx",
        "expo-host-src/testing/tao-test-plan.tsx",
        "expo-host-src/testing/test-runner.tsx",
        "expo-host-src/testing/test-compiler/WorkerProcess.ts",
        "expo-host-src/testing/device-module-mocks/*.setup.ts",
        "expo-host-tests/**/*.{test,jest}.{ts,tsx}"
      ],
      "project": [
        "expo-host-src/**/*.{ts,tsx}",
        "expo-host-tests/**/*.{ts,tsx}"
      ]
    },
    "packages/apps/stdlib": {
      "entry": [
        "@tao/**/*.{ts,tsx}",
        "stdlib-tests/**/*.test.{ts,tsx}"
      ],
      "project": [
        "@tao/**/*.{ts,tsx}",
        "stdlib-src/**/*.{ts,tsx}",
        "stdlib-tests/**/*.{ts,tsx}"
      ],
      "includeEntryExports": true
    },
    "packages/ides/studio": {
      "entry": [
        "studio-src/TaoStudioBrowser.tsx",
        "studio-tests/**/*.test.{ts,tsx}"
      ],
      "project": [
        "studio-src/**/*.{ts,tsx}",
        "studio-tests/**/*.{ts,tsx}"
      ]
    }
  }
}
