{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(adb *)",
      "Bash(emulator *)",
      "Bash(open -a Simulator *)",
      "Bash(xcrun simctl *)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "adb *",
      "emulator *",
      "open -a Simulator *",
      "xcrun simctl *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/Developer/CoreSimulator",
        "~/Library/Developer/Xcode/DerivedData",
        "~/Library/Logs/CoreSimulator"
      ]
    }
  }
}
