        "*.appstoreconnect.apple.com",
        "idmsa.apple.com",
        "appleid.apple.com",
        "gsa.apple.com",
        "contentdelivery.apple.com",
        "*.itunes.apple.com",
        "devimages-cdn.apple.com",
        "swcdn.apple.com",
        "swdist.apple.com"
