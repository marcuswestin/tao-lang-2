    "filesystem": {
      "allowWrite": [
        "~/.bun",
        "~/.cache",
        "~/.gradle",
        "~/.android",
        "~/.expo",
        "~/.hutch",
        "~/.local/state/watchman",
        "~/Library/Caches"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket",
        "~/.local/state/watchman"
      ],
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "nodejs.org",
        "*.nodejs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "expo.dev",
        "*.expo.dev",
