    "filesystem": {
      "allowWrite": [
        "~/.bun",
        "~/.cache",
        "~/.gradle",
        "~/.android",
        "~/.expo",
        "~/.hutch",
        "~/.local/state/watchman",
        "~/Library/Caches"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket",
        "~/.local/state/watchman"
      ],
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "nodejs.org",
        "*.nodejs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "expo.dev",
        "*.expo.dev",
        "*.expo.io",
        "exp.host",
        "repo1.maven.org",
        "cache.nixos.org",
        "*.cachix.org",
        "*.anthropic.com",
        "*.openai.com",
        "developer.apple.com",
        "*.developer.apple.com",
        "appstoreconnect.apple.com",
        "*.appstoreconnect.apple.com",
        "idmsa.apple.com",
        "appleid.apple.com",
        "gsa.apple.com",
        "contentdelivery.apple.com",
        "*.itunes.apple.com",
        "devimages-cdn.apple.com",
        "swcdn.apple.com",
        "swdist.apple.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        }
      ]
    }
