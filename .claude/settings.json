{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./agent *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(file *)",
      "Bash(git branch --show-current)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git tag --list *)",
      "Bash(git worktree list *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(lsof -nP -iTCP:* -sTCP:LISTEN -t)",
      "Bash(plutil -lint *)",
      "Bash(plutil -p *)",
      "Bash(pwd)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(stat *)",
      "Bash(sw_vers *)",
      "Bash(tail *)",
      "Bash(uname *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Read(~/code/tao-lang/**)",
      "SendMessage",
      "WebFetch",
      "WebSearch",
      "mcp__Claude_Browser__*",
      "mcp__Claude_Code_iOS_Simulator__*",
      "mcp__claude-in-chrome__*",
      "Bash(./agent unsandboxed land)",
      "Bash(./agent unsandboxed land *)",
      "Bash(./agent unsandboxed finalize)",
      "Bash(./agent unsandboxed finalize *)",
      "Bash(./agent unsandboxed merge-main)",
      "Bash(./agent unsandboxed merge-main *)",
      "Bash(./agent unsandboxed merge-recover)",
      "Bash(./agent unsandboxed merge-recover *)",
      "Bash(./agent unsandboxed landed)",
      "Bash(./agent unsandboxed landed *)",
      "Bash(./agent unsandboxed capabilities)",
      "Bash(./agent unsandboxed capabilities *)",
      "Bash(./agent unsandboxed open-pr)",
      "Bash(./agent unsandboxed open-pr *)",
      "Bash(./agent unsandboxed fix-agent-config)",
      "Bash(./agent unsandboxed fix-agent-config *)",
      "Bash(./agent unsandboxed test-host)",
      "Bash(./agent unsandboxed test-host *)",
      "Bash(./agent unsandboxed studio-smoke)",
      "Bash(./agent unsandboxed studio-smoke *)",
      "Bash(./agent unsandboxed studio-proof-real-app)",
      "Bash(./agent unsandboxed studio-proof-real-app *)",
      "Bash(./agent unsandboxed admission-experiment)",
      "Bash(./agent unsandboxed admission-experiment *)",
      "Bash(./agent unsandboxed native-module-check)",
      "Bash(./agent unsandboxed native-module-check *)",
      "Bash(./agent unsandboxed reclaim)",
      "Bash(./agent unsandboxed reclaim *)",
      "Bash(./agent unsandboxed prepare-release)",
      "Bash(./agent unsandboxed prepare-release *)",
      "Bash(./agent unsandboxed app-dev)",
      "Bash(./agent unsandboxed app-dev *)",
      "Bash(./agent unsandboxed studio)",
      "Bash(./agent unsandboxed studio *)",
      "Bash(./agent unsandboxed studio-native)",
      "Bash(./agent unsandboxed studio-native *)",
      "Bash(./agent unsandboxed docker-desktop)",
      "Bash(./agent unsandboxed docker-desktop *)",
      "Bash(./agent unsandboxed local-instantdb)",
      "Bash(./agent unsandboxed local-instantdb *)",
      "Bash(./agent unsandboxed companion-host-build)",
      "Bash(./agent unsandboxed companion-host-build *)",
      "Bash(./agent unsandboxed standalone-cli-vm-setup)",
      "Bash(./agent unsandboxed standalone-cli-vm-setup *)",
      "Bash(./agent unsandboxed standalone-cli-clean-machine)",
      "Bash(./agent unsandboxed standalone-cli-clean-machine *)",
      "Bash(./agent unsandboxed simulators)",
      "Bash(./agent unsandboxed simulators *)",
      "Bash(./agent unsandboxed devices)",
      "Bash(./agent unsandboxed devices *)",
      "Bash(./agent unsandboxed xcode)",
      "Bash(./agent unsandboxed xcode *)",
      "Bash(./agent unsandboxed pods)",
      "Bash(./agent unsandboxed pods *)",
      "Bash(./agent unsandboxed android)",
      "Bash(./agent unsandboxed android *)",
      "Bash(./agent unsandboxed remote)",
      "Bash(./agent unsandboxed remote *)",
      "Bash(./agent unsandboxed processes)",
      "Bash(./agent unsandboxed processes *)",
      "Bash(./agent unsandboxed start-branch)",
      "Bash(./agent unsandboxed start-branch *)"
    ],
    "ask": [
      "Bash(./agent land-unlock --force*)",
      "mcp__ccd_session_mgmt__send_message"
    ],
    "deny": [
      "Bash(bun install *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "./agent unsandboxed land",
      "./agent unsandboxed land *",
      "./agent unsandboxed finalize",
      "./agent unsandboxed finalize *",
      "./agent unsandboxed merge-main",
      "./agent unsandboxed merge-main *",
      "./agent unsandboxed merge-recover",
      "./agent unsandboxed merge-recover *",
      "./agent unsandboxed landed",
      "./agent unsandboxed landed *",
      "./agent unsandboxed capabilities",
      "./agent unsandboxed capabilities *",
      "./agent unsandboxed open-pr",
      "./agent unsandboxed open-pr *",
      "./agent unsandboxed fix-agent-config",
      "./agent unsandboxed fix-agent-config *",
      "./agent unsandboxed test-host",
      "./agent unsandboxed test-host *",
      "./agent unsandboxed studio-smoke",
      "./agent unsandboxed studio-smoke *",
      "./agent unsandboxed studio-proof-real-app",
      "./agent unsandboxed studio-proof-real-app *",
      "./agent unsandboxed admission-experiment",
      "./agent unsandboxed admission-experiment *",
      "./agent unsandboxed native-module-check",
      "./agent unsandboxed native-module-check *",
      "./agent unsandboxed reclaim",
      "./agent unsandboxed reclaim *",
      "./agent unsandboxed prepare-release",
      "./agent unsandboxed prepare-release *",
      "./agent unsandboxed app-dev",
      "./agent unsandboxed app-dev *",
      "./agent unsandboxed studio",
      "./agent unsandboxed studio *",
      "./agent unsandboxed studio-native",
      "./agent unsandboxed studio-native *",
      "./agent unsandboxed docker-desktop",
      "./agent unsandboxed docker-desktop *",
      "./agent unsandboxed local-instantdb",
      "./agent unsandboxed local-instantdb *",
      "./agent unsandboxed companion-host-build",
      "./agent unsandboxed companion-host-build *",
      "./agent unsandboxed standalone-cli-vm-setup",
      "./agent unsandboxed standalone-cli-vm-setup *",
      "./agent unsandboxed standalone-cli-clean-machine",
      "./agent unsandboxed standalone-cli-clean-machine *",
      "./agent unsandboxed simulators",
      "./agent unsandboxed simulators *",
      "./agent unsandboxed devices",
      "./agent unsandboxed devices *",
      "./agent unsandboxed xcode",
      "./agent unsandboxed xcode *",
      "./agent unsandboxed pods",
      "./agent unsandboxed pods *",
      "./agent unsandboxed android",
      "./agent unsandboxed android *",
      "./agent unsandboxed remote",
      "./agent unsandboxed remote *",
      "./agent unsandboxed processes",
      "./agent unsandboxed processes *",
      "./agent unsandboxed start-branch",
      "./agent unsandboxed start-branch *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.tao",
        "~/.bun",
        "~/.cache",
        "~/.gradle",
        "~/.android",
        "~/.expo",
        "~/.hutch",
        "~/Library/Caches"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket"
      ],
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "nodejs.org",
        "*.nodejs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "expo.dev",
        "*.expo.dev",
        "*.expo.io",
        "exp.host",
        "repo1.maven.org",
        "repo.reactnative.dev",
        "cache.nixos.org",
        "*.cachix.org",
        "*.anthropic.com",
        "*.openai.com",
        "developer.apple.com",
        "*.developer.apple.com",
        "appstoreconnect.apple.com",
        "*.appstoreconnect.apple.com",
        "idmsa.apple.com",
        "appleid.apple.com",
        "gsa.apple.com",
        "contentdelivery.apple.com",
        "*.itunes.apple.com",
        "devimages-cdn.apple.com",
        "swcdn.apple.com",
        "swdist.apple.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-session-start.zsh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-output-discipline.zsh\" || true"
          },
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-shell-habits.zsh\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" spawn > /dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" start > /dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-subagent-brief.zsh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" stop > /dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=packages/cli/agent-cli/agent-cli-src/cli/agent-worktree.zsh && repo_root=\"$(git rev-parse --show-toplevel)\" && { [ -x \"$repo_root/$script\" ] || repo_root=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"; } && \"$repo_root/$script\" create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=packages/cli/agent-cli/agent-cli-src/cli/agent-worktree.zsh && repo_root=\"$(git rev-parse --show-toplevel)\" && { [ -x \"$repo_root/$script\" ] || repo_root=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"; } && \"$repo_root/$script\" remove"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "autoCompactWindow": 272000
}
