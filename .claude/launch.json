{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hnreader-dev",
      "runtimeExecutable": "direnv",
      "runtimeArgs": [
        "exec",
        ".",
        "./tao",
        "dev",
        "Apps/HNReader",
        "--app",
        "HNReader"
      ],
      "port": 8081
    },
    {
      "name": "tao-dev",
      "url": "http://localhost:8081",
      "port": 8081
    },
    {
      "name": "studio-wordflower",
      "runtimeExecutable": "direnv",
      "runtimeArgs": [
        "exec",
        ".",
        "./dev",
        "studio",
        "Apps/WordFlower/1 - Current",
        "--app",
        "WordFlower",
        "--port",
        "4820",
        "--no-browser"
      ],
      "port": 4820
    }
  ]
}
