# Generated by `./agent setup` from .rulesync/permissions.jsonc. Edit that file, not this one.
# These commands need host capabilities the sandbox cannot express. The explicitly listed
# listed mutable entrypoints also run their repository code and child processes outside the sandbox.
# Other allowed commands remain inside the active filesystem and network permission profile.

prefix_rule(pattern=["ps","-axo","pid=,ppid=,lstart=,command="], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["emulator","-list-avds"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["./agent","land"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["./agent","prepare-release","studio"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["./agent","prepare-release","ide-extension"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["bun","install"], decision="forbidden", justification="Use ./agent setup for repository dependencies.")
