# Generated by `./agent setup` from .rulesync/permissions.jsonc. Edit that file, not this one.
# These exact prefixes need host capabilities the sandbox cannot express. Every other allowed
# command remains inside the active filesystem and network permission profile.

prefix_rule(pattern=["git","worktree","list"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["ps","-o","comm=,lstart=","-p"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["ps","-o","pid=,ppid=,lstart=,command=","-p"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["ps","-axo","pid=,ppid=,lstart=,command="], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["kill","-0"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["/bin/kill","-0"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["kill","-TERM"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["/bin/kill","-TERM"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["kill","-KILL"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["/bin/kill","-KILL"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["adb","devices"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["adb","get-state"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["emulator","-list-avds"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["xcrun","simctl","list"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["git","merge"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["git","fetch","origin"], decision="allow", justification="Repository-approved host command.")
prefix_rule(pattern=["git","ls-remote","origin"], decision="allow", justification="Repository-approved host command.")
