{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/hooks-schema.json",
  // Canonical agent lifecycle hooks for this repository, one source for two harnesses.
  // `./agent setup` renders them through rulesync's hooks feature into .claude/settings.json and
  // .codex/hooks.json. Edit this file, never the generated ones. Keep every command
  // harness-neutral: a relative path, which rulesync prefixes with `$CLAUDE_PROJECT_DIR` for
  // Claude Code and leaves as is for Codex, and no field one harness does not document.
  "hooks": {
    // Every harness reaches the repository's one setup entry, `./agent setup`, before an agent's
    // first command. Worktrunk runs it from its blocking `pre-start` hook (.config/wt.toml) and
    // Cursor from its worktree setup (.cursor/worktrees.json); a worktree Claude Code or Codex
    // creates itself — `--worktree`, `isolation: "worktree"`, a background session — passes
    // through neither, so it would start with no node_modules, no current generated parser, and no
    // generated agent adapters, and an agent would meet a checkout where `./tao`, `bun test`, and
    // `tsc` fail for reasons that look like product breakage. This hook gives that path the same guarantee. Hooks run as ordinary
    // processes outside the Bash sandbox, which matters for Claude Code: its sandbox denies the
    // writes a dependency install needs under paths it protects.
    //
    // The script runs `./agent setup` — the entrypoint rather than `just setup` because it
    // activates the pinned devenv profile itself, which a fresh worktree has not done yet; it is
    // idempotent and returns in well under a second once a checkout is bootstrapped, so it runs
    // unconditionally — and then, when Claude Code hands it CLAUDE_ENV_FILE, exports that profile's
    // bin directory onto the PATH of every later Bash tool command. Its stdout would enter the
    // agent's context in both harnesses, hence the redirect.
    "sessionStart": [
      {
        "type": "command",
        "command": "./packages/dev/dev-src/cli/agent-session-start.zsh > /dev/null",
      },
    ],
  },
}
