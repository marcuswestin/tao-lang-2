{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/hooks-schema.json",
  // Canonical agent lifecycle hooks for this repository, one source for two harnesses.
  // `./agent setup` renders them through rulesync's hooks feature into .claude/settings.json and
  // .codex/hooks.json. Edit this file, never the generated ones. Keep every command
  // harness-neutral: discover the worktree root through Git so a harness launched from any
  // repository subdirectory reaches the same script, and use no field one harness does not document.
  "hooks": {
    // Every harness reaches the repository's one setup entry, `./agent setup`, before an agent's
    // first command. Worktrunk runs it from its blocking `pre-start` hook (.config/wt.toml) and
    // Cursor from its worktree setup (.cursor/worktrees.json); a worktree Claude Code or Codex
    // creates itself — `--worktree`, `isolation: "worktree"`, a background session — passes
    // through neither, so it would start with no node_modules and no generated agent adapters,
    // and an agent would meet a checkout where `bun test` and `tsc` fail for reasons that look
    // like product breakage. This hook gives that path the same guarantee. Hooks run as ordinary
    // processes outside the Bash sandbox, which matters for Claude Code: its sandbox denies the
    // writes a dependency install needs under paths it protects.
    //
    // The script runs `./agent setup` — the entrypoint rather than `just setup` because it
    // activates the pinned devenv profile itself, which a fresh worktree has not done yet; it is
    // idempotent and returns in well under a second once a checkout is bootstrapped, so it runs
    // unconditionally — and then, when Claude Code hands it CLAUDE_ENV_FILE, exports that profile's
    // bin directory onto the PATH of every later Bash tool command. Its stdout would enter the
    // agent's context in both harnesses, hence the redirect.
    "sessionStart": [
      {
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && \"$repo_root/packages/dev/dev-src/cli/agent-session-start.zsh\" > /dev/null",
      },
    ],
    // The three delegation hooks record what this repository hands to subagents, so that the
    // routing table in the `delegation` skill is tuned against evidence; `./agent
    // delegation-report` reads them and says which fields a harness left out. They come out when
    // `Docs/Roadmap/Subagent delegation/Plan - Subagent delegation.md` says the calibration is
    // done. Claude Code renamed the spawning tool from `Task` to `Agent`; the matcher follows.
    //
    // The shell-habits hook states, beside the tool result, the habits this repository's commands
    // depend on: `rg` over a recursive `grep` or `find`, no `cd`/`export`/`VAR=` prefix, and a
    // gate's exit status captured rather than piped away. Both harnesses carry that text
    // non-blocking through `hookSpecificOutput.additionalContext`, so unlike the logging hooks
    // above its stdout must reach the harness rather than /dev/null. It warns; it never blocks,
    // and `|| true` keeps a missing worktree from being reported as a hook error.
    "preToolUse": [
      // The output-discipline hook is the one hook here that refuses rather than warns, and the
      // reason is structural rather than a preference for strictness. A warning travels in
      // `additionalContext`, which both harnesses place beside the tool result — so a warning about
      // an eight-thousand-character dump arrives underneath the dump, having prevented nothing.
      // Shell file reads and unbounded Git patches were 42% of every character this repository's
      // agents read through Bash in a week, and `OutputDiscipline.ts` refuses exactly those,
      // naming the pipe, the redirect, or the summary flag that makes the command acceptable. It
      // owns no habit the shell-habits hook already warns about.
      {
        "type": "command",
        "matcher": "Bash",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/dev/dev-src/cli/agent-output-discipline.zsh\" || true",
      },
      {
        "type": "command",
        "matcher": "Agent",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/dev/dev-src/cli/agent-delegation-log.zsh\" spawn > /dev/null 2>&1 || true",
      },
      {
        "type": "command",
        "matcher": "Bash",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/dev/dev-src/cli/agent-shell-habits.zsh\" 2>/dev/null || true",
      },
    ],
    // A subagent gets the repository boilerplate from the second hook rather than from every
    // caller pasting it into every brief; neither harness lets a SubagentStart hook block.
    "subagentStart": [
      {
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/dev/dev-src/cli/agent-delegation-log.zsh\" start > /dev/null 2>&1 || true",
      },
      {
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/dev/dev-src/cli/agent-subagent-brief.zsh\" 2>/dev/null || true",
      },
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/dev/dev-src/cli/agent-delegation-log.zsh\" stop > /dev/null 2>&1 || true",
      },
    ],
  },
}
