{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/hooks-schema.json",
  // Canonical agent lifecycle hooks for this repository, one source for two harnesses.
  // `./agent setup` renders them through rulesync's hooks feature into .claude/settings.json and
  // .codex/hooks.json. Edit this file, never the generated ones. Keep every command
  // harness-neutral: discover the worktree root through Git so a harness launched from any
  // repository subdirectory reaches the same script, and use no field one harness does not document.
  "hooks": {
    // Every harness reaches the repository's one setup entry, `./agent setup`, before an agent's
    // first command. Worktrunk runs it from its blocking `pre-start` hook (.config/wt.toml) and
    // Cursor from its worktree setup (.cursor/worktrees.json); a worktree Claude Code or Codex
    // creates itself — `--worktree`, `isolation: "worktree"`, a background session — passes
    // through neither, so it would start with no node_modules and no generated agent adapters,
    // and an agent would meet a checkout where `bun test` and `tsc` fail for reasons that look
    // like product breakage. This hook gives that path the same guarantee. Hooks run as ordinary
    // processes outside the Bash sandbox, which matters for Claude Code: its sandbox denies the
    // writes a dependency install needs under paths it protects.
    //
    // The script runs `./agent setup` — the entrypoint rather than `just setup` because it
    // activates the pinned devenv profile itself, which a fresh worktree has not done yet; it is
    // idempotent and returns in well under a second once a checkout is bootstrapped, so it runs
    // unconditionally — and then, when Claude Code hands it CLAUDE_ENV_FILE, exports that profile's
    // bin directory onto the PATH of every later Bash tool command. Setup stays quiet; after it
    // completes, the model-routing notice reaches the agent only when the routing table looks
    // behind the models this machine runs.
    "sessionStart": [
      {
        "name": "Set up this checkout",
        "description": "Install pinned dependencies, generate harness configuration, and load the development tools when a session starts.",
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-session-start.zsh\"",
      },
    ],
    // The three delegation hooks record what this repository hands to subagents, so that the
    // routing table in the `delegation` skill is tuned against evidence; `./agent
    // delegation-report` reads them and says which fields a harness left out. They come out when
    // `Docs/Roadmap/Subagent delegation/Plan - Subagent delegation.md` says the calibration is
    // done. Claude Code renamed the spawning tool from `Task` to `Agent`; the matcher follows.
    //
    // The shell-habits hook states, beside the tool result, the two habits a warning still serves:
    // no `cd`/`export`/`VAR=` prefix, which would send the command to permission review, and a
    // report's exit status captured rather than piped away. A gate's pipe is refused below rather
    // than warned about here, so that one command never draws both voices. Both harnesses carry
    // this text non-blocking through `hookSpecificOutput.additionalContext`, so unlike the logging
    // hooks above its stdout must reach the harness rather than /dev/null. It warns; it never
    // blocks, and `|| true` keeps a missing worktree from being reported as a hook error.
    "preToolUse": [
      // The output-discipline hook is the one hook here that refuses rather than warns, and the
      // reason is structural rather than a preference for strictness. A warning travels in
      // `additionalContext`, which both harnesses place beside the tool result — so a warning about
      // an eight-thousand-character dump arrives underneath the dump, having prevented nothing.
      // Shell file reads and unbounded Git patches were 42% of every character this repository's
      // agents read through Bash in a week, and `OutputDiscipline.ts` refuses exactly those,
      // naming the pipe, the redirect, or the summary flag that makes the command acceptable. It
      // owns no habit the shell-habits hook already warns about.
      //
      // It also refuses the commands that return a plausible wrong answer rather than a large one,
      // where a warning arrives beside a result the agent has already believed: a recursive `grep`
      // or `find` over a tree 67 times the size of its source, `rg -r`/`rg -L` spelled from a grep
      // habit, a gate whose verdict a filter replaces, `bun test` on a relative path, a wide `git
      // add` or a bare `git stash` over work other writers left here, and a shell redirect writing
      // reviewed content. `# hook-ok: <reason>` runs a command a rule wrongly caught and records
      // the reason in `.artifacts/logs/hook-overrides.jsonl`, so a misfiring rule is found from
      // evidence rather than from argument.
      //
      // The refusal travels as `hookSpecificOutput.permissionDecision: "deny"`, which both harnesses
      // document as the way to deny a tool call, neither requiring a particular exit code for it:
      // code.claude.com/docs/en/hooks and learn.chatgpt.com/docs/hooks ("To deny a supported tool
      // call, return this hook-specific shape"). Exiting 0 regardless therefore denies where a rule
      // matched and costs nothing where none did, and the `|| true` cannot swallow a decision that
      // travels on stdout.
      {
        "type": "command",
        "matcher": "Bash",
        "name": "Check shell commands before running",
        "description": "Block overly broad output, misleading commands, and unsafe staging; explain how to correct the command.",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-output-discipline.zsh\" || true",
      },
      {
        "type": "command",
        "matcher": "Agent",
        "name": "Record subagent requests locally",
        "description": "Save delegation requests in this checkout's local logs to review model routing and cost.",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" spawn > /dev/null 2>&1 || true",
      },
      {
        "type": "command",
        "matcher": "Bash",
        "name": "Remind agents about shell conventions",
        "description": "Add non-blocking reminders about working-directory changes, environment prefixes, and preserving command exit status.",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-shell-habits.zsh\" 2>/dev/null || true",
      },
    ],
    // A subagent gets the repository boilerplate from the second hook rather than from every
    // caller pasting it into every brief; neither harness lets a SubagentStart hook block.
    "subagentStart": [
      {
        "name": "Record subagent starts locally",
        "description": "Save subagent start events in this checkout's local delegation logs.",
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" start > /dev/null 2>&1 || true",
      },
      {
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-subagent-brief.zsh\" 2>/dev/null || true",
        "name": "Give subagents repository instructions",
        "description": "Provide each subagent with the repository's working-directory, search, file ownership, and reporting rules.",
      },
    ],
    "subagentStop": [
      {
        "name": "Record subagent completions locally",
        "description": "Save subagent completion events in this checkout's local delegation logs.",
        "type": "command",
        "command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && \"$repo_root/packages/cli/agent-cli/agent-cli-src/cli/agent-delegation-log.zsh\" stop > /dev/null 2>&1 || true",
      },
    ],
    // Claude Code otherwise creates its worktrees inside the checkout, under `.claude/worktrees/`,
    // which puts each one inside every watch of the primary checkout: Watchman answers a path
    // under an existing watch with that watch, by design (WorktreePlacement.ts has the rest). These
    // two replace its `git worktree add` and `git worktree remove` so worktrees live beside the
    // checkout. Codex already keeps its own outside, and rulesync renders these two events for
    // Claude Code alone. The create hook's stdout is the worktree path the harness adopts, and a
    // failure must reach the harness, so neither command swallows one. A checkout that predates the
    // script borrows the primary checkout's copy rather than failing every worktree it would make.
    "worktreeCreate": [
      {
        "name": "Create isolated worktrees beside the checkout",
        "description": "Create a sibling Git worktree so its files stay outside the primary checkout's file watchers.",
        "type": "command",
        "command": "script=packages/cli/agent-cli/agent-cli-src/cli/agent-worktree.zsh && repo_root=\"$(git rev-parse --show-toplevel)\" && { [ -x \"$repo_root/$script\" ] || repo_root=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"; } && \"$repo_root/$script\" create",
      },
    ],
    "worktreeRemove": [
      {
        "name": "Remove a finished isolated worktree",
        "description": "Remove the worktree selected by the harness through the repository's worktree cleanup script.",
        "type": "command",
        "command": "script=packages/cli/agent-cli/agent-cli-src/cli/agent-worktree.zsh && repo_root=\"$(git rev-parse --show-toplevel)\" && { [ -x \"$repo_root/$script\" ] || repo_root=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\"; } && \"$repo_root/$script\" remove",
      },
    ],
  },
}
