{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  // Canonical agent permission rules for this repository. `./agent setup` renders them into
  // .claude/settings.json (via rulesync) plus .codex/config.toml and .codex/rules/tao.rules
  // (via tao-agent-cli's CodexConfigGenerator). Edit this file, never the generated ones.
  // Git metadata paths are checkout-specific: setup installs exact common/worktree directory
  // grants in the machine-local Codex user profile, never in the tracked project config.
  "permission": {
    "bash": {
      // `--force` breaks a lock this session did not necessarily take, on the strength of a dead
      // PID that proves nothing (see LandingLock.ts). This sits above the blanket `./agent *`
      // allow below — deny, then ask, then allow, is Claude Code's own
      // precedence regardless of rule order — so a force-unlock always asks even though the plain
      // command does not. Codex cannot express this: `CodexConfigGenerator.renderCodexRules` only
      // emits `allow` entries, so Codex gets no equivalent gate; that asymmetry is accepted.
      "./agent land-unlock --force*": "ask",
      // Agent workflow commands stay sandboxed except for one host rule per named
      // `./agent unsandboxed X` operation. The editable dispatcher checks deeper argv.
      "./agent *": "allow",
      // One owner prevents concurrent or redundant Bun installs from colliding in node_modules.
      // The generated harness rules reject this directly and point agents to `./agent setup`.
      "bun install *": "deny",
      // Routine inspection stays sandboxed. State-changing variants are deliberately absent.
      "pwd": "allow",
      // Harmless on its own, and listed so a compound `cd <dir> && rg …` keeps every part inside
      // an allow rule instead of waiting on permission review; the built-in read-only `cd` covers
      // only paths under the working directory. Agents should still not need it: see `env` below.
      "cd *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "jq *": "allow",
      "plutil -lint *": "allow",
      "plutil -p *": "allow",
      "uname *": "allow",
      "sw_vers *": "allow",
      "df *": "allow",
      "du *": "allow",
      "which *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git worktree list *": "allow",
      "git ls-files *": "allow",
      "git remote -v": "allow",
      "git tag --list *": "allow",
      "lsof -nP -iTCP:* -sTCP:LISTEN -t": "allow",
    },
    "read": {
      // The previous repository is reference material (see AGENTS.md).
      "~/code/tao-lang/**": "allow",
      // Claude Code and Codex's read-only review profile enforce these denials. Codex's default
      // workspace profile omits them: Codex will not honor an explicit host command rule when
      // any denied-read pattern is active. AGENTS.md still forbids agents from reading them.
      // Keep the patterns narrow so they do not match unrelated repository files.
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.aws/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.ssh/**": "deny",
    },
    "webfetch": {
      "*": "allow",
    },
    "websearch": {
      "*": "allow",
    },
    "mcp__Claude_Browser__*": {
      "*": "allow",
    },
    "mcp__Claude_Code_iOS_Simulator__*": {
      "*": "allow",
    },
    "mcp__claude-in-chrome__*": {
      "*": "allow",
    },
    // Messaging a subagent you spawned is always allowed. `SendMessage` cannot tell a subagent from
    // another session by its arguments, so the rule that a message to any other agent or session
    // is the Developer's to approve lives in AGENTS.md and the `delegation` skill; the session-management
    // tool below only ever reaches another session, so it keeps its gate. As with the force-unlock
    // rules above, Codex gets no equivalent gate, because `CodexConfigGenerator.renderCodexRules`
    // emits only `allow` entries.
    "SendMessage": {
      "*": "allow",
    },
    "mcp__ccd_session_mgmt__send_message": {
      "*": "ask",
    },
  },
  // Named argv prefixes accepted by ./agent unsandboxed. The harnesses grant one exception
  // per first operation name; the wrapper checks deeper argv and HostCommandTargets implements
  // tool operations. This editable-wrapper trust boundary is tracked for later replacement.
  "agentHostCommands": [
    "notify-developer",
    "stop",
    "land", "finalize", "merge-main", "merge-recover", "landed", "capabilities", "open-pr", "fix-agent-config", "verify-full",
    "test-host", "qa-capture", "studio-smoke", "studio-proof-real-app", "admission-experiment",
    "native-module-check", "reclaim --execute",
    "prepare-release studio", "prepare-release ide-extension", "ide-extension-acceptance",
    "app-dev", "test-watch", "standalone-cli-acceptance", "studio", "studio-native", "studio-ps", "studio-stop",
    "docker-desktop start",
    "watchman start", "watchman status", "watchman stop",
    "local-instantdb start", "local-instantdb stop",
    "companion-host-build",
    "setup-ios", "setup-visionos", "setup-watchos",
    "studio-companion-install", "clerk-review",
    "standalone-cli-vm-setup", "standalone-cli-clean-machine", "contributor-linux-test",
    "simulators list", "simulators boot", "simulators run", "simulators app-container",
    "simulators install", "simulators launch", "simulators open-url", "simulators uninstall", "simulators open",
    "devices list", "devices apps", "devices launch",
    "xcode version", "xcode setup-status", "xcode sdks", "xcode build-project",
    "xcode build-workspace", "xcode export-archive",
    "pods install", "pods spec",
    "android devices", "android state", "android emulators", "android boot", "android ensure",
    "remote fetch", "remote refs", "remote heads", "remote exists",
    "processes list", "processes started", "start-branch",
    "storage sync", "storage qa", "storage push",
  ],
  "claudecode": {
    "autoCompactWindow": 272000,
    "sandbox": {
      "enabled": true,
      "excludedCommands": [],
      // The `read` deny rules above only bind the file tools. These bind sandboxed shell
      // commands, which would otherwise be able to cat the same files.
      "credentials": {
        "files": [
          { "path": "~/.ssh", "mode": "deny" },
          { "path": "~/.aws", "mode": "deny" },
          { "path": "~/.config/gh", "mode": "deny" },
        ],
      },
      // Caches the pinned toolchain writes outside the worktree. Expo's native-module cache and
      // Hutch's launcher root are as much part of the dev loop as Bun's and Gradle's.
      "filesystem": {
        "allowWrite": [
          "~/.tao",
          "~/.bun",
          "~/.cache",
          "~/.gradle",
          "~/.android",
          "~/.expo",
          "~/.hutch",
          "~/Library/Caches",
        ],
      },
      "network": {
        "allowLocalBinding": true,
        // Watchman is deliberately absent. Its socket sits under each developer's home directory,
        // and Codex accepts only an absolute socket path, which would put a login in the tracked
        // config; an agent sandbox also refuses OS file watching outright. So file-watching dev
        // loops run on the host (`./agent unsandboxed app-dev` or `studio`), and sandboxed tests
        // and builds crawl the tree without Watchman.
        "allowUnixSockets": [
          "/nix/var/nix/daemon-socket/socket",
        ],
        "allowedDomains": [
          "registry.npmjs.org",
          "*.npmjs.org",
          "nodejs.org",
          "*.nodejs.org",
          "github.com",
          "*.github.com",
          "*.githubusercontent.com",
          // Pinned native Studio launcher, engine, and runtime release artifacts.
          "hutch.blackboard.sh",
          "electrobun-artifacts.blackboard.sh",
          // Compiler used to rebuild the pinned native engine with its reviewed transport patch.
          "ziglang.org",
          "expo.dev",
          "*.expo.dev",
          "*.expo.io",
          "exp.host",
          // React Native's CocoaPods integration downloads iOS artifacts from Maven and its
          // artifact CDN during native builds. These network rules do not grant a host escape.
          "repo1.maven.org",
          "repo.reactnative.dev",
          // CocoaPods resolves native iOS podspecs through its official metadata CDN.
          "cdn.cocoapods.org",
          // Contributor Ubuntu image: token exchange, registry, and documented blob delivery.
          // https://docs.docker.com/desktop/setup/allow-list/
          "auth.docker.io",
          "registry-1.docker.io",
          "production.cloudfront.docker.com",
          // The fixed amd64 Ubuntu base installs prerequisites from these package archives.
          "archive.ubuntu.com",
          "security.ubuntu.com",
          // nix-bootstrap.sh downloads its checksum-pinned release directly, without channels.
          "releases.nixos.org",
          "cache.nixos.org",
          "*.cachix.org",
          "*.anthropic.com",
          "*.openai.com",
          // Apple: Developer Portal and App Store Connect APIs, Apple ID sign-in, uploads, downloads.
          "developer.apple.com",
          "*.developer.apple.com",
          "appstoreconnect.apple.com",
          "*.appstoreconnect.apple.com",
          "idmsa.apple.com",
          "appleid.apple.com",
          "gsa.apple.com",
          "contentdelivery.apple.com",
          "*.itunes.apple.com",
          "devimages-cdn.apple.com",
          "swcdn.apple.com",
          "swdist.apple.com",
        ],
      },
    },
    // Claude Code returns its tool shell to the worktree root after every command, so an agent
    // never needs a `cd` prefix — which takes a command out of its allow rule and into permission
    // review, about two seconds per call. The profile PATH comes from the session-start hook in
    // hooks.jsonc, because `env` values here are literal and cannot extend the existing PATH.
    // Subagents default to the standard tier's `opus` alias, left unpinned so each install
    // resolves it to the newest Opus it knows.
    "env": {
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    },
    // Deliberately not set here: `env.CLAUDE_CODE_SUBPROCESS_ENV_SCRUB`. It scrubs only
    // Anthropic and cloud-provider credentials from subprocess environments, and in exchange
    // pins every session in this repository to the `default` permission mode — no acceptEdits,
    // no auto. The credential denies above cover the files this repository actually holds.
  },
}
