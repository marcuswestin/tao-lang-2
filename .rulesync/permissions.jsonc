{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  // Canonical agent permission rules for this repository. `./agent setup` renders them into
  // .claude/settings.json (via rulesync) plus .codex/config.toml and .codex/rules/tao.rules
  // (via packages/dev's CodexConfigGenerator). Edit this file, never the generated ones.
  "permission": {
    "bash": {
      // `--force` breaks a lock this session did not necessarily take, on the strength of a dead
      // PID that proves nothing (see LandingLock.ts). These sit above the blanket `./agent *` /
      // `./dev *` / `just *` allows below — deny, then ask, then allow, is Claude Code's own
      // precedence regardless of rule order — so a force-unlock always asks even though the plain
      // command does not. Codex cannot express this: `CodexConfigGenerator.renderCodexRules` only
      // emits `allow` entries, so Codex gets no equivalent gate; that asymmetry is accepted.
      "./dev land-unlock --force*": "ask",
      "./agent land-unlock --force*": "ask",
      "just land-unlock --force*": "ask",
      // The repository's own workflow surface. Agents run these without asking.
      "./agent *": "allow",
      "./dev *": "allow",
      "./tao *": "allow",
      "just *": "allow",
      // One owner prevents concurrent or redundant Bun installs from colliding in node_modules.
      // The generated harness rules reject this directly and point agents to `./agent setup`.
      "bun install *": "deny",
      "bun run *": "allow",
      "bun test *": "allow",
      "direnv exec . *": "allow",
      "dprint *": "allow",
      // Routine inspection stays sandboxed. State-changing variants are deliberately absent.
      "pwd": "allow",
      // Harmless on its own, and listed so a compound `cd <dir> && rg …` keeps every part inside
      // an allow rule instead of waiting on permission review; the built-in read-only `cd` covers
      // only paths under the working directory. Agents should still not need it: see `env` below.
      "cd *": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "jq *": "allow",
      "plutil -lint *": "allow",
      "plutil -p *": "allow",
      "uname *": "allow",
      "sw_vers *": "allow",
      "df *": "allow",
      "du *": "allow",
      "which *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git worktree list *": "allow",
      "git ls-files *": "allow",
      "git remote -v": "allow",
      "git tag --list *": "allow",
      // The macOS sandbox denies process-table access outright, so every `ps` shape an agent may
      // run has to be named here and excluded from the sandbox below; anything unlisted fails with
      // "operation not permitted" rather than with a permission prompt.
      //
      // Prefer `ProcessTree` over any of these. On macOS it reads the same facts through libproc
      // with no subprocess at all, which is why a `ps` denial cannot break it — and why a liveness
      // check built on `ps` silently lost its start-time comparison in every sandboxed run.
      //
      // The whole-table read and the per-PID start time are both read-only. The residual hazard is
      // the trailing wildcard: `ps -E` prints another same-user process's environment, which can
      // hold tokens the `read` denies below exist to keep out. Nothing in this repository runs it,
      // and there is no bash deny rule to forbid it, so it is recorded here as the boundary rather
      // than hidden. Termination prefixes stay absent entirely.
      "ps -axo pid=,ppid=,lstart=,command=": "allow",
      "ps -o lstart= -p *": "allow",
      "lsof -nP -iTCP:* -sTCP:LISTEN -t": "allow",
      // Read-only device discovery is automatic. Install, shell, boot, erase, and wipe operations
      // remain approval boundaries and belong to an explicitly selected native workflow.
      "adb devices *": "allow",
      "adb get-state *": "allow",
      "emulator -list-avds": "allow",
      "xcrun simctl list *": "allow",
      // Merging runs without a prompt. An agent decides which branch lands on main, and when, on
      // its own judgment; `verification-lanes` owns where that judgment stops and hands the
      // landing to Ro. A bare `git push` is the outward-facing step and is deliberately absent
      // from this list — the landing command does its own pushing, under that same judgment.
      "git merge *": "allow",
      // Read-only remote queries, so agents can inspect origin. Pushing stays absent
      // above by design; the sandbox exclusion below is what lets its prompt succeed.
      "git fetch origin *": "allow",
      // Both orders, because git accepts the flag on either side of the remote and a pattern that
      // matches only one of them is a rule that looks present and is not: `merge-with-main`'s own
      // preflight runs `git ls-remote --heads origin refs/heads/...`, which `git ls-remote origin *`
      // cannot match, so the landing command failed inside the sandbox on its own remote query.
      "git ls-remote origin *": "allow",
      "git ls-remote --heads origin *": "allow",
    },
    "read": {
      // The previous repository is reference material (see AGENTS.md).
      "~/code/tao-lang/**": "allow",
      // Not `.env*`: that pattern also matches this repository's own `.envrc`.
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.aws/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.ssh/**": "deny",
    },
    "webfetch": {
      "*": "allow",
    },
    "websearch": {
      "*": "allow",
    },
    "mcp__Claude_Browser__*": {
      "*": "allow",
    },
    "mcp__Claude_Code_iOS_Simulator__*": {
      "*": "allow",
    },
    "mcp__claude-in-chrome__*": {
      "*": "allow",
    },
    // Messaging a subagent you spawned is always allowed. `SendMessage` cannot tell a subagent from
    // another session by its arguments, so the rule that a message to any other agent or session
    // is Ro's to approve lives in AGENTS.md and the `delegation` skill; the session-management
    // tool below only ever reaches another session, so it keeps its gate. As with the force-unlock
    // rules above, Codex gets no equivalent gate, because `CodexConfigGenerator.renderCodexRules`
    // emits only `allow` entries.
    "SendMessage": {
      "*": "allow",
    },
    "mcp__ccd_session_mgmt__send_message": {
      "*": "ask",
    },
  },
  "claudecode": {
    "sandbox": {
      "enabled": true,
      "excludedCommands": [
        // These commands need host process or native-service access the sandbox cannot express.
        // Every entry also has a matching allow rule above; the Codex generator derives the
        // project-local outside-sandbox rules from that intersection.
        "ps -axo pid=,ppid=,lstart=,command=",
        "ps -o lstart= -p *",
        "adb devices *",
        "adb get-state *",
        "emulator -list-avds",
        "xcrun simctl list *",
        "gh *",
        // Git's github.com credential helper is `gh auth git-credential`, which reads
        // ~/.config/gh — denied below. `gh *` is excluded, but a helper spawned by git
        // inherits git's sandbox, so networked git fails with a misleading
        // "could not read Username for 'https://github.com'". These exclusions make direct
        // top-level Git commands eligible for host review; they cannot lift a nested Git command
        // such as merge-with-main's own preflight out of the sandbox.
        "git fetch origin *",
        "git ls-remote origin *",
        "git ls-remote --heads origin *",
        "git push *",
        // Removing a worktree writes outside this checkout. It still prompts, which is
        // correct for a command that deletes directories.
        "git worktree *",
        // A squash merge, and the reset that aborts one, write the primary checkout's working
        // tree, which the sandbox denies from a linked worktree. `git merge *` is already allowed
        // above without a prompt; excluding it is what lets that permission succeed instead of
        // failing on "Operation not permitted". The reset exclusion is deliberately narrow — only
        // the two abort shapes — so an unsandboxed `git reset --hard <ref>` never becomes possible
        // by policy; other reset forms still prompt and still run sandboxed. Which branch lands on
        // main, and when, is the agent's own judgment; `verification-lanes` owns where that
        // judgment stops.
        "git merge *",
        "git reset --merge",
        "git reset --hard HEAD",
        // The landing itself, because none of the entries above can reach inside it. The sandbox
        // matches the top-level command string, so a landing spawns its Git, its gates, and its
        // gates' children all sandboxed however many Git exclusions are listed here. What that
        // costs is not subtle: measured 2026-09-21, `./dev land` sandboxed failed every Studio and
        // browser gate in 1.5-9.9s — Studio exits before reporting readiness — and the same gates
        // passed in the same tree moments later unsandboxed. The landing is already an approval
        // boundary that `verification-lanes` owns and `./dev *` already allows, so naming it here
        // makes it one reviewed unit rather than a command that half-runs and blames the branch.
        // `land-unlock --force` keeps its own `ask` rule above; excluding a command from the
        // sandbox never grants it permission.
        //
        // Both spellings of the landing are named, because they are two CLI verbs rather than one:
        // `land` wraps the lock, the barrier, and then `merge-with-main`, which is also reachable on
        // its own and is the spelling AGENTS.md uses. Naming only `land` would leave the documented
        // entry point sandboxed and failing exactly as before. `./agent` has no landing command at
        // all — `JUST_COMMANDS` in `agent-dev.ts` stops at `land-lock`, `land-unlock` and `landed`,
        // because an agent proposes a landing rather than making one — so an `./agent land` entry
        // here would be a rule that looks like coverage and matches nothing.
        "./dev land",
        "./dev land *",
        "./dev merge-with-main",
        "./dev merge-with-main *",
        "just land",
        "just land *",
        "just merge-with-main",
        "just merge-with-main *",
        "just my-land",
        "just my-land *",
      ],
      // The `read` deny rules above only bind the file tools. These bind sandboxed shell
      // commands, which would otherwise be able to cat the same files.
      "credentials": {
        "files": [
          { "path": "~/.ssh", "mode": "deny" },
          { "path": "~/.aws", "mode": "deny" },
          { "path": "~/.config/gh", "mode": "deny" },
        ],
      },
      // Caches the pinned toolchain writes outside the worktree. Expo's native-module cache,
      // Hutch's launcher root, and Watchman's state directory are as much part of the dev loop
      // as Bun's and Gradle's: without them Studio, native Studio, and file watching all fail.
      "filesystem": {
        "allowWrite": [
          "~/.bun",
          "~/.cache",
          "~/.gradle",
          "~/.android",
          "~/.expo",
          "~/.hutch",
          "~/.local/state/watchman",
          "~/Library/Caches",
        ],
      },
      "network": {
        "allowLocalBinding": true,
        // Watchman's client talks to its server over this socket, and Metro falls back to
        // watching through the OS without it — which this repository exceeds, so Metro dies
        // with EMFILE partway through its first bundle. The `<user>-state` segment is
        // Watchman's own naming; a glob is not matched here, so the path is spelled out.
        "allowUnixSockets": [
          "/nix/var/nix/daemon-socket/socket",
          "~/.local/state/watchman/ro-state/sock",
        ],
        "allowedDomains": [
          "registry.npmjs.org",
          "*.npmjs.org",
          "nodejs.org",
          "*.nodejs.org",
          "github.com",
          "*.github.com",
          "*.githubusercontent.com",
          "expo.dev",
          "*.expo.dev",
          "*.expo.io",
          "exp.host",
          // React Native's CocoaPods integration downloads the Hermes iOS artifact from Maven
          // during the native-module compiler proof. The command still requires explicit host
          // review or an opt-in unsandboxed session; this network rule does not grant a host escape.
          "repo1.maven.org",
          "cache.nixos.org",
          "*.cachix.org",
          "*.anthropic.com",
          "*.openai.com",
          // Apple: Developer Portal and App Store Connect APIs, Apple ID sign-in, uploads, downloads.
          "developer.apple.com",
          "*.developer.apple.com",
          "appstoreconnect.apple.com",
          "*.appstoreconnect.apple.com",
          "idmsa.apple.com",
          "appleid.apple.com",
          "gsa.apple.com",
          "contentdelivery.apple.com",
          "*.itunes.apple.com",
          "devimages-cdn.apple.com",
          "swcdn.apple.com",
          "swdist.apple.com",
        ],
      },
    },
    // Claude Code returns its tool shell to the worktree root after every command, so an agent
    // never needs a `cd` prefix — which takes a command out of its allow rule and into permission
    // review, about two seconds per call. The profile PATH comes from the session-start hook in
    // hooks.jsonc, because `env` values here are literal and cannot extend the existing PATH.
    "env": {
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    },
    // Deliberately not set here: `env.CLAUDE_CODE_SUBPROCESS_ENV_SCRUB`. It scrubs only
    // Anthropic and cloud-provider credentials from subprocess environments, and in exchange
    // pins every session in this repository to the `default` permission mode — no acceptEdits,
    // no auto. The credential denies above cover the files this repository actually holds.
  },
}
