{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": ["codexcli", "claudecode"],
  // Features generated for every target. The permissions feature is opted into per target by
  // packages/dev/dev-src/agent-config/AgentConfigGenerator.ts, because Codex CLI keeps a
  // hand-written .codex/config.toml that rulesync's translator cannot express.
  "features": ["subagents"],
  "delete": true,
}
