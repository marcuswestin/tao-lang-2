#!/bin/zsh

set -e

# Repository development tooling: package tests and Expo device preparation.
# This is not the Tao CLI; `./tao dev` runs the app development loop.
SCRIPT_DIR="${0:A:h}"
DEVENV_PROFILE="$SCRIPT_DIR/.devenv/profile"
DEPENDENCY_SCRIPT="$SCRIPT_DIR/packages/dev/dev-src/cli/ensure-dependencies.zsh"

source "$SCRIPT_DIR/packages/dev/dev-src/cli/agent-worktree-profile.zsh"

if ! tao_activate_devenv_profile "$SCRIPT_DIR" "$DEVENV_PROFILE"; then
  echo "Tao's pinned devenv profile is unavailable." >&2
  echo "Create the worktree with Worktrunk, or run: direnv allow && direnv exec . ./agent setup" >&2
  exit 1
fi

# `./dev` runs from source, so it uses the same installer and completion proof as `./agent` before
# Bun resolves the entry module. A dependency tree restored here therefore never triggers a second
# install when the next command enters through `./agent`.
if [[ "${1:-}" == agent-config ]]; then
  # Agent-config regeneration is a sandbox-excluded recovery; use only dependencies already here.
  zsh "$DEPENDENCY_SCRIPT" "$SCRIPT_DIR" --no-install
else
  zsh "$DEPENDENCY_SCRIPT" "$SCRIPT_DIR"
fi

exec bun run "$SCRIPT_DIR/packages/dev/dev-src/dev.ts" "$@"
